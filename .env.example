# ── Database ──────────────────────────────────────────────────────────────────
# Full PostgreSQL connection string (required)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://user:password@localhost:5432/pos_db

# ── Session ───────────────────────────────────────────────────────────────────
# Secret used to sign session cookies (required in production)
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-string

# ── Server ────────────────────────────────────────────────────────────────────
# Port the app listens on (Hostinger sets this automatically)
PORT=3000

# ── Routing ───────────────────────────────────────────────────────────────────
# URL base path for the app (leave as / if the app runs at the domain root)
# Use /pos-system only when the app is served under a sub-path
BASE_PATH=/

# ── Environment ───────────────────────────────────────────────────────────────
NODE_ENV=production
