<%- include('partials/header', Object.assign({pageTitle: 'سجل الحضور'}, locals)) %>
<div class="space-y-6">
  <h1 class="text-2xl font-bold text-gray-800">📅 سجل الحضور والانصراف</h1>

  <!-- Filters -->
  <div class="bg-white rounded-2xl border shadow-sm p-4 flex flex-wrap gap-3 items-end">
    <div>
      <label class="text-xs font-semibold text-gray-600 block mb-1">الموظف</label>
      <select id="userFilter" onchange="loadAttendance()"
        class="border rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-200 min-w-40">
        <option value="">الكل</option>
      </select>
    </div>
    <div>
      <label class="text-xs font-semibold text-gray-600 block mb-1">من تاريخ</label>
      <input id="dateFrom" type="date" onchange="loadAttendance()"
        class="border rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-200"/>
    </div>
    <div>
      <label class="text-xs font-semibold text-gray-600 block mb-1">إلى تاريخ</label>
      <input id="dateTo" type="date" onchange="loadAttendance()"
        class="border rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-200"/>
    </div>
    <button onclick="resetFilters()" class="text-xs text-gray-500 border rounded-xl px-3 py-2 hover:bg-gray-50">إعادة ضبط</button>
  </div>

  <!-- Summary Cards -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
    <div class="bg-blue-50 border border-blue-100 rounded-2xl p-4 text-center">
      <div id="sumTotal" class="text-2xl font-black text-blue-700">—</div>
      <div class="text-xs text-blue-500 mt-1">إجمالي الجلسات</div>
    </div>
    <div class="bg-green-50 border border-green-100 rounded-2xl p-4 text-center">
      <div id="sumActive" class="text-2xl font-black text-green-700">—</div>
      <div class="text-xs text-green-500 mt-1">نشط الآن</div>
    </div>
    <div class="bg-purple-50 border border-purple-100 rounded-2xl p-4 text-center">
      <div id="sumAvgDuration" class="text-2xl font-black text-purple-700">—</div>
      <div class="text-xs text-purple-500 mt-1">متوسط مدة الجلسة</div>
    </div>
    <div class="bg-orange-50 border border-orange-100 rounded-2xl p-4 text-center">
      <div id="sumUniqueUsers" class="text-2xl font-black text-orange-700">—</div>
      <div class="text-xs text-orange-500 mt-1">موظفون حاضرون</div>
    </div>
  </div>

  <!-- Sessions Table -->
  <div class="bg-white rounded-2xl border shadow-sm overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 border-b">
        <tr class="text-right text-gray-600 font-semibold">
          <th class="px-4 py-3">الموظف</th>
          <th class="px-4 py-3">الدور</th>
          <th class="px-4 py-3">وقت الدخول</th>
          <th class="px-4 py-3">وقت الخروج</th>
          <th class="px-4 py-3">المدة</th>
          <th class="px-4 py-3">الحالة</th>
        </tr>
      </thead>
      <tbody id="attendanceTable" class="divide-y"></tbody>
    </table>
    <div id="noAttendance" class="hidden text-center text-gray-400 py-12 text-sm">لا توجد سجلات في هذه الفترة</div>
  </div>
</div>
<script>
const BASE = "<%- base %>";

async function loadUsers() {
  const res = await fetch(`${BASE}/api/users`);
  const users = await res.json();
  const sel = document.getElementById("userFilter");
  users.forEach(u => {
    const opt = document.createElement("option");
    opt.value = u.id;
    opt.textContent = `${u.username} (${u.role === 'manager' ? 'مدير' : 'موظف'})`;
    sel.appendChild(opt);
  });
}

function calcDuration(loginAt, logoutAt) {
  const start = new Date(loginAt);
  const end = logoutAt ? new Date(logoutAt) : new Date();
  const diff = Math.floor((end - start) / 60000);
  if (diff < 60) return `${diff} دقيقة`;
  const h = Math.floor(diff / 60);
  const m = diff % 60;
  return `${h}س ${m}د`;
}

async function loadAttendance() {
  const userId = document.getElementById("userFilter").value;
  const from = document.getElementById("dateFrom").value;
  const to = document.getElementById("dateTo").value;
  let url = `${BASE}/api/attendance?`;
  if (from) url += `from=${from}&`;
  if (to) url += `to=${to}&`;
  if (userId) url += `user_id=${userId}&`;

  const res = await fetch(url);
  const data = await res.json();

  // Summary
  document.getElementById("sumTotal").textContent = data.length;
  const active = data.filter(s => !s.logout_at);
  document.getElementById("sumActive").textContent = active.length;
  const uniqueUsers = new Set(data.map(s => s.user_id)).size;
  document.getElementById("sumUniqueUsers").textContent = uniqueUsers;
  const completed = data.filter(s => s.logout_at);
  if (completed.length) {
    const avgMs = completed.reduce((sum, s) => {
      return sum + (new Date(s.logout_at) - new Date(s.login_at));
    }, 0) / completed.length / 60000;
    document.getElementById("sumAvgDuration").textContent = `${Math.round(avgMs)}د`;
  } else {
    document.getElementById("sumAvgDuration").textContent = "—";
  }

  const tbody = document.getElementById("attendanceTable");
  const noMsg = document.getElementById("noAttendance");
  if (!data.length) { tbody.innerHTML = ""; noMsg.classList.remove("hidden"); return; }
  noMsg.classList.add("hidden");

  tbody.innerHTML = data.map(s => {
    const isActive = !s.logout_at;
    return `<tr class="hover:bg-gray-50 ${isActive ? 'bg-green-50/30' : ''}">
      <td class="px-4 py-3 font-medium text-gray-800">${s.username}</td>
      <td class="px-4 py-3">
        <span class="text-xs font-bold px-2 py-1 rounded-full ${s.role === 'manager' ? 'bg-yellow-100 text-yellow-700' : 'bg-blue-100 text-blue-700'}">
          ${s.role === 'manager' ? 'مدير' : 'موظف'}
        </span>
      </td>
      <td class="px-4 py-3 text-gray-700 font-mono text-xs">${s.login_at ? s.login_at.replace('T',' ').slice(0,16) : '—'}</td>
      <td class="px-4 py-3 text-gray-700 font-mono text-xs">${s.logout_at ? s.logout_at.replace('T',' ').slice(0,16) : '—'}</td>
      <td class="px-4 py-3 text-gray-600">${calcDuration(s.login_at, s.logout_at)}</td>
      <td class="px-4 py-3">
        <span class="text-xs font-bold px-2.5 py-1 rounded-full ${isActive ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-600'}">
          ${isActive ? '🟢 نشط' : '✓ خرج'}
        </span>
      </td>
    </tr>`;
  }).join("");
}

function resetFilters() {
  document.getElementById("userFilter").value = "";
  const today = new Date().toISOString().split("T")[0];
  const monthAgo = new Date(Date.now() - 30*24*3600*1000).toISOString().split("T")[0];
  document.getElementById("dateFrom").value = monthAgo;
  document.getElementById("dateTo").value = today;
  loadAttendance();
}

// Init
const today = new Date().toISOString().split("T")[0];
const monthAgo = new Date(Date.now() - 30*24*3600*1000).toISOString().split("T")[0];
document.getElementById("dateFrom").value = monthAgo;
document.getElementById("dateTo").value = today;
loadUsers().then(() => loadAttendance());
</script>

</main>
<%- include('partials/footer', locals) %>
