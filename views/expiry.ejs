<%- include('partials/header', Object.assign({pageTitle: 'تنبيهات الصلاحية'}, locals)) %>
<div class="space-y-6">
  <h1 class="text-2xl font-bold text-gray-800" data-ar="⏰ تنبيهات الصلاحية والمراجعة" data-en="⏰ Expiry Alerts">⏰ تنبيهات الصلاحية والمراجعة</h1>

  <div class="bg-white rounded-2xl border shadow-sm p-4 flex flex-wrap items-center gap-4">
    <div class="flex items-center gap-2">
      <label class="text-sm font-medium text-gray-600" data-ar="تنبيه قبل" data-en="Alert before">تنبيه قبل</label>
      <input id="monthsInput" type="number" min="1" max="36" value="3"
        class="border rounded-xl px-3 py-2 w-20 text-sm text-center focus:outline-none focus:ring-2 focus:ring-blue-200"/>
      <span class="text-sm text-gray-600" data-ar="شهر" data-en="months">شهر</span>
    </div>
    <button onclick="loadExpiry()" class="bg-blue-700 text-white px-5 py-2 rounded-xl text-sm font-semibold hover:bg-blue-800" data-ar="🔍 بحث" data-en="🔍 Search">
      🔍 بحث
    </button>
    <div class="flex items-center gap-4 text-xs mr-auto flex-wrap">
      <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-red-500 inline-block"></span> <span data-ar="منتهي الصلاحية" data-en="Expired">منتهي الصلاحية</span></span>
      <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-orange-400 inline-block"></span> <span data-ar="قريب من الانتهاء" data-en="Expiring soon">قريب من الانتهاء</span></span>
    </div>
  </div>

  <div class="bg-white rounded-2xl border shadow-sm overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 border-b">
        <tr class="text-right text-gray-600 font-semibold">
          <th class="px-4 py-3" data-ar="المنتج" data-en="Product">المنتج</th>
          <th class="px-4 py-3" data-ar="الكمية" data-en="Qty">الكمية</th>
          <th class="px-4 py-3" data-ar="سعر البيع" data-en="Price">سعر البيع</th>
          <th class="px-4 py-3" data-ar="تاريخ الصلاحية" data-en="Expiry Date">تاريخ الصلاحية</th>
          <th class="px-4 py-3" data-ar="الحالة" data-en="Status">الحالة</th>
          <th class="px-4 py-3" data-ar="إجراءات" data-en="Actions">إجراءات</th>
        </tr>
      </thead>
      <tbody id="expiryTable"></tbody>
    </table>
    <div id="noExpiry" class="text-center text-gray-400 py-12 text-sm" data-ar="لا توجد منتجات تستحق التنبيه في هذه الفترة ✓" data-en="No products require alerts in this period ✓">لا توجد منتجات تستحق التنبيه في هذه الفترة ✓</div>
  </div>
</div>

<!-- Discount Modal -->
<div id="discountModal" class="hidden fixed inset-0 bg-black/40 flex items-center justify-center z-50 p-4">
  <div class="bg-white rounded-2xl w-full max-w-sm shadow-2xl p-6 space-y-4">
    <h3 class="font-bold text-gray-800 text-lg" data-ar="💰 تطبيق خصم على السعر" data-en="💰 Apply Discount">💰 تطبيق خصم على السعر</h3>
    <p id="discountProductName" class="text-sm text-gray-600 bg-gray-50 rounded-xl p-3"></p>
    <div>
      <label class="text-xs font-medium text-gray-600">السعر الجديد (جنيه)</label>
      <input id="newPriceInput" type="number" step="0.01" min="0"
        class="w-full border rounded-xl px-3 py-2 text-sm mt-1 focus:outline-none focus:ring-2 focus:ring-blue-200"/>
    </div>
    <div class="flex gap-3">
      <button onclick="applyDiscount()" class="flex-1 bg-green-600 text-white font-semibold py-2.5 rounded-xl hover:bg-green-700">تطبيق الخصم</button>
      <button onclick="document.getElementById('discountModal').classList.add('hidden')" class="flex-1 bg-gray-100 text-gray-700 font-semibold py-2.5 rounded-xl">إلغاء</button>
    </div>
  </div>
</div>
<script>
const BASE = "<%- base %>";
let selectedProductId = null;

async function loadExpiry() {
  const months = document.getElementById("monthsInput").value || 3;
  const res = await fetch(`${BASE}/api/expiry-alerts?months=${months}`);
  const data = await res.json();
  const tbody = document.getElementById("expiryTable");
  const noMsg = document.getElementById("noExpiry");

  if (data.length === 0) { tbody.innerHTML = ""; noMsg.classList.remove("hidden"); return; }
  noMsg.classList.add("hidden");

  tbody.innerHTML = data.map(p => {
    const isExpired = p.status === "expired";
    const rowClass = isExpired ? "bg-red-50 hover:bg-red-100" : "bg-orange-50 hover:bg-orange-100";
    const badge = isExpired
      ? `<span class="bg-red-100 text-red-700 text-xs font-bold px-2.5 py-1 rounded-full">منتهي الصلاحية</span>`
      : `<span class="bg-orange-100 text-orange-700 text-xs font-bold px-2.5 py-1 rounded-full">قريب من الانتهاء</span>`;
    return `<tr class="${rowClass}">
      <td class="px-4 py-3 font-medium text-gray-800">${p.product_name}</td>
      <td class="px-4 py-3 font-bold">${p.quantity}</td>
      <td class="px-4 py-3 text-blue-700 font-semibold">${p.sale_price.toFixed(2)} جنيه</td>
      <td class="px-4 py-3 font-semibold ${isExpired ? 'text-red-700' : 'text-orange-700'}">${p.expiry_date}</td>
      <td class="px-4 py-3">${badge}</td>
      <td class="px-4 py-3">
        <div class="flex gap-2">
          <button onclick="openDiscount(${p.id}, ${JSON.stringify(p.product_name)}, ${p.sale_price})"
            class="text-xs bg-green-100 text-green-700 px-3 py-1.5 rounded-lg hover:bg-green-200 font-medium">تخفيض السعر</button>
          <button onclick="markDamaged(${p.id}, ${JSON.stringify(p.product_name)}, ${p.quantity}, ${p.purchase_price})"
            class="text-xs bg-red-100 text-red-700 px-3 py-1.5 rounded-lg hover:bg-red-200 font-medium">تالف / مُعدم</button>
        </div>
      </td>
    </tr>`;
  }).join("");
}

function openDiscount(id, name, currentPrice) {
  selectedProductId = id;
  document.getElementById("discountProductName").textContent = `${name} | السعر الحالي: ${currentPrice.toFixed(2)} جنيه`;
  document.getElementById("newPriceInput").value = currentPrice;
  document.getElementById("discountModal").classList.remove("hidden");
}

async function applyDiscount() {
  const newPrice = parseFloat(document.getElementById("newPriceInput").value);
  if (isNaN(newPrice) || newPrice < 0) { alert("أدخل سعراً صحيحاً"); return; }
  await fetch(`${BASE}/api/products/${selectedProductId}/apply-discount`, {
    method: "POST", headers: {"Content-Type":"application/json"}, body: JSON.stringify({ new_price: newPrice })
  });
  document.getElementById("discountModal").classList.add("hidden");
  loadExpiry();
}

async function markDamaged(id, name, qty, purchase_price) {
  const loss = (qty * purchase_price).toFixed(2);
  if (!confirm(`تأكيد إعدام "${name}"؟\nالكمية: ${qty} | الخسارة: ${loss} جنيه\n(سيتم تسجيل خسارة في المصروفات)`)) return;
  await fetch(`${BASE}/api/products/${id}/mark-damaged`, { method: "POST" });
  loadExpiry();
}

loadExpiry();
</script>

</main>
<%- include('partials/footer', locals) %>
