<%- include('partials/header', Object.assign({pageTitle: 'مزامنة DenTrust'}, locals)) %>
<div class="space-y-6">

  <!-- Header -->
  <div class="flex items-center justify-between flex-wrap gap-3">
    <div>
      <h1 class="text-2xl font-bold text-gray-800">🔄 مزامنة DenTrust ↔ POS</h1>
      <p class="text-sm text-gray-500 mt-1">مزامنة المنتجات، الزباين، والمخزون بين الموقع ونظام البيع</p>
    </div>
    <button onclick="runFullSync()" id="fullSyncBtn"
      class="bg-gradient-to-l from-blue-600 to-purple-600 text-white px-6 py-2.5 rounded-xl font-bold hover:opacity-90 shadow-lg text-sm flex items-center gap-2">
      <span>⚡</span> مزامنة شاملة الآن
    </button>
  </div>

  <!-- Live sync status bar -->
  <div class="bg-white border rounded-2xl px-4 py-3 shadow-sm flex flex-wrap items-center gap-4 text-sm">
    <div class="flex items-center gap-2">
      <span id="syncDot" class="w-2.5 h-2.5 rounded-full bg-green-400 animate-pulse inline-block"></span>
      <span class="font-semibold text-gray-700">مزامنة تلقائية كل دقيقة</span>
    </div>
    <div class="flex items-center gap-1.5 text-gray-500">
      <span>📥 آخر جلب:</span>
      <span id="lastPullTime" class="font-mono text-gray-700">—</span>
    </div>
    <div class="flex items-center gap-1.5 text-gray-500">
      <span>📤 آخر رفع:</span>
      <span id="lastPushTime" class="font-mono text-gray-700">—</span>
    </div>
    <div class="mr-auto flex items-center gap-2 text-gray-400 text-xs">
      <span>تحديث الصفحة خلال</span>
      <span id="refreshCountdown" class="font-mono font-bold text-blue-600">30</span>
      <span>ثانية</span>
    </div>
  </div>

  <div id="syncAlert" class="hidden rounded-2xl px-4 py-3 text-sm font-semibold"></div>

  <!-- Summary Cards -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
    <div class="bg-white border rounded-2xl p-4 shadow-sm text-center">
      <div id="cardPOS" class="text-3xl font-black text-gray-800">—</div>
      <div class="text-xs text-gray-500 mt-1">منتجات POS</div>
    </div>
    <div class="bg-white border rounded-2xl p-4 shadow-sm text-center">
      <div id="cardLinked" class="text-3xl font-black text-blue-700">—</div>
      <div class="text-xs text-gray-500 mt-1">مرتبطة بـ DenTrust</div>
    </div>
    <div class="bg-white border rounded-2xl p-4 shadow-sm text-center">
      <div id="cardDT" class="text-3xl font-black text-green-700">—</div>
      <div class="text-xs text-gray-500 mt-1">منتجات DenTrust</div>
    </div>
    <div class="bg-white border rounded-2xl p-4 shadow-sm text-center">
      <div id="cardCust" class="text-3xl font-black text-purple-700">—</div>
      <div class="text-xs text-gray-500 mt-1">زباين مُستوردين</div>
    </div>
  </div>

  <!-- Tabs -->
  <div class="flex border-b gap-1">
    <button onclick="showTab('products')" id="tab-products"
      class="tab-btn px-5 py-2.5 text-sm font-semibold border-b-2 border-blue-600 text-blue-700 -mb-px">
      📦 المنتجات
    </button>
    <button onclick="showTab('customers')" id="tab-customers"
      class="tab-btn px-5 py-2.5 text-sm font-semibold border-b-2 border-transparent text-gray-500 hover:text-gray-700 -mb-px">
      👥 الزباين
    </button>
    <button onclick="showTab('stock')" id="tab-stock"
      class="tab-btn px-5 py-2.5 text-sm font-semibold border-b-2 border-transparent text-gray-500 hover:text-gray-700 -mb-px">
      📊 المخزون
    </button>
  </div>

  <!-- PRODUCTS TAB -->
  <div id="pane-products" class="space-y-4">
    <div class="flex flex-wrap gap-2 items-center justify-between">
      <p class="text-sm text-gray-600">استيراد منتجات DenTrust إلى مخزون POS أو تحديث الموجود منها.</p>
      <div class="flex gap-2">
        <button onclick="importProducts()" id="importProdBtn"
          class="bg-green-600 text-white px-4 py-2 rounded-xl text-sm font-semibold hover:bg-green-700 shadow">
          ⬇️ استيراد/تحديث المنتجات
        </button>
        <button onclick="autoLink()"
          class="bg-purple-50 text-purple-700 border border-purple-200 px-4 py-2 rounded-xl text-sm font-semibold hover:bg-purple-100">
          ✨ ربط تلقائي بالاسم
        </button>
        <button onclick="pushStock()"
          class="bg-blue-50 text-blue-700 border border-blue-200 px-4 py-2 rounded-xl text-sm font-semibold hover:bg-blue-100">
          ↑ رفع المخزون
        </button>
        <button onclick="pushUnlinked()" id="pushUnlinkedBtn"
          class="bg-orange-500 text-white px-4 py-2 rounded-xl text-sm font-semibold hover:bg-orange-600 shadow">
          🆕 رفع المنتجات غير المرتبطة
        </button>
        <button onclick="pullStock()"
          class="bg-gray-50 text-gray-700 border px-4 py-2 rounded-xl text-sm font-semibold hover:bg-gray-100">
          ↓ جلب المخزون
        </button>
        <button onclick="pushPurchasePrices()" id="pushPPBtn"
          class="bg-emerald-600 text-white px-4 py-2 rounded-xl text-sm font-semibold hover:bg-emerald-700 shadow">
          💰 مزامنة أسعار الشراء
        </button>
        <button onclick="pushImages()" id="pushImagesBtn"
          class="bg-pink-600 text-white px-4 py-2 rounded-xl text-sm font-semibold hover:bg-pink-700 shadow">
          🖼️ رفع صور المنتجات للموقع
        </button>
        <button onclick="pullImages()" id="pullImagesBtn"
          class="bg-teal-600 text-white px-4 py-2 rounded-xl text-sm font-semibold hover:bg-teal-700 shadow">
          🖼️ جلب صور الموقع للـ POS
        </button>
      </div>
    </div>
    <div class="bg-white rounded-2xl border shadow-sm overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="bg-gray-50 border-b">
            <tr class="text-right text-gray-600 font-semibold">
              <th class="px-4 py-3">منتج POS</th>
              <th class="px-4 py-3 text-center">كمية POS</th>
              <th class="px-4 py-3 text-center">سعر البيع</th>
              <th class="px-4 py-3">منتج DenTrust المرتبط</th>
              <th class="px-4 py-3 text-center">كمية DenTrust</th>
              <th class="px-4 py-3 text-center">حالة الربط</th>
            </tr>
          </thead>
          <tbody id="syncTable" class="divide-y"></tbody>
        </table>
        <div id="noSync" class="hidden text-center text-gray-400 py-10 text-sm">
          لا توجد منتجات — اضغط "استيراد المنتجات" لجلبها من DenTrust
        </div>
      </div>
    </div>
  </div>

  <!-- CUSTOMERS TAB -->
  <div id="pane-customers" class="hidden space-y-4">
    <div class="flex flex-wrap gap-2 items-center justify-between">
      <p class="text-sm text-gray-600">استيراد الزباين من طلبات DenTrust إلى قاعدة بيانات POS.</p>
      <button onclick="importCustomers()" id="importCustBtn"
        class="bg-purple-600 text-white px-4 py-2 rounded-xl text-sm font-semibold hover:bg-purple-700 shadow">
        ⬇️ استيراد الزباين من DenTrust
      </button>
    </div>

    <!-- DenTrust customers preview -->
    <div class="bg-blue-50 border border-blue-100 rounded-2xl p-4">
      <h3 class="font-semibold text-blue-800 text-sm mb-3">زباين DenTrust (من الطلبات):</h3>
      <div id="dtCustomersList" class="space-y-2">
        <div class="text-sm text-blue-500">جارٍ التحميل...</div>
      </div>
    </div>

    <!-- POS customers list -->
    <div class="bg-white rounded-2xl border shadow-sm overflow-hidden">
      <div class="p-4 border-b flex items-center justify-between bg-gray-50">
        <h3 class="font-semibold text-gray-700">زباين POS الحاليين</h3>
        <span id="custCount" class="text-xs text-gray-500 bg-gray-100 px-3 py-1 rounded-full">0 زبون</span>
      </div>
      <table class="w-full text-sm">
        <thead class="bg-gray-50 border-b">
          <tr class="text-right text-gray-600 font-semibold">
            <th class="px-4 py-3">الاسم</th>
            <th class="px-4 py-3">الهاتف</th>
            <th class="px-4 py-3 text-center">الديون المتراكمة</th>
            <th class="px-4 py-3 text-center">تاريخ الإضافة</th>
          </tr>
        </thead>
        <tbody id="custTable" class="divide-y"></tbody>
      </table>
      <div id="noCust" class="hidden text-center text-gray-400 py-8 text-sm">لا يوجد زباين حتى الآن</div>
    </div>
  </div>

  <!-- STOCK TAB -->
  <div id="pane-stock" class="hidden space-y-4">
    <p class="text-sm text-gray-600">مزامنة كميات المخزون يدوياً بين POS و DenTrust.</p>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="bg-white border rounded-2xl p-6 shadow-sm text-center space-y-3">
        <div class="text-4xl">📤</div>
        <h3 class="font-bold text-gray-800">POS → DenTrust</h3>
        <p class="text-sm text-gray-500">رفع كميات POS إلى الموقع (يجعل ما في POS هو المرجع)</p>
        <button onclick="pushStock()"
          class="w-full bg-green-600 text-white font-semibold py-2.5 rounded-xl hover:bg-green-700">
          ↑ رفع الكميات
        </button>
      </div>
      <div class="bg-white border rounded-2xl p-6 shadow-sm text-center space-y-3">
        <div class="text-4xl">📥</div>
        <h3 class="font-bold text-gray-800">DenTrust → POS</h3>
        <p class="text-sm text-gray-500">جلب كميات DenTrust إلى POS (يجعل الموقع هو المرجع)</p>
        <button onclick="pullStock()"
          class="w-full bg-blue-600 text-white font-semibold py-2.5 rounded-xl hover:bg-blue-700">
          ↓ جلب الكميات
        </button>
      </div>
    </div>

    <div class="bg-yellow-50 border border-yellow-200 rounded-2xl p-4 text-sm text-yellow-800">
      ⚡ <strong>مزامنة تلقائية:</strong> كل مبيعة في POS تُخصم تلقائياً من مخزون DenTrust. وكل طلب أونلاين يُخصم من POS فور استلامه.
    </div>
  </div>

</div>
<script>
const BASE = "<%- base %>";
let posProducts = [], dentrustProducts = [], posCustomers = [];
let activeTab = "products";

function showTab(tab) {
  activeTab = tab;
  ["products","customers","stock"].forEach(t => {
    document.getElementById(`pane-${t}`).classList.toggle("hidden", t !== tab);
    const btn = document.getElementById(`tab-${t}`);
    if (t === tab) {
      btn.className = "tab-btn px-5 py-2.5 text-sm font-semibold border-b-2 border-blue-600 text-blue-700 -mb-px";
    } else {
      btn.className = "tab-btn px-5 py-2.5 text-sm font-semibold border-b-2 border-transparent text-gray-500 hover:text-gray-700 -mb-px";
    }
  });
  if (tab === "customers") loadCustomers();
}

async function loadData() {
  const [posRes, dtRes] = await Promise.all([
    fetch(`${BASE}/api/products`),
    fetch(`${BASE}/api/sync/dentrust-products`).catch(() => null)
  ]);
  posProducts = await posRes.json();
  dentrustProducts = dtRes && dtRes.ok ? await dtRes.json() : [];

  document.getElementById("cardPOS").textContent = posProducts.length;
  document.getElementById("cardLinked").textContent = posProducts.filter(p => p.dentrust_id).length;
  document.getElementById("cardDT").textContent = dentrustProducts.length;

  renderProductTable();

  // Load customer count
  const custRes = await fetch(`${BASE}/api/sync/pos-customers`).catch(() => null);
  if (custRes && custRes.ok) {
    posCustomers = await custRes.json();
    document.getElementById("cardCust").textContent = posCustomers.length;
  }
}

function renderProductTable() {
  const tbody = document.getElementById("syncTable");
  const noMsg = document.getElementById("noSync");
  if (!posProducts.length) { tbody.innerHTML = ""; noMsg.classList.remove("hidden"); return; }
  noMsg.classList.add("hidden");

  const dtMap = Object.fromEntries(dentrustProducts.map(d => [d.id, d]));
  const dtOptions = `<option value="">— غير مرتبط —</option>` +
    dentrustProducts.map(d => `<option value="${d.id}">${d.name}</option>`).join("");

  tbody.innerHTML = posProducts.map(p => {
    const linked = p.dentrust_id ? dtMap[p.dentrust_id] : null;
    const dtStock = linked ? (linked.stock ?? '—') : '—';
    return `<tr class="hover:bg-gray-50 ${!linked ? 'bg-yellow-50/20' : ''}">
      <td class="px-4 py-3 font-medium text-gray-800">${p.product_name}</td>
      <td class="px-4 py-3 text-center font-bold text-blue-700">${p.quantity}</td>
      <td class="px-4 py-3 text-center text-gray-600">${(p.sale_price||0).toFixed(2)} جنيه</td>
      <td class="px-4 py-3">
        <select onchange="linkProduct(${p.id}, this.value)"
          class="border rounded-lg px-2 py-1.5 text-xs w-full focus:outline-none focus:ring-2 focus:ring-blue-200">
          ${dtOptions.replace(`value="${p.dentrust_id||''}"`, `value="${p.dentrust_id||''}" selected`)}
        </select>
      </td>
      <td class="px-4 py-3 text-center font-bold ${linked ? 'text-green-700' : 'text-gray-400'}">${dtStock}</td>
      <td class="px-4 py-3 text-center">
        ${linked
          ? '<span class="text-xs bg-green-100 text-green-700 px-2.5 py-1 rounded-full font-medium">✓ مرتبط</span>'
          : '<span class="text-xs bg-gray-100 text-gray-500 px-2.5 py-1 rounded-full">غير مرتبط</span>'}
      </td>
    </tr>`;
  }).join("");
}

async function loadCustomers() {
  const [custRes, dtCustRes] = await Promise.all([
    fetch(`${BASE}/api/sync/pos-customers`).catch(() => null),
    fetch(`${BASE}/api/sync/dentrust-customers`).catch(() => null),
  ]);

  posCustomers = custRes && custRes.ok ? await custRes.json() : [];
  document.getElementById("cardCust").textContent = posCustomers.length;
  document.getElementById("custCount").textContent = posCustomers.length + " زبون";

  // Show DenTrust customers list
  const dtCustomers = dtCustRes && dtCustRes.ok ? await dtCustRes.json() : [];
  const dtCustEl = document.getElementById("dtCustomersList");
  if (!dtCustomers.length) {
    dtCustEl.innerHTML = `<div class="text-sm text-gray-400">لا يوجد زباين مسجلين على DenTrust</div>`;
  } else {
    dtCustEl.innerHTML = dtCustomers.map(c => `
      <div class="flex items-center justify-between py-1.5 border-b border-blue-100 last:border-0">
        <span class="font-medium text-blue-900 text-sm">${c.name || '—'}</span>
        <span class="font-mono text-blue-600 text-xs">${c.phone}</span>
      </div>`).join("");
  }

  await refreshCustomerTable(posCustomers);
}

async function refreshCustomerTable(customers) {
  const tbody = document.getElementById("custTable");
  const noMsg = document.getElementById("noCust");
  document.getElementById("custCount").textContent = customers.length + " زبون";
  document.getElementById("cardCust").textContent = customers.length;

  if (!customers.length) {
    tbody.innerHTML = "";
    noMsg.classList.remove("hidden");
    return;
  }
  noMsg.classList.add("hidden");
  tbody.innerHTML = customers.map(c => `
    <tr class="hover:bg-gray-50">
      <td class="px-4 py-3 font-medium text-gray-800">${c.name || '—'}</td>
      <td class="px-4 py-3 font-mono text-gray-600">${c.phone || '—'}</td>
      <td class="px-4 py-3 text-center ${c.total_debt > 0 ? 'text-red-600 font-bold' : 'text-gray-400'}">${(c.total_debt||0).toFixed(2)}</td>
      <td class="px-4 py-3 text-center text-xs text-gray-400">${(c.created_at||'').slice(0,16)}</td>
    </tr>
  `).join("");
}

async function linkProduct(posId, dentrustId) {
  await fetch(`${BASE}/api/sync/link`, {
    method: "POST",
    headers: {"Content-Type":"application/json"},
    body: JSON.stringify({ pos_product_id: posId, dentrust_product_id: dentrustId ? parseInt(dentrustId) : null })
  });
  await loadData();
}

async function autoLink() {
  if (!dentrustProducts.length) { showAlert("لا توجد منتجات DenTrust للربط", "error"); return; }
  let linked = 0;
  for (const pos of posProducts) {
    if (pos.dentrust_id) continue;
    const posName = pos.product_name.toLowerCase().trim();
    const match = dentrustProducts.find(d =>
      d.name.toLowerCase().trim() === posName ||
      d.name.toLowerCase().includes(posName) ||
      posName.includes(d.name.toLowerCase())
    );
    if (match) {
      await fetch(`${BASE}/api/sync/link`, {
        method: "POST", headers: {"Content-Type":"application/json"},
        body: JSON.stringify({ pos_product_id: pos.id, dentrust_product_id: match.id })
      });
      linked++;
    }
  }
  await loadData();
  showAlert(linked ? `✅ تم ربط ${linked} منتج تلقائياً` : "لم يُعثر على تطابقات جديدة", linked ? "success" : "info");
}

async function importProducts() {
  const btn = document.getElementById("importProdBtn");
  btn.disabled = true; btn.textContent = "⏳ جارٍ الاستيراد...";
  const res = await fetch(`${BASE}/api/sync/import-products`, {method:"POST"});
  const data = await res.json();
  btn.disabled = false; btn.textContent = "⬇️ استيراد/تحديث المنتجات";
  if (data.ok) {
    showAlert(`✅ منتجات: ${data.created} جديد، ${data.updated} محدَّث من أصل ${data.total}`, "success");
    await loadData();
  } else {
    showAlert(data.error || "حدث خطأ", "error");
  }
}

async function importCustomers() {
  const btn = document.getElementById("importCustBtn");
  btn.disabled = true; btn.textContent = "⏳ جارٍ الاستيراد...";
  const res = await fetch(`${BASE}/api/sync/import-customers`, {method:"POST"});
  const data = await res.json();
  btn.disabled = false; btn.textContent = "⬇️ استيراد الزباين من DenTrust";
  if (data.ok) {
    showAlert(`✅ زباين: ${data.created} جديد، ${data.skipped} موجود مسبقاً من أصل ${data.total}`, "success");
    const freshRes = await fetch(`${BASE}/api/sync/pos-customers`);
    posCustomers = freshRes.ok ? await freshRes.json() : posCustomers;
    await refreshCustomerTable(posCustomers);
    document.getElementById("cardCust").textContent = posCustomers.length;
    // Show DenTrust source
    document.getElementById("dtCustomersList").innerHTML = posCustomers.map(c =>
      `<div class="flex items-center gap-3 bg-white rounded-xl px-3 py-2 border">
        <div class="w-8 h-8 rounded-full bg-blue-100 text-blue-700 flex items-center justify-center font-bold text-sm">${(c.name||'?')[0].toUpperCase()}</div>
        <div><div class="font-medium text-sm text-gray-800">${c.name||'—'}</div><div class="text-xs text-gray-500 font-mono">${c.phone||'—'}</div></div>
      </div>`
    ).join("");
  } else {
    showAlert(data.error || "حدث خطأ", "error");
  }
}

async function runFullSync() {
  const btn = document.getElementById("fullSyncBtn");
  btn.disabled = true; btn.innerHTML = "<span>⏳</span> جارٍ المزامنة الشاملة...";
  try {
    const res = await fetch(`${BASE}/api/sync/force-full`, {method:"POST"});
    const data = await res.json();
    btn.disabled = false; btn.innerHTML = "<span>⚡</span> مزامنة شاملة الآن";
    if (data.ok) {
      showAlert(
        `✅ مزامنة كاملة — منتجات: ${data.synced_products || 0} | زباين: ${data.synced_customers || 0}`,
        "success"
      );
      await loadData();
      if (activeTab === "customers") loadCustomers();
    } else {
      showAlert(data.error || data.reason || "فشل في المزامنة الشاملة", "error");
    }
  } catch(e) {
    btn.disabled = false; btn.innerHTML = "<span>⚡</span> مزامنة شاملة الآن";
    showAlert("خطأ في الاتصال", "error");
  }
}

async function pushUnlinked() {
  const btn = document.getElementById("pushUnlinkedBtn");
  btn.disabled = true; btn.textContent = "⏳ جارٍ الرفع...";
  const res = await fetch(`${BASE}/api/sync/push-unlinked`, {method:"POST"});
  const data = await res.json();
  btn.disabled = false; btn.textContent = "🆕 رفع المنتجات غير المرتبطة";
  if (data.ok) {
    const msg = data.pushed === 0
      ? "✅ كل المنتجات مرتبطة بالفعل"
      : `✅ تم رفع ${data.pushed} منتج جديد إلى DenTrust${data.failed ? ` (${data.failed} فشل)` : ""}`;
    showAlert(msg, data.failed ? "info" : "success");
    await loadData();
  } else {
    showAlert(data.error || "خطأ", "error");
  }
}

async function pushStock() {
  const res = await fetch(`${BASE}/api/sync/push-stock`, {method:"POST"});
  const data = await res.json();
  showAlert(data.ok ? `✅ تم رفع مخزون ${data.updated} منتج إلى DenTrust` : (data.error || "خطأ"), data.ok ? "success" : "error");
  if (data.ok) await loadData();
}

async function pullStock() {
  const res = await fetch(`${BASE}/api/sync/pull-stock`, {method:"POST"});
  const data = await res.json();
  showAlert(data.ok ? `✅ تم جلب مخزون ${data.updated} منتج من DenTrust` : (data.error || "خطأ"), data.ok ? "success" : "error");
  if (data.ok) await loadData();
}

async function pushPurchasePrices() {
  const btn = document.getElementById("pushPPBtn");
  btn.disabled = true; btn.textContent = "⏳ جاري المزامنة...";
  const res = await fetch(`${BASE}/api/sync/push-purchase-prices`, {method:"POST"});
  const data = await res.json();
  btn.disabled = false; btn.textContent = "💰 مزامنة أسعار الشراء";
  if (data.ok) {
    showAlert(data.updated > 0
      ? `✅ تم مزامنة أسعار الشراء لـ ${data.updated} منتج إلى DenTrust`
      : "⚠️ لا توجد منتجات مرتبطة بها سعر شراء — أدخل أسعار الشراء في المخزون أولاً",
      data.updated > 0 ? "success" : "info");
  } else {
    showAlert(data.error || "خطأ في المزامنة", "error");
  }
}

async function pullImages() {
  const btn = document.getElementById("pullImagesBtn");
  btn.disabled = true; btn.textContent = "⏳ جاري الجلب...";
  const res = await fetch(`${BASE}/api/sync/pull-images`, {method:"POST"});
  const data = await res.json();
  btn.disabled = false; btn.textContent = "🖼️ جلب صور الموقع للـ POS";
  if (data.ok) {
    showAlert(
      data.updated > 0
        ? `✅ تم جلب ${data.updated} صورة من الموقع إلى POS — ${data.skipped} منتج بدون صورة على الموقع`
        : `⚠️ لا توجد صور جديدة للجلب — كل المنتجات إما عندها صورة أو مش موجودة على الموقع`,
      data.updated > 0 ? "success" : "info"
    );
  } else {
    showAlert(data.error || "خطأ في جلب الصور", "error");
  }
}

async function pushImages() {
  const btn = document.getElementById("pushImagesBtn");
  btn.disabled = true; btn.textContent = "⏳ جاري رفع الصور...";
  const res = await fetch(`${BASE}/api/sync/push-images`, {method:"POST"});
  const data = await res.json();
  btn.disabled = false; btn.textContent = "🖼️ رفع صور المنتجات للموقع";
  if (data.ok) {
    showAlert(
      `✅ تم رفع ${data.uploaded} صورة على الموقع — تم تخطي ${data.skipped} (موجودة) — فشل ${data.failed} من أصل ${data.total} منتج`,
      data.failed === 0 ? "success" : "info"
    );
  } else {
    showAlert(data.error || "خطأ في رفع الصور", "error");
  }
}

function showAlert(msg, type) {
  const el = document.getElementById("syncAlert");
  el.textContent = msg;
  const colors = {
    success: "bg-green-50 border border-green-200 text-green-800",
    error:   "bg-red-50 border border-red-200 text-red-800",
    info:    "bg-blue-50 border border-blue-200 text-blue-800",
  };
  el.className = `rounded-2xl px-4 py-3 text-sm font-semibold ${colors[type]||colors.info}`;
  el.classList.remove("hidden");
  setTimeout(() => el.classList.add("hidden"), 5000);
}

// ── Live sync-status bar ──────────────────────────────────────────────────────
function fmtTime(iso) {
  if (!iso) return '—';
  const d = new Date(iso);
  return d.toLocaleTimeString('ar-EG', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
}

async function refreshSyncStatus() {
  try {
    const r = await fetch(`${BASE}/api/sync/status`);
    if (!r.ok) return;
    const s = await r.json();
    document.getElementById('lastPullTime').textContent = fmtTime(s.lastPull);
    document.getElementById('lastPushTime').textContent = fmtTime(s.lastPush);
  } catch(_) {}
}

// Auto-refresh page data every 30 seconds + live countdown
let _refreshSecs = 30;
refreshSyncStatus();
setInterval(refreshSyncStatus, 10000); // update timestamps every 10 s

setInterval(() => {
  _refreshSecs--;
  const el = document.getElementById('refreshCountdown');
  if (el) el.textContent = _refreshSecs;
  if (_refreshSecs <= 0) {
    _refreshSecs = 30;
    loadData();
    refreshSyncStatus();
  }
}, 1000);

loadData();
</script>

</main>
