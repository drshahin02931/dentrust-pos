<%- include('partials/header', Object.assign({pageTitle: 'التقارير اليومية والأرشيف'}, locals)) %>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

<style>
  @media print {
    .no-print { display: none !important; }
    body { background: #ffffff !important; color: #000000 !important; font-size: 11pt !important; }
    .print-card { box-shadow: none !important; border: 1px solid #cbd5e1 !important; page-break-inside: avoid; }
    .print-header { display: block !important; }
    table { width: 100% !important; border-collapse: collapse !important; font-size: 10pt !important; }
    th, td { border: 1px solid #94a3b8 !important; padding: 5px 8px !important; }
    th { background-color: #f1f5f9 !important; color: #0f172a !important; font-weight: bold !important; }
    .badge-red { background-color: #fee2e2 !important; color: #991b1b !important; border: 1px solid #f87171 !important; }
    .badge-yellow { background-color: #fef3c7 !important; color: #92400e !important; border: 1px solid #fcd34d !important; }
    .badge-green { background-color: #dcfce7 !important; color: #166534 !important; border: 1px solid #86efac !important; }
    @page {
      size: A4 portrait;
      margin: 12mm 10mm;
    }
  }
  .tier-red { background-color: #fef2f2; border-right: 4px solid #ef4444; }
  .tier-yellow { background-color: #fffbeb; border-right: 4px solid #f59e0b; }
  .tier-green { background-color: #f0fdf4; border-right: 4px solid #22c55e; }
</style>

<div class="space-y-6 pb-12">

  <div id="printableReportArea" class="space-y-6 bg-white rounded-2xl">
  <!-- Printable Header (Visible only on print or top of page) -->
  <div class="hidden print-header bg-white p-4 border-b-2 border-blue-900 mb-4">
    <div class="flex items-center justify-between pb-3 border-b border-gray-200">
      <div>
        <h1 class="text-xl font-black text-blue-900">🦷 DenTrust Dental Supplies</h1>
        <p class="text-xs text-gray-600 mt-0.5">نظام إدارة نقاط البيع والمستودعات الطبية</p>
      </div>
      <div class="text-left text-xs text-gray-700">
        <div><strong>التقرير اليومي والإداري الشامل</strong></div>
        <div>تاريخ التقرير: <span id="printDateLabel" class="font-bold"></span></div>
        <div>تاريخ الطباعة: <span><%= new Date().toLocaleDateString('ar-EG') %></span></div>
        <div class="mt-0.5 text-blue-900 font-bold">الوضع النشط: <span id="printBasisLabel">💰 التحصيل الفعلي</span></div>
      </div>
    </div>

    <!-- Executive Comparative Summary Table (Printed on PDF) -->
    <div class="mt-3">
      <div class="text-xs font-black text-gray-800 mb-1.5 flex items-center justify-between">
        <span>⚖️ ملخص المقارنة المحاسبية والتنفيذية (النقدي vs الاستحقاق):</span>
        <span class="text-[10px] text-gray-500 font-normal">مقارنة حركة الدرج والخزينة الفعلية بإجمالي المبيعات الآجلة</span>
      </div>
      <table class="w-full text-right text-xs border border-gray-300">
        <thead class="bg-gray-100 font-bold text-gray-900">
          <tr>
            <th class="p-2 border border-gray-300">المؤشر المالي</th>
            <th class="p-2 text-center border border-gray-300 bg-blue-50 text-blue-900">💰 التحصيل الفعلي (الدرج والخزينة)</th>
            <th class="p-2 text-center border border-gray-300 bg-purple-50 text-purple-900">📋 شامل الآجل (الاستحقاق العام)</th>
            <th class="p-2 text-center border border-gray-300 bg-amber-50 text-amber-900">الفارق المحاسبي</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
          <tr>
            <td class="p-2 border border-gray-300 font-bold text-gray-800">إجمالي الإيراد / المقبوضات</td>
            <td class="p-2 text-center border border-gray-300 text-blue-900 font-black" id="print-comp-cash-rev">0.00 ج.م</td>
            <td class="p-2 text-center border border-gray-300 text-purple-900 font-black" id="print-comp-acc-rev">0.00 ج.م</td>
            <td class="p-2 text-center border border-gray-300 text-gray-700 font-bold" id="print-comp-diff-rev">—</td>
          </tr>
          <tr>
            <td class="p-2 border border-gray-300 font-bold text-gray-800">إجمالي المصروفات</td>
            <td class="p-2 text-center border border-gray-300 text-red-700 font-black" id="print-comp-cash-exp">0.00 ج.م</td>
            <td class="p-2 text-center border border-gray-300 text-red-700 font-black" id="print-comp-acc-exp">0.00 ج.م</td>
            <td class="p-2 text-center border border-gray-300 text-gray-400">0.00 ج.م</td>
          </tr>
          <tr>
            <td class="p-2 border border-gray-300 font-bold text-gray-800">إجمالي الأرباح</td>
            <td class="p-2 text-center border border-gray-300 text-emerald-800 font-black" id="print-comp-cash-gross">0.00 ج.م</td>
            <td class="p-2 text-center border border-gray-300 text-amber-800 font-black" id="print-comp-acc-gross">0.00 ج.م</td>
            <td class="p-2 text-center border border-gray-300 text-gray-700 font-bold" id="print-comp-diff-gross">—</td>
          </tr>
          <tr class="bg-gray-50 font-bold">
            <td class="p-2 border border-gray-300 font-black text-gray-900">صافي الربح الحقيقي</td>
            <td class="p-2 text-center border border-gray-300 text-emerald-900 font-black" id="print-comp-cash-net">0.00 ج.م</td>
            <td class="p-2 text-center border border-gray-300 text-purple-900 font-black" id="print-comp-acc-net">0.00 ج.م</td>
            <td class="p-2 text-center border border-gray-300 text-gray-700 font-bold" id="print-comp-diff-net">—</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Top Action Bar (No-Print) -->
  <div class="no-print bg-white p-4 sm:p-5 rounded-2xl shadow-sm border border-gray-100 flex flex-wrap items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-black text-gray-900 flex items-center gap-2">
        <span>📑</span>
        <span>التقارير اليومية وأرشيف الـ PDF</span>
      </h1>
      <p class="text-xs text-gray-500 mt-1">استعراض التقرير المالي، المنتجات المباعة، النواقص الحرجة، وتتبع الصلاحيات لأي يوم</p>
    </div>

    <!-- Filters, Period & Basis Toggle -->
    <div class="flex flex-wrap items-center gap-2 sm:gap-3">
      <!-- Quick Period Selectors -->
      <div class="flex items-center gap-1 bg-gray-100 p-1 rounded-xl border border-gray-200" id="quickPeriodGroup">
        <button type="button" onclick="setQuickPeriod('today')" class="px-2.5 py-1.5 text-xs font-bold rounded-lg transition-all bg-white text-blue-900 shadow-2xs" id="btn-period-today">اليوم</button>
        <button type="button" onclick="setQuickPeriod('yesterday')" class="px-2.5 py-1.5 text-xs font-bold rounded-lg transition-all text-gray-700 hover:bg-white" id="btn-period-yesterday">أمس</button>
        <button type="button" onclick="setQuickPeriod('week')" class="px-2.5 py-1.5 text-xs font-bold rounded-lg transition-all text-gray-700 hover:bg-white" id="btn-period-week">آخر 7 أيام</button>
        <button type="button" onclick="setQuickPeriod('month')" class="px-2.5 py-1.5 text-xs font-bold rounded-lg transition-all text-gray-700 hover:bg-white" id="btn-period-month">هذا الشهر</button>
      </div>

      <!-- Custom Date Picker -->
      <div class="flex items-center gap-1.5 bg-gray-50 px-2.5 py-1.5 rounded-xl border border-gray-200">
        <label for="reportDatePicker" class="text-xs font-bold text-gray-600">تاريخ محدد:</label>
        <input type="date" id="reportDatePicker" onchange="onCustomDatePicked(this.value)" class="text-xs font-bold bg-transparent border-0 focus:ring-0 p-0 text-gray-800 cursor-pointer" />
      </div>

      <!-- Basis Toggle Switch: Cash vs Accrual -->
      <div class="flex items-center bg-gray-100 p-1 rounded-xl border border-gray-300 shadow-inner">
        <button type="button" id="btnBasisCash" onclick="setBasis('cash')" class="px-3 py-1.5 text-xs font-black rounded-lg transition-all bg-blue-700 text-white shadow flex items-center gap-1">
          <span>💰</span>
          <span>التحصيل الفعلي (الدرج)</span>
        </button>
        <button type="button" id="btnBasisAccrual" onclick="setBasis('accrual')" class="px-3 py-1.5 text-xs font-black rounded-lg transition-all text-gray-600 hover:text-gray-900 flex items-center gap-1">
          <span>📋</span>
          <span>شامل الآجل (الاستحقاق)</span>
        </button>
      </div>

      <!-- PDF Download & Print Buttons -->
      <div class="flex items-center gap-1.5">
        <button type="button" onclick="downloadPdfDirect()" id="btnDownloadPdf" class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-3 py-2 rounded-xl shadow flex items-center gap-1.5 text-xs transition-all cursor-pointer">
          <span>📥</span>
          <span>تحميل PDF مباشر</span>
        </button>
        <button type="button" onclick="window.print()" class="bg-blue-700 hover:bg-blue-800 text-white font-bold px-3 py-2 rounded-xl shadow flex items-center gap-1.5 text-xs transition-all cursor-pointer">
          <span>🖨️</span>
          <span>معاينة / طباعة</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Loading State -->
  <div id="reportLoading" class="hidden text-center py-16">
    <div class="inline-block animate-spin text-4xl mb-3">⏳</div>
    <div class="text-base font-bold text-gray-700">جارٍ إعداد بيانات التقرير والحسابات...</div>
  </div>

  <!-- Report Content Container -->
  <div id="reportContent" class="space-y-6">

    <!-- ══════════════════════════════════════════════════════════════════════
         1️⃣ SECTION: FINANCIAL OVERVIEW (التقرير المالي وحركة الخزينة)
         ══════════════════════════════════════════════════════════════════════ -->
    <div class="bg-white rounded-2xl p-5 shadow-sm border border-gray-100 print-card space-y-4">
      <div class="flex flex-wrap items-center justify-between border-b pb-3 gap-2">
        <h2 class="text-lg font-black text-gray-800 flex items-center gap-2">
          <span class="text-xl">💰</span>
          <span>1. التقرير المالي والأرباح (الفترة: <span class="currentReportDateText font-mono text-blue-700"></span>)</span>
        </h2>
        <div class="flex items-center gap-2">
          <span class="text-xs font-bold px-2.5 py-1 bg-blue-50 text-blue-800 rounded-lg" id="invoicesCountBadge">0 فاتورة</span>
          <span class="text-xs font-bold px-2.5 py-1 rounded-lg" id="basisStatusBadge"></span>
        </div>
      </div>

      <!-- Mode Explainer Banner -->
      <div id="basisExplainerBanner" class="bg-blue-50/90 border border-blue-200 rounded-xl p-3 text-xs flex flex-wrap items-center justify-between gap-2">
        <div class="flex items-center gap-2">
          <span id="basisExplainerIcon" class="text-base">💰</span>
          <span id="basisExplainerText" class="font-bold text-blue-900">وضع التحصيل الفعلي: يعرض ما تم تحصيله فعلياً في الخزينة والدرج اليوم + دفعات سداد مديونيات العملاء، مع استبعاد الآجل غير المحصل.</span>
        </div>
        <span id="basisBadgePill" class="bg-blue-200 text-blue-950 px-2.5 py-0.5 rounded-full font-black text-[10px]">الأساس النقدي (Cash Basis)</span>
      </div>

      <!-- Sales Channels Breakdown Bar (المحل vs الأونلاين vs سداد الديون) -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 text-xs">
        <div class="bg-indigo-50/70 border border-indigo-100 rounded-xl p-3 flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="text-base">🏬</span>
            <span class="font-bold text-indigo-900">مبيعات المحل المباشرة:</span>
          </div>
          <div class="text-left">
            <div id="chan-pos-sales" class="font-black text-indigo-950 text-sm">0.00 ج.م</div>
            <div id="chan-pos-count" class="text-[10px] text-indigo-600 font-bold">0 فاتورة</div>
          </div>
        </div>

        <div class="bg-teal-50/70 border border-teal-100 rounded-xl p-3 flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="text-base">🌐</span>
            <span class="font-bold text-teal-900">أوردرات الموقع (أونلاين):</span>
          </div>
          <div class="text-left">
            <div id="chan-online-sales" class="font-black text-teal-950 text-sm">0.00 ج.م</div>
            <div id="chan-online-count" class="text-[10px] text-teal-600 font-bold">0 أوردر</div>
          </div>
        </div>

        <div class="bg-amber-50/70 border border-amber-100 rounded-xl p-3 flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="text-base">🤝</span>
            <span class="font-bold text-amber-900">سداد مديونيات الدكاترة:</span>
          </div>
          <div class="text-left">
            <div id="chan-debt-sales" class="font-black text-amber-950 text-sm">0.00 ج.م</div>
            <div id="chan-debt-count" class="text-[10px] text-amber-600 font-bold">0 دفعة محصلة</div>
          </div>
        </div>
      </div>

      <!-- 4 Core Financial Cards -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
        <!-- Card 1: Gross Sales or Cash In -->
        <div class="bg-blue-50/70 border border-blue-100 rounded-xl p-4 text-center">
          <div id="fin-card1-title" class="text-xs font-bold text-blue-600 mb-1">المقبوضات النقدية (Cash In)</div>
          <div id="fin-gross-sales" class="text-xl sm:text-2xl font-black text-blue-900">0.00 ج.م</div>
          <div id="fin-discounts-note" class="text-[11px] text-gray-500 mt-1">مبيعات نقدية + سداد ديون</div>
        </div>

        <!-- Card 2: Total Expenses -->
        <div class="bg-red-50/70 border border-red-100 rounded-xl p-4 text-center">
          <div class="text-xs font-bold text-red-600 mb-1">إجمالي المصروفات (Expenses Out)</div>
          <div id="fin-expenses" class="text-xl sm:text-2xl font-black text-red-700">0.00 ج.م</div>
          <div id="fin-expenses-count" class="text-[11px] text-red-500 mt-1">0 بنود مسجلة</div>
        </div>

        <!-- Card 3: Gross Profit or Realized Profit -->
        <div id="fin-gross-card" class="bg-amber-50/70 border border-amber-100 rounded-xl p-4 text-center transition-colors">
          <div id="fin-card3-title" class="text-xs font-bold text-amber-700 mb-1">أرباح التحصيل الفعلي (Realized Profit)</div>
          <div id="fin-gross-profit" class="text-xl sm:text-2xl font-black text-amber-800">0.00 ج.م</div>
          <div id="fin-gross-note" class="text-[11px] text-amber-600 mt-1">= أرباح المحصل نقداً + سداد الديون</div>
        </div>

        <!-- Card 4: Net Profit -->
        <div id="fin-net-card" class="bg-emerald-50/70 border border-emerald-100 rounded-xl p-4 text-center transition-colors">
          <div id="fin-card4-title" class="text-xs font-bold text-emerald-700 mb-1">صافي الربح الفعلي (Net Cash Profit)</div>
          <div id="fin-net-profit" class="text-xl sm:text-2xl font-black text-emerald-800">0.00 ج.م</div>
          <div id="fin-net-note" class="text-[11px] text-emerald-600 mt-1">= الربح المحقق − المصروفات</div>
        </div>
      </div>

      <!-- Payment Channels Breakdown -->
      <div class="bg-gray-50 rounded-xl p-3 sm:p-4 border border-gray-200">
        <div class="text-xs font-bold text-gray-700 mb-2">توزيع قنوات التحصيل والدفع:</div>
        <div id="paymentBreakdownGrid" class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-center text-xs">
          <!-- Filled dynamically -->
        </div>
      </div>

      <!-- Customer Debt Payments Table (سداد مديونيات العملاء) -->
      <div id="debtPaymentsWrapper" class="space-y-2 pt-2 border-t border-gray-100">
        <div class="flex items-center justify-between text-xs font-bold text-gray-700">
          <span class="flex items-center gap-1.5">
            <span>🤝</span>
            <span>سداد مديونيات ودفعات العملاء والدكاترة في هذه الفترة:</span>
          </span>
          <span id="debtPaymentsTotalLabel" class="text-amber-700 font-bold"></span>
        </div>
        <div class="overflow-x-auto rounded-xl border border-gray-200">
          <table class="w-full text-right text-xs">
            <thead class="bg-gray-100 text-gray-700 font-bold">
              <tr>
                <th class="p-2.5 text-center w-10">م</th>
                <th class="p-2.5">اسم الطبيب / العميل</th>
                <th class="p-2.5 text-center">المبلغ المسدد</th>
                <th class="p-2.5 text-center">طريقة الدفع</th>
                <th class="p-2.5 text-center">التاريخ والوقت</th>
                <th class="p-2.5">ملاحظات</th>
              </tr>
            </thead>
            <tbody id="debtPaymentsTableBody" class="divide-y divide-gray-100">
              <!-- Filled dynamically -->
            </tbody>
          </table>
        </div>
        <div id="noDebtPaymentsMsg" class="hidden text-center py-3 text-xs text-gray-400 bg-gray-50 rounded-lg">
          لا توجد دفعات سداد مديونيات مسجلة في هذه الفترة ✨
        </div>
      </div>

      <!-- Detailed Expenses Table -->
      <div id="expensesWrapper" class="space-y-2 pt-2 border-t border-gray-100">
        <div class="flex items-center justify-between text-xs font-bold text-gray-700">
          <span>تفاصيل المصروفات المسجلة في هذه الفترة:</span>
          <span id="expensesTotalLabel" class="text-red-600 font-bold"></span>
        </div>
        <div class="overflow-x-auto rounded-xl border border-gray-200">
          <table class="w-full text-right text-xs">
            <thead class="bg-gray-100 text-gray-700 font-bold">
              <tr>
                <th class="p-2.5 text-center w-10">م</th>
                <th class="p-2.5">عنوان وبند المصروف</th>
                <th class="p-2.5 text-center">المبلغ</th>
                <th class="p-2.5 text-center">التاريخ</th>
              </tr>
            </thead>
            <tbody id="expensesTableBody" class="divide-y divide-gray-100">
              <!-- Filled dynamically -->
            </tbody>
          </table>
        </div>
        <div id="noExpensesMsg" class="hidden text-center py-3 text-xs text-gray-400 bg-gray-50 rounded-lg">
          لا توجد أي مصروفات مسجلة في هذا التاريخ ✨
        </div>
      </div>
    </div>


    <!-- ══════════════════════════════════════════════════════════════════════
         2️⃣ SECTION: PRODUCTS SOLD TODAY (الأصناف والمنتجات المباعة اليوم)
         ══════════════════════════════════════════════════════════════════════ -->
    <div class="bg-white rounded-2xl p-5 shadow-sm border border-gray-100 print-card space-y-4">
      <div class="flex items-center justify-between border-b pb-3">
        <h2 class="text-lg font-black text-gray-800 flex items-center gap-2">
          <span class="text-xl">🛍️</span>
          <span>2. الأصناف والمنتجات التي بيعت اليوم (<span id="soldItemsCount">0</span> صنف)</span>
        </h2>
        <span class="text-xs font-bold text-blue-700" id="soldItemsTotalQty">إجمالي القطع المباعة: 0</span>
      </div>

      <div class="overflow-x-auto rounded-xl border border-gray-200">
        <table class="w-full text-right text-xs sm:text-sm">
          <thead class="bg-gray-100 text-gray-700 font-bold">
            <tr>
              <th class="p-2.5 text-center w-12">م</th>
              <th class="p-2.5">اسم الخامة / الصنف</th>
              <th class="p-2.5">القسم</th>
              <th class="p-2.5 text-center">الباركود</th>
              <th class="p-2.5 text-center">الكمية المباعة</th>
              <th class="p-2.5 text-center">متوسط السعر</th>
              <th class="p-2.5 text-center">إجمالي القيمة</th>
            </tr>
          </thead>
          <tbody id="productsSoldTableBody" class="divide-y divide-gray-100">
            <!-- Filled dynamically -->
          </tbody>
        </table>
      </div>
      <div id="noProductsSoldMsg" class="hidden text-center py-6 text-sm text-gray-400 bg-gray-50 rounded-xl">
        لم يتم تسجيل أي مبيعات في هذا التاريخ
      </div>
    </div>

    <!-- ══════════════════════════════════════════════════════════════════════
         3️⃣ SECTION: ACTUAL SHORTAGES (النواقص الفعلية المشروطة بحد الطلب)
         ══════════════════════════════════════════════════════════════════════ -->
    <div class="bg-white rounded-2xl p-5 shadow-sm border border-gray-100 print-card space-y-4">
      <div class="flex items-center justify-between border-b pb-3">
        <div>
          <h2 class="text-lg font-black text-gray-800 flex items-center gap-2">
            <span class="text-xl">⚠️</span>
            <span>3. النواقص الفعلية المطلوبة للمخزن</span>
          </h2>
          <p class="text-xs text-gray-500 mt-0.5">يشمل الأصناف المحددة بحد طلب مسجل (min_stock) وبلغ رصيدها الحد أو نفذت بالكامل</p>
        </div>
        <span class="text-xs font-bold px-2.5 py-1 bg-amber-50 text-amber-800 rounded-lg" id="shortagesCountBadge">0 نواقص</span>
      </div>

      <div class="overflow-x-auto rounded-xl border border-gray-200">
        <table class="w-full text-right text-xs sm:text-sm">
          <thead class="bg-amber-50/70 text-amber-900 font-bold border-b border-amber-200">
            <tr>
              <th class="p-2.5 text-center w-12">م</th>
              <th class="p-2.5">اسم الخامة</th>
              <th class="p-2.5">القسم</th>
