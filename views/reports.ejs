<script>
const BASE = '<%= base %>';
const PAYMENT_LABELS = {
  cash: '💵 نقداً (الدرج)',
  vodafone_cash: '📱 فودافون كاش / إنستاباي',
  instapay: '⚡ إنستاباي',
  credit: '📋 آجل (حساب عيادة)',
  card: '💳 فيزا / ماستركارد',
  online: '🌐 طلب موقع',
};

function getIsoDate(dateObj = new Date()) {
  const y = dateObj.getFullYear();
  const m = String(dateObj.getMonth() + 1).padStart(2, '0');
  const d = String(dateObj.getDate()).padStart(2, '0');
  return `${y}-${m}-${d}`;
}

let currentBasis = 'cash';
let currentPeriod = 'today';
let reportDataCache = null;

function setBasis(basis) {
  currentBasis = basis;
  const btnCash = document.getElementById('btnBasisCash');
  const btnAccrual = document.getElementById('btnBasisAccrual');
  if (basis === 'cash') {
    btnCash.className = 'px-3 py-1.5 text-xs font-black rounded-lg transition-all bg-blue-700 text-white shadow flex items-center gap-1';
    btnAccrual.className = 'px-3 py-1.5 text-xs font-black rounded-lg transition-all text-gray-600 hover:text-gray-900 flex items-center gap-1';
  } else {
    btnAccrual.className = 'px-3 py-1.5 text-xs font-black rounded-lg transition-all bg-purple-700 text-white shadow flex items-center gap-1';
    btnCash.className = 'px-3 py-1.5 text-xs font-black rounded-lg transition-all text-gray-600 hover:text-gray-900 flex items-center gap-1';
  }
  if (reportDataCache) {
    renderFinancialCards(reportDataCache);
  }
}

function setQuickPeriod(period) {
  currentPeriod = period;
  const dateInput = document.getElementById('reportDatePicker');
  if (dateInput) dateInput.value = '';

  ['today', 'yesterday', 'week', 'month'].forEach(p => {
    const btn = document.getElementById(`btn-period-${p}`);
    if (btn) {
      if (p === period) {
        btn.className = 'px-2.5 py-1.5 text-xs font-bold rounded-lg transition-all bg-white text-blue-900 shadow-2xs';
      } else {
        btn.className = 'px-2.5 py-1.5 text-xs font-bold rounded-lg transition-all text-gray-700 hover:bg-white';
      }
    }
  });

  fetchReportData({ period });
}

function onCustomDatePicked(val) {
  if (!val) return;
  currentPeriod = 'custom';
  ['today', 'yesterday', 'week', 'month'].forEach(p => {
    const btn = document.getElementById(`btn-period-${p}`);
    if (btn) btn.className = 'px-2.5 py-1.5 text-xs font-bold rounded-lg transition-all text-gray-700 hover:bg-white';
  });
  fetchReportData({ date: val });
}

// Backward compatibility alias
function setQuickDate(type) {
  setQuickPeriod(type);
}

function initReports() {
  setQuickPeriod('today');
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', initReports);
} else {
  initReports();
}

async function downloadPdfDirect() {
  const btn = document.getElementById('btnDownloadPdf');
  let originalHtml = '';
  if (btn) {
    originalHtml = btn.innerHTML;
    btn.innerHTML = '<span>⏳</span><span>جارٍ إعداد الـ PDF...</span>';
    btn.disabled = true;
  }

  const printHeader = document.querySelector('.print-header');
  try {
    if (printHeader) {
      printHeader.classList.remove('hidden');
    }

    const area = document.getElementById('printableReportArea') || document.getElementById('reportContent');
    const dateLabel = (document.getElementById('printDateLabel')?.textContent || 'تقرير').replace(/[\s\/:]+/g, '_');
    const basisLabel = currentBasis === 'cash' ? 'تحصيل_فعلي' : 'شامل_الآجل';
    const filename = `تقرير_DenTrust_${basisLabel}_${dateLabel}.pdf`;

    const opt = {
      margin: [10, 8, 10, 8],
      filename: filename,
      image: { type: 'jpeg', quality: 0.98 },
      html2canvas: { scale: 2, useCORS: true, logging: false },
      jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' },
      pagebreak: { mode: ['avoid-all', 'css', 'legacy'] }
    };

    if (typeof html2pdf !== 'undefined') {
      await html2pdf().set(opt).from(area).save();
    } else {
      window.print();
    }
  } catch (err) {
    console.error('Direct PDF error, falling back to window.print():', err);
    window.print();
  } finally {
    if (printHeader) {
      printHeader.classList.add('hidden');
    }
    if (btn) {
      btn.innerHTML = originalHtml;
      btn.disabled = false;
    }
  }
}

async function fetchReportData(params = { period: 'today' }) {
  let url = `${BASE}/api/reports/daily-comprehensive?`;
  if (params.period) url += `period=${encodeURIComponent(params.period)}`;
  else if (params.date) url += `date=${encodeURIComponent(params.date)}`;

  const loadingEl = document.getElementById('reportLoading');
  const contentEl = document.getElementById('reportContent');
  loadingEl.classList.remove('hidden');
  contentEl.classList.add('opacity-40', 'pointer-events-none');

  try {
    const res = await fetch(url, { credentials: 'include' });
    if (!res.ok) throw new Error('فشل جلب بيانات التقرير');
    const data = await res.json();
    reportDataCache = data;
    renderReport(data);
  } catch (err) {
    alert('حدث خطأ أثناء تحميل التقرير: ' + err.message);
  } finally {
    loadingEl.classList.add('hidden');
    contentEl.classList.remove('opacity-40', 'pointer-events-none');
  }
}

function renderPaymentBreakdown(breakdown) {
  const payGrid = document.getElementById('paymentBreakdownGrid');
  if (!breakdown || breakdown.length === 0) {
    payGrid.innerHTML = '<div class="col-span-4 text-center py-2 text-gray-400">لا توجد حركات تحصيل في هذه الفترة</div>';
  } else {
    payGrid.innerHTML = breakdown.map(p => `
      <div class="bg-white p-2.5 rounded-lg border border-gray-200">
        <div class="text-gray-500 font-bold">${p.label || PAYMENT_LABELS[p.payment_method] || p.payment_method}</div>
        <div class="text-sm font-black text-blue-900 mt-0.5">${parseFloat(p.total).toLocaleString('ar-EG', { minimumFractionDigits: 2 })} ج.م</div>
        ${p.cnt ? `<div class="text-[10px] text-gray-400">${p.cnt} عملية</div>` : ''}
      </div>
    `).join('');
  }
}

function renderFinancialCards(data) {
  const isCash = currentBasis === 'cash';
  const finCash = data.financial?.cash || {};
  const finAccrual = data.financial?.accrual || data.financial || {};
  const expTotal = parseFloat(data.financial?.expenses_total || 0);
  const expList = data.financial?.expenses_list || [];

  const banner = document.getElementById('basisExplainerBanner');
  const icon = document.getElementById('basisExplainerIcon');
  const text = document.getElementById('basisExplainerText');
  const pill = document.getElementById('basisBadgePill');
  const statusBadge = document.getElementById('basisStatusBadge');

  if (isCash) {
    if (banner) banner.className = 'bg-blue-50/90 border border-blue-200 rounded-xl p-3 text-xs flex flex-wrap items-center justify-between gap-2';
    if (icon) icon.textContent = '💰';
    if (text) text.textContent = 'وضع التحصيل الفعلي: يحسب المبالغ المحصلة في الخزينة والدرج + دفعات سداد مديونيات الدكاترة، مع استبعاد الآجل غير المحصل.';
    if (pill) {
      pill.className = 'bg-blue-200 text-blue-950 px-2.5 py-0.5 rounded-full font-black text-[10px]';
      pill.textContent = 'الأساس النقدي (Cash Basis)';
    }
    if (statusBadge) {
      statusBadge.className = 'text-xs font-black px-2.5 py-1 bg-blue-100 text-blue-900 rounded-lg';
      statusBadge.textContent = '💰 التحصيل الفعلي';
    }

    // Card 1: Cash In
    document.getElementById('fin-card1-title').textContent = 'المقبوضات النقدية (Cash In)';
    document.getElementById('fin-gross-sales').textContent = (finCash.total_cash_in || 0).toLocaleString('ar-EG', { minimumFractionDigits: 2 }) + ' ج.م';
    document.getElementById('fin-discounts-note').textContent = `مبيعات نقدية: ${(finCash.cash_sales_collected || 0).toLocaleString('ar-EG', { minimumFractionDigits: 2 })} ج.م | سداد ديون: ${(finCash.debt_collected || 0).toLocaleString('ar-EG', { minimumFractionDigits: 2 })} ج.م`;

    // Card 2: Expenses
    document.getElementById('fin-expenses').textContent = expTotal.toLocaleString('ar-EG', { minimumFractionDigits: 2 }) + ' ج.م';
    document.getElementById('fin-expenses-count').textContent = `${expList.length} بند مسجل`;

    // Card 3: Realized Gross Profit
    const grossVal = parseFloat(finCash.realized_gross_profit || 0);
    const grossEl = document.getElementById('fin-gross-profit');
    const grossCard = document.getElementById('fin-gross-card');
    const grossNote = document.getElementById('fin-gross-note');
    document.getElementById('fin-card3-title').textContent = 'أرباح التحصيل الفعلي (Realized Profit)';
    grossEl.textContent = grossVal.toLocaleString('ar-EG', { minimumFractionDigits: 2 }) + ' ج.م';
    if (grossVal < 0) {
      grossEl.className = 'text-xl sm:text-2xl font-black text-red-600';
      if (grossCard) grossCard.className = 'bg-red-50/90 border border-red-200 rounded-xl p-4 text-center';
      if (grossNote) grossNote.innerHTML = '<span class="text-red-700 font-black">⚠️ بيع بخسارة (أقل من التكلفة)</span>';
    } else {
      grossEl.className = 'text-xl sm:text-2xl font-black text-amber-800';
      if (grossCard) grossCard.className = 'bg-amber-50/70 border border-amber-100 rounded-xl p-4 text-center';
      if (grossNote) grossNote.textContent = '= أرباح المحصل نقداً + سداد الديون';
    }

    // Card 4: Net Cash Profit
    const netVal = parseFloat(finCash.realized_net_profit || 0);
    const netEl = document.getElementById('fin-net-profit');
    const netCard = document.getElementById('fin-net-card');
    const netNote = document.getElementById('fin-net-note');
    document.getElementById('fin-card4-title').textContent = 'صافي الربح الفعلي (Net Cash Profit)';
    netEl.textContent = netVal.toLocaleString('ar-EG', { minimumFractionDigits: 2 }) + ' ج.م';
    if (netVal < 0) {
      netEl.className = 'text-xl sm:text-2xl font-black text-red-700';
      if (netCard) netCard.className = 'bg-red-50/90 border border-red-200 rounded-xl p-4 text-center';
      if (netNote) netNote.innerHTML = '<span class="text-red-700 font-black">⚠️ صافي خسارة للفترة</span>';
    } else {
      netEl.className = 'text-xl sm:text-2xl font-black text-emerald-800';
      if (netCard) netCard.className = 'bg-emerald-50/70 border border-emerald-100 rounded-xl p-4 text-center';
      if (netNote) netNote.textContent = '= الربح المحقق − المصروفات';
    }

    // Payment Breakdown Grid
    renderPaymentBreakdown(finCash.payment_breakdown || []);
    document.getElementById('invoicesCountBadge').textContent = `${finCash.invoices_count || 0} فاتورة`;

  } else {
    // Accrual Mode
    if (banner) banner.className = 'bg-purple-50/90 border border-purple-200 rounded-xl p-3 text-xs flex flex-wrap items-center justify-between gap-2';
    if (icon) icon.textContent = '📋';
    if (text) text.textContent = 'وضع شامل الآجل: يحسب كافة الفواتير التي صدرت كأنها مدفوعة بالكامل، مع احتساب الربح التقديري لكافة البضاعة المباعة.';
    if (pill) {
      pill.className = 'bg-purple-200 text-purple-950 px-2.5 py-0.5 rounded-full font-black text-[10px]';
      pill.textContent = 'أساس الاستحقاق (Accrual Basis)';
    }
    if (statusBadge) {
      statusBadge.className = 'text-xs font-black px-2.5 py-1 bg-purple-100 text-purple-900 rounded-lg';
      statusBadge.textContent = '📋 شامل الآجل';
    }

    // Card 1: Gross Sales
    document.getElementById('fin-card1-title').textContent = 'إجمالي المبيعات (Gross Sales)';
    document.getElementById('fin-gross-sales').textContent = (finAccrual.gross_sales || 0).toLocaleString('ar-EG', { minimumFractionDigits: 2 }) + ' ج.م';
    document.getElementById('fin-discounts-note').textContent = `خصومات: ${(finAccrual.total_discounts || 0).toLocaleString('ar-EG', { minimumFractionDigits: 2 })} ج.م | صافي المبيعات: ${(finAccrual.net_sales || 0).toLocaleString('ar-EG', { minimumFractionDigits: 2 })} ج.م`;

    // Card 2: Expenses
    document.getElementById('fin-expenses').textContent = expTotal.toLocaleString('ar-EG', { minimumFractionDigits: 2 }) + ' ج.م';
    document.getElementById('fin-expenses-count').textContent = `${expList.length} بند مسجل`;

    // Card 3: Gross Profit
    const grossVal = parseFloat(finAccrual.gross_profit || 0);
    const grossEl = document.getElementById('fin-gross-profit');
    const grossCard = document.getElementById('fin-gross-card');
    const grossNote = document.getElementById('fin-gross-note');
    document.getElementById('fin-card3-title').textContent = 'إجمالي الأرباح (Gross Profit)';
    grossEl.textContent = grossVal.toLocaleString('ar-EG', { minimumFractionDigits: 2 }) + ' ج.م';
    if (grossVal < 0) {
      grossEl.className = 'text-xl sm:text-2xl font-black text-red-600';
      if (grossCard) grossCard.className = 'bg-red-50/90 border border-red-200 rounded-xl p-4 text-center';
      if (grossNote) grossNote.innerHTML = '<span class="text-red-700 font-black">⚠️ بيع بخسارة (أقل من التكلفة)</span>';
    } else {
      grossEl.className = 'text-xl sm:text-2xl font-black text-amber-800';
      if (grossCard) grossCard.className = 'bg-amber-50/70 border border-amber-100 rounded-xl p-4 text-center';
      if (grossNote) grossNote.textContent = '= المبيعات − التكلفة (COGS)';
    }

    // Card 4: Net Profit
    const netVal = parseFloat(finAccrual.net_profit || 0);
    const netEl = document.getElementById('fin-net-profit');
    const netCard = document.getElementById('fin-net-card');
    const netNote = document.getElementById('fin-net-note');
    document.getElementById('fin-card4-title').textContent = 'صافي الربح الحقيقي (Net Profit)';
    netEl.textContent = netVal.toLocaleString('ar-EG', { minimumFractionDigits: 2 }) + ' ج.م';
    if (netVal < 0) {
      netEl.className = 'text-xl sm:text-2xl font-black text-red-700';
      if (netCard) netCard.className = 'bg-red-50/90 border border-red-200 rounded-xl p-4 text-center';
      if (netNote) netNote.innerHTML = '<span class="text-red-700 font-black">⚠️ صافي خسارة للفترة</span>';
    } else {
      netEl.className = 'text-xl sm:text-2xl font-black text-emerald-800';
      if (netCard) netCard.className = 'bg-emerald-50/70 border border-emerald-100 rounded-xl p-4 text-center';
      if (netNote) netNote.textContent = '= إجمالي الربح − المصروفات';
    }

    // Payment Breakdown Grid
    renderPaymentBreakdown(finAccrual.payment_breakdown || []);
    document.getElementById('invoicesCountBadge').textContent = `${finAccrual.invoices_count || 0} فاتورة`;
  }

  const printBasis = document.getElementById('printBasisLabel');
  if (printBasis) {
    printBasis.textContent = isCash ? '💰 التحصيل الفعلي (الأساس النقدي)' : '📋 شامل الآجل (أساس الاستحقاق)';
  }
}

function renderReport(data) {
  // Update date labels
  const labelText = data.period_label || data.date || '';
  document.querySelectorAll('.currentReportDateText').forEach(el => el.textContent = labelText);
  const printLabel = document.getElementById('printDateLabel');
  if (printLabel) printLabel.textContent = labelText;

  // Populate Executive Comparative Table in Print Header
  const cRev = parseFloat(data.financial?.cash?.total_cash_in || 0);
  const aRev = parseFloat(data.financial?.accrual?.gross_sales || 0);
  const diffRev = aRev - cRev;

  const cExp = parseFloat(data.financial?.cash?.expenses_total || data.financial?.expenses_total || 0);
  const aExp = parseFloat(data.financial?.accrual?.expenses_total || data.financial?.expenses_total || 0);

  const cGross = parseFloat(data.financial?.cash?.realized_gross_profit || 0);
  const aGross = parseFloat(data.financial?.accrual?.gross_profit || 0);
  const diffGross = aGross - cGross;

  const cNet = parseFloat(data.financial?.cash?.realized_net_profit || 0);
  const aNet = parseFloat(data.financial?.accrual?.net_profit || 0);
  const diffNet = aNet - cNet;

  const elCashRev = document.getElementById('print-comp-cash-rev');
  if (elCashRev) {
    elCashRev.textContent = cRev.toLocaleString('ar-EG', { minimumFractionDigits: 2 }) + ' ج.م';
    document.getElementById('print-comp-acc-rev').textContent = aRev.toLocaleString('ar-EG', { minimumFractionDigits: 2 }) + ' ج.م';
    document.getElementById('print-comp-diff-rev').textContent = (diffRev >= 0 ? '+' : '') + diffRev.toLocaleString('ar-EG', { minimumFractionDigits: 2 }) + ' ج.م';

    document.getElementById('print-comp-cash-exp').textContent = cExp.toLocaleString('ar-EG', { minimumFractionDigits: 2 }) + ' ج.م';
    document.getElementById('print-comp-acc-exp').textContent = aExp.toLocaleString('ar-EG', { minimumFractionDigits: 2 }) + ' ج.م';

    document.getElementById('print-comp-cash-gross').textContent = cGross.toLocaleString('ar-EG', { minimumFractionDigits: 2 }) + ' ج.م';
    document.getElementById('print-comp-acc-gross').textContent = aGross.toLocaleString('ar-EG', { minimumFractionDigits: 2 }) + ' ج.م';
    document.getElementById('print-comp-diff-gross').textContent = (diffGross >= 0 ? '+' : '') + diffGross.toLocaleString('ar-EG', { minimumFractionDigits: 2 }) + ' ج.م';

    document.getElementById('print-comp-cash-net').textContent = cNet.toLocaleString('ar-EG', { minimumFractionDigits: 2 }) + ' ج.م';
    document.getElementById('print-comp-acc-net').textContent = aNet.toLocaleString('ar-EG', { minimumFractionDigits: 2 }) + ' ج.م';
    document.getElementById('print-comp-diff-net').textContent = (diffNet >= 0 ? '+' : '') + diffNet.toLocaleString('ar-EG', { minimumFractionDigits: 2 }) + ' ج.م';
  }

  // Render Channels Breakdown
  const chan = data.financial?.channels || {};
  const debtTotal = parseFloat(data.financial?.cash?.debt_collected || 0);
  const debtCount = parseInt(data.financial?.cash?.debt_collections_count || 0, 10);

  document.getElementById('chan-pos-sales').textContent = (chan.pos_sales || 0).toLocaleString('ar-EG', { minimumFractionDigits: 2 }) + ' ج.م';
  document.getElementById('chan-pos-count').textContent = `${chan.pos_count || 0} فاتورة`;

  document.getElementById('chan-online-sales').textContent = (chan.online_sales || 0).toLocaleString('ar-EG', { minimumFractionDigits: 2 }) + ' ج.م';
  document.getElementById('chan-online-count').textContent = `${chan.online_count || 0} أوردر`;

  document.getElementById('chan-debt-sales').textContent = debtTotal.toLocaleString('ar-EG', { minimumFractionDigits: 2 }) + ' ج.م';
  document.getElementById('chan-debt-count').textContent = `${debtCount} دفعة محصلة`;

  // Render Financial Cards based on currentBasis
  renderFinancialCards(data);

  // Render Customer Debt Payments Table
  const debtList = data.financial?.customer_payments_list || [];
  const debtTbody = document.getElementById('debtPaymentsTableBody');
  const noDebtMsg = document.getElementById('noDebtPaymentsMsg');
  const debtTotalLabel = document.getElementById('debtPaymentsTotalLabel');

  if (debtList.length === 0) {
    debtTbody.innerHTML = '';
    noDebtMsg.classList.remove('hidden');
    if (debtTotalLabel) debtTotalLabel.textContent = '';
  } else {
    noDebtMsg.classList.add('hidden');
    if (debtTotalLabel) {
      debtTotalLabel.textContent = `إجمالي المحصل: ${debtTotal.toLocaleString('ar-EG', { minimumFractionDigits: 2 })} ج.م (${debtList.length} دفعة)`;
    }
    debtTbody.innerHTML = debtList.map((cp, idx) => {
      const cAmt = parseFloat(cp.cash_amount || 0);
      const iAmt = parseFloat(cp.instapay_amount || 0);
      let methodBadge = '<span class="bg-blue-100 text-blue-800 px-2 py-0.5 rounded font-bold text-[11px]">💵 كاش</span>';
      if (cAmt > 0 && iAmt > 0) {
        methodBadge = `<span class="bg-purple-100 text-purple-800 px-2 py-0.5 rounded font-bold text-[11px]">مقسم (كاش: ${cAmt} | Insta: ${iAmt})</span>`;
      } else if (iAmt > 0) {
        methodBadge = '<span class="bg-teal-100 text-teal-800 px-2 py-0.5 rounded font-bold text-[11px]">📱 InstaPay</span>';
      }

      return `
        <tr class="hover:bg-amber-50/40">
          <td class="p-2.5 text-center text-gray-400 font-mono">${idx + 1}</td>
          <td class="p-2.5">
            <div class="font-bold text-gray-900">${cp.customer_name || '—'}</div>
            ${cp.customer_phone ? `<div class="text-[10px] text-gray-500 font-mono">${cp.customer_phone}</div>` : ''}
          </td>
          <td class="p-2.5 text-center font-black text-amber-900">${parseFloat(cp.amount).toLocaleString('ar-EG', { minimumFractionDigits: 2 })} ج.م</td>
          <td class="p-2.5 text-center">${methodBadge}</td>
          <td class="p-2.5 text-center text-gray-500 font-mono text-[11px]">${(cp.date || '').replace('T', ' ').slice(0, 16)}</td>
          <td class="p-2.5 text-gray-600 text-xs">${cp.note || '—'}</td>
        </tr>
      `;
    }).join('');
  }

  // Render Expenses Table
  const expTbody = document.getElementById('expensesTableBody');
  const noExpMsg = document.getElementById('noExpensesMsg');
  const expList = data.financial?.expenses_list || [];
  const expTotal = parseFloat(data.financial?.expenses_total || 0);

  if (expList.length === 0) {
    expTbody.innerHTML = '';
    noExpMsg.classList.remove('hidden');
    document.getElementById('expensesTotalLabel').textContent = '';
  } else {
    noExpMsg.classList.add('hidden');
    document.getElementById('expensesTotalLabel').textContent = `إجمالي: ${expTotal.toLocaleString('ar-EG', { minimumFractionDigits: 2 })} ج.م`;
    expTbody.innerHTML = expList.map((e, idx) => `
      <tr class="hover:bg-gray-50">
        <td class="p-2.5 text-center text-gray-400 font-mono">${idx + 1}</td>
        <td class="p-2.5 font-bold text-gray-900">${e.title || '—'}</td>
        <td class="p-2.5 text-center font-bold text-red-600">${parseFloat(e.amount).toLocaleString('ar-EG', { minimumFractionDigits: 2 })} ج.م</td>
        <td class="p-2.5 text-center text-gray-500">${(e.date || '').slice(0, 10)}</td>
      </tr>
    `).join('');
  }

  // 2. Products Sold Table
  const soldTbody = document.getElementById('productsSoldTableBody');
  const noSoldMsg = document.getElementById('noProductsSoldMsg');
  const soldList = data.products_sold || [];
  document.getElementById('soldItemsCount').textContent = soldList.length;

  if (soldList.length === 0) {
    soldTbody.innerHTML = '';
    noSoldMsg.classList.remove('hidden');
    document.getElementById('soldItemsTotalQty').textContent = 'إجمالي القطع المباعة: 0';
  } else {
    noSoldMsg.classList.add('hidden');
    const totalSoldQty = soldList.reduce((sum, p) => sum + parseInt(p.quantity_sold || 0, 10), 0);
    document.getElementById('soldItemsTotalQty').textContent = `إجمالي القطع المباعة: ${totalSoldQty} قطعة`;

    soldTbody.innerHTML = soldList.map((p, idx) => `
      <tr class="hover:bg-gray-50">
        <td class="p-2.5 text-center text-gray-400 font-mono">${idx + 1}</td>
        <td class="p-2.5 font-bold text-gray-900">${p.product_name}</td>
        <td class="p-2.5 text-gray-600">${p.category || 'عام'}</td>
        <td class="p-2.5 text-center font-mono text-xs text-gray-500">${p.barcode || '—'}</td>
        <td class="p-2.5 text-center font-black text-blue-700">${p.quantity_sold}</td>
        <td class="p-2.5 text-center text-gray-700">${parseFloat(p.avg_unit_price).toFixed(2)} ج.م</td>
        <td class="p-2.5 text-center font-bold text-emerald-800">${parseFloat(p.total_sales_amount).toFixed(2)} ج.م</td>
      </tr>
    `).join('');
  }

  // 3. Shortages Table (Strict criteria: min_stock > 0 and shop_qty <= min_stock)
  const shortTbody = document.getElementById('shortagesTableBody');
  const noShortMsg = document.getElementById('noShortagesMsg');
  const shortList = data.shortages || [];
  document.getElementById('shortagesCountBadge').textContent = `${shortList.length} نواقص مسجلة`;

  if (shortList.length === 0) {
    shortTbody.innerHTML = '';
    noShortMsg.classList.remove('hidden');
  } else {
    noShortMsg.classList.add('hidden');
    shortTbody.innerHTML = shortList.map((s, idx) => {
      const isZero = s.shop_qty <= 0;
      const whQty = parseInt(s.warehouse_qty || 0, 10);
      let actionHtml = '';

      if (whQty > 0) {
        actionHtml = `<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold bg-blue-100 text-blue-800">📦 تحويل من المستودع (${whQty} متاح)</span>`;
      } else {
        actionHtml = `<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold bg-red-100 text-red-800">🚨 طلب توريد من المورد</span>`;
      }

      return `
        <tr class="hover:bg-amber-50/40">
          <td class="p-2.5 text-center text-gray-400 font-mono">${idx + 1}</td>
          <td class="p-2.5 font-bold text-gray-900">${s.product_name}</td>
          <td class="p-2.5 text-gray-600">${s.category || 'عام'}</td>
          <td class="p-2.5 text-center font-bold text-amber-800">${s.min_stock}</td>
          <td class="p-2.5 text-center font-black ${isZero ? 'text-red-600' : 'text-amber-700'}">${s.shop_qty} ${isZero ? '(نفذ)' : ''}</td>
          <td class="p-2.5 text-center font-bold ${whQty > 0 ? 'text-blue-700 bg-blue-50/30' : 'text-gray-400'}">${whQty}</td>
          <td class="p-2.5 text-center">${actionHtml}</td>
        </tr>
      `;
    }).join('');
  }

  // 4. Expiry Tracker Table (Color tiered)
  const expiryTbody = document.getElementById('expiriesTableBody');
  const noExpTableMsg = document.getElementById('noExpiriesMsg');
  const expiryList = data.expiries || [];

  if (expiryList.length === 0) {
    expiryTbody.innerHTML = '';
    noExpTableMsg.classList.remove('hidden');
  } else {
    noExpTableMsg.classList.add('hidden');
    expiryTbody.innerHTML = expiryList.map((e, idx) => {
      let badgeClass = 'badge-green';
      let rowClass = 'tier-green';
      if (e.tier === 'red') {
        badgeClass = 'badge-red';
        rowClass = 'tier-red';
      } else if (e.tier === 'yellow') {
        badgeClass = 'badge-yellow';
        rowClass = 'tier-yellow';
      }

      const formattedExpiry = (e.expiry_date || '').toString().slice(0, 10);

      return `
        <tr class="${rowClass} hover:bg-gray-50/80 transition-colors">
          <td class="p-2.5 text-center text-gray-400 font-mono">${idx + 1}</td>
          <td class="p-2.5 font-bold text-gray-900">${e.product_name}</td>
          <td class="p-2.5 text-gray-600">${e.category || 'عام'}</td>
          <td class="p-2.5 text-center font-bold text-gray-900">${e.quantity} وحدة</td>
          <td class="p-2.5 text-center font-mono font-bold text-gray-800">${formattedExpiry}</td>
          <td class="p-2.5 text-center font-bold text-xs">${e.months_left} شهر (${e.diff_days} يوم)</td>
          <td class="p-2.5 text-center">
            <span class="inline-block px-2.5 py-1 rounded-full text-xs font-bold ${badgeClass}">
              ${e.tier_label}
            </span>
          </td>
        </tr>
      `;
    }).join('');
  }
}
</script>

<%- include('partials/footer') %>
