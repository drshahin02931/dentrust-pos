<%- include('partials/header', Object.assign({pageTitle: 'المحاسبة'}, locals)) %>
<div class="space-y-6">
  <div class="flex items-center justify-between flex-wrap gap-3">
    <h1 class="text-2xl font-bold text-gray-800">📊 المحاسبة والتقارير</h1>
    <!-- Export CSV & PDF buttons -->
    <div class="flex gap-2 flex-wrap items-center">
      <a href="<%= base %>/reports" class="flex items-center gap-1.5 bg-gradient-to-r from-blue-700 to-indigo-800 hover:from-blue-800 hover:to-indigo-900 text-white text-xs sm:text-sm font-bold px-3.5 py-2 rounded-xl shadow transition-all">
        <span>📑</span>
        <span>تقرير الإغلاق الشامل و PDF</span>
      </a>
      <button onclick="exportCSV('sales')" class="flex items-center gap-1.5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold px-3 py-2 rounded-xl shadow-sm">⬇️ تصدير المبيعات</button>
      <button onclick="exportCSV('products')" class="flex items-center gap-1.5 bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold px-3 py-2 rounded-xl shadow-sm">⬇️ تصدير المنتجات (Excel)</button>
      <button onclick="exportCSV('customers')" class="flex items-center gap-1.5 bg-purple-600 hover:bg-purple-700 text-white text-xs font-semibold px-3 py-2 rounded-xl shadow-sm">⬇️ تصدير العملاء</button>
      <button onclick="exportCSV('expenses')" class="flex items-center gap-1.5 bg-red-600 hover:bg-red-700 text-white text-xs font-semibold px-3 py-2 rounded-xl shadow-sm">⬇️ تصدير المصروفات</button>
    </div>
  </div>

  <!-- ══ Capital, Debt Ratio, Gold/USD Assets & Growth Scale Dashboard ══ -->
  <div id="capitalDashboard" class="space-y-4">
    <!-- Top Banner: Total Capital & Composition -->
    <div class="bg-gradient-to-br from-slate-900 via-blue-950 to-indigo-950 text-white rounded-3xl shadow-lg p-5 sm:p-6 space-y-5">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
          <div class="flex items-center gap-2 text-blue-200 text-xs font-bold mb-1">
            <span>🏛️</span>
            <span>إجمالي رأس مال DenTrust (المخزون + المستودع + الديون + الأصول)</span>
          </div>
          <div class="flex flex-wrap items-baseline gap-3">
            <span id="cap-total-cost" class="text-3xl sm:text-4xl font-black tracking-tight">—</span>
            <span class="text-sm text-blue-200 font-semibold">جنيه (بالتكلفة وسعر اليوم)</span>
          </div>
          <div class="text-xs text-slate-300 mt-1">
            القيمة البيعية المتوقعة للبضاعة + الديون + الأصول:
            <strong id="cap-total-retail" class="text-emerald-300 font-bold">—</strong> ج
          </div>
        </div>
        <div class="flex flex-col items-end gap-1.5">
          <div id="cap-scale-badge" class="px-3.5 py-1.5 rounded-2xl text-xs font-black bg-white/10 border border-white/20">
            ⏳ جاري حساب النمو...
          </div>
          <div id="cap-scale-sub" class="text-[11px] text-slate-300 text-left"></div>
        </div>
      </div>

      <!-- Visual Stacked Bar -->
      <div class="space-y-1.5">
        <div class="h-3.5 w-full bg-white/10 rounded-full overflow-hidden flex">
          <div id="bar-inv" class="bg-sky-400 transition-all duration-500" style="width:0%" title="مخزون المحل"></div>
          <div id="bar-wh" class="bg-indigo-400 transition-all duration-500" style="width:0%" title="المستودع"></div>
          <div id="bar-debt" class="bg-amber-400 transition-all duration-500" style="width:0%" title="ديون العملاء"></div>
          <div id="bar-assets" class="bg-yellow-300 transition-all duration-500" style="width:0%" title="أصول دهب ودولار"></div>
        </div>
      </div>

      <!-- 4 Breakdown Cards -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3">
        <div class="bg-white/10 border border-white/15 rounded-2xl p-3.5">
          <div class="flex items-center justify-between text-xs text-sky-200 font-semibold">
            <span>📦 مخزون المحل</span>
            <span id="cap-inv-pct" class="bg-sky-400/20 text-sky-200 px-2 py-0.5 rounded-full font-bold">0%</span>
          </div>
          <div id="cap-inv-val" class="text-xl font-black mt-1">—</div>
          <div class="text-[11px] text-slate-300 mt-0.5">بسعر البيع: <span id="cap-inv-retail">—</span> ج</div>
        </div>

        <div class="bg-white/10 border border-white/15 rounded-2xl p-3.5">
          <div class="flex items-center justify-between text-xs text-indigo-200 font-semibold">
            <span>🏢 بضاعة المستودع</span>
            <span id="cap-wh-pct" class="bg-indigo-400/20 text-indigo-200 px-2 py-0.5 rounded-full font-bold">0%</span>
          </div>
          <div id="cap-wh-val" class="text-xl font-black mt-1">—</div>
          <div class="text-[11px] text-slate-300 mt-0.5">بسعر البيع: <span id="cap-wh-retail">—</span> ج</div>
        </div>

        <div class="bg-amber-500/15 border border-amber-400/40 rounded-2xl p-3.5">
          <div class="flex items-center justify-between text-xs text-amber-200 font-semibold">
            <span>💳 جزء الديون (الآجل)</span>
            <span id="cap-debt-pct" class="bg-amber-400/30 text-amber-100 px-2 py-0.5 rounded-full font-black">0%</span>
          </div>
          <div id="cap-debt-val" class="text-xl font-black text-amber-200 mt-1">—</div>
          <div class="flex items-center justify-between text-[11px] mt-0.5">
            <span id="cap-debt-cnt" class="text-slate-200">0 دكتور</span>
            <span id="cap-debt-risk" class="font-bold">—</span>
          </div>
        </div>

        <div class="bg-yellow-500/15 border border-yellow-300/40 rounded-2xl p-3.5">
          <div class="flex items-center justify-between text-xs text-yellow-200 font-semibold">
            <span>🪙 أصول (دهب + دولار + عقار)</span>
            <span id="cap-assets-pct" class="bg-yellow-400/25 text-yellow-100 px-2 py-0.5 rounded-full font-bold">0%</span>
          </div>
          <div id="cap-assets-val" class="text-xl font-black text-yellow-200 mt-1">—</div>
          <div id="cap-assets-gain" class="text-[11px] mt-0.5 font-semibold">—</div>
        </div>
      </div>
    </div>

    <!-- Two Columns: Growth Graph (Scale) + Gold/USD Portfolio -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-5">
      <!-- Growth Graph / Scale (7 cols) -->
      <div class="lg:col-span-7 bg-white rounded-2xl border shadow-sm p-5 flex flex-col justify-between space-y-4">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <div>
            <h3 class="font-extrabold text-gray-800 text-base">📈 مؤشر النمو (Scale): بنكبر ولا بنخسر؟</h3>
            <p class="text-xs text-gray-500 mt-0.5">مسار رأس المال شاملاً أرباح التشغيل وتغيّر أسعار الدهب والدولار</p>
          </div>
          <div class="flex bg-gray-100 p-1 rounded-xl text-xs font-bold">
            <button type="button" id="scaleBtnMonths" onclick="setScaleChartView('months')" class="px-3 py-1 rounded-lg bg-blue-700 text-white shadow">آخر 6 شهور</button>
            <button type="button" id="scaleBtnDaily" onclick="setScaleChartView('daily')" class="px-3 py-1 rounded-lg text-gray-600">اللقطات اليومية</button>
          </div>
        </div>

        <div id="scale-svg-container" class="w-full min-h-[210px] bg-slate-50/70 border border-slate-100 rounded-2xl p-3 flex items-center justify-center">
          <span class="text-xs text-gray-400">جاري رسم الجراف...</span>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 text-center">
          <div class="bg-slate-50 border rounded-xl p-2.5">
            <div class="text-[11px] text-gray-500 font-medium">درجة النمو (الشهر)</div>
            <div id="scale-pct-val" class="text-lg font-black text-gray-800 mt-0.5">—</div>
            <div id="scale-egp-val" class="text-[11px] text-gray-500">—</div>
          </div>
          <div class="bg-emerald-50 border border-emerald-100 rounded-xl p-2.5">
            <div class="text-[11px] text-emerald-700 font-medium">🔄 50% ضخ لرأس المال</div>
            <div id="scale-reinvest-val" class="text-lg font-black text-emerald-700 mt-0.5">—</div>
            <div class="text-[11px] text-emerald-600">من صافي <span id="scale-ops-profit">—</span></div>
          </div>
          <div class="bg-purple-50 border border-purple-100 rounded-xl p-2.5">
            <div class="text-[11px] text-purple-700 font-medium">🏦 50% سحب شخصي</div>
            <div id="scale-owner-val" class="text-lg font-black text-purple-700 mt-0.5">—</div>
            <div class="text-[11px] text-purple-600">حصتك الصافية الشهر ده</div>
          </div>
          <div class="bg-amber-50 border border-amber-100 rounded-xl p-2.5">
            <div class="text-[11px] text-amber-800 font-medium">🪙 من ارتفاع الأصول</div>
            <div id="scale-assets-gain" class="text-lg font-black text-amber-700 mt-0.5">—</div>
            <div class="text-[11px] text-amber-700">فرق سعر الدهب/$/العقار</div>
          </div>
        </div>
      </div>

      <!-- Gold, USD & Real Estate Assets Tracker (5 cols) -->
      <div class="lg:col-span-5 bg-white rounded-2xl border shadow-sm p-5 space-y-4">
        <div class="flex items-center justify-between gap-2">
          <h3 class="font-extrabold text-gray-800 text-base">🪙 محفظة الأصول (دهب + دولار + عقار)</h3>
          <button type="button" onclick="refreshCapitalRates()" id="btnRefreshRates"
            class="text-xs bg-amber-50 hover:bg-amber-100 text-amber-800 border border-amber-200 font-bold px-2.5 py-1.5 rounded-xl">
            🔄 تحديث تلقائي
          </button>
        </div>

        <!-- Live/Manual Rates Box -->
        <div class="bg-amber-50/70 border border-amber-200 rounded-2xl p-3 space-y-2.5">
          <div class="flex flex-wrap items-center justify-between gap-1 text-[11px] text-amber-900">
            <span class="font-bold">أسعار السوق اليوم (<span id="rate-source">—</span>)</span>
            <span id="rate-updated" class="text-amber-700"></span>
          </div>
          <div class="grid grid-cols-4 gap-1.5 text-center text-[11px]">
            <div class="bg-white rounded-xl p-1.5 border border-amber-100"><div class="text-gray-400">عيار 24</div><strong id="rate-24" class="text-gray-800">—</strong></div>
            <div class="bg-white rounded-xl p-1.5 border border-amber-200"><div class="text-amber-700 font-bold">عيار 21</div><strong id="rate-21" class="text-amber-800">—</strong></div>
            <div class="bg-white rounded-xl p-1.5 border border-amber-100"><div class="text-gray-400">عيار 18</div><strong id="rate-18" class="text-gray-800">—</strong></div>
            <div class="bg-white rounded-xl p-1.5 border border-emerald-200"><div class="text-emerald-700 font-bold">الدولار $</div><strong id="rate-usd" class="text-emerald-800">—</strong></div>
          </div>
          <div class="text-[11px] text-amber-800 flex items-center justify-between px-1">
            <span>الجنيه الدهب (8 جم عيار 21):</span>
            <strong id="rate-pound">—</strong>
          </div>
          <div class="grid grid-cols-5 gap-1.5 pt-1 border-t border-amber-200/70">
            <input id="inp-rate-21" type="number" step="1" min="1" placeholder="سعر 21"
              class="col-span-2 bg-white border border-amber-200 rounded-xl px-2.5 py-1.5 text-xs font-bold" title="سعر جرام عيار 21 بالصاغة"/>
            <input id="inp-rate-usd" type="number" step="0.01" min="1" placeholder="سعر $"
              class="col-span-2 bg-white border border-amber-200 rounded-xl px-2.5 py-1.5 text-xs font-bold" title="سعر الدولار اليوم"/>
            <button type="button" onclick="saveCapitalRates()" class="col-span-1 bg-amber-600 hover:bg-amber-700 text-white text-xs font-bold rounded-xl py-1.5">حفظ</button>
          </div>
        </div>

        <!-- Add Asset Form -->
        <form onsubmit="addCompanyAsset(event)" class="space-y-2.5 border-t pt-3">
          <div class="grid grid-cols-2 gap-2">
            <select id="asset-type" onchange="toggleAssetTypeFields()" class="border rounded-xl px-2.5 py-2 text-xs font-bold bg-gray-50">
              <option value="gold">🪙 دهب (جرام + عيار)</option>
              <option value="usd">💵 دولار أمريكي ($)</option>
              <option value="real_estate">🏢 عقار / مقر الشركة (يزيد مع الوقت)</option>
            </select>
            <input id="asset-date" type="date" class="border rounded-xl px-2.5 py-2 text-xs"/>
          </div>

          <div id="asset-gold-fields" class="grid grid-cols-2 gap-2">
            <select id="asset-karat" onchange="onAssetKaratChange()" class="border rounded-xl px-2.5 py-2 text-xs font-semibold">
              <option value="21">عيار 21</option>
              <option value="24">عيار 24 (سبائك)</option>
              <option value="18">عيار 18</option>
              <option value="218">جنيه دهب (8 جم 21)</option>
            </select>
            <div class="relative">
              <input id="asset-grams" type="number" step="0.01" min="0.01" placeholder="الوزن بالجرام (مثلاً 10.5)"
                class="w-full border rounded-xl px-2.5 py-2 text-xs font-bold"/>
              <button type="button" id="gold-pound-helper" onclick="addGoldPoundWeight()"
                class="hidden mt-1 text-[10px] text-amber-700 font-bold hover:underline">+ إضافة 8 جم (جنيه واحد)</button>
            </div>
          </div>

          <div id="asset-usd-fields" class="hidden">
            <input id="asset-usd" type="number" step="0.01" min="0.01" placeholder="المبلغ بالدولار ($)"
              class="w-full border rounded-xl px-2.5 py-2 text-xs font-bold"/>
          </div>

          <div id="asset-realestate-fields" class="hidden space-y-1">
            <div class="flex items-center gap-2">
              <label class="text-[11px] font-semibold text-gray-600 shrink-0">الزيادة السنوية المتوقعة %:</label>
              <input id="asset-growth-pct" type="number" step="0.5" min="0" value="20" placeholder="نسبة الزيادة السنوية % (مثلاً 20%)"
                class="w-full border rounded-xl px-2.5 py-2 text-xs font-bold"/>
            </div>
            <p class="text-[10px] text-gray-500">بيزيد تلقائياً يوم بيوم من تاريخ الشراء حسب النسبة السنوية (وتقدر تعدّل تقييمه يدوياً في أي وقت).</p>
          </div>

          <div class="grid grid-cols-2 gap-2">
            <div class="flex gap-1">
              <input id="asset-cost" type="number" step="0.01" min="0" required placeholder="سعر الشراء الكلي (ج)"
                class="w-full border rounded-xl px-2.5 py-2 text-xs font-bold"/>
              <button type="button" id="asset-fill-today-btn" onclick="fillAssetCurrentCost()" title="املأ بسعر اليوم"
                class="px-2 bg-gray-100 hover:bg-gray-200 rounded-xl text-[11px] font-bold text-gray-600 shrink-0">اليوم</button>
            </div>
            <input id="asset-notes" type="text" placeholder="ملاحظة (مثلاً سبيكة BTC)"
              class="border rounded-xl px-2.5 py-2 text-xs"/>
          </div>
          <button type="submit" class="w-full bg-slate-800 hover:bg-slate-900 text-white font-bold py-2 rounded-xl text-xs">
            ➕ إضافة أصل للمحفظة
          </button>
        </form>

        <!-- Holdings Summary + List -->
        <div id="assets-holdings-summary" class="text-[11px] text-gray-600 bg-gray-50 rounded-xl px-3 py-2 hidden"></div>
        <div class="max-h-52 overflow-y-auto divide-y text-xs" id="assets-list"></div>
      </div>
    </div>
  </div>

  <!-- Period Selector & Basis Toggle -->
  <div class="bg-white rounded-2xl border shadow-sm p-4 flex flex-wrap items-center justify-between gap-3">
    <!-- Period Buttons -->
    <div class="flex flex-wrap items-center gap-2">
      <button onclick="setPeriod('today')" id="p-today" class="period-btn px-5 py-2 rounded-xl text-sm font-semibold">اليوم</button>
      <button onclick="setPeriod('week')"  id="p-week"  class="period-btn px-5 py-2 rounded-xl text-sm font-semibold">الأسبوع</button>
      <button onclick="setPeriod('month')" id="p-month" class="period-btn px-5 py-2 rounded-xl text-sm font-semibold">الشهر</button>
      <button onclick="setPeriod('all')"   id="p-all"   class="period-btn px-5 py-2 rounded-xl text-sm font-semibold">الكل</button>
    </div>

    <!-- Basis Toggle Switch: Cash vs Accrual -->
    <div class="flex items-center bg-gray-100 p-1 rounded-xl border border-gray-300 shadow-inner">
      <button type="button" id="accBasisCash" onclick="setAccountingBasis('cash')" class="px-3.5 py-1.5 text-xs font-black rounded-lg transition-all bg-blue-700 text-white shadow flex items-center gap-1.5">
        <span>💰</span>
        <span>التحصيل الفعلي (الدرج)</span>
      </button>
      <button type="button" id="accBasisAccrual" onclick="setAccountingBasis('accrual')" class="px-3.5 py-1.5 text-xs font-black rounded-lg transition-all text-gray-600 hover:text-gray-900 flex items-center gap-1.5">
        <span>📋</span>
        <span>شامل الآجل (الاستحقاق)</span>
      </button>
    </div>
  </div>

  <!-- Mode Explainer Banner -->
  <div id="accBasisBanner" class="bg-blue-50/90 border border-blue-200 rounded-2xl p-3 text-xs flex flex-wrap items-center justify-between gap-2">
    <div class="flex items-center gap-2">
      <span id="accBasisIcon" class="text-base">💰</span>
      <span id="accBasisText" class="font-bold text-blue-900">وضع التحصيل الفعلي: يحسب النقدية المحصلة في الدرج والخزينة + دفعات سداد مديونيات العملاء، مع استبعاد الآجل غير المحصل.</span>
    </div>
    <span id="accBasisBadge" class="bg-blue-200 text-blue-950 px-2.5 py-0.5 rounded-full font-black text-[10px]">الأساس النقدي (Cash Basis)</span>
  </div>

  <!-- Financial Cards -->
  <div class="grid grid-cols-2 lg:grid-cols-5 gap-4">
    <div class="bg-blue-50 border border-blue-100 rounded-2xl p-4 text-center">
      <div id="c-revenue-title" class="text-xs text-blue-500 font-medium mb-1">المقبوضات النقدية</div>
      <div id="c-revenue" class="text-2xl font-black text-blue-700">—</div>
      <div id="c-revenue-note" class="text-[11px] text-blue-500 mt-1">مبيعات نقدية + سداد ديون</div>
      <div id="c-refunds-note" class="text-xs text-orange-500 mt-1 hidden"></div>
    </div>
    <div class="bg-green-50 border border-green-100 rounded-2xl p-4 text-center">
      <div id="c-gross-title" class="text-xs text-green-600 font-medium mb-1">الربح المحقق</div>
      <div id="c-gross" class="text-2xl font-black text-green-700">—</div>
      <div id="c-gross-note" class="text-[11px] text-green-500 mt-1">= أرباح المحصل فعلياً</div>
    </div>
    <div class="bg-red-50 border border-red-100 rounded-2xl p-4 text-center">
      <div class="text-xs text-red-500 font-medium mb-1">المصروفات</div>
      <div id="c-expenses" class="text-2xl font-black text-red-600">—</div>
      <div class="text-[11px] text-red-400 mt-1">مصروفات الفترة</div>
    </div>
    <div class="bg-yellow-50 border border-yellow-100 rounded-2xl p-4 text-center">
      <div class="text-xs text-yellow-600 font-medium mb-1">💰 أرباح إضافية</div>
      <div id="c-extra" class="text-2xl font-black text-yellow-700">—</div>
      <div class="text-[11px] text-yellow-500 mt-1">أرباح أخرى مسجلة</div>
    </div>
    <div class="bg-purple-50 border border-purple-100 rounded-2xl p-4 text-center">
      <div id="c-net-title" class="text-xs text-purple-600 font-medium mb-1">صافي الربح الفعلي</div>
      <div id="c-net" class="text-2xl font-black text-purple-700">—</div>
      <div id="c-net-note" class="text-[11px] text-purple-500 mt-1">= الربح المحقق − المصروفات</div>
      <div id="c-net-split" class="text-[11px] font-bold text-purple-800 bg-purple-100/80 rounded-lg px-2 py-1 mt-1.5 hidden"></div>
    </div>
  </div>

  <div id="c-refunds-bar" class="hidden bg-orange-50 border border-orange-200 rounded-2xl px-5 py-3 flex items-center justify-between text-sm">
    <span class="font-semibold text-orange-700">↩️ إجمالي المردودات (مخصومة من الإيراد)</span>
    <span id="c-refunds-val" class="font-black text-orange-700 text-base">0.00</span>
  </div>

  <!-- Payment Breakdown -->
  <div class="bg-white rounded-2xl border shadow-sm p-4">
    <h3 class="font-bold text-gray-700 mb-3">توزيع طرق الدفع والتحصيل</h3>
    <div id="payBreakdown" class="grid grid-cols-2 lg:grid-cols-4 gap-3"></div>
  </div>

  <!-- ══ Detailed Reports Tabs ══ -->
  <div class="bg-white rounded-2xl border shadow-sm overflow-x-auto">
    <div class="flex border-b">
      <button id="tab-top-products"  onclick="switchDetailTab('top-products')"  class="detail-tab-btn flex-1 py-3 text-sm font-semibold text-blue-700 border-b-2 border-blue-700">🏆 أكثر المنتجات</button>
      <button id="tab-top-customers" onclick="switchDetailTab('top-customers')" class="detail-tab-btn flex-1 py-3 text-sm font-semibold text-gray-400">👑 أعلى العملاء</button>
      <button id="tab-hourly"        onclick="switchDetailTab('hourly')"        class="detail-tab-btn flex-1 py-3 text-sm font-semibold text-gray-400">⏰ مبيعات ساعة بساعة</button>
    </div>

    <!-- Top Products -->
    <div id="pane-top-products" class="p-4">
      <div class="flex items-center justify-between mb-3">
        <span class="text-sm text-gray-500">أكثر المنتجات مبيعاً</span>
        <button onclick="exportCSV('top-products')" class="text-xs bg-emerald-50 text-emerald-700 hover:bg-emerald-100 px-3 py-1.5 rounded-lg font-medium">⬇️ تصدير</button>
      </div>
      <div id="topProductsList" class="space-y-2"><div class="text-center text-gray-400 py-6 text-sm">جار التحميل...</div></div>
    </div>

    <!-- Top Customers -->
    <div id="pane-top-customers" class="hidden p-4">
      <div class="flex items-center justify-between mb-3">
        <span class="text-sm text-gray-500">أعلى العملاء إنفاقاً</span>
        <button onclick="exportCSV('top-customers')" class="text-xs bg-emerald-50 text-emerald-700 hover:bg-emerald-100 px-3 py-1.5 rounded-lg font-medium">⬇️ تصدير</button>
      </div>
      <div id="topCustomersList" class="space-y-2"><div class="text-center text-gray-400 py-6 text-sm">جار التحميل...</div></div>
    </div>

    <!-- Hourly Sales -->
    <div id="pane-hourly" class="hidden p-4">
      <div class="flex items-center justify-between mb-3">
        <span class="text-sm text-gray-500">توزيع المبيعات حسب الساعة</span>
      </div>
      <div id="hourlyChart" class="space-y-2"><div class="text-center text-gray-400 py-6 text-sm">جار التحميل...</div></div>
    </div>
  </div>

  <!-- Extra Profits Section -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="bg-white rounded-2xl border border-yellow-200 shadow-sm p-5">
      <h3 class="font-bold text-gray-700 mb-4">💰 إضافة ربح إضافي</h3>
      <form onsubmit="addExtraProfit(event)" class="space-y-3">
        <div>
          <label class="text-xs font-medium text-gray-600">البيان *</label>
          <input id="ep-title" required placeholder="مثال: عمولة، بيع قديم..."
            class="w-full border rounded-xl px-3 py-2 text-sm mt-1 focus:outline-none focus:ring-2 focus:ring-yellow-200"/>
        </div>
        <div>
          <label class="text-xs font-medium text-gray-600">المبلغ (جنيه) *</label>
          <input id="ep-amount" type="number" step="0.01" min="0.01" required placeholder="0.00"
            class="w-full border rounded-xl px-3 py-2 text-sm mt-1 focus:outline-none focus:ring-2 focus:ring-yellow-200"/>
        </div>
        <div>
          <label class="text-xs font-medium text-gray-600">التاريخ</label>
          <input id="ep-date" type="date"
            class="w-full border rounded-xl px-3 py-2 text-sm mt-1 focus:outline-none focus:ring-2 focus:ring-yellow-200"/>
        </div>
        <button type="submit" class="w-full bg-yellow-500 text-white font-semibold py-2.5 rounded-xl hover:bg-yellow-600 transition-colors">تسجيل الربح الإضافي</button>
      </form>
    </div>
    <div class="lg:col-span-2 bg-white rounded-2xl border border-yellow-100 shadow-sm overflow-hidden">
      <div class="p-4 border-b font-bold text-gray-700">💰 سجل الأرباح الإضافية</div>
      <div class="overflow-y-auto max-h-96">
        <table class="w-full text-sm">
          <thead class="bg-yellow-50 border-b sticky top-0">
            <tr class="text-right text-gray-600 font-semibold">
              <th class="px-4 py-2.5">البيان</th>
              <th class="px-4 py-2.5">المبلغ</th>
              <th class="px-4 py-2.5">التاريخ</th>
              <th class="px-4 py-2.5"></th>
            </tr>
          </thead>
          <tbody id="extraProfitTable" class="divide-y"></tbody>
        </table>
        <div id="noExtraProfit" class="hidden text-center text-gray-400 py-8 text-sm">لا توجد أرباح إضافية مسجلة</div>
      </div>
      <div id="extraProfitTotal" class="p-3 bg-yellow-50 border-t text-sm font-bold text-yellow-700 text-left hidden"></div>
    </div>
  </div>

  <!-- Expense Section -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <div class="bg-white rounded-2xl border shadow-sm p-5">
      <h3 class="font-bold text-gray-700 mb-4">➕ إضافة مصروف</h3>
      <form onsubmit="addExpense(event)" class="space-y-3">
        <div>
          <label class="text-xs font-medium text-gray-600">البيان *</label>
          <input id="e-title" required placeholder="مثال: فاتورة الكهرباء"
            class="w-full border rounded-xl px-3 py-2 text-sm mt-1 focus:outline-none focus:ring-2 focus:ring-red-200"/>
        </div>
        <div>
          <label class="text-xs font-medium text-gray-600">المبلغ (جنيه) *</label>
          <input id="e-amount" type="number" step="0.01" min="0.01" required placeholder="0.00"
            class="w-full border rounded-xl px-3 py-2 text-sm mt-1 focus:outline-none focus:ring-2 focus:ring-red-200"/>
        </div>
        <div>
          <label class="text-xs font-medium text-gray-600">التاريخ</label>
          <input id="e-date" type="date"
            class="w-full border rounded-xl px-3 py-2 text-sm mt-1 focus:outline-none focus:ring-2 focus:ring-red-200"/>
        </div>
        <button type="submit" class="w-full bg-red-600 text-white font-semibold py-2.5 rounded-xl hover:bg-red-700 transition-colors">تسجيل المصروف</button>
      </form>
    </div>

    <div class="lg:col-span-2 bg-white rounded-2xl border shadow-sm overflow-x-auto">
      <div class="p-4 border-b font-bold text-gray-700">سجل المصروفات</div>
      <div class="overflow-y-auto max-h-96">
        <table class="w-full text-sm">
          <thead class="bg-gray-50 border-b sticky top-0">
            <tr class="text-right text-gray-600 font-semibold">
              <th class="px-4 py-2.5">البيان</th>
              <th class="px-4 py-2.5">المبلغ</th>
              <th class="px-4 py-2.5">التاريخ</th>
              <th class="px-4 py-2.5"></th>
            </tr>
          </thead>
          <tbody id="expenseTable" class="divide-y"></tbody>
        </table>
        <div id="noExpenses" class="hidden text-center text-gray-400 py-8 text-sm">لا توجد مصروفات مسجلة</div>
      </div>
      <div id="expensesTotal" class="p-3 bg-red-50 border-t text-sm font-bold text-red-600 text-left hidden"></div>
    </div>
  </div>
</div>

<style>
  .period-btn { background:#f3f4f6; color:#6b7280; transition:all 0.15s; }
  .period-btn.active { background:#1d4ed8; color:white; }
  .period-btn:not(.active):hover { background:#e5e7eb; }
</style>
<script>
const BASE = "<%- base %>";
let currentPeriod = "today";
let currentAccountingBasis = "cash";
let summaryDataCache = null;
let currentDetailTab = "top-products";
const PAYMENT_LABELS = { cash:"💵 كاش", visa:"💳 فيزا", instapay:"📱 InstaPay", credit:"📋 آجل", split:"↔️ مختلط", online:"🌐 أونلاين" };

function setAccountingBasis(basis) {
  currentAccountingBasis = basis;
  const btnCash = document.getElementById("accBasisCash");
  const btnAccrual = document.getElementById("accBasisAccrual");
  if (basis === "cash") {
    btnCash.className = "px-3.5 py-1.5 text-xs font-black rounded-lg transition-all bg-blue-700 text-white shadow flex items-center gap-1.5";
    btnAccrual.className = "px-3.5 py-1.5 text-xs font-black rounded-lg transition-all text-gray-600 hover:text-gray-900 flex items-center gap-1.5";
  } else {
    btnAccrual.className = "px-3.5 py-1.5 text-xs font-black rounded-lg transition-all bg-purple-700 text-white shadow flex items-center gap-1.5";
    btnCash.className = "px-3.5 py-1.5 text-xs font-black rounded-lg transition-all text-gray-600 hover:text-gray-900 flex items-center gap-1.5";
  }
  if (summaryDataCache) {
    renderSummaryCards();
  } else {
    loadSummary();
  }
}

function setPeriod(p) {
  currentPeriod = p;
  document.querySelectorAll(".period-btn").forEach(b => b.classList.remove("active"));
  document.getElementById(`p-${p}`).classList.add("active");
  loadSummary();
  loadDetailTab(currentDetailTab);
  loadExpenses();
  loadExtraProfit();
}

async function loadSummary() {
  const res = await fetch(`${BASE}/api/reports/summary?period=${currentPeriod}&basis=${currentAccountingBasis}`);
  const d = await res.json();
  summaryDataCache = d;
  renderSummaryCards();
}

function renderSummaryCards() {
  if (!summaryDataCache) return;
  const isCash = currentAccountingBasis === "cash";
  const d = isCash ? (summaryDataCache.cash || summaryDataCache) : (summaryDataCache.accrual || summaryDataCache);

  // Update banner
  const banner = document.getElementById("accBasisBanner");
  const icon = document.getElementById("accBasisIcon");
  const text = document.getElementById("accBasisText");
  const badge = document.getElementById("accBasisBadge");

  if (isCash) {
    banner.className = "bg-blue-50/90 border border-blue-200 rounded-2xl p-3 text-xs flex flex-wrap items-center justify-between gap-2";
    icon.textContent = "💰";
    text.textContent = "وضع التحصيل الفعلي: يحسب النقدية المحصلة في الدرج والخزينة + دفعات سداد مديونيات العملاء، مع استبعاد الآجل غير المحصل.";
    badge.className = "bg-blue-200 text-blue-950 px-2.5 py-0.5 rounded-full font-black text-[10px]";
    badge.textContent = "الأساس النقدي (Cash Basis)";

    document.getElementById("c-revenue-title").textContent = "المقبوضات النقدية (الدرج)";
    document.getElementById("c-revenue").textContent = (d.revenue || 0).toFixed(2);
    document.getElementById("c-revenue-note").textContent = `مبيعات نقدية: ${(d.sales_cash_collected || 0).toFixed(2)} | سداد ديون: ${(d.debt_collected || 0).toFixed(2)}`;

    document.getElementById("c-gross-title").textContent = "الربح المحقق";
    document.getElementById("c-gross-note").textContent = "= أرباح المبالغ المحصلة فعلياً";

    document.getElementById("c-net-title").textContent = "صافي الربح الفعلي";
    document.getElementById("c-net-note").textContent = "= الربح المحقق − المصروفات";
  } else {
    banner.className = "bg-purple-50/90 border border-purple-200 rounded-2xl p-3 text-xs flex flex-wrap items-center justify-between gap-2";
    icon.textContent = "📋";
    text.textContent = "وضع شامل الآجل: يحسب كافة الفواتير الصادرة كأنها مدفوعة بالكامل، مع احتساب إجمالي الربح التقديري لكافة البضاعة المباعة.";
    badge.className = "bg-purple-200 text-purple-950 px-2.5 py-0.5 rounded-full font-black text-[10px]";
    badge.textContent = "أساس الاستحقاق (Accrual Basis)";

    document.getElementById("c-revenue-title").textContent = "إيراد المبيعات (الاستحقاق)";
    document.getElementById("c-revenue").textContent = (d.revenue || 0).toFixed(2);
    document.getElementById("c-revenue-note").textContent = "إجمالي كافة الفواتير الصادرة";

    document.getElementById("c-gross-title").textContent = "الربح الإجمالي";
    document.getElementById("c-gross-note").textContent = "= الصافي − التكلفة";

    document.getElementById("c-net-title").textContent = "صافي الربح التقديري";
    document.getElementById("c-net-note").textContent = "= إجمالي الربح − المصروفات";
  }

  const grossVal = parseFloat(d.gross_profit || 0);
  const grossEl = document.getElementById("c-gross");
  grossEl.textContent = grossVal.toFixed(2);
  grossEl.className = `text-2xl font-black ${grossVal >= 0 ? 'text-green-700' : 'text-red-600'}`;
  const grossCard = grossEl.closest('.rounded-2xl') || grossEl.parentElement;
  if (grossVal < 0) {
    grossCard.className = "bg-red-50 border border-red-200 rounded-2xl p-4 text-center transition-colors";
  } else {
    grossCard.className = "bg-green-50 border border-green-100 rounded-2xl p-4 text-center transition-colors";
  }

  document.getElementById("c-expenses").textContent = (d.expenses || summaryDataCache.expenses || 0).toFixed(2);
  document.getElementById("c-extra").textContent    = (d.extra_profit || summaryDataCache.extra_profit || 0).toFixed(2);
  const refundsBar  = document.getElementById("c-refunds-bar");
  const refundsNote = document.getElementById("c-refunds-note");
  const refundsVal  = document.getElementById("c-refunds-val");
  const refVal = parseFloat(d.refunds || summaryDataCache.refunds || 0);
  if (refVal > 0) {
    refundsBar.classList.remove("hidden");
    refundsVal.textContent  = `− ${refVal.toFixed(2)} جنيه`;
    refundsNote.textContent = `صافي: ${(d.net_revenue || 0).toFixed(2)}`;
    refundsNote.classList.remove("hidden");
  } else {
    refundsBar.classList.add("hidden");
    refundsNote.classList.add("hidden");
  }

  const netVal = parseFloat(d.net_profit || 0);
  const netEl = document.getElementById("c-net");
  netEl.textContent = netVal.toFixed(2);
  netEl.className = `text-2xl font-black ${netVal >= 0 ? 'text-purple-700' : 'text-red-700'}`;
  const splitEl = document.getElementById("c-net-split");
  if (splitEl) {
    if (netVal > 0) {
      const half = (netVal * 0.5).toFixed(0);
      splitEl.textContent = `🔄 50% لرأس المال: ${half} ج | 🏦 50% شخصي: ${half} ج`;
      splitEl.classList.remove("hidden");
    } else {
      splitEl.classList.add("hidden");
    }
  }

  const breakdown = document.getElementById("payBreakdown");
  const pList = d.payment_breakdown || [];
  if (!pList.length) {
    breakdown.innerHTML = '<div class="col-span-4 text-center text-gray-400 text-sm py-4">لا توجد حركات في هذه الفترة</div>';
  } else {
    breakdown.innerHTML = pList.map(r => `
      <div class="bg-gray-50 rounded-xl p-3 text-center border">
        <div class="text-sm font-medium text-gray-600">${r.label || PAYMENT_LABELS[r.payment_method] || r.payment_method}</div>
        <div class="text-xl font-bold text-gray-800 mt-1">${(parseFloat(r.total) || 0).toFixed(2)}</div>
        ${r.cnt ? `<div class="text-xs text-gray-400">${r.cnt} عملية</div>` : ''}
      </div>`).join("");
  }
}

// ── Detail Tabs ────────────────────────────────────────────────────────────
function switchDetailTab(tab) {
  currentDetailTab = tab;
  ["top-products","top-customers","hourly"].forEach(t => {
    const btn  = document.getElementById(`tab-${t}`);
    const pane = document.getElementById(`pane-${t}`);
    if (t === tab) {
      btn.className  = "detail-tab-btn flex-1 py-3 text-sm font-semibold text-blue-700 border-b-2 border-blue-700";
      pane.classList.remove("hidden");
    } else {
      btn.className  = "detail-tab-btn flex-1 py-3 text-sm font-semibold text-gray-400";
      pane.classList.add("hidden");
    }
  });
  loadDetailTab(tab);
}

async function loadDetailTab(tab) {
  if (tab === "top-products") {
    const res  = await fetch(`${BASE}/api/reports/top-products?period=${currentPeriod}`);
    const data = await res.json();
    const el   = document.getElementById("topProductsList");
    if (!data.length) { el.innerHTML = '<div class="text-center text-gray-400 py-6 text-sm">لا توجد بيانات</div>'; return; }
    const maxQty = Math.max(...data.map(r => r.total_qty));
    el.innerHTML = data.map((r,i) => `
      <div class="flex items-center gap-3">
        <div class="w-6 text-center text-xs font-bold text-gray-400">${i+1}</div>
        <div class="flex-1 min-w-0">
          <div class="flex items-center justify-between mb-1">
            <span class="text-sm font-semibold text-gray-800 truncate">${r.product_name}</span>
            <span class="text-sm font-black text-blue-700 mr-2 shrink-0">${r.total_qty} وحدة</span>
          </div>
          <div class="h-2 bg-gray-100 rounded-full overflow-hidden">
            <div class="h-2 bg-blue-500 rounded-full" style="width:${Math.round((r.total_qty/maxQty)*100)}%"></div>
          </div>
          <div class="text-xs text-gray-400 mt-0.5">إيراد: ${(r.total_revenue||0).toFixed(2)} جنيه</div>
        </div>
      </div>`).join("");
  } else if (tab === "top-customers") {
    const res  = await fetch(`${BASE}/api/reports/top-customers?period=${currentPeriod}`);
    const data = await res.json();
    const el   = document.getElementById("topCustomersList");
    if (!data.length) { el.innerHTML = '<div class="text-center text-gray-400 py-6 text-sm">لا توجد بيانات</div>'; return; }
    const maxSpent = Math.max(...data.map(r => r.total_spent));
    el.innerHTML = data.map((r,i) => `
      <div class="flex items-center gap-3">
        <div class="w-6 text-center text-xs font-bold text-gray-400">${i+1}</div>
        <div class="flex-1 min-w-0">
          <div class="flex items-center justify-between mb-1">
            <span class="text-sm font-semibold text-gray-800 truncate">${r.customer_name}</span>
            <span class="text-sm font-black text-green-700 mr-2 shrink-0">${(r.total_spent||0).toFixed(2)} ج</span>
          </div>
          <div class="h-2 bg-gray-100 rounded-full overflow-hidden">
            <div class="h-2 bg-green-500 rounded-full" style="width:${Math.round(((r.total_spent||0)/maxSpent)*100)}%"></div>
          </div>
          <div class="text-xs text-gray-400 mt-0.5">${r.order_count} طلب</div>
        </div>
      </div>`).join("");
  } else if (tab === "hourly") {
    const res  = await fetch(`${BASE}/api/reports/hourly?period=${currentPeriod}`);
    const data = await res.json();
    const el   = document.getElementById("hourlyChart");
    if (!data.length) { el.innerHTML = '<div class="text-center text-gray-400 py-6 text-sm">لا توجد بيانات</div>'; return; }
    const maxTotal = Math.max(...data.map(r => r.total));
    // Build a 24-hour grid with zeros for missing hours
    const byHour = {};
    data.forEach(r => byHour[r.hour] = r);
    const hours = Array.from({length:24}, (_,h) => String(h).padStart(2,"0"));
    el.innerHTML = `<div class="grid grid-cols-1 gap-1.5">` +
      hours.filter(h => byHour[h]).map(h => {
        const r = byHour[h];
        const pct = maxTotal > 0 ? Math.round((r.total / maxTotal) * 100) : 0;
        const label = parseInt(h) < 12 ? `${parseInt(h) || 12} ص` : `${parseInt(h)-12 || 12} م`;
        return `<div class="flex items-center gap-2">
          <div class="w-10 text-xs text-gray-500 text-left shrink-0">${label}</div>
          <div class="flex-1 h-6 bg-gray-100 rounded-lg overflow-hidden">
            <div class="h-6 bg-indigo-500 rounded-lg flex items-center px-2" style="width:${pct}%">
              ${pct > 15 ? `<span class="text-white text-xs font-bold">${r.total.toFixed(0)} ج</span>` : ''}
            </div>
          </div>
          <div class="w-14 text-xs text-gray-400 text-left shrink-0">${r.cnt} عملية</div>
        </div>`;
      }).join("") + `</div>`;
  }
}

// ── Expenses ───────────────────────────────────────────────────────────────
async function loadExpenses() {
  const res  = await fetch(`${BASE}/api/expenses?period=${currentPeriod}`);
  const data = await res.json();
  const tbody   = document.getElementById("expenseTable");
  const noMsg   = document.getElementById("noExpenses");
  const totalEl = document.getElementById("expensesTotal");
  if (!data.length) { tbody.innerHTML=""; noMsg.classList.remove("hidden"); totalEl.classList.add("hidden"); return; }
  noMsg.classList.add("hidden");
  const total = data.reduce((s,e) => s+e.amount, 0);
  totalEl.textContent = `الإجمالي: ${total.toFixed(2)} جنيه`;
  totalEl.classList.remove("hidden");
  tbody.innerHTML = data.map(e => `
    <tr class="hover:bg-gray-50">
      <td class="px-4 py-2.5 text-gray-800">${e.title}</td>
      <td class="px-4 py-2.5 font-bold text-red-600">${e.amount.toFixed(2)} جنيه</td>
      <td class="px-4 py-2.5 text-gray-500 text-xs">${e.date}</td>
      <td class="px-4 py-2.5">
        <button onclick="deleteExpense(${e.id})" class="text-xs text-red-400 hover:text-red-600 px-2 py-1 rounded hover:bg-red-50">حذف</button>
      </td>
    </tr>`).join("");
}

async function addExpense(ev) {
  ev.preventDefault();
  await fetch(`${BASE}/api/expenses`, {
    method:"POST", headers:{"Content-Type":"application/json"},
    body: JSON.stringify({
      title:  document.getElementById("e-title").value,
      amount: parseFloat(document.getElementById("e-amount").value),
      date:   document.getElementById("e-date").value || new Date().toISOString().split("T")[0]
    })
  });
  document.getElementById("e-title").value  = "";
  document.getElementById("e-amount").value = "";
  loadExpenses(); loadSummary(); loadCapitalDashboard();
}

async function deleteExpense(id) {
  if (!confirm("حذف هذا المصروف؟")) return;
  await fetch(`${BASE}/api/expenses/${id}`, { method:"DELETE" });
  loadExpenses(); loadSummary(); loadCapitalDashboard();
}

// ── Extra Profits ──────────────────────────────────────────────────────────
async function loadExtraProfit() {
  const res  = await fetch(`${BASE}/api/extra-profits?period=${currentPeriod}`);
  const data = await res.json();
  const tbody   = document.getElementById("extraProfitTable");
  const noMsg   = document.getElementById("noExtraProfit");
  const totalEl = document.getElementById("extraProfitTotal");
  if (!data.length) { tbody.innerHTML=""; noMsg.classList.remove("hidden"); totalEl.classList.add("hidden"); return; }
  noMsg.classList.add("hidden");
  const total = data.reduce((s,e) => s + parseFloat(e.amount), 0);
  totalEl.textContent = `الإجمالي: ${total.toFixed(2)} جنيه`;
  totalEl.classList.remove("hidden");
  tbody.innerHTML = data.map(e => `
    <tr class="hover:bg-yellow-50">
      <td class="px-4 py-2.5 text-gray-800">${e.title}</td>
      <td class="px-4 py-2.5 font-bold text-yellow-700">${parseFloat(e.amount).toFixed(2)} جنيه</td>
      <td class="px-4 py-2.5 text-gray-500 text-xs">${e.date}</td>
      <td class="px-4 py-2.5">
        <button onclick="deleteExtraProfit(${e.id})" class="text-xs text-red-400 hover:text-red-600 px-2 py-1 rounded hover:bg-red-50">حذف</button>
      </td>
    </tr>`).join("");
}

async function addExtraProfit(ev) {
  ev.preventDefault();
  await fetch(`${BASE}/api/extra-profits`, {
    method:"POST", headers:{"Content-Type":"application/json"},
    body: JSON.stringify({
      title:  document.getElementById("ep-title").value,
      amount: parseFloat(document.getElementById("ep-amount").value),
      date:   document.getElementById("ep-date").value || new Date().toISOString().split("T")[0]
    })
  });
  document.getElementById("ep-title").value  = "";
  document.getElementById("ep-amount").value = "";
  loadExtraProfit(); loadSummary(); loadCapitalDashboard();
}

async function deleteExtraProfit(id) {
  if (!confirm("حذف هذا الربح الإضافي؟")) return;
  await fetch(`${BASE}/api/extra-profits/${id}`, { method:"DELETE" });
  loadExtraProfit(); loadSummary(); loadCapitalDashboard();
}

// ── CSV & Excel Export ─────────────────────────────────────────────────────
function exportCSV(type) {
  const url = type === 'products'
    ? `${BASE}/api/export/excel?type=warehouse_full`
    : `${BASE}/api/export/csv?type=${type}&period=${currentPeriod}`;
  window.location.href = url;
}

// ── Capital, Assets & Growth Scale Dashboard ───────────────────────────────
let capitalDataCache = null;
let scaleChartView = "months";

function fmtEgp(n) {
  return (parseFloat(n) || 0).toLocaleString("en-US", { minimumFractionDigits: 0, maximumFractionDigits: 2 });
}
function escHtml(s) {
  return String(s == null ? "" : s).replace(/[&<>"]/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", "\"": "&quot;" }[c]));
}

async function loadCapitalDashboard(refreshRates = false) {
  try {
    const res = await fetch(`${BASE}/api/accounting/capital${refreshRates ? "?refresh_rates=1" : ""}`);
    const d = await res.json();
    if (!res.ok || d.error) return;
    capitalDataCache = d;
    renderCapitalDashboard(d);
  } catch (err) {
    console.error("Capital load err:", err);
  }
}

function renderCapitalDashboard(d) {
  const b = d.breakdown || {};
  const r = d.rates || {};
  const sc = d.scale_metrics || {};

  document.getElementById("cap-total-cost").textContent = fmtEgp(d.total_capital_cost);
  document.getElementById("cap-total-retail").textContent = fmtEgp(d.total_capital_retail);

  // Stacked bar widths
  document.getElementById("bar-inv").style.width = `${b.inventory_pct || 0}%`;
  document.getElementById("bar-wh").style.width = `${b.warehouse_pct || 0}%`;
  document.getElementById("bar-debt").style.width = `${b.debts_pct || 0}%`;
  document.getElementById("bar-assets").style.width = `${b.assets_pct || 0}%`;

  // Breakdown cards
  document.getElementById("cap-inv-val").textContent = fmtEgp(b.inventory_cost) + " ج";
  document.getElementById("cap-inv-pct").textContent = (b.inventory_pct || 0) + "%";
  document.getElementById("cap-inv-retail").textContent = fmtEgp(b.inventory_retail);

  document.getElementById("cap-wh-val").textContent = fmtEgp(b.warehouse_cost) + " ج";
  document.getElementById("cap-wh-pct").textContent = (b.warehouse_pct || 0) + "%";
  document.getElementById("cap-wh-retail").textContent = fmtEgp(b.warehouse_retail);

  document.getElementById("cap-debt-val").textContent = fmtEgp(b.customer_debts) + " ج";
  document.getElementById("cap-debt-pct").textContent = (b.debts_pct || 0) + "%";
  document.getElementById("cap-debt-cnt").textContent = `${b.debtors_count || 0} دكتور`;
  const debtPct = parseFloat(b.debts_pct || 0);
  const riskEl = document.getElementById("cap-debt-risk");
  if (debtPct >= 40) { riskEl.textContent = "🔴 مرتفعة"; riskEl.className = "font-bold text-red-300"; }
  else if (debtPct >= 25) { riskEl.textContent = "🟡 متوسطة"; riskEl.className = "font-bold text-amber-200"; }
  else { riskEl.textContent = "🟢 آمنة"; riskEl.className = "font-bold text-emerald-300"; }

  document.getElementById("cap-assets-val").textContent = fmtEgp(b.assets_value) + " ج";
  document.getElementById("cap-assets-pct").textContent = (b.assets_pct || 0) + "%";
  const aGain = parseFloat(b.assets_gain || 0);
  const gainEl = document.getElementById("cap-assets-gain");
  gainEl.textContent = `${aGain >= 0 ? "+" : ""}${fmtEgp(aGain)} ج فرق سعر`;
  gainEl.className = `text-[11px] mt-0.5 font-bold ${aGain >= 0 ? "text-emerald-300" : "text-red-300"}`;

  // Top Scale badge
  const mPct = parseFloat(sc.monthly_growth_pct || 0);
  const mChg = parseFloat(sc.monthly_change_egp || 0);
  const badge = document.getElementById("cap-scale-badge");
  if (sc.status === "growing") {
    badge.className = "px-3.5 py-1.5 rounded-2xl text-xs font-black bg-emerald-500/25 border border-emerald-400/50 text-emerald-200";
    badge.textContent = `📈 الشركة بتكبر (${mPct >= 0 ? "+" : ""}${mPct}%)`;
  } else if (sc.status === "shrinking") {
    badge.className = "px-3.5 py-1.5 rounded-2xl text-xs font-black bg-red-500/25 border border-red-400/50 text-red-200";
    badge.textContent = `📉 تراجع (${mPct}%)`;
  } else {
    badge.className = "px-3.5 py-1.5 rounded-2xl text-xs font-black bg-white/15 border border-white/25 text-slate-200";
    badge.textContent = `⚖️ استقرار (${mPct >= 0 ? "+" : ""}${mPct}%)`;
  }
  document.getElementById("cap-scale-sub").textContent = `التغيّر هذا الشهر: ${mChg >= 0 ? "+" : ""}${fmtEgp(mChg)} ج`;

  // Scale pills below chart
  document.getElementById("scale-pct-val").textContent = `${mPct >= 0 ? "+" : ""}${mPct}%`;
  document.getElementById("scale-pct-val").className = `text-lg font-black mt-0.5 ${mPct >= 0 ? "text-emerald-700" : "text-red-600"}`;
  document.getElementById("scale-egp-val").textContent = `${mChg >= 0 ? "+" : ""}${fmtEgp(mChg)} ج عن الشهر السابق`;

  const opsP = parseFloat(sc.current_month_profit || 0);
  const reinvP = parseFloat(sc.current_month_reinvested || 0);
  const ownerP = parseFloat(sc.current_month_owner_share || 0);
  document.getElementById("scale-ops-profit").textContent = `${opsP >= 0 ? "+" : ""}${fmtEgp(opsP)} ج`;
  document.getElementById("scale-reinvest-val").textContent = `${reinvP >= 0 ? "+" : ""}${fmtEgp(reinvP)} ج`;
  document.getElementById("scale-owner-val").textContent = `${fmtEgp(ownerP)} ج`;
  document.getElementById("scale-assets-gain").textContent = `${aGain >= 0 ? "+" : ""}${fmtEgp(aGain)} ج`;

  // Rates box
  document.getElementById("rate-24").textContent = fmtEgp(r.gold_24) + " ج";
  document.getElementById("rate-21").textContent = fmtEgp(r.gold_21) + " ج";
  document.getElementById("rate-18").textContent = fmtEgp(r.gold_18) + " ج";
  document.getElementById("rate-pound").textContent = fmtEgp(r.gold_pound) + " ج";
  document.getElementById("rate-usd").textContent = fmtEgp(r.usd_egp) + " ج";
  document.getElementById("rate-source").textContent = r.source || "—";
  document.getElementById("rate-updated").textContent = r.updated_at ? r.updated_at.slice(0, 16).replace("T", " ") : "";
  document.getElementById("inp-rate-21").value = r.gold_21 || "";
  document.getElementById("inp-rate-usd").value = r.usd_egp || "";

  // Assets holdings summary
  const sm = d.assets_summary || {};
  const parts = [];
  if (sm.gold_grams_24 > 0) parts.push(`عيار 24: <b>${sm.gold_grams_24} جم</b>`);
  if (sm.gold_grams_21 > 0) parts.push(`عيار 21: <b>${sm.gold_grams_21} جم</b>`);
  if (sm.gold_grams_18 > 0) parts.push(`عيار 18: <b>${sm.gold_grams_18} جم</b>`);
  if (sm.gold_grams_pound > 0) parts.push(`جنيه دهب: <b>${sm.gold_grams_pound} جم</b>`);
  if (sm.total_usd > 0) parts.push(`دولار: <b>$${fmtEgp(sm.total_usd)}</b>`);
  if (sm.real_estate_value > 0) parts.push(`عقارات: <b>${fmtEgp(sm.real_estate_value)} ج</b>`);
  const sumEl = document.getElementById("assets-holdings-summary");
  if (parts.length) {
    sumEl.innerHTML = "الرصيد: " + parts.join(" · ");
    sumEl.classList.remove("hidden");
  } else {
    sumEl.classList.add("hidden");
  }

  // Assets list
  const listEl = document.getElementById("assets-list");
  const assets = d.assets || [];
  if (!assets.length) {
    listEl.innerHTML = '<div class="text-center text-gray-400 py-5">لا توجد أصول مسجلة بعد — أضف دهب أو دولار أو عقار أعلاه</div>';
  } else {
    const karatLabel = k => k === 218 ? "جنيه دهب (عيار 21)" : `دهب عيار ${k}`;
    listEl.innerHTML = assets.map(a => {
      let title = "";
      if (a.asset_type === "gold") {
        title = `🪙 ${karatLabel(a.karat)} — ${a.weight_grams} جرام`;
      } else if (a.asset_type === "usd") {
        title = `💵 $${fmtEgp(a.usd_amount)}`;
      } else {
        const modeTxt = parseFloat(a.manual_current_value_egp || 0) > 0
          ? "تقييم يدوي"
          : `نمو سنوي ${a.annual_growth_pct || 0}%`;
        title = `🏢 ${escHtml(a.notes || "عقار / مقر الشركة")} (${modeTxt})`;
      }
      const diff = parseFloat(a.profit_loss_egp || 0);
      const diffCls = diff >= 0 ? "text-emerald-700" : "text-red-600";
      const revalBtn = a.asset_type === "real_estate"
        ? `<button type="button" onclick="editRealEstateValuation(${a.id}, ${a.current_value_egp}, ${a.annual_growth_pct || 0}, ${a.manual_current_value_egp || 0})" class="text-blue-600 hover:text-blue-800 px-1.5 py-1 rounded hover:bg-blue-50 text-[11px] font-bold" title="تعديل التقييم">✏️ تقييم</button>`
        : "";
      return `
        <div class="py-2.5 flex items-center justify-between gap-2">
          <div class="min-w-0">
            <div class="font-bold text-gray-800">${title}</div>
            <div class="text-[11px] text-gray-400">
              شراء: ${fmtEgp(a.purchase_total_egp)} ج (${escHtml(a.purchase_date)})${a.asset_type !== "real_estate" && a.notes ? " · " + escHtml(a.notes) : ""}
            </div>
          </div>
          <div class="text-left shrink-0 flex items-center gap-1.5">
            <div>
              <div class="font-black text-gray-900">${fmtEgp(a.current_value_egp)} ج</div>
              <div class="text-[11px] font-bold ${diffCls}">${diff >= 0 ? "+" : ""}${fmtEgp(diff)} ج (${a.profit_loss_pct >= 0 ? "+" : ""}${a.profit_loss_pct}%)</div>
            </div>
            ${revalBtn}
            <button type="button" onclick="deleteCompanyAsset(${a.id})" class="text-red-400 hover:text-red-600 px-1.5 py-1 rounded hover:bg-red-50" title="حذف">🗑</button>
          </div>
        </div>`;
    }).join("");
  }

  renderScaleChart();
}

function setScaleChartView(v) {
  scaleChartView = v;
  const bm = document.getElementById("scaleBtnMonths");
  const bd = document.getElementById("scaleBtnDaily");
  bm.className = v === "months" ? "px-3 py-1 rounded-lg bg-blue-700 text-white shadow" : "px-3 py-1 rounded-lg text-gray-600";
  bd.className = v === "daily" ? "px-3 py-1 rounded-lg bg-blue-700 text-white shadow" : "px-3 py-1 rounded-lg text-gray-600";
  renderScaleChart();
}

function renderScaleChart() {
  const box = document.getElementById("scale-svg-container");
  if (!capitalDataCache) return;
  const raw = scaleChartView === "daily"
    ? (capitalDataCache.snapshots || []).map(s => ({ label: String(s.snapshot_date).slice(5), val: parseFloat(s.total_capital_egp || 0), sub: null, reinv: null }))
    : (capitalDataCache.growth_series || []).map(m => ({ label: m.label, val: parseFloat(m.capital || 0), sub: parseFloat(m.net_profit || 0), reinv: parseFloat(m.reinvested_profit || 0) }));

  if (!raw.length) {
    box.innerHTML = '<span class="text-xs text-gray-400">لا توجد بيانات كافية للرسم بعد</span>';
    return;
  }

  const W = 560, H = 200, padL = 54, padR = 24, padT = 24, padB = 34;
  const vals = raw.map(p => p.val);
  let minV = Math.min(...vals), maxV = Math.max(...vals);
  if (minV === maxV) { minV = Math.max(0, minV * 0.9); maxV = maxV * 1.1 || 100; }
  const margin = (maxV - minV) * 0.15;
  minV = Math.max(0, minV - margin);
  maxV = maxV + margin;

  const xFor = i => raw.length === 1 ? (padL + (W - padL - padR) / 2) : padL + (i / (raw.length - 1)) * (W - padL - padR);
  const yFor = v => padT + (1 - (v - minV) / (maxV - minV || 1)) * (H - padT - padB);

  const pts = raw.map((p, i) => ({ ...p, x: xFor(i), y: yFor(p.val) }));
  const lineD = pts.map((p, i) => `${i === 0 ? "M" : "L"}${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(" ");
  const areaD = `${lineD} L${pts[pts.length - 1].x.toFixed(1)},${(H - padB).toFixed(1)} L${pts[0].x.toFixed(1)},${(H - padB).toFixed(1)} Z`;

  const isUp = pts[pts.length - 1].val >= pts[0].val;
  const stroke = isUp ? "#059669" : "#dc2626";
  const fillGrad = isUp ? "rgba(16,185,129,0.18)" : "rgba(239,68,68,0.18)";

  const gridYs = [0, 0.5, 1].map(t => {
    const v = minV + t * (maxV - minV);
    const y = yFor(v);
    const lbl = v >= 1000 ? `${(v / 1000).toFixed(0)}k` : v.toFixed(0);
    return `<line x1="${padL}" y1="${y}" x2="${W - padR}" y2="${y}" stroke="#e2e8f0" stroke-dasharray="3,3"/>
            <text x="${padL - 6}" y="${y + 4}" text-anchor="end" font-size="10" fill="#64748b">${lbl}</text>`;
  }).join("");

  const dots = pts.map(p => {
    const valLbl = p.val >= 1000 ? `${(p.val / 1000).toFixed(1)}k` : p.val.toFixed(0);
    return `<circle cx="${p.x}" cy="${p.y}" r="4.5" fill="#fff" stroke="${stroke}" stroke-width="2.5">
              <title>${p.label}: ${fmtEgp(p.val)} ج${p.sub != null ? " | ربح التشغيل: " + fmtEgp(p.sub) + " ج | ضخ 50%: " + fmtEgp(p.reinv) + " ج" : ""}</title>
            </circle>
            <text x="${p.x}" y="${p.y - 10}" text-anchor="middle" font-size="10" font-weight="bold" fill="#0f172a">${valLbl}</text>
            <text x="${p.x}" y="${H - 12}" text-anchor="middle" font-size="10" fill="#475569">${escHtml(p.label)}</text>`;
  }).join("");

  box.innerHTML = `<svg viewBox="0 0 ${W} ${H}" class="w-full h-auto overflow-visible" dir="ltr">
    ${gridYs}
    <path d="${areaD}" fill="${fillGrad}"/>
    <path d="${lineD}" fill="none" stroke="${stroke}" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
    ${dots}
  </svg>`;
}

function toggleAssetTypeFields() {
  const t = document.getElementById("asset-type").value;
  document.getElementById("asset-gold-fields").classList.toggle("hidden", t !== "gold");
  document.getElementById("asset-usd-fields").classList.toggle("hidden", t !== "usd");
  document.getElementById("asset-realestate-fields").classList.toggle("hidden", t !== "real_estate");
  document.getElementById("asset-fill-today-btn").classList.toggle("hidden", t === "real_estate");
  document.getElementById("asset-cost").placeholder = t === "real_estate" ? "سعر شراء المكان (ج)" : "سعر الشراء الكلي (ج)";
  document.getElementById("asset-notes").placeholder = t === "real_estate" ? "اسم العقار (مثلاً مقر شركة DenTrust)" : "ملاحظة (مثلاً سبيكة BTC)";
}

function onAssetKaratChange() {
  const k = document.getElementById("asset-karat").value;
  document.getElementById("gold-pound-helper").classList.toggle("hidden", k !== "218");
}

function addGoldPoundWeight() {
  const el = document.getElementById("asset-grams");
  el.value = ((parseFloat(el.value) || 0) + 8).toFixed(2);
}

function fillAssetCurrentCost() {
  if (!capitalDataCache?.rates) return;
  const r = capitalDataCache.rates;
  const t = document.getElementById("asset-type").value;
  if (t === "gold") {
    const k = parseInt(document.getElementById("asset-karat").value, 10);
    const g = parseFloat(document.getElementById("asset-grams").value) || 0;
    const rate = k === 24 ? r.gold_24 : (k === 18 ? r.gold_18 : r.gold_21);
    document.getElementById("asset-cost").value = (g * rate).toFixed(2);
  } else if (t === "usd") {
    const u = parseFloat(document.getElementById("asset-usd").value) || 0;
    document.getElementById("asset-cost").value = (u * (r.usd_egp || 0)).toFixed(2);
  }
}

async function saveCapitalRates() {
  const g21 = parseFloat(document.getElementById("inp-rate-21").value);
  const usd = parseFloat(document.getElementById("inp-rate-usd").value);
  const res = await fetch(`${BASE}/api/accounting/capital/rates`, {
    method: "POST", headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ mode: "manual", gold_21_egp: g21, usd_egp: usd })
  });
  const data = await res.json();
  if (!res.ok) { alert(data.error || "خطأ في حفظ الأسعار"); return; }
  await loadCapitalDashboard(false);
}

async function refreshCapitalRates() {
  const btn = document.getElementById("btnRefreshRates");
  btn.disabled = true; btn.textContent = "جاري التحديث...";
  try {
    await fetch(`${BASE}/api/accounting/capital/rates`, {
      method: "POST", headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ mode: "auto" })
    });
    await loadCapitalDashboard(false);
  } finally {
    btn.disabled = false; btn.textContent = "🔄 تحديث تلقائي";
  }
}

async function addCompanyAsset(ev) {
  ev.preventDefault();
  const type = document.getElementById("asset-type").value;
  const body = {
    asset_type: type,
    karat: parseInt(document.getElementById("asset-karat").value, 10),
    weight_grams: parseFloat(document.getElementById("asset-grams").value) || 0,
    usd_amount: parseFloat(document.getElementById("asset-usd").value) || 0,
    annual_growth_pct: parseFloat(document.getElementById("asset-growth-pct").value),
    purchase_total_egp: parseFloat(document.getElementById("asset-cost").value) || 0,
    purchase_date: document.getElementById("asset-date").value,
    notes: document.getElementById("asset-notes").value
  };
  const res = await fetch(`${BASE}/api/accounting/capital/assets`, {
    method: "POST", headers: { "Content-Type": "application/json" },
    body: JSON.stringify(body)
  });
  const data = await res.json();
  if (!res.ok) { alert(data.error || "تعذر إضافة الأصل"); return; }
  document.getElementById("asset-grams").value = "";
  document.getElementById("asset-usd").value = "";
  document.getElementById("asset-cost").value = "";
  document.getElementById("asset-notes").value = "";
  await loadCapitalDashboard(false);
}

function editRealEstateValuation(id, curVal, curPct, manualVal) {
  const ov = document.createElement("div");
  ov.className = "fixed inset-0 bg-black/50 flex items-center justify-center z-[100] p-4";
  ov.innerHTML = `
    <div dir="rtl" class="bg-white rounded-3xl shadow-2xl w-full max-w-sm p-6 space-y-4">
      <h3 class="font-extrabold text-gray-900 text-base">🏢 تحديث تقييم العقار</h3>
      <div>
        <label class="text-xs font-semibold text-gray-600 block mb-1">القيمة السوقية الحالية يدوياً (ج) — اكتب 0 للرجوع للحساب التلقائي</label>
        <input id="re-manual" type="number" min="0" step="100" value="${manualVal > 0 ? manualVal : curVal}"
          class="w-full border rounded-xl px-3 py-2 text-sm font-bold"/>
      </div>
      <div>
        <label class="text-xs font-semibold text-gray-600 block mb-1">نسبة الزيادة السنوية التلقائية (%)</label>
        <input id="re-pct" type="number" min="0" step="0.5" value="${curPct}"
          class="w-full border rounded-xl px-3 py-2 text-sm font-bold"/>
      </div>
      <div class="flex gap-2 pt-1">
        <button id="re-save" class="flex-1 bg-blue-700 hover:bg-blue-800 text-white font-bold py-2.5 rounded-xl text-xs">✅ حفظ</button>
        <button id="re-auto" class="flex-1 bg-amber-100 hover:bg-amber-200 text-amber-900 font-bold py-2.5 rounded-xl text-xs">🔄 حساب تلقائي</button>
        <button id="re-cancel" class="px-3 bg-gray-100 text-gray-600 font-semibold py-2.5 rounded-xl text-xs">إلغاء</button>
      </div>
    </div>`;
  document.body.appendChild(ov);
  ov.querySelector("#re-cancel").onclick = () => ov.remove();
  const submitVal = async (useAuto) => {
    const manual = useAuto ? 0 : (parseFloat(ov.querySelector("#re-manual").value) || 0);
    const pct = parseFloat(ov.querySelector("#re-pct").value);
    const r = await fetch(`${BASE}/api/accounting/capital/assets/${id}`, {
      method: "PUT", headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ manual_current_value_egp: manual, annual_growth_pct: isNaN(pct) ? 20 : pct })
    });
    if (!r.ok) { alert("تعذر تحديث التقييم"); return; }
    ov.remove();
    await loadCapitalDashboard(false);
  };
  ov.querySelector("#re-save").onclick = () => submitVal(false);
  ov.querySelector("#re-auto").onclick = () => submitVal(true);
}

async function deleteCompanyAsset(id) {
  if (!confirm("حذف هذا الأصل من المحفظة؟")) return;
  await fetch(`${BASE}/api/accounting/capital/assets/${id}`, { method: "DELETE" });
  await loadCapitalDashboard(false);
}

document.getElementById("e-date").value  = new Date().toISOString().split("T")[0];
document.getElementById("ep-date").value = new Date().toISOString().split("T")[0];
document.getElementById("asset-date").value = new Date().toISOString().split("T")[0];
document.getElementById("p-today").classList.add("active");
loadCapitalDashboard();
loadSummary();
loadExpenses();
loadExtraProfit();
loadDetailTab("top-products");
</script>

