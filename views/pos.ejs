let _appliedPromo = null;
async function applyPromoCode() {
  const code = (document.getElementById("promoCodeInput").value || '').trim();
  if (!code) {
    alert("يرجى إدخال كود الخصم أولاً");
    return;
  }
  const subtotal = cart.reduce((s,i) => s + i.unit_price * i.quantity, 0);
  const btn = document.getElementById("applyPromoBtn");
  btn.disabled = true;
  btn.textContent = "...";
  try {
    const res = await fetch(`${BASE}/api/promo/validate`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ code, total_amount: subtotal })
    });
    const data = await res.json();
    if (!res.ok) throw new Error(data.error || "كود الخصم غير صحيح");
    _appliedPromo = data.promo;
    const badge = document.getElementById("promoBadge");
    badge.textContent = `✅ خصم ${_appliedPromo.discount_amount} ج (${_appliedPromo.code})`;
