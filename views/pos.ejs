  "مطروح": ["مرسى مطروح", "العلمين", "الحمام", "الساحل الشمالي", "مارينا", "سيدي عبد الرحمن"],
  "جنوب سيناء": ["شرم الشيخ", "طور سيناء", "دهب", "نويبع", "طابا", "رأس سدر"],
