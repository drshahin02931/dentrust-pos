      if (qMap[p.id] !== undefined && qMap[p.id] !== p.quantity) {
        p.quantity = qMap[p.id];
        changed = true;
      }
    });
    if (changed) refreshAllCardUIs();
  } catch(e) {}
}, 3000);

// ── Online Order Bell Notification ───────────────────────────────────────────
let _lastAlertCount = null;
let _toastTimer     = null;

function playBellSound() {
  try {
    const ctx = new (window.AudioContext || window.webkitAudioContext)();
    const tone = (freq, start, dur, vol = 0.45) => {
      const o = ctx.createOscillator();
      const g = ctx.createGain();
      o.connect(g); g.connect(ctx.destination);
      o.frequency.value = freq;
      o.type = 'sine';
      g.gain.setValueAtTime(vol, ctx.currentTime + start);
      g.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + start + dur);
      o.start(ctx.currentTime + start);
      o.stop(ctx.currentTime + start + dur + 0.05);
    };
    tone(880,  0,    0.30);
    tone(1100, 0.18, 0.30);
    tone(880,  0.40, 0.55);
  } catch(e) {}
}

function showOrderToast(order) {
  const toast = document.getElementById('pos-order-toast');
  const body  = document.getElementById('pos-order-toast-body');
  if (!toast || !body) return;
  body.textContent = order
    ? `${order.customer_name || 'عميل'} — ${order.items_summary || '—'} — ${parseFloat(order.total_amount || 0).toFixed(2)} ج`
    : 'تحقق من طلبات الموقع';
  toast.style.display = 'flex';
  toast.style.animation = 'none';
  void toast.offsetWidth;
  toast.style.animation = 'posToastSlide 0.4s ease';
  clearTimeout(_toastTimer);
  _toastTimer = setTimeout(() => { toast.style.display = 'none'; }, 9000);
}

setInterval(async () => {
  try {
    const r = await fetch(`${BASE}/api/website-orders/alerts/count`);
    if (!r.ok) return;
    const { count } = await r.json();
    if (_lastAlertCount === null) { _lastAlertCount = count; return; }
    if (count > _lastAlertCount) {
      _lastAlertCount = count;
      playBellSound();
      try {
        const r2 = await fetch(`${BASE}/api/website-orders/alerts`);
        if (r2.ok) { const orders = await r2.json(); showOrderToast(orders[0] || null); }
        else showOrderToast(null);
      } catch(e) { showOrderToast(null); }
    } else {
      _lastAlertCount = count;
    }
  } catch(e) {}
}, 3000);

// ── Product Search ────────────────────────────────────────────────────────────
const scanInput = document.getElementById("scanInput");
const suggestions = document.getElementById("suggestions");

scanInput.addEventListener("input", () => {
  clearTimeout(searchTimeout);
  const q = scanInput.value.trim();
  if (!q) { suggestions.classList.add("hidden"); return; }
  searchTimeout = setTimeout(() => searchProducts(q), 180);
});

scanInput.addEventListener("keydown", e => {
  if (e.key === "Enter") {
    const q = scanInput.value.trim();
    if (!q) return;
    clearTimeout(searchTimeout);
    fetch(`${BASE}/api/products?q=${encodeURIComponent(q)}`).then(r=>r.json()).then(data => {
      suggestions.classList.add("hidden");
      if (data.length === 1) {
        // If the product has variants, open the picker instead of adding directly
        const _scanProd = data[0];
        const _scanV    = parseVariants(_scanProd);
        if (_scanV && _scanV.sizes && _scanV.sizes.length > 0) {
          openVariantPicker(_scanProd, _scanV);
        } else {
          addToCart(_scanProd);
        }
        scanInput.value = "";
      }
      else if (data.length > 1) showSuggestions(data);
      else alert("لم يتم العثور على المنتج");
    });
  }
});

document.addEventListener("click", e => {
  if (!suggestions.contains(e.target) && e.target !== scanInput) suggestions.classList.add("hidden");
});

function searchProducts(q) {
  const url = q ? `${BASE}/api/products?q=${encodeURIComponent(q)}` : `${BASE}/api/products`;
  fetch(url).then(r=>r.json()).then(data => {
    if (posSelectedCategory) {
      data = data.filter(p => p.category === posSelectedCategory);
    }
    if (!data.length) { suggestions.classList.add("hidden"); return; }
    showSuggestions(data);
  });
}

function showSuggestions(data) {
  suggCache = {};
  data.slice(0,8).forEach(p => suggCache[p.id] = p);
  suggestions.innerHTML = data.slice(0,8).map(p => `
    <div onclick="pickProduct(${p.id})"
      class="px-4 py-2.5 hover:bg-blue-50 cursor-pointer flex justify-between items-center text-sm">
      <div>
        <span class="font-medium">${p.product_name}</span>
        ${p.quantity<=0 ? '<span class="text-xs text-red-500 mr-2">نفذ</span>' :
          p.quantity<=5 ? `<span class="text-xs text-orange-500 mr-2">(${p.quantity} متبقي)</span>` : ''}
      </div>
      <span class="text-blue-700 font-bold">${p.sale_price.toFixed(2)} جنيه</span>
    </div>
  `).join("");
  suggestions.classList.remove("hidden");
}

function pickProduct(id) {
  const p = suggCache[id];
  if (!p) return;
  suggestions.classList.add("hidden");
  scanInput.value = "";
  scanInput.focus();
  const v = parseVariants(p);
  if (v && v.sizes && v.sizes.length > 0) { openVariantPicker(p, v); return; }
  addToCart(p);
}

// ── Variant Picker ────────────────────────────────────────────────────────────
let _vpProduct   = null;
let _vpVariants  = null;
let _vpSelSize   = null;
let _vpSelCbKey  = null;
let _vpSelColor  = null;
let _vpQty       = 1;

function parseVariants(p) {
  if (p.variants) {
    try {
      const v = typeof p.variants === 'string' ? JSON.parse(p.variants) : p.variants;
      if (v && v.items && v.items.length > 0) {
        return { sizes: v.items.map(item => ({ label: item.label, qty: item.qty })) };
      }
      if (v && v.sizes && v.sizes.length > 0) return v;
    } catch(e) {}
  }
  if (p.checkbox_values) {
    try {
      const cv = typeof p.checkbox_values === 'string' ? JSON.parse(p.checkbox_values) : p.checkbox_values;
      const sizes = [];
      Object.entries(cv).forEach(([key, val]) => {
        if (typeof val === 'object' && val !== null && !key.includes('::') && val.stock == null) {
          Object.entries(val).forEach(([subKey, subVal]) => {
            if (typeof subVal === 'object' && subVal !== null) {
              const checked = subVal.checked ?? true;
              const disabled = subVal.disabled ?? false;
              if (!checked || disabled) return;
              const stock = subVal.stock != null ? parseInt(subVal.stock) : (p.quantity || 0);
              const costPrice = (subVal.cost_price != null && parseFloat(subVal.cost_price) > 0)
              const salePrice = (subVal.sale_price != null && parseFloat(subVal.sale_price) > 0)
                ? parseFloat(subVal.sale_price)
                : parseFloat(p.sale_price || 0);
              sizes.push({ label: subKey, qty: stock, cost_price: costPrice, sale_price: salePrice, _cbKey: `${key}::${subKey}`, group: key });
            }
          });
          return;
        }
        const sep = key.indexOf('::');
        if (sep === -1) return;
        const group    = key.slice(0, sep);
        const label    = key.slice(sep + 2);
        const checked  = typeof val === 'boolean' ? val : (val?.checked ?? false);
        const disabled = typeof val === 'object'  ? (val?.disabled ?? false) : false;
        if (!checked || disabled) return;
        const stock = (typeof val === 'object' && val?.stock !== null && val?.stock !== undefined)
          ? parseInt(val.stock)
          : (p.quantity || 0);
        const costPrice = (typeof val === 'object' && val?.cost_price != null && parseFloat(val.cost_price) > 0)
          ? parseFloat(val.cost_price)
          : parseFloat(p.purchase_price || 0);
        const salePrice = (typeof val === 'object' && val?.sale_price != null && parseFloat(val.sale_price) > 0)
          ? parseFloat(val.sale_price)
          : parseFloat(p.sale_price || 0);
        sizes.push({ label, qty: stock, cost_price: costPrice, sale_price: salePrice, _cbKey: key, group });
      });
      if (sizes.length > 0) return { sizes };
    } catch(e) {}
  }
  return null;
}

function openVariantPicker(product, variants) {
  _vpProduct  = product;
  _vpVariants = variants;
  _vpSelSize  = null;
  _vpSelCbKey = null;
  _vpSelColor = null;
  _vpQty      = 1;

  document.getElementById("vp-name").textContent  = product.product_name;
  document.getElementById("vp-price").textContent = product.sale_price.toFixed(2) + " جنيه";
  document.getElementById("vp-size-err").classList.add("hidden");
  document.getElementById("vp-stock-info").classList.add("hidden");
  document.getElementById("vp-qty-row").classList.add("hidden");

  // Sizes
  renderVPSizes();

  // Colors
  const colorSec = document.getElementById("vp-colors-section");
  if (variants.colors && variants.colors.length > 0) {
    colorSec.classList.remove("hidden");
    renderVPColors();
  } else { colorSec.classList.add("hidden"); }

  document.getElementById("variantModal").classList.remove("hidden");
}

function closeVariantPicker() {
  document.getElementById("variantModal").classList.add("hidden");
  _vpProduct = _vpVariants = _vpSelSize = _vpSelColor = _vpSelCbKey = null;
  _vpQty = 1;
}

function _renderSizeBtn(s) {
  const outOfStock = s.qty <= 0;
  const lowStock   = !outOfStock && s.qty <= 2;
  const selected   = _vpSelSize === s._cbKey;
  let btnClass, qtyClass;
  if (selected)       { btnClass = 'border-blue-600 bg-blue-600 text-white shadow-lg scale-105';        qtyClass = 'text-blue-100'; }
  else if (outOfStock){ btnClass = 'border-gray-200 text-gray-300 bg-gray-50 cursor-not-allowed';        qtyClass = 'text-red-400'; }
  else if (lowStock)  { btnClass = 'border-orange-400 text-orange-700 bg-orange-50 hover:bg-orange-100'; qtyClass = 'text-orange-500 font-bold'; }
  else                { btnClass = 'border-gray-200 text-gray-700 bg-white hover:border-blue-400 hover:bg-blue-50'; qtyClass = 'text-gray-400'; }
  const key = (s._cbKey || s.label).replace(/\\/g,'\\\\').replace(/'/g,"\\'");
  return `<button type="button" onclick="selectVPSize('${key}')" ${outOfStock ? 'disabled' : ''}
    class="relative flex flex-col items-center justify-center min-w-[4rem] px-4 py-3 rounded-2xl border-2 font-bold text-sm transition-all ${btnClass}">
    <span class="text-base">${s.label}${lowStock ? ' ⚠️' : ''}</span>
    <span class="text-xs font-normal mt-0.5 ${qtyClass}">${outOfStock ? 'نفذ' : s.qty + ' قطعة'}</span>
  </button>`;
}

function renderVPSizes() {
  const sizes = _vpVariants.sizes || [];
  const hasGroups = sizes.some(s => s.group);
  const container = document.getElementById("vp-sizes");

  if (hasGroups) {
    // Build ordered group map preserving insertion order
    const groupMap = {};
    const groupOrder = [];
    sizes.forEach(s => {
      const g = s.group || '';
      if (!groupMap[g]) { groupMap[g] = []; groupOrder.push(g); }
      groupMap[g].push(s);
    });
    container.style.flexDirection = 'column';
    container.innerHTML = groupOrder.map(g => `
      <div style="width:100%;margin-bottom:0.75rem;">
        <div style="font-size:0.7rem;font-weight:700;color:#6b7280;text-transform:uppercase;letter-spacing:0.06em;margin-bottom:0.4rem;border-bottom:1px solid #e5e7eb;padding-bottom:2px;">${g}</div>
        <div style="display:flex;flex-wrap:wrap;gap:0.5rem;margin-top:0.4rem;">
          ${groupMap[g].map(s => _renderSizeBtn(s)).join('')}
        </div>
      </div>`).join('');
  } else {
    container.style.flexDirection = '';
    container.innerHTML = sizes.map(s => _renderSizeBtn(s)).join('');
  }
}

function renderVPColors() {
  const colors = _vpVariants.colors || [];
  document.getElementById("vp-colors").innerHTML = colors.map(c => {
    const selected = _vpSelColor === c;
    return `<button type="button" onclick="selectVPColor('${c.replace(/'/g,"\\'")}')"
      class="px-4 py-2 rounded-full border-2 text-sm font-semibold transition-all
        ${selected ? 'border-blue-600 bg-blue-600 text-white' : 'border-gray-200 text-gray-700 bg-white hover:border-blue-400'}">
      ${c}
    </button>`;
  }).join("");
}

function selectVPSize(key) {
  _vpSelSize = key;  // key is now _cbKey (e.g. "SHORT::2") — unique per option
  _vpQty = 1;
  document.getElementById("vp-size-err").classList.add("hidden");
  renderVPSizes();
  const s = (_vpVariants.sizes || []).find(x => (x._cbKey || x.label) === key);
  _vpSelCbKey = s?._cbKey || null;  // track full checkbox key for checkbox-based options
  if (s) {
    if (s.sale_price && parseFloat(s.sale_price) > 0) {
      document.getElementById("vp-price").textContent = parseFloat(s.sale_price).toFixed(2) + " جنيه";
    } else {
      document.getElementById("vp-price").textContent = parseFloat(_vpProduct.sale_price || 0).toFixed(2) + " جنيه";
    }
    const info = document.getElementById("vp-stock-info");
    const lowS  = s.qty <= 2;
    if (lowS) {
      info.innerHTML = `<span style="color:#c2410c;font-weight:700;">⚠️ تنبيه: متبقي ${s.qty} قطعة فقط من ${s.label} — كمية محدودة!</span>`;
      info.style.background = "#fff7ed";
      info.style.border     = "1px solid #fdba74";
    } else {
      info.innerHTML = `<span style="color:#4b5563;">متبقي: <b>${s.qty}</b> قطعة من ${s.label}</span>`;
      info.style.background = "";
      info.style.border     = "";
    }
    info.classList.remove("hidden");
    // show qty counter
    const qtyRow = document.getElementById("vp-qty-row");
    qtyRow.classList.remove("hidden");
    document.getElementById("vp-qty-val").textContent = 1;
    document.getElementById("vp-qty-plus").disabled = s.qty <= 1;
    document.getElementById("vp-qty-min").disabled  = true;
  }
}

function incrVPQty() {
  const s = (_vpVariants?.sizes || []).find(x => x.label === _vpSelSize);
  const max = s ? s.qty : 1;
  if (_vpQty < max) {
    _vpQty++;
    document.getElementById("vp-qty-val").textContent = _vpQty;
    document.getElementById("vp-qty-plus").disabled = _vpQty >= max;
    document.getElementById("vp-qty-min").disabled  = false;
  }
}

function decrVPQty() {
  if (_vpQty > 1) {
    _vpQty--;
    const s = (_vpVariants?.sizes || []).find(x => x.label === _vpSelSize);
    const max = s ? s.qty : 1;
    document.getElementById("vp-qty-val").textContent = _vpQty;
    document.getElementById("vp-qty-plus").disabled = _vpQty >= max;
    document.getElementById("vp-qty-min").disabled  = _vpQty <= 1;
  }
}

function selectVPColor(c) {
  _vpSelColor = _vpSelColor === c ? null : c;
  renderVPColors();
}

function confirmVariantAdd() {
  if (!_vpSelSize) {
    document.getElementById("vp-size-err").classList.remove("hidden");
    document.getElementById("vp-sizes").scrollIntoView({ behavior: "smooth", block: "nearest" });
    return;
  }
  const sizeObj = (_vpVariants.sizes || []).find(s => (s._cbKey || s.label) === _vpSelSize);
  const maxQty  = sizeObj ? sizeObj.qty : 1;
  const qty     = Math.min(_vpQty || 1, maxQty);

  const cartKey = `${_vpProduct.id}__${_vpSelSize}__${_vpSelColor || ""}`;
  const existing = cart.find(i => i._cartKey === cartKey);
  if (existing) {
    const newTotal = existing.quantity + qty;
    if (newTotal > maxQty) { alert(`لا يوجد مخزون كافٍ — متبقي ${Math.max(0, maxQty - existing.quantity)} قطعة فقط`); return; }
    existing.quantity = newTotal;
  } else {
    const label = (sizeObj?.label || _vpSelSize) + (_vpSelColor ? ` · ${_vpSelColor}` : "");
    const variantCost = (sizeObj && sizeObj.cost_price != null && parseFloat(sizeObj.cost_price) > 0)
      ? parseFloat(sizeObj.cost_price)
      : parseFloat(_vpProduct.purchase_price || 0);
    cart.push({
      _cartKey:      cartKey,
      product_id:    _vpProduct.id,
      product_name:  `${_vpProduct.product_name} — ${label}`,
      _baseName:     _vpProduct.product_name,
      _size:         _vpSelSize,
      selected_size: _vpSelSize,
      selected_option: _vpSelCbKey || null,
      _color:        _vpSelColor || null,
      unit_price:    (sizeObj && sizeObj.sale_price != null && parseFloat(sizeObj.sale_price) > 0) ? parseFloat(sizeObj.sale_price) : _vpProduct.sale_price,
      purchase_price: variantCost,
      quantity:      qty,
      max_qty:       maxQty
    });
  }
  closeVariantPicker();
  renderCart();
}

function addToCart(product) {
  // Safety net: if product has variants, always redirect to picker
  const _addV = parseVariants(product);
  if (_addV && _addV.sizes && _addV.sizes.length > 0) { openVariantPicker(product, _addV); return; }
  if (product.quantity <= 0) { alert(`⚠️ "${product.product_name}" غير متوفر في المخزون`); return; }
  const existing = cart.find(i => i.product_id === product.id && !i._cartKey);
  if (existing) {
    if (existing.quantity >= product.quantity) { alert("لا يوجد مخزون كافٍ"); return; }
    existing.quantity++;
  } else {
    cart.push({
      product_id:    product.id,
      product_name:  product.product_name,
      unit_price:    product.sale_price,
      purchase_price: product.purchase_price || 0,
      quantity:      1,
      max_qty:       product.quantity
    });
  }
  renderCart();
}

// ── Cart Rendering ────────────────────────────────────────────────────────────
function renderCart() {
  saveCart();
  const body = document.getElementById("cartBody");
  if (cart.length === 0) {
    body.innerHTML = '<div id="emptyMsg" class="text-center text-gray-400 py-10 text-sm">لا توجد منتجات — امسح الباركود أو ابحث</div>';
    updateTotal(); return;
  }
  body.innerHTML = cart.map((item, idx) => {
    const priceHtml = CAN_EDIT_PRICES
      ? `<div class="flex items-center gap-1">
           <input type="number" value="${item.unit_price.toFixed(2)}" min="0" step="0.01"
             onchange="editPrice(${idx}, this.value)"
             class="w-20 text-center text-xs border ${item._priceEdited ? 'border-orange-400 bg-orange-50' : 'border-gray-200'} rounded-lg px-1 py-1 focus:outline-none focus:ring-2 focus:ring-orange-300 font-mono"/>
           <span class="text-xs text-gray-400">جنيه</span>
         </div>`
      : `<div class="text-xs text-gray-500">${item.unit_price.toFixed(2)} جنيه</div>`;
    return `<div class="flex items-center gap-3 px-4 py-3 ${item._priceEdited ? 'bg-orange-50/30' : ''}">
      <div class="flex-1 min-w-0">
        <div class="font-medium text-gray-800 text-sm truncate">${item.product_name}${item._priceEdited ? ' <span class="text-xs text-orange-500">✏️</span>' : ''}</div>
        ${priceHtml}
      </div>
      <div class="flex items-center gap-1">
        <button onclick="changeQty(${idx},-1)" class="w-7 h-7 rounded-lg bg-gray-100 hover:bg-red-100 text-gray-600 font-bold text-lg flex items-center justify-center leading-none">−</button>
        <span class="w-8 text-center font-bold text-sm">${item.quantity}</span>
        <button onclick="changeQty(${idx},1)"  class="w-7 h-7 rounded-lg bg-gray-100 hover:bg-green-100 text-gray-600 font-bold text-lg flex items-center justify-center leading-none">+</button>
      </div>
      <div class="font-bold text-blue-700 w-20 text-left text-sm">${(item.unit_price*item.quantity).toFixed(2)}</div>
      <button onclick="removeItem(${idx})" class="text-red-400 hover:text-red-600 text-xl leading-none">×</button>
    </div>`;
  }).join("");
  updateTotal();
  // Update product card available-stock display after cart changes
  refreshAllCardUIs();
}

function updateCreditSplit() {
  const total = parseFloat(document.getElementById("finalTotal").textContent) || 0;
  const cash  = parseFloat(document.getElementById("credit-cash").value) || 0;
  const insta = parseFloat(document.getElementById("credit-instapay").value) || 0;
  const debt  = Math.max(0, total - cash - insta);
  document.getElementById("creditDebtAmount").textContent = debt.toFixed(2);
}

function updateChange() {
  if (paymentType === "credit") { updateCreditSplit(); return; }

  const total    = parseFloat(document.getElementById("finalTotal").textContent) || 0;
  const received = parseFloat(document.getElementById("amountReceived").value) || 0;
  const changeBox = document.getElementById("changeBox");
  const shortBox  = document.getElementById("shortBox");

  if (!received) { changeBox.classList.add("hidden"); shortBox.classList.add("hidden"); return; }
  const diff = received - total;
  if (diff >= 0) {
    changeBox.classList.remove("hidden"); shortBox.classList.add("hidden");
    document.getElementById("changeDue").textContent = diff.toFixed(2);
  } else {
    shortBox.classList.remove("hidden"); changeBox.classList.add("hidden");
    document.getElementById("shortAmount").textContent = Math.abs(diff).toFixed(2);
  }
}

function editPrice(idx, val) {
  const v = parseFloat(val);
  if (!isNaN(v) && v >= 0) {
    cart[idx].unit_price = v;
    cart[idx]._priceEdited = true;
    updateTotal();
    setTimeout(() => {
      const body = document.getElementById("cartBody");
      const totalEls = body.querySelectorAll('.text-blue-700.w-20');
      cart.forEach((item,i) => { if (totalEls[i]) totalEls[i].textContent = (item.unit_price*item.quantity).toFixed(2); });
    }, 0);
  }
}

function changeQty(idx, delta) {
  const item = cart[idx];
  // Compute effective max: for variant items use live variant qty, else product qty
  let effectiveMax = item.max_qty;
  if (item._size || item.selected_size) {
    const sz    = item._size || item.selected_size;
    const prod  = (_posCatProducts || []).find(p => p.id === item.product_id);
    if (prod?.variants) {
      try {
        const vObj = typeof prod.variants === 'string' ? JSON.parse(prod.variants) : prod.variants;
        const vSz  = (vObj.sizes || []).find(s => s.label === sz);
        if (vSz) effectiveMax = vSz.qty;
      } catch (_) {}
    }
  }
  item.quantity += delta;
  if (item.quantity <= 0) { cart.splice(idx, 1); }
  else if (item.quantity > effectiveMax) {
    item.quantity = effectiveMax;
    alert("لا يوجد مخزون كافٍ للمقاس المحدد");
  }
  renderCart();
}
function removeItem(idx) { cart.splice(idx,1); renderCart(); }
function clearCart()     { cart = []; clearSavedCart(); renderCart(); }

// ── Totals ────────────────────────────────────────────────────────────────────
function updateTotal() {
  const subtotal  = cart.reduce((s,i) => s + i.unit_price * i.quantity, 0);
  const rawDisc   = parseFloat(document.getElementById("discountInput").value) || 0;
  const discType  = document.getElementById("discountType").value;
  let discAmt     = discType === "percent" ? subtotal * rawDisc / 100 : rawDisc;
  if (_appliedPromo) {
    if (_appliedPromo.discount_type === 'percentage') {
      discAmt += (subtotal * _appliedPromo.discount_value) / 100;
    } else {
      discAmt += _appliedPromo.discount_amount;
    }
  }
  const delivery  = (_currentDeliveryMode === 'delivery') ? (parseFloat(document.getElementById("deliveryInput").value) || 0) : 0;
  const final     = Math.max(0, subtotal - discAmt) + delivery;

  // Cart bottom summary
  document.getElementById("subtotalDisplay").textContent = subtotal.toFixed(2) + " جنيه";
  document.getElementById("finalTotal").textContent = final.toFixed(2);
  document.getElementById("cartTotal").textContent   = final.toFixed(2) + " جنيه";

  const discRow = document.getElementById("discountRow");
  if (discAmt > 0) {
    discRow.classList.remove("hidden");
    document.getElementById("discountDisplay").textContent = "−" + discAmt.toFixed(2) + " جنيه" + (_appliedPromo ? ` (شامل كود ${_appliedPromo.code})` : '');
  } else { discRow.classList.add("hidden"); }

  const delRow = document.getElementById("deliveryRow");
  if (delivery > 0 && _currentDeliveryMode === 'delivery') {
    delRow.classList.remove("hidden");
    document.getElementById("deliveryDisplay").textContent = "+" + delivery.toFixed(2) + " جنيه";
  } else { delRow.classList.add("hidden"); }

  // Profit (screen only)
  if (cart.length > 0) {
    const cost   = cart.reduce((s,i) => s + (i.purchase_price||0) * i.quantity, 0);
    const profit = Math.max(0, subtotal - discAmt) - cost;
    document.getElementById("profitDisplay").textContent = profit.toFixed(2) + " جنيه";
    document.getElementById("profitRow").classList.remove("hidden");
  } else {
    document.getElementById("profitRow").classList.add("hidden");
  }
  updateChange();
}

// ── Payment Selection ─────────────────────────────────────────────────────────
function setPaymentType(type) {
  paymentType = type;
  document.getElementById("ptype-cash").className   = `ptype-btn border-2 rounded-xl py-2.5 text-xs font-bold transition-all ` +
    (type==="cash"   ? "border-green-500 bg-green-50 text-green-700" : "border-gray-200 text-gray-500 hover:border-green-400");
  document.getElementById("ptype-credit").className = `ptype-btn border-2 rounded-xl py-2.5 text-xs font-bold transition-all ` +
    (type==="credit" ? "border-orange-500 bg-orange-50 text-orange-700" : "border-gray-200 text-gray-500 hover:border-orange-400");
  document.getElementById("ptype-split").className  = `ptype-btn border-2 rounded-xl py-2.5 text-xs font-bold transition-all ` +
    (type==="split"  ? "border-pink-500 bg-pink-50 text-pink-700" : "border-gray-200 text-gray-500 hover:border-pink-400");

  const isCredit = type === "credit";
  const isSplit  = type === "split";
  document.getElementById("subMethodSection").classList.toggle("hidden", isCredit || isSplit);
  document.getElementById("splitSection").classList.toggle("hidden", !isSplit);
  document.getElementById("customerRequired").classList.toggle("hidden", !isCredit && !isSplit);
  document.getElementById("customerOptional").classList.toggle("hidden", isCredit || isSplit);
  document.getElementById("cashReceivedBox").classList.toggle("hidden", isSplit || isCredit);
  document.getElementById("creditSplitSection").classList.toggle("hidden", !isCredit);
  document.getElementById("amountReceived").value = "";
  document.getElementById("changeBox").classList.add("hidden");
  document.getElementById("shortBox").classList.add("hidden");
  if (isCredit) {
    document.getElementById("credit-cash").value = "0";
    document.getElementById("credit-instapay").value = "0";
    updateCreditSplit();
  }
  if (isSplit) {
    const total = parseFloat(document.getElementById("finalTotal").textContent) || 0;
    document.getElementById("split-cash").value = total.toFixed(2);
    document.getElementById("split-credit").value = "0.00";
    updateSplitRemaining();
  }
  const firstOpt = document.getElementById("customerSelect").options[0];
  if (isCredit || isSplit) {
    firstOpt.textContent = "-- اختر عميل --";
  } else {
    firstOpt.textContent = "-- اختر عميل (اختياري) --";
  }
}

function setPaymentSub(sub) {
  paymentSub = sub;
  document.getElementById("psub-naqdi").className   = `psub-btn border-2 rounded-xl py-2.5 text-sm font-bold transition-all ` +
    (sub==="naqdi"   ? "border-blue-500 bg-blue-50 text-blue-700" : "border-gray-200 text-gray-500 hover:border-purple-400");
  document.getElementById("psub-instapay").className= `psub-btn border-2 rounded-xl py-2.5 text-sm font-bold transition-all ` +
    (sub==="instapay"? "border-purple-500 bg-purple-50 text-purple-700" : "border-gray-200 text-gray-500 hover:border-purple-400");
}

// Split payment helpers
function onSplitInput(changed) {
  const total = parseFloat(document.getElementById("finalTotal").textContent) || 0;
  if (changed === 'cash') {
    const cash = parseFloat(document.getElementById("split-cash").value) || 0;
    document.getElementById("split-credit").value = Math.max(0, total - cash).toFixed(2);
  } else {
    const credit = parseFloat(document.getElementById("split-credit").value) || 0;
    document.getElementById("split-cash").value = Math.max(0, total - credit).toFixed(2);
  }
  updateSplitRemaining();
}

function updateSplitRemaining() {
  const total  = parseFloat(document.getElementById("finalTotal").textContent) || 0;
  const cash   = parseFloat(document.getElementById("split-cash").value) || 0;
  const credit = parseFloat(document.getElementById("split-credit").value) || 0;
  const diff = total - cash - credit;
  const el = document.getElementById("splitRemaining");
  if (Math.abs(diff) < 0.01) {
    el.textContent = "✅ المبلغ مكتمل";
    el.className = "text-xs text-center font-semibold text-green-600";
  } else if (diff > 0) {
    el.textContent = `⚠️ ناقص ${diff.toFixed(2)} ج`;
    el.className = "text-xs text-center font-semibold text-orange-600";
  } else {
    el.textContent = `زيادة ${Math.abs(diff).toFixed(2)} ج`;
    el.className = "text-xs text-center font-semibold text-red-500";
  }
}

// Final method: cash+naqdi→'cash', cash+instapay→'instapay', split→'split', credit→'credit'
function getFinalPaymentMethod() {
  if (paymentType === "credit") return "credit";
  if (paymentType === "split")  return "split";
  return paymentSub === "instapay" ? "instapay" : "cash";
}

// ── Checkout ──────────────────────────────────────────────────────────────────
async function checkout() {
  if (cart.length === 0) { alert("الفاتورة فارغة!"); return; }
  if ((paymentType === "credit" || paymentType === "split") && !document.getElementById("customerSelect").value) {
    alert("يرجى اختيار عميل للبيع الآجل / المقسّم"); return;
  }

  const subtotal   = cart.reduce((s,i) => s + i.unit_price * i.quantity, 0);
  const rawDisc    = parseFloat(document.getElementById("discountInput").value) || 0;
  const discType   = document.getElementById("discountType").value;
  const discAmt    = discType === "percent" ? subtotal * rawDisc / 100 : rawDisc;
  const delivery   = parseFloat(document.getElementById("deliveryInput").value) || 0;
  const total      = Math.max(0, subtotal - discAmt) + delivery;
  const customerId = document.getElementById("customerSelect").value || null;
  const method     = getFinalPaymentMethod();
  const customerName = null;

  let amountReceived = null;
  let changeDue      = null;
  let paymentSplitData = null;

  if (method === "credit") {
    const creditCash  = parseFloat(document.getElementById("credit-cash").value) || 0;
    const creditInsta = parseFloat(document.getElementById("credit-instapay").value) || 0;
    const upfront = creditCash + creditInsta;
    amountReceived = upfront > 0 ? upfront : null;
    paymentSplitData = { cash: creditCash, instapay: creditInsta };
  } else if (method === "split") {
    const splitCash   = parseFloat(document.getElementById("split-cash").value) || 0;
    const splitCredit = parseFloat(document.getElementById("split-credit").value) || 0;
    if (Math.abs(splitCash + splitCredit - total) > 0.05) {
      alert(`مجموع الدفع المقسّم (${(splitCash+splitCredit).toFixed(2)}) لا يساوي إجمالي الفاتورة (${total.toFixed(2)})`);
      return;
    }
    paymentSplitData = { cash: splitCash, credit: splitCredit };
  } else {
    const receivedRaw = parseFloat(document.getElementById("amountReceived").value) || null;
    amountReceived = receivedRaw;
    changeDue = (amountReceived && amountReceived >= total) ? +(amountReceived - total).toFixed(2) : null;
  }

  const selectedAddress = (_currentDeliveryMode === 'delivery')
    ? (document.getElementById("clinicAddressSelect")?.value || null)
    : null;

  const res = await fetch(`${BASE}/api/sales`, {
    method:"POST", headers:{"Content-Type":"application/json"},
    body: JSON.stringify({
      items: cart, total_amount: total, payment_method: method,
      customer_id: customerId ? parseInt(customerId) : null,
      customer_name: customerName,
      amount_received: amountReceived,
      change_due: changeDue,
      payment_split: paymentSplitData,
      discount_amount:  discAmt    > 0 ? discAmt    : undefined,
      delivery_amount:  delivery   > 0 ? delivery   : undefined,
      delivery_type:    _currentDeliveryMode,
      clinic_address:   selectedAddress,
      promo_code:       _appliedPromo ? _appliedPromo.code : undefined
    })
  });
  const data = await res.json();
  if (!res.ok) { alert(data.error || "حدث خطأ"); return; }
  lastSaleId = data.sale_id;

  // ── Update in-memory product list so variant picker shows fresh stock ───────
  // Reduce variant qty and total qty in _posCatProducts after each sale
  cart.forEach(item => {
    const prod = (_posCatProducts || []).find(p => p.id === item.product_id);
    if (!prod) return;
    prod.quantity = Math.max(0, prod.quantity - item.quantity);
    const sz = item._size || item.selected_size;
    if (sz && prod.variants) {
      try {
        const vObj = typeof prod.variants === 'string' ? JSON.parse(prod.variants) : JSON.parse(JSON.stringify(prod.variants));
        const vIdx = (vObj.sizes || []).findIndex(s => s.label === sz);
        if (vIdx >= 0) {
          vObj.sizes[vIdx].qty = Math.max(0, (vObj.sizes[vIdx].qty || 0) - item.quantity);
          prod.variants = vObj;
        }
      } catch (_) {}
    }
    // Also deduct from checkbox_values if a checkbox option was sold
    const selCbOpt = item.selected_option;
    if (selCbOpt && prod.checkbox_values) {
      try {
        const cbvL = typeof prod.checkbox_values === 'string' ? JSON.parse(prod.checkbox_values) : JSON.parse(JSON.stringify(prod.checkbox_values));
        if (cbvL[selCbOpt] && typeof cbvL[selCbOpt] === 'object' && cbvL[selCbOpt].stock != null) {
          cbvL[selCbOpt].stock = Math.max(0, cbvL[selCbOpt].stock - item.quantity);
          if (cbvL[selCbOpt].stock <= 0) cbvL[selCbOpt].disabled = true;
          prod.checkbox_values = cbvL;
        }
      } catch (_) {}
    }
  });

  const payLabel = method==="credit" ? "📋 آجل" : method==="instapay" ? "📱 انستا باي" : method==="split" ? "✂️ مقسّم" : "💵 نقدي";
  document.getElementById("successInvoiceNum").textContent = `فاتورة رقم #${lastSaleId}`;
  document.getElementById("successTotal").textContent = total.toFixed(2) + " جنيه";
  document.getElementById("successPayMethod").textContent = payLabel;
  document.getElementById("successModal").classList.remove("hidden");

  // Refresh bell badge after sale (low stock may have changed)
  if (typeof refreshBadge === 'function') setTimeout(refreshBadge, 800);

  cart = [];
  clearSavedCart();
  document.getElementById("discountInput").value  = "0";
  document.getElementById("deliveryInput").value   = "0";
  document.getElementById("customerSelect").value  = "";
  document.getElementById("amountReceived").value  = "";
  document.getElementById("changeBox").classList.add("hidden");
  document.getElementById("shortBox").classList.add("hidden");
  document.getElementById("credit-cash").value    = "0";
  document.getElementById("credit-instapay").value = "0";
  renderCart();
  loadStats();
}


function printAndClose() {
  if (lastSaleId) window.open(`${BASE}/invoice/${lastSaleId}`, "_blank");
  closeSuccess();
}

function closeSuccess() {
  document.getElementById("successModal").classList.add("hidden");
  lastSaleId = null;
  scanInput.focus();
}

// ── Hold / Resume Invoices ────────────────────────────────────────────────────
let heldCounter = 0;

function holdInvoice() {
  if (cart.length === 0) { alert("الفاتورة فارغة، لا يوجد شيء لتعليقه"); return; }
  heldCounter++;
  heldCarts.push({
    id:          heldCounter,
    label:       `فاتورة ${heldCounter} (${cart.length} صنف)`,
    cart:        JSON.parse(JSON.stringify(cart)),
    discount:    document.getElementById("discountInput").value,
    discountType:document.getElementById("discountType").value,
    delivery:    document.getElementById("deliveryInput").value,
    payType:     paymentType,
    paySub:      paymentSub,
  });
  clearCart();
  document.getElementById("discountInput").value = "0";
  document.getElementById("deliveryInput").value  = "0";
  renderHeld();
  scanInput.focus();
}

function resumeHeld(id) {
  const idx = heldCarts.findIndex(h => h.id === id);
  if (idx === -1) return;
  if (cart.length > 0 && !confirm("سيتم التخلي عن الفاتورة الحالية. هل أنت متأكد؟")) return;
  const h = heldCarts.splice(idx, 1)[0];
  cart = h.cart;
  document.getElementById("discountInput").value  = h.discount;
  document.getElementById("discountType").value   = h.discountType;
  document.getElementById("deliveryInput").value  = h.delivery;
  setPaymentType(h.payType);
  setPaymentSub(h.paySub);
  renderCart();
  renderHeld();
}

function renderHeld() {
  const panel = document.getElementById("heldPanel");
  const list  = document.getElementById("heldList");
  if (heldCarts.length === 0) { panel.classList.add("hidden"); return; }
  panel.classList.remove("hidden");
  list.innerHTML = heldCarts.map(h => `
    <button onclick="resumeHeld(${h.id})"
      class="text-xs bg-white border border-yellow-300 text-yellow-800 px-3 py-1.5 rounded-lg hover:bg-yellow-100 font-medium shadow-sm">
      📌 ${h.label}
    </button>
  `).join("");
}

function newInvoice() {
  if (cart.length > 0 && !confirm("مسح الفاتورة الحالية وفتح جديدة؟")) return;
  cart = [];
  clearSavedCart();
  document.getElementById("discountInput").value = "0";
  document.getElementById("deliveryInput").value  = "0";
  setPaymentType("cash");
  setPaymentSub("naqdi");
  renderCart();
  scanInput.focus();
}

// ── Barcode & Extra Phone Helpers ──────────────────────────────────────────────
async function generateNewBarcodeForModal(targetInputId) {
  const inp = document.getElementById(targetInputId);
  if (!inp) return;
  inp.value = "جاري التوليد...";
  try {
    const res = await fetch(`${BASE}/api/customer/generate-barcode`);
    const data = await res.json();
    if (data.ok && data.barcode) inp.value = data.barcode;
    else inp.value = Math.floor(100000 + Math.random() * 900000).toString();
  } catch (_) {
    inp.value = Math.floor(100000 + Math.random() * 900000).toString();
  }
}

function addExtraPhoneField(containerId, initialVal = "") {
  const container = document.getElementById(containerId);
  if (!container) return;
  const currentCount = container.querySelectorAll("input").length;
  if (currentCount >= 3) {
    alert("الحد الأقصى للأرقام الإضافية هو 3 أرقام فقط.");
    return;
  }
  const div = document.createElement("div");
  div.className = "flex items-center gap-2";
  div.innerHTML = `
    <input type="tel" value="${initialVal}" placeholder="رقم إضافي (عيادة / مساعد)"
      class="flex-1 border border-gray-200 rounded-lg px-2.5 py-1.5 text-xs font-mono bg-white focus:outline-none focus:ring-1 focus:ring-blue-300"/>
    <button type="button" onclick="this.parentElement.remove()" class="text-red-500 hover:text-red-700 text-sm font-black px-1.5 leading-none">✕</button>
  `;
  container.appendChild(div);
}

// ── Quick Add Customer ────────────────────────────────────────────────────────
function openQuickAddCustomer() {
  ["qc-name","qc-phone","qc-barcode","qc-clinic-name","qc-clinic-details","qc-clinic-phone","qc-clinic-region-custom"].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.value = "";
  });
  populateGovSelect("qc-clinic-city", "القاهرة");
  populateDistrictSelect("القاهرة", "qc-clinic-region", "qc-clinic-region-custom-box", "");
  const container = document.getElementById("qcExtraPhonesContainer");
  if (container) container.innerHTML = "";
  document.getElementById("qcError").classList.add("hidden");
  document.getElementById("qcSubmitBtn").disabled = false;
  document.getElementById("quickAddCustomerModal").classList.remove("hidden");
  generateNewBarcodeForModal("qc-barcode");
  setTimeout(() => document.getElementById("qc-name").focus(), 100);
}

function closeQuickAddCustomer() {
  document.getElementById("quickAddCustomerModal").classList.add("hidden");
}

async function submitQuickAddCustomer(e) {
  e.preventDefault();
  const name    = document.getElementById("qc-name").value.trim();
  const barcode = (document.getElementById("qc-barcode")?.value || "").trim();
  const phone   = document.getElementById("qc-phone").value.trim();
  if (!name) return;

  const extraInps = document.querySelectorAll("#qcExtraPhonesContainer input");
  const extraPhones = Array.from(extraInps).map(inp => inp.value.trim()).filter(Boolean);

  const cName = document.getElementById("qc-clinic-name")?.value.trim() || "";
  const cCity = document.getElementById("qc-clinic-city")?.value.trim() || "";
  const cRegSel = document.getElementById("qc-clinic-region")?.value.trim() || "";
  const cRegCustom = document.getElementById("qc-clinic-region-custom")?.value.trim() || "";
  const cRegion = (cRegSel === '__custom__' ? cRegCustom : cRegSel);
  const cDetails = document.getElementById("qc-clinic-details")?.value.trim() || "";
  const cPhone = document.getElementById("qc-clinic-phone")?.value.trim() || "";

  let addresses = [];
  if (cName || cCity || cRegion || cDetails) {
    const full = [cCity, cRegion, cDetails].filter(Boolean).join(' - ');
    addresses.push({
      id: 'addr_' + Date.now(),
      title: cName || (cRegion ? `عيادة ${cRegion}` : 'العيادة الرئيسية'),
      city: cCity || 'القاهرة',
      region: cRegion || '',
      details: cDetails || '',
      phone: cPhone || '',
      address: full,
      is_default: true
    });
  }

  const btn = document.getElementById("qcSubmitBtn");
  btn.disabled = true;
  btn.textContent = "جارٍ الحفظ...";

  try {
    const res  = await fetch(`${BASE}/api/customers`, {
      method: "POST", headers: {"Content-Type":"application/json"},
      body: JSON.stringify({ name, phone, barcode, extra_phones: extraPhones, addresses })
    });
    const data = await res.json();
    if (!res.ok) throw new Error(data.error || "فشل الحفظ");

    // Reload customers list
    const updated = await fetch(`${BASE}/api/customers`).then(r => r.json());
    customers = updated;
    populateCustomerSelect(updated);

    // Auto-select the newly added customer
    const newCustId = data.customer_id || (data.customer && data.customer.id);
    if (newCustId) {
      document.getElementById("customerSelect").value = newCustId;
      onCustomerSelectChange();
    }

    closeQuickAddCustomer();
  } catch(err) {
    const errEl = document.getElementById("qcError");
    errEl.textContent = err.message || "حدث خطأ، حاول مرة أخرى";
    errEl.classList.remove("hidden");
    btn.disabled = false;
    btn.textContent = "حفظ وتحديد العميل فوراً";
  }
}

// ── Quick Add Clinic Address During Sale ─────────────────────────────────────
function openQuickAddClinicModal() {
  const custId = document.getElementById("customerSelect").value;
  if (!custId) {
    alert("يرجى اختيار العميل أولاً لتسجيل عنوان عيادة له.");
    return;
  }
  ["qcl-title","qcl-details","qcl-phone","qcl-region-custom"].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.value = "";
  });
  populateGovSelect("qcl-city", "القاهرة");
  populateDistrictSelect("القاهرة", "qcl-region", "qcl-region-custom-box", "");
  document.getElementById("qclError").classList.add("hidden");
  document.getElementById("qclSubmitBtn").disabled = false;
  document.getElementById("quickAddClinicModal").classList.remove("hidden");
  setTimeout(() => document.getElementById("qcl-title").focus(), 100);
}

function closeQuickAddClinicModal() {
  document.getElementById("quickAddClinicModal").classList.add("hidden");
}

async function submitQuickAddClinic() {
  const custId = parseInt(document.getElementById("customerSelect").value, 10);
  if (!custId) return;
  const title   = document.getElementById("qcl-title").value.trim();
  const city    = document.getElementById("qcl-city").value.trim();
  const regSel  = document.getElementById("qcl-region").value.trim();
  const regCustom = document.getElementById("qcl-region-custom")?.value.trim() || "";
  const region  = (regSel === '__custom__' ? regCustom : regSel);
  const details = document.getElementById("qcl-details").value.trim();
  const phone   = document.getElementById("qcl-phone")?.value.trim() || "";

  const errEl = document.getElementById("qclError");
  if (!title || !city) {
    errEl.textContent = "اسم العيادة والمحافظة مطلوبان.";
    errEl.classList.remove("hidden");
    return;
  }

  const btn = document.getElementById("qclSubmitBtn");
  btn.disabled = true;
  btn.textContent = "جارٍ الحفظ...";

  try {
    const res = await fetch(`${BASE}/api/customer/add-address`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ customer_id: custId, title, city, region, details, phone, is_default: true })
    });
    const data = await res.json();
    if (!res.ok) throw new Error(data.error || "فشل تسجيل العنوان");

    // Update customer's addresses in memory
    const cust = customers.find(c => c.id === custId);
    if (cust) cust.addresses = data.addresses;

    // Refresh clinic dropdown and select this new address
    onCustomerSelectChange();
    const clinicSelect = document.getElementById("clinicAddressSelect");
    if (data.new_address && clinicSelect) {
      for (let i = 0; i < clinicSelect.options.length; i++) {
        if (clinicSelect.options[i].text.includes(data.new_address.title)) {
          clinicSelect.selectedIndex = i;
          break;
        }
      }
    }

    closeQuickAddClinicModal();
  } catch (err) {
    errEl.textContent = err.message || "حدث خطأ أثناء الحفظ";
    errEl.classList.remove("hidden");
    btn.disabled = false;
    btn.textContent = "حفظ وتحديد هذا العنوان";
  }
}

</script>

