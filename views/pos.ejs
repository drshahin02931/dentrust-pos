setInterval(async () => {
  if (!_posCatProducts || !_posCatProducts.length) return;
  try {
    const r = await fetch(`${BASE}/api/stock-snapshot`);
    if (!r.ok) return;
    const data = await r.json();
    if (!Array.isArray(data)) return;
    const qMap = {};
    data.forEach(p => { qMap[p.id] = p.quantity; });
    let changed = false;
