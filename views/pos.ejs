};

function populateGovSelect(citySelectId, initialCity) {
  const sel = document.getElementById(citySelectId);
  if (!sel) return;
  sel.innerHTML = '<option value="">اختر المحافظة...</option>' +
    Object.keys(EGYPT_GOVERNORATES).map(gov => `<option value="${gov}" ${gov === initialCity ? 'selected' : ''}>${gov}</option>`).join('');
}

function populateDistrictSelect(cityVal, regionSelectId, customBoxId, initialRegion) {
  const sel = document.getElementById(regionSelectId);
  const box = customBoxId ? document.getElementById(customBoxId) : null;
  if (!sel) return;
  const list = EGYPT_GOVERNORATES[cityVal] || [];
  if (!cityVal || !list.length) {
    sel.innerHTML = '<option value="">اختر المحافظة أولاً...</option>';
    if (box) box.classList.add('hidden');
    return;
  }
  let isKnown = false;
  let html = '<option value="">اختر المنطقة / الحي...</option>';
  list.forEach(d => {
    const isSel = (d === initialRegion);
    if (isSel) isKnown = true;
    html += `<option value="${d}" ${isSel ? 'selected' : ''}>${d}</option>`;
  });
  html += `<option value="__custom__" ${(!isKnown && initialRegion) ? 'selected' : ''}>+ منطقة أخرى (كتابة يدوية)</option>`;
  sel.innerHTML = html;

  if (box) {
    if (!isKnown && initialRegion) {
      box.classList.remove('hidden');
      const customInput = box.querySelector('input');
      if (customInput) customInput.value = initialRegion;
    } else {
      box.classList.add('hidden');
    }
  }
}

function onGovChange(citySelectId, regionSelectId, customBoxId) {
  const cityVal = document.getElementById(citySelectId)?.value || '';
  populateDistrictSelect(cityVal, regionSelectId, customBoxId, '');
}

function onDistrictChange(regionSelectId, customBoxId) {
  const regVal = document.getElementById(regionSelectId)?.value || '';
  const box = customBoxId ? document.getElementById(customBoxId) : null;
  if (!box) return;
  if (regVal === '__custom__') {
    box.classList.remove('hidden');
    const inp = box.querySelector('input');
    if (inp) { inp.value = ''; inp.focus(); }
  } else {
    box.classList.add('hidden');
  }
}

// ── Cart persistence ──────────────────────────────────────────────────────────
const CART_SAVE_KEY = 'pos_cart_saved_v1';
function saveCart() {
  try { localStorage.setItem(CART_SAVE_KEY, JSON.stringify(cart)); } catch(_) {}
}
function clearSavedCart() {
  try { localStorage.removeItem(CART_SAVE_KEY); } catch(_) {}
}
function loadSavedCart() {
  try {
    const raw = localStorage.getItem(CART_SAVE_KEY);
    if (!raw) return;
    const parsed = JSON.parse(raw);
    if (Array.isArray(parsed) && parsed.length > 0) { cart = parsed; renderCart(); }
  } catch(_) {}
}
let paymentSub  = "naqdi";   // 'naqdi' | 'instapay'
let lastSaleId  = null;
let customers   = [];
let heldCarts   = [];        // [{label, cart, discount, delivery, discountType}]
let searchTimeout = null;
let suggCache   = {};        // id → product object, avoids JSON escaping in onclick
let posSelectedCategory = null;

// ── Load & Search Customers ──────────────────────────────────────────────────
function populateCustomerSelect(list) {
  const sel = document.getElementById("customerSelect");
  const currentVal = sel.value;
  while (sel.options.length > 1) sel.remove(1);
  (list || customers).forEach(c => {
    const opt = document.createElement("option");
    opt.value = c.id;
    const debt = parseFloat(c.total_debt || 0);
    const debtLabel = debt > 0 ? ` (عليه: ${debt.toLocaleString('ar-EG', {minimumFractionDigits:2})} ج)` : ' (مسدد)';
    opt.textContent = `${c.name}${debtLabel}`;
    sel.appendChild(opt);
  });
  if (currentVal) sel.value = currentVal;
}

fetch(`${BASE}/api/customers`).then(r=>r.json()).then(data => {
  customers = data;
  populateCustomerSelect(data);
});

function onCustomerSearch(query) {
  const q = (query || '').toLowerCase().trim();
  if (!q) {
    populateCustomerSelect(customers);
    return;
  }
  const filtered = customers.filter(c => {
    const nameMatch = (c.name || '').toLowerCase().includes(q);
    const codeMatch = (c.customer_code || '').toLowerCase().includes(q);
    const barcodeMatch = (c.barcode || '').includes(q);
    const phoneMatch = (c.phone || '').includes(q);
    const extraMatch = (c.extra_phones || '').includes(q);
    let addrMatch = false;
    try {
      const addrs = typeof c.addresses === 'string' ? JSON.parse(c.addresses) : (c.addresses || []);
      addrMatch = addrs.some(a => (a.title || '').toLowerCase().includes(q) || (a.city || '').toLowerCase().includes(q) || (a.region || '').toLowerCase().includes(q) || (a.address || '').toLowerCase().includes(q));
    } catch (_) {}
    return nameMatch || codeMatch || barcodeMatch || phoneMatch || extraMatch || addrMatch;
  });
  populateCustomerSelect(filtered);
  if (filtered.length === 1) {
    document.getElementById("customerSelect").value = filtered[0].id;
    onCustomerSelectChange();
  }
}

function onCustomerSelectChange() {
  const cid = parseInt(document.getElementById("customerSelect").value, 10);
  const cust = customers.find(c => c.id === cid);
  const codeBadge = document.getElementById("selectedCustCodeBadge");
  const clinicBox = document.getElementById("clinicAddressBox");
  const clinicSelect = document.getElementById("clinicAddressSelect");

  if (!cust) {
    codeBadge.classList.add("hidden");
    clinicBox.classList.add("hidden");
    return;
  }

  const code = cust.customer_code || cust.barcode || String(100000 + cust.id);
  codeBadge.textContent = code;
  codeBadge.classList.remove("hidden");

  let addresses = [];
  try {
    addresses = typeof cust.addresses === 'string' ? JSON.parse(cust.addresses) : (cust.addresses || []);
  } catch (_) { addresses = []; }

  clinicSelect.innerHTML = `<option value="">-- العنوان المسجل: ${cust.address || 'لا يوجد عنوان مسجل'} --</option>`;
  if (addresses.length > 0) {
    document.getElementById("addressesCountBadge").textContent = `${addresses.length} عيادة`;
    addresses.forEach((a, idx) => {
      const opt = document.createElement("option");
      const clinicTitle = a.title || ('عيادة ' + (idx + 1));
      const details = a.details || a.address || '';
      const fullLocation = [a.city, a.region, details].filter(Boolean).join(' - ');
      const isDef = a.is_default ? '⭐ ' : '';
      const fullText = `${isDef}${clinicTitle}: ${fullLocation}${a.phone ? ' (' + a.phone + ')' : ''}`;
      opt.value = fullText;
      opt.textContent = fullText;
      if (a.is_default) opt.selected = true;
      clinicSelect.appendChild(opt);
    });
  } else {
    document.getElementById("addressesCountBadge").textContent = "";
  }

  if (_currentDeliveryMode === 'delivery') {
    clinicBox.classList.remove("hidden");
  } else {
    clinicBox.classList.add("hidden");
  }
}

