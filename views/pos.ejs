  "أسيوط": ["أسيوط", "ديروط", "القوصية", "أبنوب", "منفلوط", "أبو تيج"],
  "سوهاج": ["سوهاج", "أخميم", "جرجا", "طهطا", "طما", "البلينا", "المراغة"],
  "قنا": ["قنا", "نجع حمادي", "دشنا", "قوص", "فرشوط", "أبو تشت"],
  "الأقصر": ["الأقصر", "إسنا", "أرمنت"],
  "أسوان": ["أسوان", "إدفو", "كوم أمبو", "نصر النوبة"],
