<%- include('partials/header', Object.assign({pageTitle: 'نقطة البيع'}, locals)) %>
<div class="grid grid-cols-1 lg:grid-cols-3 gap-4 min-w-[780px] lg:min-w-0">

  <!-- ── Left: Product Search + Cart ─────────────────────────────────────── -->
  <div class="lg:col-span-2 space-y-3">
    <div class="bg-white rounded-2xl shadow-sm border p-4">
      <div class="flex items-center justify-between mb-3">
        <h2 class="text-lg font-bold text-gray-800" data-ar="🛒 نقطة البيع" data-en="🛒 Point of Sale">🛒 نقطة البيع</h2>
        <div class="flex gap-2">
          <button onclick="holdInvoice()" id="btn-hold"
            class="flex items-center gap-1.5 text-sm bg-yellow-50 text-yellow-700 border border-yellow-200 px-3.5 py-2 rounded-xl hover:bg-yellow-100 font-bold transition-all shadow-xs"
            data-ar="📌 تعليق" data-en="📌 Hold">
            📌 تعليق
          </button>
          <button onclick="newInvoice()" id="btn-new"
            class="flex items-center gap-1.5 text-sm bg-blue-50 text-blue-700 border border-blue-200 px-3.5 py-2 rounded-xl hover:bg-blue-100 font-bold transition-all shadow-xs"
            data-ar="＋ فاتورة جديدة" data-en="＋ New Invoice">
            ＋ فاتورة جديدة
          </button>
        </div>
      </div>
      <!-- Category Filter Bar -->
      <div id="posCatBar" class="hidden flex-wrap gap-1.5 mb-2" style="display:none"></div>

      <input id="scanInput" type="text" autofocus
        placeholder="امسح الباركود أو ابحث عن منتج..."
        data-ar-placeholder="امسح الباركود أو ابحث عن منتج..."
        data-en-placeholder="Scan barcode or search product..."
        class="w-full border-2 border-blue-400 rounded-xl px-4 py-3 text-lg font-mono focus:outline-none focus:border-blue-600 focus:ring-2 focus:ring-blue-200"
        autocomplete="off"/>
      <div id="suggestions" class="mt-2 hidden bg-white border rounded-xl shadow-lg divide-y max-h-60 overflow-y-auto z-10 relative"></div>

      <!-- Product Grid (shown when category selected) -->
      <div id="productGrid" style="display:none" class="mt-3 grid grid-cols-2 gap-2 max-h-72 overflow-y-auto"></div>
    </div>

    <!-- Held invoices -->
    <div id="heldPanel" class="hidden bg-yellow-50 border border-yellow-200 rounded-2xl p-3">
      <div class="text-xs font-bold text-yellow-700 mb-2" data-ar="📌 فواتير معلّقة" data-en="📌 Held Invoices">📌 فواتير معلّقة</div>
      <div id="heldList" class="flex gap-2 flex-wrap"></div>
    </div>

    <!-- Cart -->
    <div class="bg-white rounded-2xl shadow-sm border">
      <div class="p-4 border-b flex items-center justify-between">
        <h3 class="font-bold text-gray-700" data-ar="الفاتورة الحالية" data-en="Current Invoice">الفاتورة الحالية</h3>
        <button onclick="clearCart()" class="text-xs text-red-500 hover:underline" data-ar="مسح الكل" data-en="Clear All">مسح الكل</button>
      </div>
      <div id="cartBody" class="divide-y min-h-[100px]">
        <div id="emptyMsg" class="text-center text-gray-400 py-10 text-sm" data-ar="لا توجد منتجات — امسح الباركود أو ابحث" data-en="No items — scan barcode or search">لا توجد منتجات — امسح الباركود أو ابحث</div>
      </div>
      <!-- Subtotal row -->
      <div class="p-4 bg-gray-50 rounded-b-2xl space-y-1.5 text-sm">
        <div class="flex justify-between text-gray-600">
          <span data-ar="المجموع الفرعي" data-en="Subtotal">المجموع الفرعي</span>
          <span id="subtotalDisplay" class="font-bold">0.00 جنيه</span>
        </div>
        <div id="discountRow" class="hidden flex justify-between text-red-600">
          <span data-ar="الخصم" data-en="Discount">الخصم</span>
          <span id="discountDisplay" class="font-bold">0.00 جنيه</span>
        </div>
        <div id="deliveryRow" class="hidden flex justify-between text-indigo-600">
          <span data-ar="التوصيل" data-en="Delivery">التوصيل</span>
          <span id="deliveryDisplay" class="font-bold">0.00 جنيه</span>
        </div>
        <div class="flex justify-between text-lg font-black text-blue-700 pt-1 border-t">
          <span data-ar="إجمالي الدفع" data-en="Total">إجمالي الدفع</span>
          <span id="cartTotal">0.00 جنيه</span>
        </div>
        <!-- Profit (screen only, not printed) -->
        <div id="profitRow" class="hidden flex justify-between text-green-700 text-xs font-semibold bg-green-50 rounded-lg px-3 py-1.5 mt-1">
          <span data-ar="💹 الربح المتوقع" data-en="💹 Expected Profit">💹 الربح المتوقع</span>
          <span id="profitDisplay">0.00 جنيه</span>
        </div>
      </div>
    </div>
  </div>

  <!-- ── Right: Checkout Panel ─────────────────────────────────────────────── -->
  <div class="space-y-3">
    <div class="bg-white rounded-2xl shadow-sm border p-4 space-y-4">
      <h3 class="font-bold text-gray-700 text-lg" data-ar="💳 الدفع" data-en="💳 Payment">💳 الدفع</h3>

      <!-- Level 1: كاش / آجل / مقسّم -->
      <div>
        <label class="text-xs font-semibold text-gray-500 block mb-2">نوع الدفع</label>
        <div class="grid grid-cols-3 gap-2">
          <button onclick="setPaymentType('cash')" id="ptype-cash"
            class="ptype-btn border-2 border-green-500 bg-green-50 text-green-700 rounded-xl py-3 text-sm font-bold shadow-xs min-h-[46px] flex items-center justify-center gap-1">
            💵 كاش
          </button>
          <button onclick="setPaymentType('credit')" id="ptype-credit"
            class="ptype-btn border-2 border-gray-200 text-gray-500 rounded-xl py-3 text-sm font-bold hover:border-orange-400 shadow-xs min-h-[46px] flex items-center justify-center gap-1">
            📋 آجل
          </button>
          <button onclick="setPaymentType('split')" id="ptype-split"
            class="ptype-btn border-2 border-gray-200 text-gray-500 rounded-xl py-3 text-sm font-bold hover:border-pink-400 shadow-xs min-h-[46px] flex items-center justify-center gap-1">
            ✂️ مقسّم
          </button>
        </div>
      </div>

      <!-- Level 2: نقدي / انستا باي (cash only) -->
      <div id="subMethodSection">
        <label class="text-xs font-semibold text-gray-500 block mb-2">طريقة الاستلام</label>
        <div class="grid grid-cols-2 gap-2">
          <button onclick="setPaymentSub('naqdi')" id="psub-naqdi"
            class="psub-btn border-2 border-blue-500 bg-blue-50 text-blue-700 rounded-xl py-3 text-sm font-bold shadow-xs min-h-[46px] flex items-center justify-center gap-1">
            🪙 نقدي
          </button>
          <button onclick="setPaymentSub('instapay')" id="psub-instapay"
            class="psub-btn border-2 border-gray-200 text-gray-500 rounded-xl py-3 text-sm font-bold hover:border-purple-400 shadow-xs min-h-[46px] flex items-center justify-center gap-1">
            📱 انستا باي
          </button>
        </div>
      </div>

      <!-- Split Payment Amounts -->
      <div id="splitSection" class="hidden space-y-2">
        <label class="text-xs font-medium text-gray-500 block">توزيع المبلغ</label>
        <div class="bg-pink-50 border border-pink-200 rounded-xl p-3 space-y-2">
          <div class="flex items-center gap-2">
            <span class="text-xs font-semibold text-gray-600 w-20">🪙 نقدي</span>
            <input id="split-cash" type="number" min="0" step="0.01" value="0"
              oninput="onSplitInput('cash')"
              class="flex-1 border rounded-lg px-2 py-1.5 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-pink-200"/>
            <span class="text-xs text-gray-400">ج</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-xs font-semibold text-gray-600 w-20">📋 آجل</span>
            <input id="split-credit" type="number" min="0" step="0.01" value="0"
              oninput="onSplitInput('credit')"
              class="flex-1 border rounded-lg px-2 py-1.5 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-orange-200"/>
            <span class="text-xs text-gray-400">ج</span>
          </div>
          <div id="splitRemaining" class="text-xs text-center font-semibold text-pink-600"></div>
        </div>
      </div>

      <!-- Customer name with Live Search & Address Picker -->
      <div>
        <label class="text-xs font-medium text-gray-500 block mb-1.5 flex items-center justify-between">
          <span>
            <span data-ar="اسم العميل / الطبيب" data-en="Customer / Doctor Name">اسم العميل / الطبيب</span>
            <span id="customerRequired" class="text-orange-500 hidden" data-ar="(مطلوب)" data-en="(required)">(مطلوب)</span>
            <span class="text-gray-400 text-xs" id="customerOptional" data-ar="(اختياري)" data-en="(optional)">(اختياري)</span>
          </span>
          <span id="selectedCustCodeBadge" class="hidden text-[11px] font-mono font-black bg-blue-100 text-blue-800 px-2 py-0.5 rounded"></span>
        </label>
        
        <div id="customerSection" class="space-y-1.5">
          <!-- Live Search Input -->
          <input id="customerSearchInput" type="text" oninput="onCustomerSearch(this.value)"
            placeholder="🔍 ابحث باسم الطبيب، الباركود (6 أرقام)، أو أي رقم هاتف..."
            class="w-full border rounded-xl px-3 py-2 text-xs focus:outline-none focus:ring-2 focus:ring-blue-300"/>

          <!-- Customer select -->
          <select id="customerSelect" onchange="onCustomerSelectChange()" class="w-full border rounded-xl px-3 py-2 text-sm font-semibold focus:outline-none focus:ring-2 focus:ring-blue-200">
            <option value="" data-ar="-- اختر عميل (اختياري) --" data-en="-- Select customer (optional) --">-- اختر عميل (اختياري) --</option>
          </select>

          <!-- Clinic Address Dropdown (hidden if none or pickup) -->
          <div id="clinicAddressBox" class="hidden bg-gray-50 border border-gray-200 rounded-xl p-2.5 space-y-1.5">
            <div class="text-[11px] font-bold text-gray-700 flex items-center justify-between">
              <span>🏥 عنوان العيادة للفاتورة:</span>
              <div class="flex items-center gap-1.5">
                <span id="addressesCountBadge" class="text-[10px] text-blue-600 bg-blue-50 px-1.5 py-0.5 rounded"></span>
                <button type="button" onclick="openQuickAddClinicModal()" class="text-[11px] text-blue-700 hover:text-blue-900 font-bold bg-white hover:bg-blue-50 px-2 py-0.5 rounded border border-blue-200 shadow-2xs">
                  ＋ تسجيل عنوان جديد
                </button>
              </div>
            </div>
            <select id="clinicAddressSelect" class="w-full border rounded-lg px-2.5 py-1.5 text-xs bg-white focus:outline-none">
              <option value="">-- العنوان المسجل الرئيسي --</option>
            </select>
          </div>

          <button type="button" onclick="openQuickAddCustomer()"
            class="w-full text-xs text-blue-600 hover:text-blue-800 border border-blue-200 hover:border-blue-400 bg-blue-50 hover:bg-blue-100 rounded-xl py-2 font-semibold transition-all flex items-center justify-center gap-1">
            <span>＋</span> إضافة عميل جديد
          </button>
        </div>
      </div>

      <!-- Delivery / Pickup Toggle -->
      <div>
        <label class="text-xs font-medium text-gray-500 block mb-1.5">نوع الاستلام والتسليم</label>
        <div class="grid grid-cols-2 gap-1.5 p-1 bg-gray-100 rounded-xl">
          <button type="button" id="btnTypePickup" onclick="setDeliveryMode('pickup')"
            class="py-2 text-xs font-bold rounded-lg transition-all bg-white text-blue-700 shadow-xs flex items-center justify-center gap-1">
            🏪 استلام من الفرع
          </button>
          <button type="button" id="btnTypeDelivery" onclick="setDeliveryMode('delivery')"
            class="py-2 text-xs font-bold rounded-lg transition-all text-gray-600 hover:text-gray-800 flex items-center justify-center gap-1">
            🛵 توصيل
          </button>
        </div>
      </div>

      <!-- Discount & Promo Code -->
      <div class="space-y-2">
        <div>
          <label class="text-xs font-medium text-gray-500 block mb-1.5" data-ar="خصم" data-en="Discount">خصم</label>
          <div class="flex gap-2">
            <input id="discountInput" type="number" min="0" value="0" oninput="updateTotal()"
              class="flex-1 border rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-200"/>
            <select id="discountType" onchange="updateTotal()" class="border rounded-xl px-2 py-2 text-sm focus:outline-none bg-white">
              <option value="amount">جنيه</option>
              <option value="percent">%</option>
            </select>
          </div>
        </div>

        <!-- Promo Code Input -->
        <div>
          <div class="flex items-center justify-between mb-1">
            <label class="text-xs font-medium text-gray-500 block">🎟️ كود الخصم (البروموكود)</label>
            <span id="promoBadge" class="hidden text-[10px] font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 px-2 py-0.5 rounded"></span>
          </div>
          <div class="flex gap-1.5">
            <input id="promoCodeInput" type="text" placeholder="اكتب كود الخصم..."
              class="flex-1 border uppercase rounded-xl px-3 py-2 text-xs font-mono focus:outline-none focus:ring-2 focus:ring-blue-300"/>
            <button type="button" onclick="applyPromoCode()" id="applyPromoBtn"
              class="bg-purple-600 hover:bg-purple-700 text-white text-xs font-bold px-3.5 py-2 rounded-xl transition-all">
              تطبيق
            </button>
          </div>
        </div>
      </div>

      <!-- Delivery Fee (hidden if pickup) -->
      <div id="deliveryFeeSection" class="hidden">
        <label class="text-xs font-medium text-gray-500 block mb-1.5" data-ar="رسوم التوصيل" data-en="Delivery Fee">رسوم التوصيل</label>
        <input id="deliveryInput" type="number" min="0" value="0" oninput="updateTotal()"
          class="w-full border rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-200"
          placeholder="0.00"/>
      </div>

      <!-- Final Total box -->
      <div class="bg-blue-50 rounded-xl p-3 text-center">
        <div class="text-sm text-blue-600 font-medium" data-ar="إجمالي الدفع" data-en="Total Due">إجمالي الدفع</div>
        <div id="finalTotal" class="text-3xl font-black text-blue-700">0.00</div>
        <div class="text-xs text-blue-500" id="currencyLabel">جنيه مصري</div>
      </div>

      <!-- Cash Received (cash/instapay only — hidden for credit) -->
      <div id="cashReceivedBox" class="space-y-2">
        <div>
          <label id="cashReceivedLabel" class="text-xs font-medium text-gray-500 block mb-1.5">💵 مبلغ مستلم من العميل</label>
          <input id="amountReceived" type="number" min="0" step="0.01" value=""
            oninput="updateChange()"
            placeholder="اكتب المبلغ المستلم..."
            class="w-full border rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-green-200"/>
        </div>
        <div id="changeBox" class="hidden bg-green-50 border border-green-200 rounded-xl p-3 flex items-center justify-between">
          <span class="text-sm font-semibold text-green-700">🪙 الباقي للعميل</span>
          <span id="changeDue" class="text-xl font-black text-green-700">0.00</span>
        </div>
        <div id="shortBox" class="hidden bg-red-50 border border-red-200 rounded-xl p-3 flex items-center justify-between">
          <span class="text-sm font-semibold text-red-600">⚠️ ناقص</span>
          <span id="shortAmount" class="text-xl font-black text-red-600">0.00</span>
        </div>
      </div>

      <!-- Credit Split: cash + instapay received upfront (shown only for آجل) -->
      <div id="creditSplitSection" class="hidden space-y-2">
        <label class="text-xs font-medium text-gray-500 block">💰 المبلغ المستلم مقدماً (اختياري)</label>
        <div class="bg-orange-50 border border-orange-200 rounded-xl p-3 space-y-2">
          <div class="flex items-center gap-2">
            <span class="text-xs font-semibold text-gray-600 w-24">🪙 كاش ورق</span>
            <input id="credit-cash" type="number" min="0" step="0.01" value="0"
              oninput="updateCreditSplit()"
              class="flex-1 border rounded-lg px-2 py-1.5 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-orange-200"/>
            <span class="text-xs text-gray-400">ج</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-xs font-semibold text-gray-600 w-24">📱 انستا باي</span>
            <input id="credit-instapay" type="number" min="0" step="0.01" value="0"
              oninput="updateCreditSplit()"
              class="flex-1 border rounded-lg px-2 py-1.5 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-purple-200"/>
            <span class="text-xs text-gray-400">ج</span>
          </div>
        </div>
        <div id="creditDebtBox" class="bg-orange-50 border border-orange-200 rounded-xl p-3 flex items-center justify-between">
          <span class="text-sm font-semibold text-orange-700">💸 سيُضاف للدَين</span>
          <span id="creditDebtAmount" class="text-xl font-black text-orange-700">0.00</span>
        </div>
      </div>

      <button onclick="checkout()"
        class="w-full bg-blue-700 hover:bg-blue-800 text-white font-black py-4 rounded-2xl text-xl transition-all active:scale-95 shadow-lg flex items-center justify-center gap-2 min-h-[56px]"
        data-ar="✅ إتمام البيع" data-en="✅ Complete Sale">
        ✅ إتمام البيع
      </button>
    </div>

    <!-- Quick Stats -->
    <div class="bg-white rounded-2xl shadow-sm border p-4">
      <div class="text-sm font-semibold text-gray-600 mb-3" data-ar="📈 إحصائيات اليوم" data-en="📈 Today's Stats">📈 إحصائيات اليوم</div>
      <div class="space-y-2 text-sm">
        <div class="flex justify-between"><span class="text-gray-500" data-ar="عدد المبيعات" data-en="Sales Count">عدد المبيعات</span><span id="s-count" class="font-bold">—</span></div>
        <div class="flex justify-between"><span class="text-gray-500" data-ar="الإيراد" data-en="Revenue">الإيراد</span><span id="s-revenue" class="font-bold text-green-600">—</span></div>
        <div class="flex justify-between"><span class="text-gray-500" data-ar="صافي الربح" data-en="Net Profit">صافي الربح</span><span id="s-net" class="font-bold text-blue-600">—</span></div>
      </div>
    </div>
  </div>
</div>

<!-- ══════════════ Quick Add Customer Modal ══════════════ -->
<div id="quickAddCustomerModal" class="hidden fixed inset-0 bg-black/40 flex items-center justify-center z-50 p-4">
  <div class="bg-white rounded-2xl w-full max-w-md shadow-2xl max-h-[90vh] flex flex-col">
    <div class="p-5 border-b flex items-center justify-between shrink-0">
      <h3 class="font-bold text-gray-800 text-lg">👤 إضافة عميل جديد</h3>
      <button onclick="closeQuickAddCustomer()" class="text-gray-400 hover:text-gray-600 text-2xl leading-none">×</button>
    </div>
    <form onsubmit="submitQuickAddCustomer(event)" class="p-5 space-y-3 overflow-y-auto">
      <div>
        <label class="text-xs font-bold text-gray-700 block mb-1">اسم الطبيب / العميل <span class="text-red-500">*</span></label>
        <input id="qc-name" required
          class="w-full border border-gray-300 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-300"
          placeholder="د. أحمد محمد"/>
      </div>
      
      <!-- Barcode 6 digits -->
      <div>
        <div class="flex items-center justify-between mb-1">
          <label class="text-xs font-bold text-gray-700">الباركود (6 أرقام عشوائية) <span class="text-red-500">*</span></label>
          <button type="button" onclick="generateNewBarcodeForModal('qc-barcode')" class="text-xs text-blue-600 hover:text-blue-800 font-bold flex items-center gap-1">
            <span>🔄</span> توليد باركود
          </button>
        </div>
        <input id="qc-barcode" required type="text" maxlength="6" pattern="[0-9]{6}"
          class="w-full border border-gray-300 rounded-xl px-3 py-2 text-sm font-mono font-bold text-blue-800 tracking-wider focus:outline-none focus:ring-2 focus:ring-blue-300"
          placeholder="مثال: 849201"/>
      </div>

      <div>
        <label class="text-xs font-bold text-gray-700 block mb-1">رقم الهاتف الأساسي</label>
        <input id="qc-phone" type="tel"
          class="w-full border border-gray-300 rounded-xl px-3 py-2 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-blue-300"
          placeholder="01xxxxxxxxx"/>
      </div>

      <!-- Extra phones -->
      <div>
        <div class="flex items-center justify-between mb-1">
          <label class="text-xs font-semibold text-gray-600">أرقام هواتف إضافية</label>
          <button type="button" onclick="addExtraPhoneField('qcExtraPhonesContainer')" class="text-xs text-emerald-600 hover:text-emerald-800 font-bold">
            ＋ إضافة رقم
          </button>
        </div>
        <div id="qcExtraPhonesContainer" class="space-y-1.5"></div>
      </div>

      <!-- Clinic address -->
      <div class="bg-blue-50/50 border border-blue-200 rounded-xl p-3.5 space-y-2.5">
        <div class="flex items-center justify-between">
          <label class="text-xs font-bold text-gray-800 flex items-center gap-1.5">
            <span>🏥</span> عنوان العيادة الرئيسية (اختياري)
          </label>
          <span class="text-[10px] bg-blue-100 text-blue-800 font-bold px-2 py-0.5 rounded-full border border-blue-200">⭐ عنوان افتراضي</span>
        </div>
        <input id="qc-clinic-name" class="w-full border border-gray-300 rounded-xl px-3 py-1.5 text-xs bg-white focus:outline-none focus:ring-2 focus:ring-blue-300" placeholder="اسم العيادة (مثال: عيادة المهندسين)"/>
        <div class="grid grid-cols-2 gap-2">
          <div>
            <label class="text-[11px] font-bold text-gray-700 block mb-1">المحافظة</label>
            <select id="qc-clinic-city" onchange="onGovChange('qc-clinic-city','qc-clinic-region','qc-clinic-region-custom-box')" class="w-full border border-gray-300 rounded-xl px-2.5 py-1.5 text-xs bg-white font-medium focus:outline-none focus:ring-2 focus:ring-blue-300">
              <option value="">اختر المحافظة...</option>
            </select>
