<%- include('partials/header', Object.assign({pageTitle: 'إدارة المخزون'}, locals)) %>
<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold text-gray-800" data-ar="📦 إدارة المخزون" data-en="📦 Inventory">📦 إدارة المخزون</h1>ِِِ
    <button onclick="openModal()" class="bg-blue-700 text-white px-5 py-2.5 rounded-xl font-semibold hover:bg-blue-800 shadow" data-ar="+ إضافة منتج" data-en="+ Add Product">+ إضافة منتج</button>
  </div>

  <!-- Financial Summary (Manager Only) -->
  <div id="financialCard" data-is-mgr="<%= isMgr ? 'true' : 'false' %>" style="<%= !isMgr ? 'display:none' : '' %>" class="bg-gradient-to-l from-blue-700 to-blue-900 text-white rounded-2xl shadow p-4">
    <div class="text-xs font-bold text-blue-200 mb-3">📊 الملخص المالي للمخزون</div>
    <div class="grid grid-cols-3 gap-3 text-center">
      <div class="bg-white/10 rounded-xl p-3">
        <div id="fin-cost" class="text-xl font-black">—</div>
        <div class="text-xs text-blue-200 mt-1">💰 رأس المال المستثمر</div>
      </div>
      <div class="bg-white/10 rounded-xl p-3">
        <div id="fin-revenue" class="text-xl font-black text-green-300">—</div>
        <div class="text-xs text-blue-200 mt-1">📈 البيع المحتمل</div>
      </div>
      <div class="bg-white/10 rounded-xl p-3">
        <div id="fin-profit" class="text-xl font-black text-yellow-300">—</div>
        <div class="text-xs text-blue-200 mt-1">💹 الربح الصافي المحتمل</div>
      </div>
    </div>
    <div id="fin-zero-note" style="display:none" class="text-center text-xs text-blue-300 mt-3">
      ⚠️ الأرقام صفر لأن الكميات لم تُضاف بعد — عدّل الكميات من المخزون لرؤية الأرقام الحقيقية
    </div>
  </div>

  <!-- Stats Bar -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
    <div class="bg-white rounded-2xl border shadow-sm p-4 text-center cursor-pointer hover:border-blue-300 transition-all" onclick="resetAllFilters()" title="عرض كل الأصناف">
      <div id="stat-total" class="text-2xl font-black text-blue-700">—</div>
      <div class="text-xs text-gray-500 mt-1">إجمالي الأصناف</div>
    </div>
    <div class="bg-white rounded-2xl border shadow-sm p-4 text-center cursor-pointer hover:border-orange-300 transition-all" onclick="filterByMinStock()" title="تصفية الأصناف التي بلغت الحد الأدنى">
      <div id="stat-low" class="text-2xl font-black text-orange-500">—</div>
      <div class="text-xs text-gray-500 mt-1">⚠️ بلغ الحد الأدنى</div>
    </div>
    <div class="bg-white rounded-2xl border shadow-sm p-4 text-center">
      <div id="stat-out" class="text-2xl font-black text-red-600">—</div>
      <div class="text-xs text-gray-500 mt-1">نفذ من المخزون</div>
    </div>
    <div class="bg-white rounded-2xl border shadow-sm p-4 text-center cursor-pointer hover:border-amber-400 hover:bg-amber-50/40 transition-all group" onclick="setWebsiteFilter('hidden')" title="اضغط لعرض الأصناف المخفية من الموقع فقط">
      <div id="stat-hidden" class="text-2xl font-black text-amber-600 group-hover:scale-105 transition-transform">—</div>
      <div class="text-xs text-gray-500 mt-1 flex items-center justify-center gap-1">
        <span>🙈</span> <span class="font-medium text-amber-700">مخفي من الموقع</span>
      </div>
    </div>
  </div>

  <!-- Low-stock banner -->
  <div id="lowStockBanner" class="hidden bg-red-50 border border-red-200 rounded-2xl px-4 py-3 flex items-center gap-3">
    <span class="text-red-500 text-xl">⚠️</span>
    <div>
      <span id="lowStockBannerText" class="font-bold text-red-700"></span>
      <span class="text-xs text-red-500 mr-1"> — اضغط على البطاقة البرتقالية لعرضها</span>
    </div>
    <button onclick="clearCategoryFilter()" class="mr-auto text-xs text-red-400 hover:text-red-600 underline">إلغاء الفلتر</button>
  </div>

  <!-- Search + Filters + Sort Control Panel -->
  <div class="bg-white rounded-2xl border shadow-sm p-4 space-y-3.5">
    <!-- Top Row: Search Input + Sort Dropdown -->
    <div class="flex flex-col md:flex-row gap-3 items-stretch md:items-center">
      <!-- Search Input -->
      <div class="relative flex-1">
        <span class="absolute inset-y-0 right-3.5 flex items-center pointer-events-none text-gray-400 text-sm">🔍</span>
        <input id="searchBox" type="text"
          data-ar-placeholder="ابحث بالاسم أو الباركود..." data-en-placeholder="Search by name or barcode..."
          placeholder="ابحث بالاسم أو الباركود..."
          oninput="onSearchInput()"
          class="w-full border rounded-xl pr-10 pl-9 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-200 transition-all"/>
        <button id="clearSearchBtn" type="button" onclick="clearSearch()" class="hidden absolute inset-y-0 left-3 flex items-center text-gray-400 hover:text-gray-600 text-sm">✕</button>
      </div>

      <!-- Sort By Dropdown -->
      <div class="flex items-center gap-2 flex-shrink-0">
        <label for="sortBySelect" class="text-xs font-bold text-gray-600 flex items-center gap-1 whitespace-nowrap">
          <span>↕️</span> <span>ترتيب حسب:</span>
        </label>
        <select id="sortBySelect" onchange="applyFilters()"
          class="border rounded-xl px-3 py-2 text-xs font-semibold text-gray-700 bg-gray-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-200 cursor-pointer">
          <option value="newest">📅 الأحدث إضافةً (من الأحدث للأقدم)</option>
          <option value="oldest">📅 الأقدم إضافةً (من الأقدم للأحدث)</option>
          <option value="price_desc">💰 السعر: من الأغلى للأرخص</option>
          <option value="price_asc">🏷️ السعر: من الأرخص للأغلى</option>
          <option value="name_asc">🔤 أبجدي: أ إلى ي (A-Z)</option>
          <option value="name_desc">🔤 أبجدي: ي إلى أ (Z-A)</option>
          <option value="qty_desc">📦 الكمية: الأكثر توفراً</option>
          <option value="qty_asc">⚠️ الكمية: الأقل توفراً</option>
        </select>
      </div>
    </div>

    <!-- Middle Row: Website Visibility Tabs & Filter Status -->
    <div class="flex flex-wrap items-center justify-between gap-2.5 pt-2 border-t border-gray-100">
      <!-- Website Visibility Toggle Pills -->
      <div class="flex items-center gap-1.5 flex-wrap">
        <span class="text-xs font-bold text-gray-600 ml-1">عرض المتجر:</span>
        
        <button type="button" onclick="setWebsiteFilter('all')" data-filter="all"
          class="web-filter-btn text-xs px-3 py-1.5 rounded-xl border font-bold transition-all bg-blue-700 text-white border-blue-700 shadow-sm flex items-center gap-1.5">
          <span>📋 الكل</span>
          <span id="badge-all-count" class="bg-white/20 text-white text-[10px] px-1.5 py-0.5 rounded-full font-mono">0</span>
        </button>

        <button type="button" onclick="setWebsiteFilter('visible')" data-filter="visible"
          class="web-filter-btn text-xs px-3 py-1.5 rounded-xl border font-medium transition-all bg-white text-gray-600 border-gray-200 hover:border-gray-300 hover:bg-gray-50 flex items-center gap-1.5">
          <span>🌐 معروض بالموقع</span>
          <span id="badge-visible-count" class="bg-emerald-100 text-emerald-700 text-[10px] px-1.5 py-0.5 rounded-full font-mono font-bold">0</span>
        </button>

        <button type="button" onclick="setWebsiteFilter('hidden')" data-filter="hidden"
          class="web-filter-btn text-xs px-3 py-1.5 rounded-xl border font-medium transition-all bg-white text-gray-600 border-gray-200 hover:border-amber-300 hover:bg-amber-50/50 flex items-center gap-1.5"
          title="عرض المنتجات غير المعروضة على الموقع فقط">
          <span>🙈 غير معروض بالموقع (مخفي)</span>
          <span id="badge-hidden-count" class="bg-amber-100 text-amber-700 text-[10px] px-1.5 py-0.5 rounded-full font-mono font-bold">0</span>
        </button>
      </div>

      <!-- Filter count and Reset Button -->
      <div class="flex items-center gap-2 mr-auto">
        <span id="filteredCount" class="text-xs font-semibold text-gray-500"></span>
        <button id="resetFiltersBtn" type="button" onclick="resetAllFilters()"
          class="hidden text-xs text-red-600 bg-red-50 hover:bg-red-100 border border-red-200 px-2.5 py-1 rounded-lg font-bold transition-colors flex items-center gap-1">
          <span>🔄</span> <span>إعادة ضبط</span>
        </button>
      </div>
    </div>

    <!-- Bottom Row: Category Filter Badges -->
    <div id="categoryFilters" class="flex flex-wrap gap-1.5 pt-2 border-t border-gray-100 hidden">
      <button onclick="setCategoryFilter(null)"
        id="cat-all"
        data-cat="all"
        class="cat-filter-btn text-xs px-3 py-1.5 rounded-full border font-medium bg-blue-700 text-white border-blue-700">
        كل الفئات
      </button>
    </div>
  </div>

  <!-- Table -->
  <div class="bg-white rounded-2xl border shadow-sm overflow-x-auto">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 border-b">
        <tr class="text-right text-gray-600 font-semibold">
          <th class="px-4 py-3">الصورة</th>
        <th class="px-4 py-3">المنتج</th>
          <th class="px-4 py-3">الفئة</th>
          <th class="px-4 py-3">الباركود</th>
          <th class="px-4 py-3">الكمية</th>
          <th class="px-4 py-3">الحد الأدنى</th>
          <th class="px-4 py-3">سعر الشراء</th>
          <th class="px-4 py-3">سعر البيع</th>
          <th class="px-4 py-3">الصلاحية</th>
          <th class="px-4 py-3">إجراءات</th>
        </tr>
      </thead>
      <tbody id="productTable" class="divide-y"></tbody>
    </table>
    <div id="noProducts" class="hidden text-center text-gray-400 py-12" data-ar="لا توجد منتجات" data-en="No products found">لا توجد منتجات</div>
  </div>
</div>

<!-- Add/Edit Modal -->
<div id="modal" class="hidden fixed inset-0 bg-black/40 flex items-center justify-center z-50 p-4">
  <div class="bg-white rounded-2xl w-full max-w-lg shadow-2xl max-h-[90vh] overflow-y-auto">
    <div class="p-5 border-b flex items-center justify-between sticky top-0 bg-white z-10">
      <h3 id="modalTitle" class="font-bold text-gray-800 text-lg">إضافة منتج</h3>
      <button onclick="closeModal()" class="text-gray-400 hover:text-gray-600 text-2xl leading-none">×</button>
    </div>
    <form id="productForm" onsubmit="saveProduct(event)" class="p-5 space-y-4">
      <input type="hidden" id="editId"/>
      <!-- صور المنتج — للعرض فقط، الإضافة/التعديل من لوحة التحكم -->
      <div id="photoPreviewSection" class="hidden">
        <label class="text-xs font-medium text-gray-600 block mb-2">🖼️ صور المنتج</label>
        <div id="photosGrid" class="flex gap-2 flex-wrap"></div>
        <p class="text-xs text-gray-400 mt-1">لإضافة أو تعديل الصور، استخدم لوحة التحكم</p>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div class="col-span-2">
          <label class="text-xs font-medium text-gray-600" data-ar="اسم المنتج *" data-en="Product Name *">اسم المنتج *</label>
          <input id="f-name" required class="w-full border rounded-xl px-3 py-2 text-sm mt-1 focus:outline-none focus:ring-2 focus:ring-blue-200"
            data-ar-placeholder="اسم المنتج" data-en-placeholder="Product name" placeholder="اسم المنتج"/>
        </div>

        <!-- Barcode with generate button -->
        <div class="col-span-2">
          <label class="text-xs font-medium text-gray-600" data-ar="الباركود (5 أرقام)" data-en="Barcode (5 digits)">الباركود (5 أرقام)</label>
          <div class="flex gap-2 mt-1">
            <input id="f-barcode" class="flex-1 border rounded-xl px-3 py-2 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-blue-200" placeholder="اختياري أو توليد تلقائي"/>
            <button type="button" onclick="generateBarcode()"
              class="bg-amber-500 hover:bg-amber-600 text-white px-3 py-2 rounded-xl text-xs font-semibold whitespace-nowrap flex items-center gap-1">
              🎲 توليد
            </button>
          </div>
        </div>

        <div>
          <label class="text-xs font-medium text-gray-600" data-ar="الكمية" data-en="Quantity">الكمية</label>
          <input id="f-qty" type="number" min="0" class="w-full border rounded-xl px-3 py-2 text-sm mt-1 focus:outline-none focus:ring-2 focus:ring-blue-200" placeholder="0"/>
        </div>
        <div>
          <label class="text-xs font-medium text-gray-600" data-ar="تاريخ الصلاحية" data-en="Expiry Date">تاريخ الصلاحية</label>
          <input id="f-expiry" type="date" class="w-full border rounded-xl px-3 py-2 text-sm mt-1 focus:outline-none focus:ring-2 focus:ring-blue-200"/>
        </div>
        <div>
          <label class="text-xs font-medium text-gray-600" data-ar="سعر الشراء (جنيه)" data-en="Cost Price (EGP)">سعر الشراء (جنيه)</label>
          <input id="f-purchase" type="number" step="0.01" min="0" class="w-full border rounded-xl px-3 py-2 text-sm mt-1 focus:outline-none focus:ring-2 focus:ring-blue-200" placeholder="0.00"/>
        </div>
        <div>
          <label class="text-xs font-medium text-gray-600">سعر البيع (جنيه)</label>
          <input id="f-sale" type="number" step="0.01" min="0" class="w-full border rounded-xl px-3 py-2 text-sm mt-1 focus:outline-none focus:ring-2 focus:ring-blue-200" placeholder="0.00"/>
        </div>
        <div>
          <label class="text-xs font-medium text-gray-600">الحد الأدنى للمخزون</label>
          <input id="f-min-stock" type="number" min="0" class="w-full border rounded-xl px-3 py-2 text-sm mt-1 focus:outline-none focus:ring-2 focus:ring-blue-200" placeholder="0"/>
        </div>

        <!-- Warehouse Quick Action & Batches Preview -->
        <div id="whQuickSection" class="col-span-2 hidden bg-gradient-to-r from-blue-50 to-indigo-50 border border-blue-200 rounded-2xl p-4 space-y-3">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="text-lg">🏢</span>
              <div>
                <span class="text-xs font-bold text-gray-800 block">المستودع الرئيسي والشحنات:</span>
                <span id="whQuickStockText" class="text-[11px] text-gray-500">المتاح بالمستودع: <strong id="whQuickAvailQty" class="text-blue-700">0</strong> قطعة</span>
              </div>
            </div>
            <button type="button" onclick="openQuickWhTransfer()"
              class="bg-blue-600 hover:bg-blue-700 text-white font-bold px-3.5 py-1.5 rounded-xl text-xs shadow-sm transition-all flex items-center gap-1.5">
              <span>🚚</span> سحب من المستودع
            </button>
          </div>
          
          <!-- Batches Table Preview -->
          <div id="whBatchesContainer" class="hidden space-y-1.5 border-t border-blue-200/60 pt-2.5">
            <div class="text-[11px] font-bold text-gray-700 flex items-center justify-between">
              <span>📦 تفصيل شحنات التكلفة وتواريخ الصلاحية:</span>
              <span class="text-[10px] text-gray-400 font-normal">نظام FIFO التلقائي</span>
            </div>
            <div id="whBatchesList" class="space-y-1.5 max-h-32 overflow-y-auto"></div>
          </div>
        </div>
        <div class="col-span-2">
          <label class="text-xs font-medium text-gray-600">الفئة</label>
          <input id="f-category" autocomplete="off"
            class="w-full border rounded-xl px-3 py-2 text-sm mt-1 focus:outline-none focus:ring-2 focus:ring-blue-200"
            placeholder="اكتب فئة جديدة أو اختر من القائمة أدناه"/>
          <select id="f-category-select"
            onchange="if(this.value){document.getElementById('f-category').value=this.value;this.value='';}" 
            class="w-full border rounded-xl px-3 py-2 text-sm mt-2 focus:outline-none focus:ring-2 focus:ring-blue-200 bg-white text-gray-600">
            <option value="">اختر فئة موجودة...</option>
          </select>
        </div>
        <div class="col-span-2">
          <label class="text-xs font-medium text-gray-600">الوصف</label>
          <textarea id="f-description" rows="3"
            class="w-full border rounded-xl px-3 py-2 text-sm mt-1 focus:outline-none focus:ring-2 focus:ring-blue-200 resize-none"
            placeholder="وصف المنتج (اختياري)..."></textarea>
        </div>

        <!-- Section Selector -->
        <div class="col-span-2">
          <label class="text-xs font-medium text-gray-600 block mb-2">القسم على موقع DenTrust</label>
          <div class="flex gap-3">
            <label class="flex-1 flex items-center gap-2.5 border-2 rounded-xl px-4 py-3 cursor-pointer transition-colors section-opt" id="sec-dental-lbl">
              <input type="radio" name="f-section" id="sec-dental" value="dental" checked onchange="onSectionChange()" class="w-4 h-4 accent-blue-700 flex-shrink-0"/>
              <div>
                <div class="text-sm font-semibold text-gray-800">🦷 منتج أسنان</div>
                <div class="text-xs text-gray-500">يظهر في قسم Products</div>
              </div>
            </label>
            <label class="flex-1 flex items-center gap-2.5 border-2 rounded-xl px-4 py-3 cursor-pointer transition-colors section-opt" id="sec-medical-lbl">
              <input type="radio" name="f-section" id="sec-medical" value="medical" onchange="onSectionChange()" class="w-4 h-4 accent-teal-600 flex-shrink-0"/>
              <div>
                <div class="text-sm font-semibold text-gray-800">🩺 ملابس طبية</div>
                <div class="text-xs text-gray-500">يظهر في قسم Medical Wear</div>
              </div>
            </label>
          </div>
        </div>

      </div><!-- end grid -->

      <!-- Variants Section -->
      <div id="variantsSection" class="hidden border border-blue-100 rounded-2xl p-4 space-y-3 bg-blue-50/30">
        <div class="flex items-center justify-between">
          <label class="text-xs font-semibold text-gray-600">📦 التفاصيل (Variants)</label>
          <span class="text-xs text-gray-500">الإجمالي: <span id="totalQtyPreview" class="font-bold text-blue-700">0</span> قطعة</span>
        </div>
        <div id="itemsTable" class="space-y-2"></div>
        <div id="noItemsMsg" class="text-xs text-gray-400 text-center py-2">لا توجد variants بعد — أضف أدناه</div>
        <div class="flex gap-2 flex-wrap">
          <input type="text" id="f-item-label" placeholder="الاسم (مثال: علبة كبيرة)"
            class="flex-1 border rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-200"/>
          <input type="number" id="f-item-boxes" placeholder="عدد" min="1"
            class="w-20 border rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-200"/>
          <input type="number" id="f-item-qpb" placeholder="كمية/علبة" min="1"
            class="w-28 border rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-200"/>
          <button type="button" onclick="addItem()"
            class="bg-blue-700 text-white px-4 py-2 rounded-xl text-sm font-semibold hover:bg-blue-800">+ إضافة</button>
        </div>
      </div>

      <!-- Checkbox Options Builder -->
      <div class="border border-gray-200 rounded-2xl p-4 space-y-3">
        <div class="flex items-center justify-between">
          <label class="text-xs font-semibold text-gray-600">خيارات المنتج (Custom Options)</label>
          <span class="text-xs text-gray-500">الإجمالي: <span id="cbTotalQty" class="font-bold text-blue-700">0</span> قطعة</span>
        </div>
        <div id="cbCategoriesContainer" class="space-y-2"></div>
        <div id="cbAddCatRow" class="flex gap-2">
          <input type="text" id="cbNewCatInput" placeholder="اسم المجموعة (مثال: الحجم، اللون...)"
            class="flex-1 border rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-200"
            onkeydown="if(event.key==='Enter'){event.preventDefault();cbAddCategory();}"/>
          <button type="button" onclick="cbAddCategory()"
            class="bg-blue-700 text-white px-4 py-2 rounded-xl text-sm font-semibold hover:bg-blue-800">+ مجموعة</button>
        </div>
      </div>

      <!-- Website Visibility Toggle Card -->
      <div class="bg-indigo-50/60 border border-indigo-200 rounded-2xl p-3.5 flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <span class="text-xl">🌐</span>
          <div>
            <div class="text-xs font-bold text-gray-800">العرض على المتجر الإلكتروني (الموقع)</div>
            <div class="text-[11px] text-gray-500">اختر إذا كان هذا المنتج يظهر للعملاء في الموقع أم لا</div>
          </div>
        </div>
        <label class="flex items-center gap-2 cursor-pointer bg-white px-3 py-1.5 rounded-xl border border-indigo-200 shadow-sm">
          <input type="checkbox" id="f-is-hidden-website" class="w-4 h-4 accent-red-600 rounded"/>
          <span class="text-xs font-bold text-red-600">إخفاء من الموقع</span>
        </label>
      </div>

      <!-- Sync Note (small badge) -->
      <div id="syncNote" class="hidden flex items-center gap-2 text-xs text-blue-500 bg-blue-50 border border-blue-100 rounded-lg px-3 py-1.5">
        <span>🔗</span><span id="syncNoteText">هذا المنتج مرتبط بـ DenTrust — التعديل سيتم تلقائياً</span>
      </div>

      <div id="modalError" class="hidden text-red-500 text-sm bg-red-50 rounded-lg px-3 py-2"></div>
      <div class="flex gap-3 pt-2">
        <button type="submit" id="submitBtn" class="flex-1 bg-blue-700 text-white font-semibold py-2.5 rounded-xl hover:bg-blue-800" data-ar="حفظ" data-en="Save">حفظ</button>
        <button type="button" onclick="closeModal()" class="flex-1 bg-gray-100 text-gray-700 font-semibold py-2.5 rounded-xl hover:bg-gray-200" data-ar="إلغاء" data-en="Cancel">إلغاء</button>
      </div>
    </form>
  </div>
</div>
<script>
const BASE = "<%- base %>";
let allProducts = [];
const productMap = {};
let activeCategoryFilter = null;
let showMinStockOnly = false;
let activeWebsiteFilter = 'all'; // 'all' | 'visible' | 'hidden'

function isProductHidden(p) {
  if (!p) return false;
  return p.is_hidden_from_website === true || 
         p.is_hidden_from_website === 'true' || 
         p.is_hidden_from_website === 1 || 
         p.is_hidden === true || 
         p.hidden === true || 
         p.section === 'hidden';
}

function updateCounters() {
  const total = allProducts.length;
  const hiddenCount = allProducts.filter(p => isProductHidden(p)).length;
  const visibleCount = total - hiddenCount;
  const lowCount = allProducts.filter(p => (p.min_stock||0) > 0 && p.quantity <= (p.min_stock||0)).length;
  const outCount = allProducts.filter(p => p.quantity <= 0).length;

  const statTotal = document.getElementById("stat-total");
  if (statTotal) statTotal.textContent = total;
  const statLow = document.getElementById("stat-low");
  if (statLow) statLow.textContent = lowCount;
  const statOut = document.getElementById("stat-out");
  if (statOut) statOut.textContent = outCount;
  const statHidden = document.getElementById("stat-hidden");
  if (statHidden) statHidden.textContent = hiddenCount;

  const badgeAll = document.getElementById("badge-all-count");
  if (badgeAll) badgeAll.textContent = total;
  const badgeVis = document.getElementById("badge-visible-count");
  if (badgeVis) badgeVis.textContent = visibleCount;
  const badgeHid = document.getElementById("badge-hidden-count");
  if (badgeHid) badgeHid.textContent = hiddenCount;

  // Low stock banner
  const banner = document.getElementById("lowStockBanner");
  const bannerText = document.getElementById("lowStockBannerText");
  if (banner && bannerText) {
    if (lowCount > 0) {
      bannerText.textContent = `${lowCount} منتج وصل للحد الأدنى`;
      banner.classList.remove("hidden");
    } else {
      banner.classList.add("hidden");
    }
  }
}

async function loadProducts() {
  try {
    const res = await fetch(`${BASE}/api/products`, { headers: { 'x-pos-app': '1' } });
    const data = await res.json();
    allProducts = Array.isArray(data) ? data : (data.products || []);
    allProducts.forEach(p => productMap[p.id] = p);
  } catch (err) {
    console.error('Failed to load products:', err);
    allProducts = [];
  }

  updateCounters();

  // Build category filter buttons
  const categories = [...new Set(allProducts.map(p => p.category).filter(Boolean))].sort();
  const catSelect = document.getElementById("f-category-select");
  if (catSelect) {
    catSelect.innerHTML = '<option value="">اختر فئة موجودة...</option>' +
      categories.map(c => `<option value="${c}">${c}</option>`).join("");
  }
  const filterDiv = document.getElementById("categoryFilters");
  if (filterDiv) {
    if (categories.length > 0) {
      filterDiv.classList.remove("hidden");
      filterDiv.innerHTML = `<button data-cat="all" onclick="setCategoryFilter(null)"
        class="cat-filter-btn text-xs px-3 py-1.5 rounded-full border font-medium transition-colors ${!activeCategoryFilter ? 'bg-blue-700 text-white border-blue-700' : 'bg-white text-gray-600 border-gray-200 hover:border-blue-300'}">كل الفئات (${allProducts.length})</button>` +
        categories.map(c => {
          const count = allProducts.filter(p => p.category === c).length;
          const active = activeCategoryFilter === c;
          return `<button data-cat="${c}" onclick="setCategoryFilter('${c}')"
            class="cat-filter-btn text-xs px-3 py-1.5 rounded-full border font-medium transition-colors ${active ? 'bg-blue-700 text-white border-blue-700' : 'bg-white text-gray-600 border-gray-200 hover:border-blue-300'}">${c} (${count})</button>`;
        }).join("");
    } else {
      filterDiv.classList.add("hidden");
    }
  }

  applyFilters();

  // Financial summary (manager only)
  const finCard = document.getElementById("financialCard");
  if (finCard && finCard.dataset.isMgr === "true") {
    const fmt = n => Number(n).toLocaleString("ar-EG", {minimumFractionDigits: 0, maximumFractionDigits: 0}) + " ج";
    const totalCost    = allProducts.reduce((s, p) => s + (parseFloat(p.purchase_price)||0) * (parseInt(p.quantity)||0), 0);
    const totalRevenue = allProducts.reduce((s, p) => s + (parseFloat(p.sale_price)||0)     * (parseInt(p.quantity)||0), 0);
    const totalProfit  = totalRevenue - totalCost;
    document.getElementById("fin-cost").textContent    = fmt(totalCost);
    document.getElementById("fin-revenue").textContent = fmt(totalRevenue);
    document.getElementById("fin-profit").textContent  = (totalProfit >= 0 ? "+" : "") + fmt(Math.abs(totalProfit));
    finCard.style.display = "block";
    if (totalCost === 0 && totalRevenue === 0) {
      document.getElementById("fin-zero-note").style.display = "block";
    }
  }
}

function renderTable(products) {
  const tbody = document.getElementById("productTable");
  const noMsg = document.getElementById("noProducts");
  if (products.length === 0) { tbody.innerHTML = ""; noMsg.classList.remove("hidden"); return; }
  noMsg.classList.add("hidden");
  tbody.innerHTML = products.map(p => {
    const today = new Date().toISOString().split("T")[0];
    const expStyle = p.expiry_date && p.expiry_date < today ? "text-red-600 font-semibold" : p.expiry_date ? "text-gray-700" : "text-gray-400";
    const minStock = parseInt(p.min_stock) || 0;
    const isLow = minStock > 0 && p.quantity <= minStock;
    const isOut = p.quantity <= 0;
    const qtyStyle = isOut ? "text-red-600 font-black" : isLow ? "text-orange-500 font-bold" : "text-gray-700";
    const rowBg = isOut ? "bg-red-50" : isLow ? "bg-orange-50" : "";
    const minStockCell = minStock > 0
      ? `<span class="text-xs font-semibold ${isLow ? 'text-orange-600 bg-orange-100 px-2 py-0.5 rounded-full' : 'text-gray-500'}">${minStock}</span>`
      : `<span class="text-gray-300">—</span>`;
    const thumbCell = `<div style="width:2.75rem;height:2.75rem;border-radius:0.5rem;" class="bg-gray-100 flex items-center justify-center text-gray-300 text-xs">—</div>`;
    
    const isHidden = p.is_hidden_from_website === true || p.is_hidden_from_website === 'true' || p.is_hidden_from_website === 1 || p.is_hidden === true || p.hidden === true || p.section === 'hidden';
    const hideBtn = `
      <button onclick="toggleWebsiteVisibility(${p.id}, ${isHidden}, this)" title="${isHidden ? 'المنتج مخفي حالياً من الموقع - اضغط لإظهاره' : 'المنتج معروض على الموقع - اضغط لإخفائه'}"
        class="text-xs px-2.5 py-1.5 rounded-lg font-bold transition-all flex items-center gap-1 ${isHidden ? 'bg-gray-100 text-gray-500 border border-gray-300 hover:bg-gray-200' : 'bg-emerald-50 text-emerald-700 border border-emerald-200 hover:bg-emerald-100'}">
        <span>${isHidden ? '🙈' : '🌐'}</span>
        <span>${isHidden ? 'مخفي بالموقع' : 'معروض بالموقع'}</span>
      </button>
    `;

    return `<tr class="hover:bg-gray-50 ${rowBg}">
      <td class="px-4 py-3">${thumbCell}</td>
      <td class="px-4 py-3 font-medium text-gray-800">${p.product_name}${p.dentrust_id ? ' <span class="text-xs text-blue-400" title="مرتبط بـ DenTrust">🔗</span>' : ''}${isLow && !isOut ? ' <span class="text-xs text-orange-500">⚠️</span>' : ''}${isOut ? ' <span class="text-xs text-red-500">🚫</span>' : ''}</td>
      <td class="px-4 py-3"><span class="text-xs ${p.category ? 'bg-indigo-50 text-indigo-700 px-2 py-0.5 rounded-full font-medium' : 'text-gray-300'}">${p.category || '—'}</span></td>
      <td class="px-4 py-3 font-mono text-gray-500 text-xs">${p.barcode || '—'}</td>
      <td class="px-4 py-3">${variantQtyCell(p, qtyStyle)}</td>
      <td class="px-4 py-3">${minStockCell}</td>
      <td class="px-4 py-3 text-gray-600">${parseFloat(p.purchase_price||0).toFixed(2)}</td>
      <td class="px-4 py-3 text-blue-700 font-semibold">${parseFloat(p.sale_price||0).toFixed(2)}</td>
      <td class="px-4 py-3 text-sm ${expStyle}">${p.expiry_date || '—'}</td>
      <td class="px-4 py-3">
        <div class="flex items-center gap-1.5 flex-wrap">
          ${hideBtn}
          <button onclick="editProduct(${p.id})" class="text-xs bg-blue-50 text-blue-700 px-3 py-1.5 rounded-lg hover:bg-blue-100 font-medium">تعديل</button>
          <button onclick="deleteProduct(${p.id})" class="text-xs bg-red-50 text-red-600 px-3 py-1.5 rounded-lg hover:bg-red-100 font-medium">حذف</button>
        </div>
      </td>
    </tr>`;
  }).join("");
}

function onSearchInput() {
  const q = (document.getElementById("searchBox")?.value || "").trim();
  const clearBtn = document.getElementById("clearSearchBtn");
  if (clearBtn) clearBtn.classList.toggle("hidden", !q);
  applyFilters();
}

function clearSearch() {
  const searchBox = document.getElementById("searchBox");
  if (searchBox) searchBox.value = "";
  const clearBtn = document.getElementById("clearSearchBtn");
  if (clearBtn) clearBtn.classList.add("hidden");
  applyFilters();
}

function setWebsiteFilter(filter) {
  activeWebsiteFilter = filter;
  document.querySelectorAll('.web-filter-btn').forEach(btn => {
    const isTarget = btn.dataset.filter === filter;
    if (isTarget) {
      if (filter === 'hidden') {
        btn.className = 'web-filter-btn text-xs px-3 py-1.5 rounded-xl border font-bold transition-all bg-amber-600 text-white border-amber-600 shadow-sm flex items-center gap-1.5';
      } else if (filter === 'visible') {
        btn.className = 'web-filter-btn text-xs px-3 py-1.5 rounded-xl border font-bold transition-all bg-emerald-600 text-white border-emerald-600 shadow-sm flex items-center gap-1.5';
      } else {
        btn.className = 'web-filter-btn text-xs px-3 py-1.5 rounded-xl border font-bold transition-all bg-blue-700 text-white border-blue-700 shadow-sm flex items-center gap-1.5';
      }
    } else {
      btn.className = 'web-filter-btn text-xs px-3 py-1.5 rounded-xl border font-medium transition-all bg-white text-gray-600 border-gray-200 hover:border-gray-300 hover:bg-gray-50 flex items-center gap-1.5';
    }
  });
  applyFilters();
}

function resetAllFilters() {
  clearSearch();
  activeCategoryFilter = null;
  showMinStockOnly = false;
  activeWebsiteFilter = 'all';
  
  const sortSelect = document.getElementById("sortBySelect");
  if (sortSelect) sortSelect.value = 'newest';

  setWebsiteFilter('all');
  document.querySelectorAll(".cat-filter-btn").forEach(btn => {
    const active = btn.dataset.cat === "all";
    btn.className = `cat-filter-btn text-xs px-3 py-1.5 rounded-full border font-medium transition-colors ${active ? 'bg-blue-700 text-white border-blue-700' : 'bg-white text-gray-600 border-gray-200 hover:border-blue-300'}`;
  });
  document.getElementById("lowStockBanner")?.classList.add("hidden");
  
  applyFilters();
}

function applyFilters() {
  const q = (document.getElementById("searchBox")?.value || "").trim().toLowerCase();
  let filtered = allProducts.slice();

  // 1. فلتر حالة العرض على الموقع (الكل / معروض بالموقع / غير معروض بالموقع)
  if (activeWebsiteFilter === 'hidden') {
    filtered = filtered.filter(p => isProductHidden(p));
  } else if (activeWebsiteFilter === 'visible') {
    filtered = filtered.filter(p => !isProductHidden(p));
  }

  // 2. فلتر الفئة
  if (activeCategoryFilter) {
    filtered = filtered.filter(p => p.category === activeCategoryFilter);
  }

  // 3. فلتر الحد الأدنى للمخزون
  if (showMinStockOnly) {
    filtered = filtered.filter(p => (p.min_stock || 0) > 0 && p.quantity <= (p.min_stock || 0));
  }

  // 4. البحث بالاسم أو الباركود
  if (q) {
    filtered = filtered.filter(p => 
      (p.product_name && p.product_name.toLowerCase().includes(q)) || 
      (p.barcode && String(p.barcode).toLowerCase().includes(q))
    );
  }

  // 5. الترتيب (أحدث، أقدم، أغلى، أرخص، أبجدي أ-ي، أبجدي ي-أ، الكمية)
  const sort = document.getElementById("sortBySelect")?.value || 'newest';
  filtered.sort((a, b) => {
    switch (sort) {
      case 'newest':
        // من الأحدث للأقدم (أكبر ID أولاً)
        return (b.id || 0) - (a.id || 0);
      case 'oldest':
        // من الأقدم للأحدث (أصغر ID أولاً)
        return (a.id || 0) - (b.id || 0);
      case 'price_desc':
        // من الأغلى للأرخص (سعر البيع تنازلي)
        return (parseFloat(b.sale_price) || 0) - (parseFloat(a.sale_price) || 0);
      case 'price_asc':
        // من الأرخص للأغلى (سعر البيع تصاعدي)
        return (parseFloat(a.sale_price) || 0) - (parseFloat(b.sale_price) || 0);
      case 'name_asc':
        // أبجدي: أ إلى ي (A-Z)
        return (a.product_name || '').localeCompare(b.product_name || '', 'ar', { numeric: true, sensitivity: 'base' });
      case 'name_desc':
        // أبجدي: ي إلى أ (Z-A)
        return (b.product_name || '').localeCompare(a.product_name || '', 'ar', { numeric: true, sensitivity: 'base' });
      case 'qty_desc':
        // الكمية: الأكثر توفراً
        return (parseInt(b.quantity) || 0) - (parseInt(a.quantity) || 0);
      case 'qty_asc':
        // الكمية: الأقل توفراً
        return (parseInt(a.quantity) || 0) - (parseInt(b.quantity) || 0);
      default:
        return (b.id || 0) - (a.id || 0);
    }
  });

  // تحديث عداد النتائج وزر إعادة الضبط
  const countEl = document.getElementById("filteredCount");
  if (countEl) {
    if (filtered.length === allProducts.length) {
      countEl.textContent = `إجمالي: ${allProducts.length} صنف`;
    } else {
      countEl.innerHTML = `<span class="text-blue-700 font-bold">${filtered.length}</span> من أصل ${allProducts.length} صنف`;
    }
  }

  const resetBtn = document.getElementById("resetFiltersBtn");
  if (resetBtn) {
    const isFiltered = q !== "" || activeCategoryFilter !== null || showMinStockOnly || activeWebsiteFilter !== 'all' || sort !== 'newest';
    resetBtn.classList.toggle("hidden", !isFiltered);
  }

  renderTable(filtered);
}

function setCategoryFilter(cat) {
  activeCategoryFilter = cat;
  showMinStockOnly = false;
  document.getElementById("lowStockBanner")?.classList.add("hidden");
  document.querySelectorAll(".cat-filter-btn").forEach(btn => {
    const active = (btn.dataset.cat === "all" && !cat) || (btn.dataset.cat === cat);
    btn.className = `cat-filter-btn text-xs px-3 py-1.5 rounded-full border font-medium transition-colors ${active ? 'bg-blue-700 text-white border-blue-700' : 'bg-white text-gray-600 border-gray-200 hover:border-blue-300'}`;
  });
  applyFilters();
}

function clearCategoryFilter() {
  setCategoryFilter(null);
  showMinStockOnly = false;
}

function filterByMinStock() {
  activeCategoryFilter = null;
  showMinStockOnly = true;
  document.querySelectorAll(".cat-filter-btn").forEach(btn => {
    btn.className = `cat-filter-btn text-xs px-3 py-1.5 rounded-full border font-medium transition-colors bg-white text-gray-600 border-gray-200 hover:border-blue-300`;
  });
  applyFilters();
}

async function generateBarcode() {
  const res = await fetch(`${BASE}/api/products/generate-barcode`);
  const data = await res.json();
  document.getElementById("f-barcode").value = data.barcode;
}

// ── Photo preview (read-only — upload from dashboard only) ───────────────────
function renderPhotosGrid(photos) {
  const grid = document.getElementById('photosGrid');
  const section = document.getElementById('photoPreviewSection');
  if (!grid || !section) return;
  const validPhotos = (photos || []).filter(Boolean);
  if (!validPhotos.length) { section.classList.add('hidden'); return; }
  section.classList.remove('hidden');
  grid.innerHTML = validPhotos.map(url =>
    `<div style="width:4rem;height:4rem;border-radius:0.75rem;border:2px solid #93c5fd;overflow:hidden;flex-shrink:0;">
      <img src="${url}" style="width:100%;height:100%;object-fit:cover;" onerror="this.style.display='none'"/>
    </div>`
  ).join('');
}

function resetPhotos() { renderPhotosGrid([]); }

function loadPhotos(arr) { renderPhotosGrid(arr); }

function onSectionChange() {
  const val = document.querySelector('input[name="f-section"]:checked')?.value || 'dental';
  document.getElementById("sec-dental-lbl").className =
    `flex-1 flex items-center gap-2.5 border-2 rounded-xl px-4 py-3 cursor-pointer transition-colors section-opt ${val==='dental' ? 'border-blue-700 bg-blue-50' : 'border-gray-200'}`;
  document.getElementById("sec-medical-lbl").className =
    `flex-1 flex items-center gap-2.5 border-2 rounded-xl px-4 py-3 cursor-pointer transition-colors section-opt ${val==='medical' ? 'border-teal-600 bg-teal-50' : 'border-gray-200'}`;
}

function setSection(val) {
  const el = document.getElementById(val === 'medical' ? 'sec-medical' : 'sec-dental');
  if (el) { el.checked = true; onSectionChange(); }
}

function openModal() {
  document.getElementById("modalTitle").textContent = "إضافة منتج جديد";
  document.getElementById("editId").value = "";
  document.getElementById("productForm").reset();
  document.getElementById("modalError").classList.add("hidden");
  document.getElementById("whQuickSection").classList.add("hidden");
  document.getElementById("f-is-hidden-website").checked = false;
  resetPhotos();
  resetVariants();
  cbReset();
  setSection('dental');
  generateBarcode();
  const sn = document.getElementById("syncNote");
  sn.classList.remove("hidden");
  document.getElementById("syncNoteText").textContent = "سيتم إضافة هذا المنتج تلقائياً في موقع DenTrust";
  document.getElementById("modal").classList.remove("hidden");
}

let _currentEditProd = null;
let _whItemForEdit = null;

function editProduct(id) {
  const p = productMap[id];
  if (!p) { alert("لم يتم العثور على المنتج، يرجى تحديث الصفحة والمحاولة مجدداً"); return; }
  _currentEditProd = p;
  document.getElementById("modalTitle").textContent = "تعديل المنتج";
  document.getElementById("editId").value = p.id;
  document.getElementById("f-name").value = p.product_name;
  document.getElementById("f-barcode").value = p.barcode || "";
  document.getElementById("f-qty").value = p.quantity != null ? p.quantity : 0;
  document.getElementById("f-purchase").value = (p.purchase_price !== undefined && p.purchase_price !== null) ? p.purchase_price : 0;
  document.getElementById("f-sale").value = (p.sale_price !== undefined && p.sale_price !== null) ? p.sale_price : 0;
  document.getElementById("f-expiry").value = p.expiry_date || "";
  document.getElementById("f-category").value = p.category || "";
  document.getElementById("f-min-stock").value = p.min_stock || 0;
  document.getElementById("f-description").value = p.description || "";
  document.getElementById("f-is-hidden-website").checked = p.is_hidden_from_website === true || p.is_hidden_from_website === 'true' || p.is_hidden_from_website === 1 || p.is_hidden === true || p.hidden === true;
  document.getElementById("modalError").classList.add("hidden");

  // Load Warehouse Quick Info & Cost Batches
  const whSec = document.getElementById("whQuickSection");
  whSec.classList.remove("hidden");
  document.getElementById("whQuickAvailQty").textContent = "جارٍ الفحص...";
  
  fetch(`${BASE}/api/warehouse/products`)
    .then(r => r.json())
    .then(data => {
      const whItem = (data.items || []).find(w => w.product_id === p.id || (w.product_name || '').toLowerCase() === p.product_name.toLowerCase());
      _whItemForEdit = whItem;
      const whQty = whItem ? parseInt(whItem.quantity || 0) : 0;
      document.getElementById("whQuickAvailQty").textContent = whQty;
    }).catch(() => {
      document.getElementById("whQuickAvailQty").textContent = "0";
    });

  // Load Cost Batches Breakdown
  const bContainer = document.getElementById("whBatchesContainer");
  const bList = document.getElementById("whBatchesList");
  fetch(`${BASE}/api/products/${p.id}/cost-batches`)
    .then(r => r.json())
    .then(data => {
      const batches = data.batches || [];
      if (!batches.length) {
        bContainer.classList.add("hidden");
      } else {
        bContainer.classList.remove("hidden");
        const distinctCosts = Array.from(new Set(batches.map(b => parseFloat(b.cost_price||0))));
        if (distinctCosts.length === 1 && distinctCosts[0] > 0) {
          document.getElementById("f-purchase").value = distinctCosts[0];
        }
        bList.innerHTML = batches.map((b, idx) => {
          const isActive = idx === 0;
          const optBadge = b.selected_option ? `<span class="bg-blue-100 text-blue-800 text-[10px] font-bold px-1.5 py-0.5 rounded-md font-mono border border-blue-200">مقاس: ${b.selected_option}</span>` : '';
          return `
            <div class="flex items-center justify-between text-xs p-2.5 rounded-xl border ${isActive ? 'bg-emerald-50/80 border-emerald-200' : 'bg-white border-gray-200'}">
              <div class="flex items-center gap-1.5">
                <span>${isActive ? '🟢' : '⏳'}</span>
                <span class="font-bold text-gray-800">${isActive ? 'شحنة نشطة' : 'شحنة تالية'}</span>
                ${optBadge}
              </div>
              <div class="flex items-center gap-2">
                <div class="flex items-center gap-2.5 font-mono text-[11px]">
                  <span class="text-blue-700 font-bold">الكمية: ${b.remaining_quantity}</span>
                  <span class="text-amber-800 font-bold">التكلفة: ${parseFloat(b.cost_price||0).toFixed(2)} ج</span>
                  ${b.expiry_date ? `<span class="text-gray-500">صلاحية: ${b.expiry_date}</span>` : ''}
                </div>
                ${b.id > 0 ? `
                  <button type="button" onclick="removeCostBatch(${p.id}, ${b.id}, ${b.remaining_quantity}, '${(b.selected_option||'').replace(/'/g, "\\'")}')"
                    class="text-red-500 hover:text-red-700 hover:bg-red-50 px-2 py-1 rounded-lg text-xs font-bold transition-colors border border-red-200 flex items-center gap-1" title="حذف هذه الشحنة وإرجاعها للمستودع">
                    <span>🗑️</span> حذف الشحنة
                  </button>
                ` : ''}
              </div>
            </div>
          `;
        }).join('');
      }
    }).catch(() => {
      bContainer.classList.add("hidden");
    });

  // جيب الصور للعرض فقط (read-only)
  resetPhotos();
  fetch(`${BASE}/api/products/${p.id}/photos`)
    .then(r => r.json())
    .then(d => loadPhotos(d.photos || []))
    .catch(() => {
      const img = p.image_url || (p.has_image ? `${BASE}/api/products/${p.id}/image` : '');
      if (img) loadPhotos([img]);
    });
  loadVariants(p);
  setSection(p.section || 'dental');
  cbLoad(p.checkbox_values);
  const sn = document.getElementById("syncNote");
  sn.classList.toggle("hidden", !p.dentrust_id);
  if (p.dentrust_id) {
    document.getElementById("syncNoteText").textContent = "هذا المنتج مرتبط بـ DenTrust — التعديل سيتم تلقائياً";
  }
  document.getElementById("modal").classList.remove("hidden");
}

function openQuickWhTransfer() {
  if (!_currentEditProd) return;
  if (!_whItemForEdit || parseInt(_whItemForEdit.quantity || 0) <= 0) {
    alert(`لا توجد كميات متاحة في المستودع حالياً لهذا المنتج (${_currentEditProd.product_name}).\nيمكنك إضافة شحنة جديدة من صفحة المستودع.`);
    return;
  }

  // Check if warehouse item has variants
  let whOpts = [];
  if (_whItemForEdit.checkbox_values) {
    try {
      const cbv = typeof _whItemForEdit.checkbox_values === 'string' ? JSON.parse(_whItemForEdit.checkbox_values) : _whItemForEdit.checkbox_values;
      for (const k of Object.keys(cbv)) {
        if (typeof cbv[k] === 'object' && cbv[k] !== null) {
          if (cbv[k].stock != null) {
            whOpts.push({ key: k, stock: parseInt(cbv[k].stock || 0) });
          } else {
            for (const subK of Object.keys(cbv[k])) {
              if (typeof cbv[k][subK] === 'object' && cbv[k][subK] !== null && cbv[k][subK].stock != null) {
                whOpts.push({ key: subK, group: k, stock: parseInt(cbv[k][subK].stock || 0) });
              }
            }
          }
        }
      }
    } catch (_) {}
  }

  let selectedOpt = null;
  let maxAvail = parseInt(_whItemForEdit.quantity || 0);

  if (whOpts.length > 0) {
    const listStr = whOpts.map((o, i) => `${i + 1}. ${o.group ? '[' + o.group + '] ' : ''}${o.key} (متاح بالمستودع: ${o.stock} قطعة)`).join('\n');
    const choice = prompt(`اختر رقم المقاس المراد سحبه من المستودع:\n${listStr}\n\n(أدخل رقم المقاس):`, "1");
    if (!choice) return;
    const idx = parseInt(choice, 10) - 1;
    if (isNaN(idx) || idx < 0 || idx >= whOpts.length) {
      alert("رقم المقاس غير صحيح");
      return;
    }
    selectedOpt = whOpts[idx].key;
    maxAvail = whOpts[idx].stock;
    if (maxAvail <= 0) {
      alert(`المقاس (${selectedOpt}) رصيده صفر بالمستودع حالياً.`);
      return;
    }
  }

  const qtyStr = prompt(`المتاح بالمستودع (${selectedOpt ? 'لمقاس ' + selectedOpt : 'للصنف'}): ${maxAvail} قطعة\nأدخل الكمية المراد تحويلها وسحبها لمخزن المحل:`, "1");
  if (!qtyStr) return;
  const qty = parseInt(qtyStr, 10);
  if (isNaN(qty) || qty <= 0) {
    alert("يرجى إدخال كمية صحيحة أكبر من صفر");
    return;
  }
  if (qty > maxAvail) {
    alert(`الكمية المطلوبة (${qty}) أكبر من المتاح بالمستودع (${maxAvail})`);
    return;
  }

  fetch(`${BASE}/api/warehouse/transfer`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      warehouse_item_id: _whItemForEdit.id,
      quantity: qty,
      selected_option: selectedOpt,
      note: 'سحب سريع من المستودع لمخزن المحل'
    })
  }).then(r => r.json())
    .then(data => {
      if (data.error) throw new Error(data.error);
      alert(`✅ تم تحويل ${qty} قطعة ${selectedOpt ? '(مقاس: ' + selectedOpt + ')' : ''} من المستودع إلى المحل بنجاح!`);
      closeModal();
      loadProducts();
    }).catch(e => {
      alert("خطأ أثناء التحويل: " + e.message);
    });
}

function closeModal() { document.getElementById("modal").classList.add("hidden"); }

async function saveProduct(e) {
  e.preventDefault();
  const btn = document.getElementById("submitBtn");
  btn.disabled = true;
  const errDiv = document.getElementById("modalError");
  errDiv.classList.add("hidden");
  try {
    const id = document.getElementById("editId").value;
    const body = {
      product_name: document.getElementById("f-name").value,
      barcode: document.getElementById("f-barcode").value || null,
      quantity: !isNaN(parseInt(document.getElementById("f-qty").value, 10)) ? parseInt(document.getElementById("f-qty").value, 10) : 0,
      purchase_price: !isNaN(parseFloat(document.getElementById("f-purchase").value)) ? parseFloat(document.getElementById("f-purchase").value) : 0,
      sale_price: !isNaN(parseFloat(document.getElementById("f-sale").value)) ? parseFloat(document.getElementById("f-sale").value) : 0,
      expiry_date: document.getElementById("f-expiry").value || null,
      category: document.getElementById("f-category").value.trim() || null,
      min_stock: parseInt(document.getElementById("f-min-stock").value) || 0,
      description: document.getElementById("f-description").value.trim() || null,
      variants: variantItems.length > 0 ? { items: variantItems } : null,
      section: document.querySelector('input[name="f-section"]:checked')?.value || 'dental',
      checkbox_values: cbGetValues(),
      is_hidden_from_website: document.getElementById("f-is-hidden-website").checked,
    };
    const url = id ? `${BASE}/api/products/${id}` : `${BASE}/api/products`;
    const method = id ? "PUT" : "POST";
    const res = await fetch(url, { method, headers: {"Content-Type":"application/json"}, body: JSON.stringify(body) });
    const data = await res.json();
    if (!res.ok) {
      errDiv.textContent = data.error || "حدث خطأ";
      errDiv.classList.remove("hidden");
      return;
    }
    closeModal();
    await loadProducts();
    if (data.sync_warning) alert("⚠️ " + data.sync_warning);
  } catch (err) {
    errDiv.textContent = "حدث خطأ في الاتصال، حاول مجدداً";
    errDiv.classList.remove("hidden");
  } finally {
    btn.disabled = false;
  }
}

async function toggleWebsiteVisibility(pid, isCurrentlyHidden, btnEl) {
  if (btnEl) {
    btnEl.disabled = true;
    btnEl.style.opacity = '0.6';
    btnEl.innerHTML = '<span>⏳</span> <span>جارٍ...</span>';
  }
  try {
    const res = await fetch(`${BASE}/api/products/${pid}/toggle-website-visibility`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' }
    });
    const data = await res.json();
    if (!res.ok || data.error) throw new Error(data.error || 'فشل تغيير حالة العرض بالموقع');
    
    // Update local state
    const p = allProducts.find(x => x.id === pid);
    if (p) {
      p.is_hidden_from_website = data.is_hidden_from_website;
      p.is_hidden = data.is_hidden_from_website;
      p.hidden = data.is_hidden_from_website;
      if (data.is_hidden_from_website) {
        p.section = 'hidden';
      } else {
        p.section = (p.orig_section && p.orig_section !== 'hidden') ? p.orig_section : 'dental';
      }
    }
    if (productMap[pid]) {
      productMap[pid].is_hidden_from_website = data.is_hidden_from_website;
      productMap[pid].is_hidden = data.is_hidden_from_website;
      productMap[pid].hidden = data.is_hidden_from_website;
      if (data.is_hidden_from_website) {
        productMap[pid].section = 'hidden';
      } else {
        productMap[pid].section = (productMap[pid].orig_section && productMap[pid].orig_section !== 'hidden') ? productMap[pid].orig_section : 'dental';
      }
    }
    
    updateCounters();
    applyFilters();
  } catch (err) {
    alert('❌ خطأ: ' + err.message);
    if (btnEl) {
      btnEl.disabled = false;
      btnEl.style.opacity = '1';
    }
  }
}

async function removeCostBatch(pid, bid, qty, opt) {
  const isReturn = confirm(`هل أنت متأكد من حذف هذه الشحنة (${qty} قطعة${opt ? ' لمقاس ' + opt : ''}) من المحل؟\n\nاضغط "موافق (OK)" لإرجاعها إلى المستودع وإلغائها من المحل.\nاضغط "إلغاء (Cancel)" للتراجع.`);
  if (!isReturn) return;

  try {
    const res = await fetch(`${BASE}/api/products/${pid}/cost-batches/${bid}?return_to_wh=true`, {
      method: 'DELETE'
    });
    const data = await res.json();
    if (!res.ok || data.error) throw new Error(data.error || 'فشل حذف الشحنة');
    
    alert('✅ تم حذف الشحنة من المحل وإرجاع كميتها للمستودع بنجاح!');
    closeModal();
    loadProducts();
  } catch (err) {
    alert('❌ خطأ: ' + err.message);
  }
}

async function deleteProduct(id) {
  if (!confirm("حذف هذا المنتج؟")) return;
  await fetch(`${BASE}/api/products/${id}`, { method: "DELETE" });
  loadProducts();
}

// ── Variants State ──────────────────────────────────────────────────────────
let variantItems = [];

function variantQtyCell(p, qtyStyle) {
  let v = null;
  try { v = p.variants ? (typeof p.variants === 'string' ? JSON.parse(p.variants) : p.variants) : null; } catch(e) {}
  // New format: {items: [...]}
  if (v && v.items && v.items.length > 0) {
    const rows = v.items.map(s =>
      `<div class="text-xs leading-5">
        <span class="font-semibold text-gray-800">${s.label}</span>
        <span class="text-gray-400"> — ${s.boxes}×${s.qty_per_box} = </span>
        <span class="font-black text-teal-700">${s.qty}</span>
      </div>`
    ).join("");
    return `<div>${rows}</div>`;
  }
  // Old format backward compat: {sizes: [...]}
  if (v && v.sizes && v.sizes.length > 0) {
    const tags = v.sizes.map(s => `<span class="inline-flex items-center gap-0.5 bg-teal-50 text-teal-700 border border-teal-200 rounded-full px-2 py-0.5 text-xs font-medium">${s.label} <span class="font-black">${s.qty}</span></span>`).join(" ");
    return `<div class="space-y-1">${tags}</div>`;
  }
  return `<span class="${qtyStyle}">${p.quantity}</span>`;
}

function toggleVariants(on) {
  document.getElementById("variantsSection").classList.toggle("hidden", !on);
  const qtyInput = document.getElementById("f-qty");
  if (on) {
    qtyInput.readOnly = true;
    qtyInput.classList.add("bg-gray-100", "text-gray-400", "cursor-not-allowed");
    updateTotalQty();
  } else {
    qtyInput.readOnly = false;
    qtyInput.classList.remove("bg-gray-100", "text-gray-400", "cursor-not-allowed");
  }
}

function addItem() {
  const labelEl = document.getElementById("f-item-label");
  const boxesEl = document.getElementById("f-item-boxes");
  const qpbEl   = document.getElementById("f-item-qpb");
  const label = labelEl.value.trim();
  const boxes = parseInt(boxesEl.value) || 0;
  const qpb   = parseInt(qpbEl.value)   || 0;
  if (!label || boxes <= 0 || qpb <= 0) {
    if (!label) labelEl.focus();
    else if (boxes <= 0) boxesEl.focus();
    else qpbEl.focus();
    return;
  }
  variantItems.push({ label, boxes, qty_per_box: qpb, qty: boxes * qpb });
  labelEl.value = "";
  boxesEl.value = "";
  qpbEl.value   = "";
  renderItems();
  updateTotalQty();
  labelEl.focus();
}

function removeItem(i) {
  variantItems.splice(i, 1);
  renderItems();
  updateTotalQty();
}

function updateItemBoxes(i, val) {
  variantItems[i].boxes = parseInt(val) || 0;
  variantItems[i].qty   = variantItems[i].boxes * variantItems[i].qty_per_box;
  const el = document.getElementById(`item-total-${i}`);
  if (el) el.textContent = variantItems[i].qty;
  updateTotalQty();
}

function updateItemQpb(i, val) {
  variantItems[i].qty_per_box = parseInt(val) || 0;
  variantItems[i].qty         = variantItems[i].boxes * variantItems[i].qty_per_box;
  const el = document.getElementById(`item-total-${i}`);
  if (el) el.textContent = variantItems[i].qty;
  updateTotalQty();
}

function renderItems() {
  const container = document.getElementById("itemsTable");
  const noMsg     = document.getElementById("noItemsMsg");
  if (!container) return;
  if (variantItems.length === 0) {
    container.innerHTML = "";
    noMsg && noMsg.classList.remove("hidden");
    return;
  }
  noMsg && noMsg.classList.add("hidden");
  container.innerHTML = variantItems.map((s, i) =>
    `<div class="flex items-center gap-2 bg-white rounded-xl border px-3 py-2 shadow-sm">
      <span class="font-bold text-sm text-gray-800 flex-1 min-w-0 truncate bg-teal-50 rounded-lg px-2 py-1 text-center">${s.label}</span>
      <input type="number" min="1" value="${s.boxes}"
        oninput="updateItemBoxes(${i}, this.value)"
        class="w-16 border rounded-lg px-2 py-1.5 text-sm text-center focus:outline-none focus:ring-2 focus:ring-teal-200"
        title="عدد البوكسات"/>
      <span class="text-gray-400 text-xs flex-shrink-0">×</span>
      <input type="number" min="1" value="${s.qty_per_box}"
        oninput="updateItemQpb(${i}, this.value)"
        class="w-16 border rounded-lg px-2 py-1.5 text-sm text-center focus:outline-none focus:ring-2 focus:ring-teal-200"
        title="الكمية في كل بوكس"/>
      <span class="text-gray-400 text-xs flex-shrink-0">=</span>
      <span id="item-total-${i}" class="w-10 text-center font-black text-teal-700 text-sm flex-shrink-0">${s.qty}</span>
      <button type="button" onclick="removeItem(${i})"
        class="text-gray-300 hover:text-red-500 text-xl leading-none flex-shrink-0">×</button>
    </div>`
  ).join("");
}

function updateTotalQty() {
  const total = variantItems.reduce((s, x) => s + (x.qty || 0), 0);
  const preview = document.getElementById("totalQtyPreview");
  if (preview) preview.textContent = total;
  document.getElementById("f-qty").value = total;
}

function resetVariants() {
  variantItems = [];
  const cb = document.getElementById("f-use-variants");
  if (cb) cb.checked = false;
  toggleVariants(false);
  renderItems();
}

function loadVariants(product) {
  let v = null;
  try { v = product.variants ? (typeof product.variants === 'string' ? JSON.parse(product.variants) : product.variants) : null; } catch(e) {}
  // New format
  if (v && v.items && v.items.length > 0) {
    variantItems = v.items;
    const cb = document.getElementById("f-use-variants");
    if (cb) cb.checked = true;
    toggleVariants(true);
    renderItems();
    updateTotalQty();
    return;
  }
  // Old format migration
  if (v && v.sizes && v.sizes.length > 0) {
    variantItems = v.sizes.map(s => ({ label: s.label, boxes: 1, qty_per_box: s.qty, qty: s.qty }));
    const cb = document.getElementById("f-use-variants");
    if (cb) cb.checked = true;
    toggleVariants(true);
    renderItems();
    updateTotalQty();
    return;
  }
  resetVariants();
}

// ── Checkbox Options Builder ────────────────────────────────────────────────
// Data: { [cat]: { [label]: { checked, disabled, reason, stock } } }
let cbData = {};

function cbReset() {
  cbData = {};
  cbRender();
  document.getElementById("cbNewCatInput").value = "";
}

function cbLoad(raw) {
  cbData = {};
  let cv = {};
  try { cv = raw ? (typeof raw === 'string' ? JSON.parse(raw) : raw) : {}; } catch(e) {}
  // Parse flat "Cat::Label" format into nested
  Object.entries(cv).forEach(([key, val]) => {
    const sep = key.indexOf("::");
    if (sep === -1) return;
    const cat = key.slice(0, sep);
    const label = key.slice(sep + 2);
    if (!cbData[cat]) cbData[cat] = {};
    const checked  = typeof val === 'boolean' ? val : (val?.checked ?? false);
    const disabled = typeof val === 'object' ? (val?.disabled ?? false) : false;
    const reason   = typeof val === 'object' ? (val?.reason ?? "") : "";
    const stock    = typeof val === 'object' && val?.stock !== undefined ? val.stock : null;
    cbData[cat][label] = { checked, disabled, reason, stock };
  });
  cbRender();
  cbUpdateTotalQty();
}

function cbGetValues() {
  const out = {};
  Object.entries(cbData).forEach(([cat, opts]) => {
    Object.entries(opts).forEach(([label, v]) => {
      const key = `${cat}::${label}`;
      const hasStock = v.stock !== null && v.stock !== undefined;
      if (!v.disabled && !hasStock) {
        out[key] = v.checked;
      } else {
        const obj = { checked: v.checked };
        if (v.disabled) { obj.disabled = true; if (v.reason) obj.reason = v.reason; }
        if (hasStock) obj.stock = v.stock;
        out[key] = obj;
      }
    });
  });
  return Object.keys(out).length > 0 ? out : null;
}

function cbAddCategory() {
  const inp = document.getElementById("cbNewCatInput");
  const cat = inp.value.trim();
  if (!cat) { inp.focus(); return; }
  if (cbData[cat]) { inp.focus(); return; }
  cbData[cat] = {};
  inp.value = "";
  cbRender();
  // Focus the "add option" input for this new category
  setTimeout(() => {
    const el = document.getElementById(`cb-opt-inp-${CSS.escape(cat)}`);
    if (el) el.focus();
  }, 50);
}

function cbRemoveCategory(cat) {
  delete cbData[cat];
  cbRender();
}

function cbAddOption(cat) {
  const inp = document.getElementById(`cb-opt-inp-${CSS.escape(cat)}`);
  const label = inp.value.trim();
  if (!label) { inp.focus(); return; }
  if (!cbData[cat]) cbData[cat] = {};
  if (cbData[cat][label]) { inp.value = ""; return; }
  cbData[cat][label] = { checked: true, disabled: false, reason: "", stock: null };
  inp.value = "";
  cbRender();
  setTimeout(() => { const el = document.getElementById(`cb-opt-inp-${CSS.escape(cat)}`); if (el) el.focus(); }, 30);
}

function cbRemoveOption(cat, label) {
  if (cbData[cat]) delete cbData[cat][label];
  cbRender();
}

function cbToggleChecked(cat, label) {
  if (cbData[cat]?.[label]) cbData[cat][label].checked = !cbData[cat][label].checked;
  cbRender();
}

function cbToggleDisabled(cat, label) {
  const o = cbData[cat]?.[label];
  if (!o) return;
  o.disabled = !o.disabled;
  if (!o.disabled) o.reason = "";
  cbRender();
}

function cbSetReason(cat, label, val) {
  if (cbData[cat]?.[label]) cbData[cat][label].reason = val;
}

function cbSetStock(cat, label, val) {
  const o = cbData[cat]?.[label];
  if (!o) return;
  const n = val === "" ? null : Math.max(0, parseInt(val) || 0);
  o.stock = n;
  if (n !== null && n <= 0) o.disabled = true;
  // Recalculate total quantity from all option stocks
  cbUpdateTotalQty();
  cbRender();
}

function cbUpdateTotalQty() {
  let total = 0;
  for (const cat of Object.keys(cbData)) {
    for (const label of Object.keys(cbData[cat])) {
      const s = cbData[cat][label].stock;
      if (s !== null && s > 0) total += s;
    }
  }
  // Only update qty field if there are options with stock
  const allStocks = Object.values(cbData).flatMap(opts => Object.values(opts).map(o => o.stock));
  const hasAnyStock = allStocks.some(s => s !== null);
  if (hasAnyStock) {
    const qtyEl = document.getElementById('f-qty');
    if (qtyEl) qtyEl.value = total;
  }
  const totalSpan = document.getElementById('cbTotalQty');
  if (totalSpan) totalSpan.textContent = total;
}

function cbFocusOpt(cat) {
  const el = document.getElementById(`cb-opt-inp-${CSS.escape(cat)}`);
  if (el) { el.focus(); el.scrollIntoView({ behavior: 'smooth', block: 'center' }); }
}

function cbRender() {
  const container = document.getElementById("cbCategoriesContainer");
  if (!container) return;
  const cats = Object.keys(cbData);
  if (cats.length === 0) { container.innerHTML = ""; return; }
  container.innerHTML = cats.map(cat => {
    const opts = cbData[cat];
    const labels = Object.keys(opts);
    const optRows = labels.map(label => {
      const o = opts[label];
      const isSoldOut = o.stock !== null && o.stock <= 0;
      const isDisabled = o.disabled || isSoldOut;
      const stockVal = o.stock !== null ? o.stock : "";
      return `<div class="flex flex-wrap items-center gap-2 px-2 py-1.5 rounded-lg border ${isDisabled ? 'border-red-200 bg-red-50' : 'border-transparent bg-white'}">
        <input type="checkbox" ${o.checked ? 'checked' : ''} ${isDisabled ? 'disabled' : ''}
          onchange="cbToggleChecked('${cat.replace(/'/g,"\\'")}','${label.replace(/'/g,"\\'")}') "
          class="w-4 h-4 accent-blue-700 flex-shrink-0 disabled:opacity-40"/>
        <span class="text-sm flex-1 ${isDisabled ? 'line-through text-gray-400' : 'text-gray-800'}">${label}</span>
        <span class="text-xs text-gray-400">كمية:</span>
        <input type="number" min="0" placeholder="∞" value="${stockVal}"
          onchange="cbSetStock('${cat.replace(/'/g,"\\'")}','${label.replace(/'/g,"\\'")}',this.value)"
          class="w-14 border border-gray-200 rounded-lg px-1.5 py-0.5 text-xs text-center focus:outline-none focus:ring-1 focus:ring-blue-300 bg-white"/>
        ${isDisabled ? `<span class="text-[10px] font-bold text-red-500 bg-red-100 px-1.5 py-0.5 rounded-full">${isSoldOut ? 'نفذ' : 'غير متاح'}</span>` : ''}
        <button type="button" title="${isDisabled ? 'تفعيل' : 'تعطيل'}"
          onclick="cbToggleDisabled('${cat.replace(/'/g,"\\'")}','${label.replace(/'/g,"\\'")}') "
          class="text-gray-300 hover:text-red-500 transition-colors flex-shrink-0 text-base leading-none">${isDisabled ? '✅' : '🚫'}</button>
        <button type="button" onclick="cbRemoveOption('${cat.replace(/'/g,"\\'")}','${label.replace(/'/g,"\\'")}') "
          class="text-gray-300 hover:text-red-500 text-lg leading-none flex-shrink-0">×</button>
        ${o.disabled && !isSoldOut ? `<div class="w-full mt-1">
          <input type="text" placeholder="سبب التعطيل..." value="${(o.reason||'').replace(/"/g,'&quot;')}"
            oninput="cbSetReason('${cat.replace(/'/g,"\\'")}','${label.replace(/'/g,"\\'")}',this.value)"
            class="w-full border border-red-200 rounded-lg px-2 py-1 text-xs focus:outline-none focus:ring-1 focus:ring-red-300 text-red-600 placeholder-red-300 bg-white"/>
        </div>` : ''}
      </div>`;
    }).join("");
    return `<div class="rounded-xl border border-gray-200 bg-gray-50 overflow-hidden">
      <div class="flex items-center gap-2 px-3 py-2 bg-white border-b border-gray-200">
        <span class="text-xs font-bold uppercase tracking-wider text-blue-700 flex-1">${cat}</span>
        <button type="button" onclick="cbFocusOpt('${cat}')" class="flex items-center gap-1 text-xs font-medium text-blue-700 hover:opacity-70">+ Add option</button>
        <button type="button" onclick="cbRemoveCategory('${cat.replace(/'/g,"\\'")}')"
          class="text-gray-300 hover:text-red-500 text-lg leading-none">×</button>
      </div>
      <div class="p-2 space-y-1">
        ${optRows || '<p class="text-xs text-gray-400 px-1 py-1 italic">لا توجد خيارات — أضف أدناه</p>'}
        <div class="flex gap-2 pt-1">
          <input type="text" id="cb-opt-inp-${CSS.escape(cat)}" placeholder="اسم الخيار..."
            class="flex-1 border rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-200 bg-white"
            onkeydown="if(event.key==='Enter'){event.preventDefault();cbAddOption('${cat.replace(/'/g,"\\'")}');}"/>
          <button type="button" onclick="cbAddOption('${cat.replace(/'/g,"\\'")}')"
            class="bg-blue-700 text-white px-3 py-1.5 rounded-lg text-sm font-semibold hover:bg-blue-800">+ إضافة</button>
        </div>
      </div>
    </div>`;
  }).join("");
}

loadProducts();
</script>

</main>
<%- include('partials/footer', locals) %>
