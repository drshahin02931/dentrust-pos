    const statusColor = { pending:'bg-blue-50 border-blue-200', paid:'bg-green-50 border-green-200', overdue:'bg-red-50 border-red-200' };
    const textColor   = { pending:'text-blue-700', paid:'text-green-700', overdue:'text-red-700' };
    const total   = data.reduce((s,i)=>s+(i.status!=='paid'?i.amount:0),0);
    const totalPd = data.reduce((s,i)=>s+(i.status==='paid'?i.amount:0),0);
    content.innerHTML = `
      <div class="flex items-center justify-between mb-3">
        <div class="flex gap-3 text-xs">
          <span class="bg-blue-50 text-blue-700 px-2 py-1 rounded-lg font-semibold">المتبقي: ${total.toFixed(2)} ج</span>
          <span class="bg-green-50 text-green-700 px-2 py-1 rounded-lg font-semibold">المدفوع: ${totalPd.toFixed(2)} ج</span>
        </div>
        <button onclick="openAddInstallment()" class="bg-blue-700 text-white text-xs font-semibold px-3 py-1.5 rounded-xl hover:bg-blue-800">+ قسط جديد</button>
      </div>
      ${!data.length ? '<div class="text-center text-gray-400 py-6 text-sm">لا توجد أقساط مسجّلة</div>' :
