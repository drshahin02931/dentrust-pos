async function saveNewClinicForCustomer() {
  if (!currentCustomer) return;
  const title = document.getElementById('newClinicTitle').value.trim();
  const city = document.getElementById('newClinicCity').value.trim();
  const regSel = document.getElementById('newClinicRegion').value.trim();
  const regCustom = document.getElementById('newClinicRegionCustom')?.value.trim() || '';
  const region = (regSel === '__custom__' ? regCustom : regSel);
  const details = document.getElementById('newClinicDetails').value.trim();
  const phone = document.getElementById('newClinicPhone')?.value.trim() || '';
  const isDefault = !!document.getElementById('newClinicDefault')?.checked;

  if (!title || !city || !region) {
    alert('يرجى كتابة اسم العيادة واختيار المحافظة والمنطقة.');
    return;
  }

  let addrs = [];
  try {
    addrs = typeof currentCustomer.addresses === 'string' ? JSON.parse(currentCustomer.addresses) : (currentCustomer.addresses || []);
  } catch (_) { addrs = []; }

  const makeDefault = isDefault || addrs.length === 0;
  if (makeDefault) {
    addrs = addrs.map(a => ({ ...a, is_default: false }));
  }

  const newObj = {
    id: 'addr_' + Date.now(),
    title,
    city,
    region,
    details,
    phone,
    address: `${city} - ${region} - ${details}`.replace(/\s*-\s*-\s*/g, ' - ').trim(),
    is_default: makeDefault
  };

  const updated = [...addrs, newObj];

  try {
    const res = await fetch(`${BASE}/api/customer/update-profile`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        customer_id: currentCustomer.id,
        phone: currentCustomer.phone,
        city: makeDefault ? city : currentCustomer.city,
        region: makeDefault ? region : currentCustomer.region,
        address: makeDefault ? newObj.address : currentCustomer.address,
        addresses: updated
      })
    });
    const data = await res.json();
    if (!res.ok) throw new Error(data.error || 'فشل الحفظ');
    currentCustomer.addresses = updated;
    if (makeDefault) {
      currentCustomer.city = city;
      currentCustomer.region = region;
      currentCustomer.address = newObj.address;
    }
    alert('✅ تم حفظ عنوان العيادة بنجاح');
    switchTab('clinics');
    loadCustomers();
  } catch (err) {
    alert('❌ خطأ: ' + err.message);
  }
}

async function setDefaultClinicForCustomer(idx) {
  if (!currentCustomer) return;
  let addrs = [];
  try {
    addrs = typeof currentCustomer.addresses === 'string' ? JSON.parse(currentCustomer.addresses) : (currentCustomer.addresses || []);
  } catch (_) { addrs = []; }

  if (!addrs[idx]) return;
  const updated = addrs.map((a, i) => ({ ...a, is_default: i === idx }));
  const chosen = updated[idx];

  try {
    const res = await fetch(`${BASE}/api/customer/update-profile`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        customer_id: currentCustomer.id,
        phone: currentCustomer.phone,
        city: chosen.city,
        region: chosen.region,
        address: chosen.address || chosen.details,
        addresses: updated
      })
    });
    const data = await res.json();
    if (!res.ok) throw new Error(data.error || 'فشل التعيين');
    currentCustomer.addresses = updated;
    currentCustomer.city = chosen.city;
    currentCustomer.region = chosen.region;
    currentCustomer.address = chosen.address || chosen.details;
    switchTab('clinics');
    loadCustomers();
  } catch (err) {
    alert('❌ خطأ: ' + err.message);
  }
}

async function deleteClinicForCustomer(idx) {
  if (!currentCustomer) return;
  if (!confirm('هل تريد بالتأكيد حذف هذا العنوان؟')) return;

  let addrs = [];
  try {
    addrs = typeof currentCustomer.addresses === 'string' ? JSON.parse(currentCustomer.addresses) : (currentCustomer.addresses || []);
  } catch (_) { addrs = []; }

  const updated = addrs.filter((_, i) => i !== idx);

  try {
    const res = await fetch(`${BASE}/api/customer/update-profile`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        customer_id: currentCustomer.id,
        phone: currentCustomer.phone,
        addresses: updated
      })
    });
    const data = await res.json();
    if (!res.ok) throw new Error(data.error || 'فشل الحذف');
    currentCustomer.addresses = updated;
    switchTab('clinics');
    loadCustomers();
  } catch (err) {
    alert('❌ خطأ: ' + err.message);
  }
}

