        </div>
        <div id="ec-clinic-region-custom-box" class="hidden">
          <input id="ec-clinic-region-custom" class="w-full border border-gray-300 rounded-xl px-3 py-2 text-xs bg-white" placeholder="اكتب اسم الحي / القرية يدوياً..."/>
        </div>
        <div>
          <label class="text-[11px] font-bold text-gray-700 block mb-1">الشارع والعمارة بالتفصيل</label>
          <input id="ec-clinic-details" class="w-full border border-gray-300 rounded-xl px-3 py-2 text-xs bg-white focus:outline-none focus:ring-2 focus:ring-blue-300" placeholder="الشارع ورقم العمارة والدور"/>
        </div>
        <div>
          <label class="text-[11px] font-bold text-gray-700 block mb-1">هاتف العيادة (اختياري)</label>
          <input id="ec-clinic-phone" type="tel" class="w-full border border-gray-300 rounded-xl px-3 py-2 text-xs font-mono bg-white focus:outline-none focus:ring-2 focus:ring-blue-300" placeholder="01xxxxxxxxx"/>
        </div>
      </div>

      <div>
        <label class="text-xs font-medium text-gray-600">خطة التقسيط</label>
        <input id="ec-plan" class="w-full border rounded-xl px-3 py-2 text-sm mt-1 focus:outline-none focus:ring-2 focus:ring-blue-200" placeholder="مثال: 500 جنيه شهرياً"/>
      </div>
      <div id="ecErr" class="hidden bg-red-50 border border-red-300 text-red-700 text-sm rounded-xl px-3 py-2"></div>
      <div class="flex gap-3 pt-1 shrink-0">
        <button type="submit" id="ecSubmitBtn" class="flex-1 bg-blue-700 text-white font-semibold py-2.5 rounded-xl hover:bg-blue-800 text-sm">حفظ التعديلات</button>
        <button type="button" onclick="closeEditCustomerModal()" class="flex-1 bg-gray-100 text-gray-700 font-semibold py-2.5 rounded-xl text-sm">إلغاء</button>
      </div>
    </form>
  </div>
</div>

<script>
// ── Merge customers ────────────────────────────────────────────────────────────
let _mergeKeep = null;
let _mergeDrop = null;

function openMergeModal() {
  _mergeKeep = null; _mergeDrop = null;
  ['mergeKeepSearch','mergeDropSearch'].forEach(id => document.getElementById(id).value = '');
  ['mergeKeepList','mergeDropList'].forEach(id => { const el = document.getElementById(id); el.innerHTML=''; el.classList.add('hidden'); });
  ['mergeKeepSelected','mergeDropSelected'].forEach(id => document.getElementById(id).classList.add('hidden'));
  document.getElementById('mergeErr').classList.add('hidden');
  const btn = document.getElementById('mergeConfirmBtn');
  btn.disabled = false; btn.textContent = '🔀 تأكيد الدمج';
  document.getElementById('mergeModal').classList.remove('hidden');
}
function closeMergeModal() { document.getElementById('mergeModal').classList.add('hidden'); }

function filterMergeList(side) {
  const q = document.getElementById(`merge${side==='keep'?'Keep':'Drop'}Search`).value.toLowerCase().trim();
  const listEl = document.getElementById(`merge${side==='keep'?'Keep':'Drop'}List`);
  if (!q) { listEl.innerHTML=''; listEl.classList.add('hidden'); return; }
  const results = allCustomers.filter(c =>
    c.name.toLowerCase().includes(q) || (c.phone||'').includes(q)
  ).slice(0, 8);
  if (!results.length) { listEl.innerHTML='<div class="px-3 py-2 text-xs text-gray-400">لا توجد نتائج</div>'; listEl.classList.remove('hidden'); return; }
  listEl.innerHTML = results.map(c => `
    <div onclick="pickMerge('${side}',${c.id})"
      class="px-3 py-2 text-sm cursor-pointer hover:bg-gray-50 flex justify-between items-center">
      <div>
        <span class="font-medium text-gray-800">${c.name}</span>
        <span class="text-xs text-gray-400 mr-2">${c.phone||''}</span>
      </div>
      ${c.total_debt>0 ? `<span class="text-xs text-red-500 font-semibold">${c.total_debt.toFixed(2)} ج</span>` : ''}
    </div>`).join('');
  listEl.classList.remove('hidden');
}

function pickMerge(side, cid) {
  const c = allCustomers.find(x => x.id === cid);
  if (!c) return;
  if (side === 'keep') { _mergeKeep = c; } else { _mergeDrop = c; }
  const prefix = side === 'keep' ? 'Keep' : 'Drop';
  document.getElementById(`merge${prefix}Name`).textContent  = c.name;
  document.getElementById(`merge${prefix}Phone`).textContent = c.phone ? `📞 ${c.phone}` : '';
  document.getElementById(`merge${prefix}Debt`).textContent  = c.total_debt > 0 ? `دين: ${c.total_debt.toFixed(2)} ج` : '';
  document.getElementById(`merge${prefix}Selected`).classList.remove('hidden');
  document.getElementById(`merge${prefix}Search`).value = '';
  document.getElementById(`merge${prefix}List`).classList.add('hidden');
}

function clearMergePick(side) {
  if (side === 'keep') _mergeKeep = null; else _mergeDrop = null;
  const prefix = side === 'keep' ? 'Keep' : 'Drop';
  document.getElementById(`merge${prefix}Selected`).classList.add('hidden');
  document.getElementById(`merge${prefix}Search`).value = '';
}

async function confirmMerge() {
  const errEl = document.getElementById('mergeErr');
  errEl.classList.add('hidden');
  if (!_mergeKeep || !_mergeDrop) { errEl.textContent = 'يجب اختيار العميلين أولاً'; errEl.classList.remove('hidden'); return; }
  if (_mergeKeep.id === _mergeDrop.id) { errEl.textContent = 'لا يمكن دمج عميل مع نفسه'; errEl.classList.remove('hidden'); return; }

  const ok = confirm(
    `⚠️ تأكيد الدمج:\n\nالأصلي (سيبقى): ${_mergeKeep.name}\nالمكرر (سيُحذف): ${_mergeDrop.name}\n\nهل أنت متأكد؟ لا يمكن التراجع.`
  );
  if (!ok) return;

  const btn = document.getElementById('mergeConfirmBtn');
  btn.disabled = true; btn.textContent = '⏳ جارٍ الدمج...';

  const res  = await fetch(`${BASE}/api/customers/merge`, {
    method: 'POST', headers: {'Content-Type':'application/json'},
    body: JSON.stringify({ keep_id: _mergeKeep.id, drop_id: _mergeDrop.id })
  });
  const data = await res.json();

  if (!res.ok) {
    errEl.textContent = data.error || 'حدث خطأ';
    errEl.classList.remove('hidden');
    btn.disabled = false; btn.textContent = '🔀 تأكيد الدمج';
    return;
  }

  closeMergeModal();
  await loadCustomers();
  alert(`✅ تم الدمج بنجاح!\n\n"${data.dropped}" ← اندمج مع → "${data.kept}"\nإجمالي الدين الجديد: ${data.merged_debt.toFixed(2)} جنيه`);
}

function openEditCustomerModal() {
  if (!currentCustomer) return;
  document.getElementById('ec-name').value    = currentCustomer.name || '';
  document.getElementById('ec-phone').value   = currentCustomer.phone || '';
  document.getElementById('ec-plan').value    = currentCustomer.installment_plan || '';
  document.getElementById('ecErr').classList.add('hidden');

  let addrs = [];
  try {
    addrs = typeof currentCustomer.addresses === 'string' ? JSON.parse(currentCustomer.addresses) : (currentCustomer.addresses || []);
  } catch (_) { addrs = []; }

  const def = addrs.find(a => a.is_default) || addrs[0] || {};
  const cityVal = def.city || currentCustomer.city || 'القاهرة';
  const regVal = def.region || currentCustomer.region || '';
  const titleVal = def.title || (regVal ? `عيادة ${regVal}` : 'العيادة الرئيسية');
  const detailsVal = def.details || currentCustomer.address || '';
  const phoneVal = def.phone || '';

  document.getElementById('ec-clinic-title').value = titleVal;
  populateGovSelect('ec-clinic-city', cityVal);
  populateDistrictSelect(cityVal, 'ec-clinic-region', 'ec-clinic-region-custom-box', regVal);
  document.getElementById('ec-clinic-details').value = detailsVal;
  document.getElementById('ec-clinic-phone').value = phoneVal;

  const btn = document.getElementById('ecSubmitBtn');
  btn.disabled = false; btn.textContent = 'حفظ التعديلات';
  document.getElementById('editCustomerModal').classList.remove('hidden');
  setTimeout(() => document.getElementById('ec-name').focus(), 80);
}

function closeEditCustomerModal() {
  document.getElementById('editCustomerModal').classList.add('hidden');
}

async function saveEditCustomer(e) {
  e.preventDefault();
  const btn   = document.getElementById('ecSubmitBtn');
  const errEl = document.getElementById('ecErr');
  errEl.classList.add('hidden');
  btn.disabled = true; btn.textContent = '⏳ جارٍ الحفظ...';

  const name = document.getElementById('ec-name').value.trim();
  const phone = document.getElementById('ec-phone').value.trim();
  const plan = document.getElementById('ec-plan').value.trim();

  const cTitle = document.getElementById('ec-clinic-title').value.trim();
  const cCity = document.getElementById('ec-clinic-city').value.trim();
  const cRegSel = document.getElementById('ec-clinic-region').value.trim();
  const cRegCustom = document.getElementById('ec-clinic-region-custom')?.value.trim() || '';
  const cRegion = (cRegSel === '__custom__' ? cRegCustom : cRegSel);
  const cDetails = document.getElementById('ec-clinic-details').value.trim();
  const cPhone = document.getElementById('ec-clinic-phone').value.trim();

  let addrs = [];
  try {
    addrs = typeof currentCustomer.addresses === 'string' ? JSON.parse(currentCustomer.addresses) : (currentCustomer.addresses || []);
  } catch (_) { addrs = []; }

  const fullAddr = [cCity, cRegion, cDetails].filter(Boolean).join(' - ');
  const defaultObj = {
    id: (addrs[0] && addrs[0].id) || ('addr_' + Date.now()),
    title: cTitle || (cRegion ? `عيادة ${cRegion}` : 'العيادة الرئيسية'),
    city: cCity || 'القاهرة',
    region: cRegion || '',
    details: cDetails || '',
    phone: cPhone || '',
    address: fullAddr,
    is_default: true
  };

  let updatedAddrs = [];
  const defIdx = addrs.findIndex(a => a.is_default);
  if (defIdx >= 0) {
    updatedAddrs = addrs.map((a, i) => i === defIdx ? defaultObj : { ...a, is_default: false });
  } else if (addrs.length > 0) {
    updatedAddrs = [defaultObj, ...addrs.slice(1).map(a => ({ ...a, is_default: false }))];
  } else {
    updatedAddrs = [defaultObj];
  }

  const body = {
    name,
    phone,
    installment_plan: plan,
    city: cCity,
    region: cRegion,
    address: fullAddr,
    addresses: updatedAddrs
  };

  const res  = await fetch(`${BASE}/api/customers/${currentCustomer.id}`, {
    method: 'PATCH', headers: {'Content-Type':'application/json'}, body: JSON.stringify(body)
  });
  const data = await res.json();

  if (!res.ok) {
    errEl.textContent = data.error || 'حدث خطأ';
    errEl.classList.remove('hidden');
    btn.disabled = false; btn.textContent = 'حفظ التعديلات';
    return;
  }

  closeEditCustomerModal();
  await loadCustomers();
  const updated = allCustomers.find(x => x.id === currentCustomer.id);
  if (updated) openDetail(updated.id);
  alert('✅ تم تحديث بيانات العميل بنجاح');
}
</script>
</main>
<%- include('partials/footer', locals) %>
