function populateGovSelect(citySelectId, initialCity) {
  const sel = document.getElementById(citySelectId);
  if (!sel) return;
  sel.innerHTML = '<option value="">اختر المحافظة...</option>' +
    Object.keys(EGYPT_GOVERNORATES).map(gov => `<option value="${gov}" ${gov === initialCity ? 'selected' : ''}>${gov}</option>`).join('');
}

function populateDistrictSelect(cityVal, regionSelectId, customBoxId, initialRegion) {
  const sel = document.getElementById(regionSelectId);
  const box = customBoxId ? document.getElementById(customBoxId) : null;
  if (!sel) return;
  const list = EGYPT_GOVERNORATES[cityVal] || [];
  if (!cityVal || !list.length) {
    sel.innerHTML = '<option value="">اختر المحافظة أولاً...</option>';
    if (box) box.classList.add('hidden');
    return;
  }
  let isKnown = false;
  let html = '<option value="">اختر المنطقة / الحي...</option>';
  list.forEach(d => {
    const isSel = (d === initialRegion);
    if (isSel) isKnown = true;
    html += `<option value="${d}" ${isSel ? 'selected' : ''}>${d}</option>`;
  });
  html += `<option value="__custom__" ${(!isKnown && initialRegion) ? 'selected' : ''}>+ منطقة أخرى (كتابة يدوية)</option>`;
  sel.innerHTML = html;

  if (box) {
    if (!isKnown && initialRegion) {
      box.classList.remove('hidden');
      const customInput = box.querySelector('input');
      if (customInput) customInput.value = initialRegion;
    } else {
      box.classList.add('hidden');
    }
  }
}

function onGovChange(citySelectId, regionSelectId, customBoxId) {
  const cityVal = document.getElementById(citySelectId)?.value || '';
  populateDistrictSelect(cityVal, regionSelectId, customBoxId, '');
}

function onDistrictChange(regionSelectId, customBoxId) {
  const regVal = document.getElementById(regionSelectId)?.value || '';
  const box = customBoxId ? document.getElementById(customBoxId) : null;
  if (!box) return;
  if (regVal === '__custom__') {
    box.classList.remove('hidden');
    const inp = box.querySelector('input');
    if (inp) { inp.value = ''; inp.focus(); }
  } else {
    box.classList.add('hidden');
  }
}

// ── Load customers ────────────────────────────────────────────────────────────
// لو الجلسة انتهت أو مش موجودة، السيرفر بيرجع 401 (JSON) — هنا بنتعامل معاه
// بإعادة تحويل نظيفة لصفحة تسجيل الدخول، بدل ما نحاول نعمل res.json() على
// رد غير متوقع ونكسر الصفحة كلها.
async function loadCustomers() {
  const res = await fetch(`${BASE}/api/customers`);
  if (res.status === 401) { window.location.href = `${BASE}/login`; return; }
  if (!res.ok) { console.error('فشل تحميل العملاء:', res.status); return; }
  allCustomers = await res.json();
  renderCustomers(allCustomers);
}

function renderCustomers(data) {
  const totalDebt = data.reduce((s, c) => s + (c.total_debt||0), 0);
  document.getElementById("totalCustomers").textContent = data.length;
  document.getElementById("totalDebt").textContent = totalDebt.toLocaleString('ar-EG', {minimumFractionDigits:2, maximumFractionDigits:2});

  const list = document.getElementById("customerList");
  const noMsg = document.getElementById("noCustomers");
  if (!data.length) { list.innerHTML=""; noMsg.classList.remove("hidden"); return; }
  noMsg.classList.add("hidden");

  list.innerHTML = data.map((c, idx) => {
    const hasDebt = c.total_debt > 0;
    const purchases = parseFloat(c.total_purchases || 0);
    const custCode = c.customer_code || c.barcode || String(100000 + c.id);
    const srcBadge = c.source === 'website'
      ? '<span class="bg-emerald-50 text-emerald-700 border border-emerald-200 text-[10px] font-bold px-1.5 py-0.5 rounded-md">🌐 الموقع</span>'
      : '<span class="bg-blue-50 text-blue-700 border border-blue-200 text-[10px] font-bold px-1.5 py-0.5 rounded-md">🏪 كاشير</span>';
    const pointsBadge = (c.points_balance > 0)
      ? `<span class="bg-amber-50 text-amber-700 border border-amber-200 text-[10px] font-bold px-1.5 py-0.5 rounded-md">⭐ ${c.points_balance} نقطة</span>`
      : '';
    const rankBadge = idx < 3
      ? ['🥇','🥈','🥉'][idx]
      : `#${idx+1}`;
    return `
    <div onclick="openDetail(${c.id})" class="cursor-pointer rounded-2xl border shadow-sm p-4 flex items-center justify-between gap-3 hover:shadow-md transition-all
      ${hasDebt ? 'bg-red-50 border-red-200' : 'bg-white border-gray-200'}">
      <div class="flex items-center gap-3 min-w-0">
        <div class="relative">
          <div class="w-10 h-10 rounded-full flex items-center justify-center text-white font-black text-lg shrink-0
            ${hasDebt ? 'bg-red-500' : 'bg-blue-500'}">
            ${c.name.charAt(0)}
          </div>
          <span class="absolute -bottom-1 -right-1 text-xs leading-none">${rankBadge}</span>
        </div>
        <div class="min-w-0">
          <div class="flex items-center gap-1.5 flex-wrap">
            <span class="font-bold text-gray-800">${c.name}</span>
            <span class="bg-blue-100 text-blue-800 font-mono font-black text-[11px] px-1.5 py-0.5 rounded-md">${c.barcode || custCode}</span>
            ${c.is_vip ? '<span class="bg-gradient-to-r from-amber-400 to-yellow-500 text-slate-900 font-black text-[10px] px-2 py-0.5 rounded-md shadow-xs flex items-center gap-1">👑 VIP</span>' : ''}
            ${srcBadge}
            ${pointsBadge}
          </div>
          <div class="text-xs text-gray-500 mt-0.5">${c.phone || 'بدون هاتف'} ${c.extra_phones ? `<span class="text-gray-400">(${c.extra_phones.split(',').filter(Boolean).length} إضافي)</span>` : ''}</div>
          ${(() => {
            let addrs = [];
            try { addrs = typeof c.addresses === 'string' ? JSON.parse(c.addresses) : (c.addresses || []); } catch(_) {}
            return addrs.length ? `<div class="text-[11px] text-gray-600 mt-0.5 flex items-center gap-1"><span>🏥 العيادات:</span> <span class="font-semibold text-blue-700">${addrs.map(a => a.title || 'عيادة').join('، ')}</span></div>` : '';
          })()}
          <div class="text-xs text-blue-600 font-semibold mt-0.5">🛒 ${purchases.toLocaleString('ar-EG', {minimumFractionDigits:2})} ج مشتريات</div>
        </div>
      </div>
      <div class="text-right shrink-0">
        ${hasDebt
          ? `<div class="text-red-600 font-black text-base">${c.total_debt.toLocaleString('ar-EG', {minimumFractionDigits:2, maximumFractionDigits:2})}</div>
             <div class="text-xs text-red-400">جنيه آجل</div>`
          : `<div class="text-green-600 font-bold text-sm">✓ مسدّد</div>`
        }
        <div class="flex items-center gap-1 mt-1 justify-end">
          <button onclick="event.stopPropagation(); quickToggleVip(${c.id}, '${c.name.replace(/'/g, "\\'")}')"
            class="text-[11px] font-bold ${c.is_vip ? 'bg-amber-100 hover:bg-amber-200 text-amber-900 border border-amber-300' : 'bg-gray-100 hover:bg-amber-50 text-gray-700 hover:text-amber-700 border border-gray-200'} px-2 py-0.5 rounded-lg transition-all"
            title="${c.is_vip ? 'إلغاء عضوية VIP' : 'ترقية العميل إلى VIP'}">
            ${c.is_vip ? '👑 VIP' : '+ ترقية VIP'}
          </button>
          <button onclick="event.stopPropagation(); quickResetPassword(${c.id}, '${c.name.replace(/'/g, "\\'")}')"
            class="text-[11px] font-bold bg-amber-50 hover:bg-amber-100 text-amber-800 border border-amber-200 px-2 py-0.5 rounded-lg transition-all"
            title="إعادة تعيين كلمة المرور إلى 1234567">
            🔑 تصفير
          </button>
        </div>
      </div>
    </div>`;
  }).join("");
}

function toggleDebtorsFilter() {
  _debtorsOnly = !_debtorsOnly;
  const btn = document.getElementById("debtorsBtn");
  if (_debtorsOnly) {
    btn.className = "flex items-center gap-1.5 px-4 py-2.5 rounded-xl border text-sm font-semibold transition-all bg-red-600 border-red-600 text-white shadow";
    btn.innerHTML = `🔴 المديونون <span class="bg-white text-red-600 rounded-full text-xs font-black px-1.5 leading-none py-0.5">${allCustomers.filter(c=>c.total_debt>0).length}</span>`;
  } else {
    btn.className = "flex items-center gap-1.5 px-4 py-2.5 rounded-xl border text-sm font-semibold transition-all bg-white border-gray-200 text-gray-600 hover:border-red-300 hover:bg-red-50 hover:text-red-600";
    btn.innerHTML = "🔴 المديونون";
  }
  filterCustomers();
}

function filterCustomers() {
  const q = (document.getElementById("searchInput").value || "").toLowerCase().trim();
  let result = allCustomers.filter(c =>
    (c.name || "").toLowerCase().includes(q) ||
    (c.customer_code || "").toLowerCase().includes(q) ||
    (c.phone || "").includes(q) ||
    (c.extra_phones || "").includes(q)
  );
  if (_debtorsOnly) {
    result = result.filter(c => c.total_debt > 0);
    result.sort((a, b) => b.total_debt - a.total_debt);
  }
  renderCustomers(result);
}

// ── Add customer ──────────────────────────────────────────────────────────────
async function generateNewBarcodeForModal(targetInputId) {
  const inp = document.getElementById(targetInputId);
  if (!inp) return;
  inp.value = "جاري التوليد...";
  try {
    const res = await fetch(`${BASE}/api/customer/generate-barcode`);
    const data = await res.json();
    if (data.ok && data.barcode) inp.value = data.barcode;
    else inp.value = Math.floor(100000 + Math.random() * 900000).toString();
  } catch (_) {
    inp.value = Math.floor(100000 + Math.random() * 900000).toString();
  }
}

function addExtraPhoneField(containerId, initialVal = "") {
  const container = document.getElementById(containerId);
  if (!container) return;
  const currentCount = container.querySelectorAll("input").length;
  if (currentCount >= 3) {
    alert("الحد الأقصى للأرقام الإضافية هو 3 أرقام فقط.");
    return;
  }
  const div = document.createElement("div");
  div.className = "flex items-center gap-2";
  div.innerHTML = `
    <input type="tel" value="${initialVal}" placeholder="رقم إضافي (عيادة / مساعد)"
      class="flex-1 border border-gray-200 rounded-lg px-2.5 py-1.5 text-xs font-mono bg-white focus:outline-none focus:ring-1 focus:ring-blue-300"/>
    <button type="button" onclick="this.parentElement.remove()" class="text-red-500 hover:text-red-700 text-sm font-black px-1.5 leading-none">✕</button>
  `;
  container.appendChild(div);
}

function openAddModal() {
  document.getElementById("addModal").classList.remove("hidden");
  generateNewBarcodeForModal("f-barcode");
  populateGovSelect("f-clinic-city", "القاهرة");
  populateDistrictSelect("القاهرة", "f-clinic-region", "f-clinic-region-custom-box", "");
}

function closeAddModal() {
  document.getElementById("addModal").classList.add("hidden");
  ["f-name","f-phone","f-barcode","f-clinic-name","f-clinic-details","f-clinic-phone","f-clinic-region-custom","f-plan"].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.value = "";
  });
  const cityEl = document.getElementById("f-clinic-city");
  if (cityEl) cityEl.value = "";
  const regEl = document.getElementById("f-clinic-region");
  if (regEl) regEl.innerHTML = '<option value="">اختر المحافظة أولاً...</option>';
  document.getElementById("f-clinic-region-custom-box")?.classList.add("hidden");
  const container = document.getElementById("extraPhonesContainer");
  if (container) container.innerHTML = "";
  const errEl = document.getElementById("addModalErr");
  if (errEl) { errEl.classList.add("hidden"); errEl.textContent=""; }
  const btn = document.getElementById("addModalBtn");
  if (btn) { btn.disabled=false; btn.textContent="حفظ وإضافة العميل"; }
}

async function addCustomer(e) {
  e.preventDefault();
  const errEl = document.getElementById("addModalErr");
  const btn   = document.getElementById("addModalBtn");
  errEl.classList.add("hidden");
  btn.disabled = true; btn.textContent = "جارٍ الإضافة...";

  const name = document.getElementById("f-name").value.trim();
  const barcode = (document.getElementById("f-barcode")?.value || "").trim();
  const phone = document.getElementById("f-phone").value.trim();
  const plan = document.getElementById("f-plan")?.value.trim() || "";

  // Extra phones
  const extraInps = document.querySelectorAll("#extraPhonesContainer input");
  const extraPhones = Array.from(extraInps).map(inp => inp.value.trim()).filter(Boolean);

  // Clinic address
  const cName = document.getElementById("f-clinic-name")?.value.trim() || "";
  const cCity = document.getElementById("f-clinic-city")?.value.trim() || "";
  const cRegSelect = document.getElementById("f-clinic-region")?.value.trim() || "";
  const cRegCustom = document.getElementById("f-clinic-region-custom")?.value.trim() || "";
  const cRegion = (cRegSelect === '__custom__' ? cRegCustom : cRegSelect);
  const cDetails = document.getElementById("f-clinic-details")?.value.trim() || "";
  const cPhone = document.getElementById("f-clinic-phone")?.value.trim() || "";

  let addresses = [];
  if (cName || cCity || cRegion || cDetails) {
    const full = [cCity, cRegion, cDetails].filter(Boolean).join(' - ');
    addresses.push({
      id: 'addr_' + Date.now(),
      title: cName || (cRegion ? `عيادة ${cRegion}` : 'العيادة الرئيسية'),
      city: cCity || 'القاهرة',
      region: cRegion || '',
      details: cDetails || '',
      phone: cPhone || '',
      address: full,
      is_default: true
    });
  }

  try {
    const res  = await fetch(`${BASE}/api/customers`, {
      method:"POST", headers:{"Content-Type":"application/json"},
      body: JSON.stringify({
        name, phone, barcode,
        extra_phones: extraPhones,
        addresses,
        installment_plan: plan
      })
    });
    const data = await res.json();
    if (!res.ok) {
      errEl.textContent = data.error || "حدث خطأ أثناء الحفظ";
      errEl.classList.remove("hidden");
      btn.disabled = false; btn.textContent = "حفظ وإضافة العميل";
      return;
    }
    closeAddModal(); loadCustomers();
  } catch(_) {
    errEl.textContent = "حدث خطأ في الاتصال";
    errEl.classList.remove("hidden");
    btn.disabled = false; btn.textContent = "حفظ وإضافة العميل";
  }
}

// ── Detail modal ──────────────────────────────────────────────────────────────
async function promptEditBarcode() {
  if (!currentCustomer) return;
  const oldBarcode = currentCustomer.barcode || currentCustomer.customer_code?.replace(/^vip/i, '') || '';
  const newCode = prompt("أدخل الباركود الجديد للعميل (يجب أن يكون 6 أرقام فقط):", oldBarcode);
  if (newCode === null) return;
  const clean = newCode.trim();
  if (!/^\d{6}$/.test(clean)) {
    alert("❌ عذراً، يجب أن يتكون الباركود من 6 أرقام فقط (مثال: 849201).");
    return;
  }
  try {
    const res = await fetch(`${BASE}/api/customer/update-barcode`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ customer_id: currentCustomer.id, barcode: clean })
    });
    const data = await res.json();
    if (!res.ok) throw new Error(data.error || "فشل تعديل الباركود");
    alert("✅ تم حفظ الباركود الجديد بنجاح: " + clean);
    currentCustomer.barcode = clean;
    currentCustomer.customer_code = data.customer_code;
    document.getElementById("detailBarcodeText").textContent = clean;
    loadCustomers();
  } catch (err) {
    alert("❌ " + err.message);
  }
}

async function quickToggleVip(cid, name) {
  const cust = allCustomers.find(x => x.id === cid);
  const isVip = cust ? cust.is_vip : false;
  const msg = isVip
    ? `هل تريد إلغاء عضوية VIP للطبيب "${name}" والعودة للكود العادي؟`
    : `هل تريد ترقية الطبيب "${name}" إلى عضوية VIP الفخمة (توصيل مجاني 100%)؟`;
  if (!confirm(msg)) return;
  try {
    const res = await fetch(`${BASE}/api/customer/toggle-vip`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ customer_id: cid })
    });
    const data = await res.json();
    if (!res.ok) throw new Error(data.error || "فشل تعديل حالة VIP");
    alert(data.is_vip ? "✅ تم ترقية العميل إلى 👑 VIP بنجاح!" : "✅ تم إلغاء عضوية VIP بنجاح.");
    await loadCustomers();
    if (currentCustomer && currentCustomer.id === cid) {
      currentCustomer.is_vip = data.is_vip;
      currentCustomer.customer_code = data.customer_code;
      openDetail(cid);
    }
  } catch (err) {
    alert("❌ " + err.message);
  }
}

async function toggleCustomerVip() {
  if (!currentCustomer) return;
  await quickToggleVip(currentCustomer.id, currentCustomer.name);
}

async function openDetail(cid) {
  const c = allCustomers.find(x => x.id === cid);
  if (!c) return;
  currentCustomer = c;
  currentTab = 'orders';

  document.getElementById("detailName").textContent = c.name;
  document.getElementById("detailPhone").textContent = c.phone ? `📞 ${c.phone}` : "";
  document.getElementById("detailAddress").textContent = c.address ? `📍 ${c.address}` : "";
  
  const barcode = c.barcode || c.customer_code?.replace(/^vip/i, '') || '';
  document.getElementById("detailBarcodeText").textContent = barcode || '—';
  
  const vipBadge = document.getElementById("detailVipBadge");
  const btnToggleVip = document.getElementById("btnToggleVip");
  if (c.is_vip) {
    vipBadge.classList.remove("hidden");
    btnToggleVip.textContent = "👑 VIP (مفعل - إلغاء)";
    btnToggleVip.className = "flex items-center gap-1.5 bg-amber-600 hover:bg-amber-700 text-white text-sm font-bold px-4 py-2 rounded-xl shadow-sm";
  } else {
    vipBadge.classList.add("hidden");
    btnToggleVip.textContent = "👑 تحويل إلى VIP";
    btnToggleVip.className = "flex items-center gap-1.5 bg-gray-100 hover:bg-amber-100 text-gray-700 hover:text-amber-800 text-sm font-bold px-4 py-2 rounded-xl shadow-sm border border-gray-200";
  }

  const badge = document.getElementById("detailDebtBadge");
  if (c.total_debt > 0) {
    badge.textContent = `متبقي: ${c.total_debt.toLocaleString('ar-EG', {minimumFractionDigits:2})} جنيه`;
    badge.className = "text-sm font-bold px-3 py-1 rounded-full bg-red-100 text-red-700";
  } else {
    badge.textContent = "✓ لا يوجد آجل";
    badge.className = "text-sm font-bold px-3 py-1 rounded-full bg-green-100 text-green-700";
  }
  document.getElementById("detailPlan").textContent = c.installment_plan ? `خطة: ${c.installment_plan}` : "";

  // WhatsApp button visibility
  document.getElementById("btnWhatsapp").style.display = c.phone ? "flex" : "none";

  document.getElementById("statementStrip").classList.add("hidden");
  document.getElementById("detailModal").classList.remove("hidden");
  switchTab('orders');

  // Load statement if customer has any credit activity
  fetch(`${BASE}/api/customers/${cid}/statement`).then(r=>r.json()).then(st => {
    if (!st.error && (st.total_invoiced > 0 || st.total_paid > 0)) {
      document.getElementById("stmtInvoiced").textContent  = st.net_invoiced.toLocaleString('ar-EG', {minimumFractionDigits:2}) + " ج";
      document.getElementById("stmtPaid").textContent      = st.total_paid.toLocaleString('ar-EG', {minimumFractionDigits:2}) + " ج";
      document.getElementById("stmtRemaining").textContent = st.remaining.toLocaleString('ar-EG', {minimumFractionDigits:2}) + " ج";
      document.getElementById("statementStrip").classList.remove("hidden");
    }
  });
}

function closeDetail() {
  document.getElementById("detailModal").classList.add("hidden");
  currentCustomer = null;
}

