<%- include('partials/header', Object.assign({pageTitle: 'العملاء'}, locals)) %>
<div class="space-y-5">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold text-gray-800" data-ar="👥 العملاء والآجل" data-en="👥 Customers &amp; Credit">👥 العملاء والآجل</h1>
    <div class="flex gap-2">
    <button onclick="openAddModal()" class="bg-blue-700 text-white px-5 py-2.5 rounded-xl font-semibold hover:bg-blue-800 shadow">+ إضافة عميل</button>
    <button onclick="openMergeModal()" class="bg-purple-600 text-white px-4 py-2.5 rounded-xl font-semibold hover:bg-purple-700 shadow">🔀 دمج عميلين</button>
  </div>
  </div>

  <!-- Stats -->
  <div class="grid grid-cols-2 gap-4">
    <div class="bg-white rounded-2xl border shadow-sm p-4 text-center">
      <div id="totalCustomers" class="text-3xl font-black text-blue-700">—</div>
      <div class="text-sm text-gray-500 mt-1" data-ar="إجمالي العملاء" data-en="Total Customers">إجمالي العملاء</div>
    </div>
    <div class="bg-white rounded-2xl border shadow-sm p-4 text-center">
      <div id="totalDebt" class="text-3xl font-black text-red-600">—</div>
      <div class="text-xs text-gray-500 mt-1" data-ar="إجمالي الآجل (جنيه)" data-en="Total Credit (EGP)">إجمالي الآجل (جنيه)</div>
    </div>
  </div>

  <!-- Search + Debtors filter -->
  <div class="flex gap-2">
    <input id="searchInput" oninput="filterCustomers()" type="text"
      data-ar-placeholder="🔍 بحث عن عميل..." data-en-placeholder="🔍 Search customer..."
      placeholder="🔍 بحث عن عميل..." class="flex-1 border rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-200"/>
    <button id="debtorsBtn" onclick="toggleDebtorsFilter()"
      class="flex items-center gap-1.5 px-4 py-2.5 rounded-xl border text-sm font-semibold transition-all bg-white border-gray-200 text-gray-600 hover:border-red-300 hover:bg-red-50 hover:text-red-600">
      🔴 المديونون
    </button>
  </div>

  <!-- Customer List -->
  <div id="customerList" class="space-y-2"></div>
  <div id="noCustomers" class="hidden text-center text-gray-400 py-12" data-ar="لا يوجد عملاء مسجلين" data-en="No customers registered">لا يوجد عملاء مسجلين</div>
</div>

<!-- ══════════════════════ Add Customer Modal ══════════════════════ -->
<div id="addModal" class="hidden fixed inset-0 bg-black/40 flex items-center justify-center z-50 p-4">
  <div class="bg-white rounded-2xl w-full max-w-md shadow-2xl max-h-[90vh] flex flex-col">
    <div class="p-5 border-b flex items-center justify-between shrink-0">
      <h3 class="font-bold text-gray-800 text-lg">إضافة عميل جديد</h3>
      <button onclick="closeAddModal()" class="text-gray-400 hover:text-gray-600 text-2xl leading-none">×</button>
    </div>
    <form onsubmit="addCustomer(event)" class="p-5 space-y-3.5 overflow-y-auto">
      <div>
        <label class="text-xs font-bold text-gray-700 block mb-1">اسم الطبيب / العميل <span class="text-red-500">*</span></label>
        <input id="f-name" required class="w-full border border-gray-300 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-300" placeholder="د. أحمد محمد"/>
      </div>
      
      <!-- Barcode 6 digits -->
      <div>
        <div class="flex items-center justify-between mb-1">
          <label class="text-xs font-bold text-gray-700">الباركود (6 أرقام عشوائية) <span class="text-red-500">*</span></label>
          <button type="button" onclick="generateNewBarcodeForModal('f-barcode')" class="text-xs text-blue-600 hover:text-blue-800 font-bold flex items-center gap-1">
            <span>🔄</span> توليد باركود جديد
          </button>
        </div>
        <input id="f-barcode" required type="text" maxlength="6" pattern="[0-9]{6}"
          class="w-full border border-gray-300 rounded-xl px-3 py-2 text-sm font-mono font-bold text-blue-800 tracking-wider focus:outline-none focus:ring-2 focus:ring-blue-300"
          placeholder="مثال: 849201"/>
        <p class="text-[11px] text-gray-400 mt-0.5">باركود رقمي فريد خاص بالطبيب مكون من 6 أرقام يمنع التكرار.</p>
      </div>

      <!-- Primary Phone -->
      <div>
        <label class="text-xs font-bold text-gray-700 block mb-1">رقم الهاتف الأساسي</label>
        <input id="f-phone" type="tel" class="w-full border border-gray-300 rounded-xl px-3 py-2 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-blue-300" placeholder="01xxxxxxxxx"/>
      </div>

      <!-- Extra phones (up to 3) -->
      <div>
        <div class="flex items-center justify-between mb-1">
          <label class="text-xs font-semibold text-gray-600">أرقام هواتف إضافية (العيادة / المساعد)</label>
          <button type="button" onclick="addExtraPhoneField('extraPhonesContainer')" class="text-xs text-emerald-600 hover:text-emerald-800 font-bold">
            ＋ إضافة رقم
          </button>
        </div>
        <div id="extraPhonesContainer" class="space-y-1.5"></div>
      </div>

      <!-- Clinic Address -->
      <div class="bg-blue-50/50 border border-blue-200 rounded-xl p-3.5 space-y-2.5">
        <div class="flex items-center justify-between">
          <label class="text-xs font-bold text-gray-800 flex items-center gap-1.5">
            <span>🏥</span> عنوان العيادة الرئيسية (اختياري)
          </label>
          <span class="text-[10px] bg-blue-100 text-blue-800 font-bold px-2 py-0.5 rounded-full border border-blue-200">⭐ عنوان افتراضي</span>
        </div>
        <input id="f-clinic-name" class="w-full border border-gray-300 rounded-xl px-3 py-2 text-xs bg-white focus:outline-none focus:ring-2 focus:ring-blue-300" placeholder="اسم العيادة (مثال: عيادة المهندسين / د. فلان)"/>
        <div class="grid grid-cols-2 gap-2">
          <div>
            <label class="text-[11px] font-bold text-gray-700 block mb-1">المحافظة *</label>
            <select id="f-clinic-city" onchange="onGovChange('f-clinic-city','f-clinic-region','f-clinic-region-custom-box')" class="w-full border border-gray-300 rounded-xl px-2.5 py-2 text-xs bg-white font-medium focus:outline-none focus:ring-2 focus:ring-blue-300">
              <option value="">اختر المحافظة...</option>
            </select>
          </div>
          <div>
            <label class="text-[11px] font-bold text-gray-700 block mb-1">المنطقة / الحي *</label>
            <select id="f-clinic-region" onchange="onDistrictChange('f-clinic-region','f-clinic-region-custom-box')" class="w-full border border-gray-300 rounded-xl px-2.5 py-2 text-xs bg-white font-medium focus:outline-none focus:ring-2 focus:ring-blue-300">
              <option value="">اختر المنطقة...</option>
            </select>
          </div>
        </div>
        <div id="f-clinic-region-custom-box" class="hidden">
          <input id="f-clinic-region-custom" class="w-full border border-gray-300 rounded-xl px-3 py-2 text-xs bg-white" placeholder="اكتب اسم الحي / القرية يدوياً..."/>
        </div>
        <div>
          <label class="text-[11px] font-bold text-gray-700 block mb-1">الشارع والعمارة بالتفصيل</label>
          <input id="f-clinic-details" class="w-full border border-gray-300 rounded-xl px-3 py-2 text-xs bg-white focus:outline-none focus:ring-2 focus:ring-blue-300" placeholder="مثال: 15 شارع سوريا - الدور 3 - عمارة الأطباء"/>
        </div>
        <div>
          <label class="text-[11px] font-bold text-gray-700 block mb-1">هاتف العيادة / السكرتير (اختياري)</label>
          <input id="f-clinic-phone" type="tel" class="w-full border border-gray-300 rounded-xl px-3 py-2 text-xs font-mono bg-white focus:outline-none focus:ring-2 focus:ring-blue-300" placeholder="01xxxxxxxxx"/>
        </div>
      </div>

      <div>
        <label class="text-xs font-semibold text-gray-600 block mb-1">خطة التقسيط / ملاحظات</label>
        <input id="f-plan" class="w-full border border-gray-300 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-300" placeholder="مثال: 500 جنيه شهرياً"/>
      </div>

      <div id="addModalErr" class="hidden bg-red-50 border border-red-300 text-red-700 text-sm rounded-xl px-3 py-2"></div>
      <div class="flex gap-3 pt-2 shrink-0">
        <button type="submit" id="addModalBtn" class="flex-1 bg-blue-700 text-white font-bold py-2.5 rounded-xl hover:bg-blue-800 shadow-sm text-sm">حفظ وإضافة العميل</button>
        <button type="button" onclick="closeAddModal()" class="flex-1 bg-gray-100 text-gray-700 font-semibold py-2.5 rounded-xl text-sm">إلغاء</button>
      </div>
    </form>
  </div>
</div>

<!-- ══════════════════════ Customer Detail Modal ══════════════════════ -->
<div id="detailModal" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-3">
  <div class="bg-white rounded-2xl w-full max-w-lg shadow-2xl flex flex-col max-h-[90vh]">

    <!-- Header -->
    <div id="detailHeader" class="p-5 border-b flex items-start justify-between shrink-0">
      <div>
        <h2 id="detailName" class="text-xl font-black text-gray-800"></h2>
        <p id="detailPhone" class="text-sm text-gray-500 mt-0.5"></p>
        <p id="detailAddress" class="text-xs text-gray-400 mt-0.5"></p>
        <div class="flex items-center gap-3 mt-2">
          <span id="detailDebtBadge" class="text-sm font-bold px-3 py-1 rounded-full"></span>
          <span id="detailPlan" class="text-xs text-gray-400"></span>
        </div>
        <div class="flex items-center gap-2 mt-2 flex-wrap">
          <span class="text-xs text-gray-500 font-semibold">🏷️ الباركود:</span>
          <span id="detailBarcodeText" class="font-mono font-black text-sm text-blue-700 bg-blue-50 px-2.5 py-0.5 rounded-md border border-blue-200"></span>
          <button onclick="promptEditBarcode()" class="text-xs text-blue-600 hover:text-blue-800 font-bold underline">✏️ تعديل الباركود</button>
          <span id="detailVipBadge" class="hidden bg-gradient-to-r from-amber-400 to-yellow-500 text-slate-900 font-black text-xs px-2.5 py-0.5 rounded-md shadow-xs">👑 VIP MEMBER</span>
        </div>
        <!-- Statement summary strip -->
        <div id="statementStrip" class="hidden mt-3 grid grid-cols-3 gap-2 text-center">
          <div class="bg-blue-50 rounded-xl px-2 py-2">
            <div class="text-xs text-blue-500 font-medium">إجمالي الفواتير</div>
            <div id="stmtInvoiced" class="text-sm font-black text-blue-700">—</div>
          </div>
          <div class="bg-green-50 rounded-xl px-2 py-2">
            <div class="text-xs text-green-600 font-medium">إجمالي المدفوع</div>
            <div id="stmtPaid" class="text-sm font-black text-green-700">—</div>
          </div>
          <div class="bg-red-50 rounded-xl px-2 py-2">
            <div class="text-xs text-red-500 font-medium">المتبقي عليه</div>
            <div id="stmtRemaining" class="text-sm font-black text-red-600">—</div>
          </div>
        </div>
      </div>
      <button onclick="closeDetail()" class="text-gray-400 hover:text-gray-600 text-2xl leading-none mt-1">×</button>
    </div>

    <!-- Action buttons -->
    <div class="px-5 py-3 border-b bg-gray-50 flex gap-2 flex-wrap shrink-0">
      <button id="btnToggleVip" onclick="toggleCustomerVip()" class="flex items-center gap-1.5 bg-amber-500 hover:bg-amber-600 text-white text-sm font-bold px-4 py-2 rounded-xl shadow-sm">
        👑 تحويل إلى VIP
      </button>
      <button id="btnWhatsapp" onclick="openWhatsapp()" class="flex items-center gap-2 bg-green-500 hover:bg-green-600 text-white text-sm font-semibold px-4 py-2 rounded-xl shadow-sm">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.127.558 4.123 1.532 5.855L.054 23.5l5.819-1.527A11.938 11.938 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 01-5.012-1.375l-.36-.213-3.727.977.994-3.63-.235-.374A9.818 9.818 0 1112 21.818z"/></svg>
        واتساب
      </button>
      <button onclick="resetCustomerPassword()" class="flex items-center gap-1.5 bg-amber-50 hover:bg-amber-100 text-amber-800 border border-amber-200 text-sm font-semibold px-4 py-2 rounded-xl shadow-sm">
        🔑 تصفير كلمة المرور
      </button>
      <button onclick="openPayModal()" class="flex items-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold px-4 py-2 rounded-xl shadow-sm">
        💸 تسجيل دفعة
      </button>
      <button onclick="openManualDebtModal()" class="flex items-center gap-2 bg-orange-50 hover:bg-orange-100 text-orange-700 text-sm font-semibold px-4 py-2 rounded-xl">
        💰 إضافة سلفة/دين
      </button>
      <button onclick="openEditCustomerModal()" class="flex items-center gap-2 bg-blue-50 hover:bg-blue-100 text-blue-700 text-sm font-semibold px-4 py-2 rounded-xl">
        ✏️ تعديل البيانات
      </button>
      <button id="btnDelete" onclick="confirmDelete()" class="flex items-center gap-2 bg-red-50 hover:bg-red-100 text-red-600 text-sm font-semibold px-4 py-2 rounded-xl">
        🗑 حذف العميل
      </button>
    </div>

    <!-- Tabs -->
    <div class="flex border-b shrink-0 overflow-x-auto">
      <button id="tabOrders"       onclick="switchTab('orders')"       class="flex-1 py-3 text-sm font-semibold text-blue-700 border-b-2 border-blue-700 whitespace-nowrap">🧾 الطلبات</button>
      <button id="tabClinics"      onclick="switchTab('clinics')"      class="flex-1 py-3 text-sm font-semibold text-gray-400 whitespace-nowrap">🏥 العيادات والعناوين</button>
      <button id="tabPayments"     onclick="switchTab('payments')"     class="flex-1 py-3 text-sm font-semibold text-gray-400 whitespace-nowrap">💳 الدفعات</button>
      <button id="tabInstallments" onclick="switchTab('installments')" class="flex-1 py-3 text-sm font-semibold text-gray-400 whitespace-nowrap">📅 الأقساط</button>
      <button id="tabDebts"        onclick="switchTab('debts')"        class="flex-1 py-3 text-sm font-semibold text-gray-400 whitespace-nowrap">💰 السلف</button>
    </div>

    <!-- Scrollable content -->
    <div class="overflow-y-auto flex-1 p-4 space-y-3" id="detailContent">
      <div class="text-center text-gray-400 py-8">جار التحميل...</div>
    </div>
  </div>
</div>

<!-- ══════════════════════ Pay Modal ══════════════════════ -->
<div id="payModal" class="hidden fixed inset-0 bg-black/40 flex items-center justify-center z-[60] p-4">
  <div class="bg-white rounded-2xl w-full max-w-sm shadow-2xl p-6 space-y-4">
    <h3 class="font-bold text-gray-800 text-lg">💸 تسجيل دفعة</h3>
    <p id="payCustomerLabel" class="text-sm text-gray-600 bg-gray-50 rounded-xl p-3 font-medium"></p>
    <div class="bg-green-50 border border-green-200 rounded-xl p-3 space-y-2">
      <div class="flex items-center gap-2">
        <span class="text-xs font-semibold text-gray-600 w-24">🪙 كاش ورق</span>
        <input id="payCash" type="number" min="0" step="0.01" value="0"
          class="flex-1 border rounded-lg px-2 py-1.5 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-green-300"/>
        <span class="text-xs text-gray-400">ج</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="text-xs font-semibold text-gray-600 w-24">📱 انستا باي</span>
        <input id="payInsta" type="number" min="0" step="0.01" value="0"
          class="flex-1 border rounded-lg px-2 py-1.5 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-purple-300"/>
        <span class="text-xs text-gray-400">ج</span>
      </div>
    </div>
    <div>
      <label class="text-xs font-medium text-gray-600">ملاحظة (اختياري)</label>
      <input id="payNote" type="text" placeholder="مثال: دفعة شهر مايو"
        class="w-full border rounded-xl px-3 py-2 text-sm mt-1 focus:outline-none focus:ring-2 focus:ring-green-200"/>
    </div>
    <div class="flex gap-3">
      <button onclick="submitPayment()" class="flex-1 bg-green-600 text-white font-semibold py-2.5 rounded-xl hover:bg-green-700">✓ تأكيد</button>
      <button onclick="document.getElementById('payModal').classList.add('hidden')" class="flex-1 bg-gray-100 text-gray-700 font-semibold py-2.5 rounded-xl">إلغاء</button>
    </div>
  </div>
</div>

<!-- ══════════════════════ Debt Collection Modal ══════════════════════ -->
<div id="debtCollectModal" class="hidden fixed inset-0 bg-black/40 flex items-center justify-center z-[70] p-4">
  <div class="bg-white rounded-2xl w-full max-w-sm shadow-2xl p-6 space-y-4">
    <h3 class="font-bold text-gray-800 text-lg">✅ تسجيل سداد الفاتورة</h3>
    <p id="debtCollectLabel" class="text-sm text-orange-700 bg-orange-50 rounded-xl p-3 font-medium border border-orange-200"></p>
    <div class="bg-blue-50 border border-blue-200 rounded-xl p-3 space-y-2">
      <p class="text-xs font-semibold text-blue-700 mb-1">كيف تم استلام المبلغ؟</p>
      <div class="flex items-center gap-2">
        <span class="text-xs font-semibold text-gray-600 w-24">🪙 كاش ورق</span>
        <input id="debtCash" type="number" min="0" step="0.01" value="0"
          oninput="updateDebtSplitInfo()"
          class="flex-1 border-2 border-gray-200 rounded-xl px-3 py-2 text-sm font-mono focus:outline-none focus:border-orange-400"/>
        <span class="text-xs text-gray-400">ج</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="text-xs font-semibold text-gray-600 w-24">📱 انستا باي</span>
        <input id="debtInsta" type="number" min="0" step="0.01" value="0"
          oninput="updateDebtSplitInfo()"
          class="flex-1 border-2 border-gray-200 rounded-xl px-3 py-2 text-sm font-mono focus:outline-none focus:border-purple-400"/>
        <span class="text-xs text-gray-400">ج</span>
      </div>
      <div id="debtSplitInfo" class="text-xs text-center font-semibold text-gray-500 pt-1"></div>
    </div>
    <div class="flex gap-3">
      <button onclick="submitDebtCollection()" class="flex-1 bg-green-600 text-white font-semibold py-2.5 rounded-xl hover:bg-green-700">✓ تأكيد السداد</button>
      <button onclick="document.getElementById('debtCollectModal').classList.add('hidden')" class="flex-1 bg-gray-100 text-gray-700 font-semibold py-2.5 rounded-xl">إلغاء</button>
    </div>
  </div>
</div>

<script>
const BASE = "<%- base %>";
let allCustomers = [];
let currentCustomer = null;
let currentTab = 'orders';
let _debtorsOnly = false;

// ── Egyptian Governorates & Key Districts ──────────────────────────────────
const EGYPT_GOVERNORATES = {
