          ✅ تأكيد الإرجاع للمستودع
        </button>
        <button type="button" onclick="closeReturnModal()" class="px-5 bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold py-3 rounded-xl text-sm">
          إلغاء
        </button>
      </div>
    </form>
  </div>
</div>

<!-- ════════════════ Modal: مقارنة مقاسات المستودع والمحل ════════════════ -->
<div id="variantCompareModal" class="hidden fixed inset-0 bg-black/60 z-[80] flex items-center justify-center p-3 md:p-6 overflow-y-auto">
  <div class="bg-white rounded-3xl shadow-2xl w-full max-w-2xl overflow-hidden animate-in fade-in zoom-in-95 duration-150">
    <div class="bg-gradient-to-r from-indigo-700 via-blue-800 to-indigo-900 text-white p-5 flex items-center justify-between">
      <div>
        <h3 class="font-black text-lg flex items-center gap-2"><span>📊</span> جدول مقارنة مقاسات المستودع ومخزون المحل</h3>
        <p id="cmp-prod-name" class="text-xs text-indigo-200 mt-0.5 font-medium"></p>
      </div>
      <button onclick="closeVariantCompareModal()" class="text-white/70 hover:text-white text-2xl leading-none">✕</button>
    </div>

    <div class="p-5 space-y-4 max-h-[75vh] overflow-y-auto">
      <div class="overflow-x-auto rounded-2xl border border-gray-200 shadow-sm">
        <table class="w-full text-right text-xs">
          <thead class="bg-gray-50 font-bold text-gray-700 border-b">
            <tr>
              <th class="p-3">المقاس / الخيار</th>
              <th class="p-3 text-center">🏢 المتاح بالمستودع</th>
              <th class="p-3 text-center">🏬 المتاح بالمحل</th>
              <th class="p-3 text-center">📦 إجمالي المخزون</th>
              <th class="p-3 text-center">حالة التوفر</th>
              <th class="p-3 text-center">إجراء سريع</th>
            </tr>
          </thead>
          <tbody id="cmp-table-body" class="divide-y divide-gray-100 font-medium"></tbody>
        </table>
      </div>

      <div class="bg-indigo-50 border border-indigo-200 rounded-2xl p-3 text-xs text-indigo-900 flex items-center justify-between">
        <span class="font-bold">💡 نصيحة: المقاسات ذات اللون الأحمر 🔴 نافدة في المحل، اضغط "تحويل للمحل" لتوريدها فوراً.</span>
      </div>
    </div>

    <div class="p-4 border-t bg-gray-50 flex justify-end">
      <button onclick="closeVariantCompareModal()" class="px-6 bg-gray-200 hover:bg-gray-300 text-gray-800 font-bold py-2.5 rounded-xl text-sm transition-all">
        إغلاق
      </button>
    </div>
  </div>
</div>

<script>
const BASE = '<%= base %>';
let _warehouseItems = [];
let _shopProducts = [];
let _currentTrItem = null;
let _currentTrSizeKey = null;
let _maxAvailTr = 0;
let _addMode = 'shop';

async function loadWarehouseData() {
  try {
    const res = await fetch(`${BASE}/api/warehouse/products`);
    const data = await res.json();
    _warehouseItems = data.items || [];
    _shopProducts = data.shop_products || [];

    // Update Valuation Stats
    const totalCost = _warehouseItems.reduce((s, i) => s + (parseFloat(i.cost_price||0) * parseInt(i.quantity||0)), 0);
    const totalRetail = _warehouseItems.reduce((s, i) => s + (parseFloat(i.sale_price||0) * parseInt(i.quantity||0)), 0);
    const totalProfit = Math.max(0, totalRetail - totalCost);

    document.getElementById('wh-stat-cost').textContent = totalCost.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ج';
    document.getElementById('wh-stat-retail').textContent = totalRetail.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ج';
    document.getElementById('wh-stat-profit').textContent = totalProfit.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ج';
    document.getElementById('wh-stat-count').textContent = _warehouseItems.length;

    // Populate Category filter
    const catSelect = document.getElementById('whCatFilter');
    const categories = Array.from(new Set(_warehouseItems.map(i => i.category).filter(Boolean)));
    catSelect.innerHTML = '<option value="">جميع التصنيفات</option>' + categories.map(c => `<option value="${c}">${c}</option>`).join('');

    renderWarehouseTable(_warehouseItems);
  } catch (err) {
    console.error('Failed to load warehouse data:', err);
  }
}

function renderWarehouseTable(items) {
  const tbody = document.getElementById('whTableBody');
  const noData = document.getElementById('whNoData');

  if (!items || !items.length) {
    tbody.innerHTML = '';
    noData.classList.remove('hidden');
    return;
  }
  noData.classList.add('hidden');

  tbody.innerHTML = items.map(i => {
    const whStock = parseInt(i.quantity || 0);
    const shopStock = i.shop_quantity != null ? parseInt(i.shop_quantity) : '—';
    const cost = parseFloat(i.cost_price || 0).toFixed(2);
    const price = parseFloat(i.sale_price || 0).toFixed(2);

    // Variants badge preview with interactive comparison trigger
    let variantsHtml = '';
    let hasVariantOpts = false;
    if (i.checkbox_values) {
      const cbv = typeof i.checkbox_values === 'string' ? JSON.parse(i.checkbox_values) : i.checkbox_values;
      const opts = Object.keys(cbv);
      if (opts.length > 0) {
        hasVariantOpts = true;
        // Compare with shop product variants if linked
        const shopProd = _shopProducts.find(p => p.id === i.product_id);
        const shopCbv = shopProd && shopProd.checkbox_values ? (typeof shopProd.checkbox_values === 'string' ? JSON.parse(shopProd.checkbox_values) : shopProd.checkbox_values) : {};

        variantsHtml = `<div class="mt-1.5 flex flex-wrap items-center gap-1.5">` +
          opts.slice(0, 3).map(o => {
            const wStock = cbv[o].stock != null ? cbv[o].stock : 0;
            const sStock = shopCbv[o]?.stock != null ? shopCbv[o]?.stock : 0;
            const isLowInShop = sStock <= 0;
            return `<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-lg text-[11px] font-mono border ${isLowInShop ? 'bg-amber-50 text-amber-800 border-amber-300' : 'bg-blue-50 text-blue-800 border-blue-200'}">
              <strong>${o}:</strong> <span title="مستودع">🏢${wStock}</span> | <span title="محل" class="${isLowInShop ? 'text-red-600 font-bold' : ''}">🏬${sStock}</span>
            </span>`;
          }).join('') +
          `<button type="button" onclick="openVariantCompareModal(${i.id})" class="px-2 py-0.5 rounded-lg text-[11px] font-bold bg-indigo-50 hover:bg-indigo-100 text-indigo-700 border border-indigo-200 transition-all flex items-center gap-1">
            <span>📊</span> مقارنة المقاسات (${opts.length})
          </button>` +
          `</div>`;
      }
    }

    // Batches count badge
    const batchCount = (i.batches || []).length;
    const batchesBadge = batchCount > 1 
      ? `<span class="px-2 py-0.5 rounded-full text-[11px] font-bold bg-purple-50 text-purple-700 border border-purple-200">📦 ${batchCount} شحنات</span>`
      : (i.expiry_date ? `<span class="text-xs text-gray-500 font-mono">📅 ${i.expiry_date}</span>` : '<span class="text-gray-300 text-xs">—</span>');

    return `
      <tr class="hover:bg-gray-50 transition-colors">
        <td class="p-3.5">
          <div class="font-bold text-gray-900">${i.product_name}</div>
          ${variantsHtml}
          ${i.description ? `<div class="text-[11px] text-gray-400 line-clamp-1 mt-0.5">${i.description}</div>` : ''}
        </td>
        <td class="p-3.5 font-mono text-xs text-gray-500">${i.barcode || '—'}</td>
        <td class="p-3.5">
          <span class="inline-block px-2.5 py-0.5 rounded-lg text-xs font-semibold bg-gray-100 text-gray-700">
            ${i.category || 'عام'}
          </span>
        </td>
        <td class="p-3.5 font-mono text-amber-700 font-bold">${cost} ج</td>
        <td class="p-3.5 font-mono text-gray-800">${price > 0 ? price + ' ج' : '—'}</td>
        <td class="p-3.5 text-center">
          <span class="px-2.5 py-1 rounded-full font-bold text-xs ${whStock > 0 ? 'bg-amber-50 text-amber-800 border border-amber-200' : 'bg-red-50 text-red-700'} font-mono">
            ${whStock} قطعة
          </span>
        </td>
        <td class="p-3.5 text-center">
          <span class="px-2.5 py-1 rounded-full font-bold text-xs bg-blue-50 text-blue-800 border border-blue-200 font-mono">
            ${shopStock} قطعة
          </span>
        </td>
        <td class="p-3.5 text-center">${batchesBadge}</td>
        <td class="p-3.5 text-center">
          <div class="flex items-center justify-center gap-1.5">
            <button onclick="openTransferModal(${i.id})" ${whStock <= 0 ? 'disabled' : ''}
              class="bg-blue-600 hover:bg-blue-700 disabled:opacity-40 text-white font-bold px-3 py-1.5 rounded-xl text-xs shadow-sm transition-all flex items-center gap-1">
              <span>🚚</span> تحويل للمحل
            </button>
            <button onclick="openAddBatchModal(${i.id})" title="إضافة شحنة جديدة"
              class="bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold p-1.5 rounded-xl text-xs transition-all">
              ➕
            </button>
          </div>
        </td>
      </tr>
    `;
  }).join('');
}

function filterWarehouseTable() {
  const q = (document.getElementById('whSearchInput').value || '').trim().toLowerCase();
  const cat = document.getElementById('whCatFilter').value;
  const stock = document.getElementById('whStockFilter').value;

  const filtered = _warehouseItems.filter(i => {
    if (q) {
      const matchName = (i.product_name || '').toLowerCase().includes(q);
      const matchBar = (i.barcode || '').toLowerCase().includes(q);
      const matchCat = (i.category || '').toLowerCase().includes(q);
      if (!matchName && !matchBar && !matchCat) return false;
    }
    if (cat && i.category !== cat) return false;
    if (stock === 'in_stock' && (parseInt(i.quantity||0) <= 0)) return false;
    if (stock === 'out_of_stock' && (parseInt(i.quantity||0) > 0)) return false;
    return true;
  });

  renderWarehouseTable(filtered);
}

// ── Add Warehouse Item Modal & Live Search ────────────────────────────────────
function openAddWarehouseModal() {
  document.getElementById('addWhModal').classList.remove('hidden');
  switchAddMode('shop');
  clearSelectedShopProduct();
  document.getElementById('aw-name').value = '';
  document.getElementById('aw-barcode').value = '';
  document.getElementById('aw-category').value = '';
  document.getElementById('aw-cost').value = '0.00';
  document.getElementById('aw-price').value = '0.00';
  document.getElementById('aw-qty').value = '1';
  document.getElementById('aw-desc').value = '';
  document.getElementById('aw-expiry').value = '';
  document.getElementById('aw-notes').value = '';
  document.getElementById('aw-error').classList.add('hidden');
}

function openAddBatchModal(itemId) {
  const item = _warehouseItems.find(i => i.id === itemId);
  if (!item) return;
  openAddWarehouseModal();
  if (item.product_id) {
    const shopProd = _shopProducts.find(p => p.id === item.product_id);
    if (shopProd) selectShopProduct(shopProd);
  } else {
    switchAddMode('custom');
    document.getElementById('aw-name').value = item.product_name;
    document.getElementById('aw-barcode').value = item.barcode || '';
    document.getElementById('aw-category').value = item.category || '';
    document.getElementById('aw-price').value = item.sale_price || 0;
  }
}

function closeAddWarehouseModal() {
  document.getElementById('addWhModal').classList.add('hidden');
}

function switchAddMode(mode) {
  _addMode = mode;
  const tabShop = document.getElementById('tabModeShop');
  const tabCust = document.getElementById('tabModeCustom');
  const secSearch = document.getElementById('sec-shop-search');
  const lockIcon = document.getElementById('aw-price-lock');
  const priceInput = document.getElementById('aw-price');

  if (mode === 'shop') {
    tabShop.className = 'pb-2.5 border-b-2 border-blue-600 text-blue-700 flex items-center gap-1.5 transition-all';
    tabCust.className = 'pb-2.5 border-b-2 border-transparent text-gray-500 hover:text-gray-800 flex items-center gap-1.5 transition-all';
    secSearch.classList.remove('hidden');
    lockIcon.classList.remove('hidden');
    priceInput.readOnly = true;
    priceInput.classList.add('bg-gray-50');
  } else {
    tabCust.className = 'pb-2.5 border-b-2 border-blue-600 text-blue-700 flex items-center gap-1.5 transition-all';
    tabShop.className = 'pb-2.5 border-b-2 border-transparent text-gray-500 hover:text-gray-800 flex items-center gap-1.5 transition-all';
    secSearch.classList.add('hidden');
    lockIcon.classList.add('hidden');
    priceInput.readOnly = false;
    priceInput.classList.remove('bg-gray-50');
    clearSelectedShopProduct();
  }
}

function handleShopSearchInput(q) {
  const dd = document.getElementById('aw-search-dropdown');
  if (!q || !q.trim()) {
    dd.classList.add('hidden');
    return;
  }
  const query = q.trim().toLowerCase();
  const matches = _shopProducts.filter(p => 
    (p.product_name || '').toLowerCase().includes(query) ||
    (p.barcode || '').toLowerCase().includes(query) ||
    (p.category || '').toLowerCase().includes(query)
  ).slice(0, 10);

  if (!matches.length) {
    dd.innerHTML = `<div class="p-3 text-xs text-gray-400 text-center">لا توجد منتجات مطابقة في المحل</div>`;
    dd.classList.remove('hidden');
    return;
  }

  dd.innerHTML = matches.map(p => `
    <div onclick="selectShopProductById(${p.id})" class="p-3 hover:bg-blue-50/80 cursor-pointer transition-colors flex items-center justify-between text-xs">
      <div>
        <div class="font-bold text-gray-900">${p.product_name}</div>
        <div class="text-[11px] text-gray-500">القسم: ${p.category || 'عام'} ${p.barcode ? '• باركود: ' + p.barcode : ''}</div>
      </div>
      <div class="text-left font-mono">
        <span class="font-bold text-blue-700 block">${parseFloat(p.sale_price||0).toFixed(2)} ج</span>
        <span class="text-[10px] text-gray-400">رصيد المحل: ${p.quantity||0}</span>
      </div>
    </div>
  `).join('');
  dd.classList.remove('hidden');
}

function selectShopProductById(id) {
  const prod = _shopProducts.find(p => p.id === id);
  if (prod) selectShopProduct(prod);
}

let _selectedShopProd = null;

function selectShopProduct(p) {
  _selectedShopProd = p;
  document.getElementById('aw-search-dropdown').classList.add('hidden');
  document.getElementById('aw-search-input').value = '';
  document.getElementById('aw-shop-prod-id').value = p.id;

  document.getElementById('aw-selected-name').textContent = `✅ ${p.product_name}`;
  document.getElementById('aw-selected-details').textContent = `القسم: ${p.category || 'عام'} • سعر البيع بالمحل: ${parseFloat(p.sale_price||0).toFixed(2)} ج • رصيد المحل الحالي: ${p.quantity || 0} قطعة`;
  document.getElementById('aw-selected-badge').classList.remove('hidden');

  document.getElementById('aw-name').value = p.product_name;
  document.getElementById('aw-barcode').value = p.barcode || '';
  document.getElementById('aw-category').value = p.category || '';
  document.getElementById('aw-price').value = p.sale_price || 0;
  document.getElementById('aw-desc').value = p.description || p.details || '';
  if (p.purchase_price && parseFloat(p.purchase_price) > 0) {
    document.getElementById('aw-cost').value = p.purchase_price;
  }

  // Render Variants Matrix if product has variants
  const varSec = document.getElementById('aw-variants-section');
  const varGrid = document.getElementById('aw-variants-grid');
  varGrid.innerHTML = '';

  let hasVariants = false;
  if (p.checkbox_values) {
    const cbv = typeof p.checkbox_values === 'string' ? JSON.parse(p.checkbox_values) : p.checkbox_values;
    const opts = Object.keys(cbv);
    if (opts.length > 0) {
      hasVariants = true;
      varGrid.innerHTML = opts.map((opt, idx) => {
        const shopStock = cbv[opt].stock != null ? cbv[opt].stock : '—';
        return `
          <div class="bg-white p-2.5 rounded-xl border border-blue-100 flex items-center justify-between gap-2 shadow-sm">
            <div>
              <span class="text-xs font-bold text-gray-800 block">${opt}</span>
              <span class="text-[10px] text-gray-400">بالمحل: ${shopStock}</span>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="text-[11px] text-blue-700 font-bold">وارد:</span>
              <input type="number" min="0" value="0"
                class="aw-var-qty-input w-16 text-center font-bold text-xs border border-blue-300 rounded-lg py-1 focus:outline-none focus:ring-2 focus:ring-blue-400 font-mono"
                data-opt-key="${opt.replace(/"/g, '&quot;')}"
                oninput="onAwVariantQtyChange()"/>
            </div>
          </div>
        `;
      }).join('');
    }
  }

  if (hasVariants) {
    varSec.classList.remove('hidden');
    document.getElementById('aw-qty').readOnly = true;
    document.getElementById('aw-qty').classList.add('bg-gray-100');
    document.getElementById('aw-qty').value = '0';
    document.getElementById('aw-var-total-sum').textContent = '0';
  } else {
    varSec.classList.add('hidden');
    document.getElementById('aw-qty').readOnly = false;
    document.getElementById('aw-qty').classList.remove('bg-gray-100');
    document.getElementById('aw-qty').value = '1';
  }
}

function addNewAwVariant() {
  const nameInp = document.getElementById('aw-new-var-name');
  const qtyInp = document.getElementById('aw-new-var-qty');
  const optName = (nameInp.value || '').trim();
  const optQty = Math.max(1, parseInt(qtyInp.value || 1, 10));

  if (!optName) {
    nameInp.focus();
    return;
  }

  const varSec = document.getElementById('aw-variants-section');
  const varGrid = document.getElementById('aw-variants-grid');
  varSec.classList.remove('hidden');

  // Check if option already exists
  const existingInp = document.querySelector(`.aw-var-qty-input[data-opt-key="${CSS.escape(optName)}"]`);
  if (existingInp) {
    existingInp.value = parseInt(existingInp.value || 0, 10) + optQty;
    nameInp.value = '';
    onAwVariantQtyChange();
    existingInp.focus();
    return;
  }

  // Create new card
  const card = document.createElement('div');
  card.className = 'bg-white p-2.5 rounded-xl border-2 border-emerald-300 flex items-center justify-between gap-2 shadow-sm animate-in fade-in duration-150';
  card.innerHTML = `
    <div>
      <span class="text-xs font-bold text-emerald-800 block flex items-center gap-1">✨ ${optName}</span>
      <span class="text-[10px] text-emerald-600 font-semibold">مقاس جديد مضاف</span>
    </div>
    <div class="flex items-center gap-1.5">
      <span class="text-[11px] text-blue-700 font-bold">وارد:</span>
      <input type="number" min="0" value="${optQty}"
        class="aw-var-qty-input w-16 text-center font-bold text-xs border border-emerald-400 rounded-lg py-1 focus:outline-none focus:ring-2 focus:ring-emerald-400 font-mono"
        data-opt-key="${optName.replace(/"/g, '&quot;')}"
        oninput="onAwVariantQtyChange()"/>
      <button type="button" onclick="this.closest('div.bg-white').remove(); onAwVariantQtyChange();" class="text-gray-400 hover:text-red-600 text-sm px-1">✕</button>
    </div>
  `;
  varGrid.appendChild(card);

  nameInp.value = '';
  document.getElementById('aw-qty').readOnly = true;
  document.getElementById('aw-qty').classList.add('bg-gray-100');
  onAwVariantQtyChange();
}

function onAwVariantQtyChange() {
  const inputs = document.querySelectorAll('.aw-var-qty-input');
  let total = 0;
  inputs.forEach(inp => {
    total += Math.max(0, parseInt(inp.value || 0, 10));
  });
  document.getElementById('aw-qty').value = total;
  document.getElementById('aw-var-total-sum').textContent = total;
}

function clearSelectedShopProduct() {
  _selectedShopProd = null;
  document.getElementById('aw-shop-prod-id').value = '';
  document.getElementById('aw-selected-badge').classList.add('hidden');
  document.getElementById('aw-variants-section').classList.add('hidden');
  document.getElementById('aw-search-input').value = '';
  document.getElementById('aw-qty').readOnly = false;
  document.getElementById('aw-qty').classList.remove('bg-gray-100');
}

async function submitAddWarehouseItem(e) {
  e.preventDefault();
  const errEl = document.getElementById('aw-error');
  errEl.classList.add('hidden');

  const prodId = document.getElementById('aw-shop-prod-id').value || null;
  const name = document.getElementById('aw-name').value;
  const barcode = document.getElementById('aw-barcode').value;
  const category = document.getElementById('aw-category').value;
  const cost = document.getElementById('aw-cost').value;
  const price = document.getElementById('aw-price').value;
  const qty = parseInt(document.getElementById('aw-qty').value || 0, 10);
  const desc = document.getElementById('aw-desc').value;
  const expiry = document.getElementById('aw-expiry').value;
  const notes = document.getElementById('aw-notes').value;

  if (qty <= 0) {
    errEl.textContent = 'يرجى تحديد كمية واردة أكبر من صفر (أدخل الكميات لكل مقاس)';
    errEl.classList.remove('hidden');
    return;
  }

  // Package variants JSON (supports both existing and newly added variants)
  let checkboxValuesJson = null;
  const varInputs = document.querySelectorAll('.aw-var-qty-input');
  if (varInputs.length > 0) {
    let baseCbv = {};
    if (_selectedShopProd && _selectedShopProd.checkbox_values) {
      baseCbv = typeof _selectedShopProd.checkbox_values === 'string' ? JSON.parse(_selectedShopProd.checkbox_values) : { ..._selectedShopProd.checkbox_values };
    }
    varInputs.forEach(inp => {
      const k = inp.dataset.optKey;
      const q = parseInt(inp.value || 0, 10);
      baseCbv[k] = { ...(baseCbv[k] || { checked: true }), stock: q, disabled: false };
    });
    checkboxValuesJson = JSON.stringify(baseCbv);
  }

  try {
    const res = await fetch(`${BASE}/api/warehouse/products`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        product_id: prodId ? parseInt(prodId, 10) : null,
        product_name: name,
        barcode,
        category,
        cost_price: parseFloat(cost || 0),
        sale_price: parseFloat(price || 0),
        quantity: qty,
        checkbox_values_json: checkboxValuesJson,
        description: desc,
        expiry_date: expiry || null,
        notes
      })
    });
    const data = await res.json();
    if (!res.ok || data.error) throw new Error(data.error || 'فشل الحفظ في المستودع');

    closeAddWarehouseModal();
    await loadWarehouseData();
    alert('✅ تم حفظ الصنف والشحنة في المستودع بنجاح مع المقاسات الجديدة!');
  } catch (err) {
    errEl.textContent = err.message;
    errEl.classList.remove('hidden');
  }
}

// ── Transfer Modal ────────────────────────────────────────────────────────────
function openTransferModal(itemId) {
  const item = _warehouseItems.find(i => i.id === itemId);
  if (!item) return;

  _currentTrItem = item;
  _currentTrSizeKey = null;
  _maxAvailTr = parseInt(item.quantity || 0);

  document.getElementById('tr-prod-name').textContent = item.product_name;
  document.getElementById('tr-avail-wh').textContent = _maxAvailTr;
  document.getElementById('tr-current-shop').textContent = item.shop_quantity != null ? item.shop_quantity : 0;
  document.getElementById('trQuantityInput').value = '1';
  document.getElementById('trNoteInput').value = '';
  document.getElementById('trError').classList.add('hidden');

  // Populate Batches Selector
  const bSelect = document.getElementById('tr-batch-select');
  const batches = item.batches || [];
  bSelect.innerHTML = '<option value="">⚡ تلقائي (الأقرب صلاحية والأقدم - FIFO)</option>' +
    batches.map(b => `<option value="${b.id}">📦 ${b.batch_number || 'شحنة'} (متاح: ${b.quantity} | تكلفة: ${parseFloat(b.cost_price||0).toFixed(2)} ج ${b.expiry_date ? '| صلاحية: ' + b.expiry_date : ''})</option>`).join('');

  // Handle Variants
  const vContainer = document.getElementById('tr-variants-container');
  const vList = document.getElementById('tr-variants-list');

  let hasVariants = false;
  vList.innerHTML = '';

  if (item.checkbox_values) {
    const cbv = typeof item.checkbox_values === 'string' ? JSON.parse(item.checkbox_values) : item.checkbox_values;
    const opts = Object.keys(cbv);
    if (opts.length > 0) {
      hasVariants = true;
      vList.innerHTML = opts.map((opt, idx) => {
        const stock = cbv[opt].stock != null ? parseInt(cbv[opt].stock) : 0;
        return `
          <button type="button" onclick="selectTrVariant('${opt}', ${stock})" id="tr-opt-${idx}"
            class="tr-opt-btn px-3 py-1.5 rounded-xl border text-xs font-bold transition-all ${idx === 0 ? 'bg-blue-600 text-white border-blue-600' : 'bg-gray-50 text-gray-700 border-gray-200 hover:border-blue-400'}">
            ${opt} <span class="text-[11px] font-mono opacity-80">(${stock})</span>
          </button>
        `;
      }).join('');
      if (opts.length > 0) {
        _currentTrSizeKey = opts[0];
        _maxAvailTr = cbv[opts[0]].stock != null ? parseInt(cbv[opts[0]].stock) : 0;
        document.getElementById('tr-avail-wh').textContent = _maxAvailTr;
      }
    }
  }

  if (hasVariants) vContainer.classList.remove('hidden');
  else vContainer.classList.add('hidden');

  document.getElementById('transferModal').classList.remove('hidden');
}

function selectTrVariant(optKey, stock) {
  _currentTrSizeKey = optKey;
  _maxAvailTr = stock;
  document.getElementById('tr-avail-wh').textContent = stock;
  document.querySelectorAll('.tr-opt-btn').forEach(b => {
    b.className = b.textContent.includes(optKey) 
      ? 'tr-opt-btn px-3 py-1.5 rounded-xl border text-xs font-bold transition-all bg-blue-600 text-white border-blue-600'
      : 'tr-opt-btn px-3 py-1.5 rounded-xl border text-xs font-bold transition-all bg-gray-50 text-gray-700 border-gray-200 hover:border-blue-400';
  });
}

function onBatchSelectChange() {
  const bId = document.getElementById('tr-batch-select').value;
  if (!bId || !_currentTrItem) return;
  const b = (_currentTrItem.batches || []).find(x => String(x.id) === String(bId));
  if (b && !_currentTrSizeKey) {
    _maxAvailTr = parseInt(b.quantity || 0);
    document.getElementById('tr-avail-wh').textContent = _maxAvailTr;
  }
}

function closeTransferModal() {
  document.getElementById('transferModal').classList.add('hidden');
}

function chgTrQty(delta) {
  const inp = document.getElementById('trQuantityInput');
  let cur = parseInt(inp.value || 0, 10);
  cur = Math.max(1, Math.min(_maxAvailTr, cur + delta));
  inp.value = cur;
}

function setTrAll() {
  document.getElementById('trQuantityInput').value = Math.max(1, _maxAvailTr);
}

function validateTrQtyInput() {
  const inp = document.getElementById('trQuantityInput');
  let val = parseInt(inp.value || 0, 10);
  if (val > _maxAvailTr) inp.value = _maxAvailTr;
  if (val < 1) inp.value = 1;
}

async function confirmTransferToStore() {
  const errEl = document.getElementById('trError');
  errEl.classList.add('hidden');
  const btn = document.getElementById('trConfirmBtn');
  btn.disabled = true;

  const qty = parseInt(document.getElementById('trQuantityInput').value || 0, 10);
  const note = document.getElementById('trNoteInput').value;
  const batchId = document.getElementById('tr-batch-select').value || null;

  try {
    const res = await fetch(`${BASE}/api/warehouse/transfer`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        warehouse_item_id: _currentTrItem.id,
        quantity: qty,
        selected_option: _currentTrSizeKey,
        batch_id: batchId ? parseInt(batchId, 10) : null,
        note
      })
    });
    const data = await res.json();
    if (!res.ok || data.error) throw new Error(data.error || 'فشل التحويل');

    closeTransferModal();
    await loadWarehouseData();
    alert(`✅ تم تحويل ${qty} قطعة إلى المحل بنجاح وتحديث الموقع الإلكتروني والتكلفة!`);
  } catch (err) {
    errEl.textContent = err.message;
    errEl.classList.remove('hidden');
  } finally {
    btn.disabled = false;
  }
}

// ── Return to Warehouse Modal ─────────────────────────────────────────────────
function openReturnFromStoreModal() {
  const sel = document.getElementById('ret-prod-select');
  sel.innerHTML = '<option value="">-- اختر الصنف من المحل --</option>' +
    _shopProducts.map(p => `<option value="${p.id}">${p.product_name} (رصيد المحل: ${p.quantity||0})</option>`).join('');
  
  document.getElementById('ret-avail-shop').textContent = '0';
  document.getElementById('ret-qty').value = '1';
  document.getElementById('ret-reason').value = '';
  document.getElementById('ret-error').classList.add('hidden');
  document.getElementById('ret-variant-container').classList.add('hidden');
  document.getElementById('returnModal').classList.remove('hidden');
}

function closeReturnModal() {
  document.getElementById('returnModal').classList.add('hidden');
}

let _retSelectedOption = null;
function onReturnProductSelect() {
  const pId = parseInt(document.getElementById('ret-prod-select').value || 0, 10);
  const prod = _shopProducts.find(p => p.id === pId);
  const vCont = document.getElementById('ret-variant-container');
  const vList = document.getElementById('ret-variant-list');
  _retSelectedOption = null;

  if (!prod) {
    document.getElementById('ret-avail-shop').textContent = '0';
    vCont.classList.add('hidden');
    return;
  }

  document.getElementById('ret-avail-shop').textContent = prod.quantity || 0;

  if (prod.checkbox_values) {
    const cbv = typeof prod.checkbox_values === 'string' ? JSON.parse(prod.checkbox_values) : prod.checkbox_values;
    const opts = Object.keys(cbv);
    if (opts.length > 0) {
      vCont.classList.remove('hidden');
      vList.innerHTML = opts.map((o, idx) => `
        <button type="button" onclick="selectRetVariant('${o}', ${cbv[o].stock||0})" id="ret-opt-${idx}"
          class="ret-opt-btn px-3 py-1.5 rounded-xl border text-xs font-bold transition-all ${idx === 0 ? 'bg-amber-600 text-white border-amber-600' : 'bg-gray-50 text-gray-700 border-gray-200'}">
          ${o} (${cbv[o].stock||0})
        </button>
      `).join('');
      _retSelectedOption = opts[0];
      document.getElementById('ret-avail-shop').textContent = cbv[opts[0]].stock != null ? cbv[opts[0]].stock : prod.quantity;
      return;
    }
  }
  vCont.classList.add('hidden');
}

function selectRetVariant(opt, stock) {
  _retSelectedOption = opt;
  document.getElementById('ret-avail-shop').textContent = stock;
  document.querySelectorAll('.ret-opt-btn').forEach(b => {
    b.className = b.textContent.includes(opt)
      ? 'ret-opt-btn px-3 py-1.5 rounded-xl border text-xs font-bold transition-all bg-amber-600 text-white border-amber-600'
      : 'ret-opt-btn px-3 py-1.5 rounded-xl border text-xs font-bold transition-all bg-gray-50 text-gray-700 border-gray-200';
  });
}

async function submitReturnToWarehouse(e) {
  e.preventDefault();
  const errEl = document.getElementById('ret-error');
  errEl.classList.add('hidden');

  const pId = parseInt(document.getElementById('ret-prod-select').value || 0, 10);
  const qty = parseInt(document.getElementById('ret-qty').value || 0, 10);
  const reason = document.getElementById('ret-reason').value;

  try {
    const res = await fetch(`${BASE}/api/warehouse/return-from-store`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        product_id: pId,
        quantity: qty,
        selected_option: _retSelectedOption,
        reason
      })
    });
    const data = await res.json();
    if (!res.ok || data.error) throw new Error(data.error || 'فشل الإرجاع للمستودع');

    closeReturnModal();
    await loadWarehouseData();
    alert(`✅ تم إرجاع ${qty} قطعة من المحل إلى المستودع بنجاح!`);
  } catch (err) {
    errEl.textContent = err.message;
    errEl.classList.remove('hidden');
  }
}

// ── Variant Comparison Modal Logic ───────────────────────────────────────────
function openVariantCompareModal(itemId) {
  const item = _warehouseItems.find(i => i.id === itemId);
  if (!item) return;

  document.getElementById('cmp-prod-name').textContent = `${item.product_name} • (كود: ${item.barcode || '—'})`;
  const tbody = document.getElementById('cmp-table-body');
  tbody.innerHTML = '';

  const whCbv = item.checkbox_values ? (typeof item.checkbox_values === 'string' ? JSON.parse(item.checkbox_values) : item.checkbox_values) : {};
  const shopProd = _shopProducts.find(p => p.id === item.product_id);
  const shopCbv = shopProd && shopProd.checkbox_values ? (typeof shopProd.checkbox_values === 'string' ? JSON.parse(shopProd.checkbox_values) : shopProd.checkbox_values) : {};

  const allOpts = Array.from(new Set([...Object.keys(whCbv), ...Object.keys(shopCbv)]));

  if (!allOpts.length) {
    tbody.innerHTML = `<tr><td colspan="6" class="p-6 text-center text-gray-400 font-bold">لا توجد مقاسات مسجلة لهذا الصنف</td></tr>`;
  } else {
    tbody.innerHTML = allOpts.map(opt => {
      const wQty = whCbv[opt]?.stock != null ? parseInt(whCbv[opt].stock) : 0;
      const sQty = shopCbv[opt]?.stock != null ? parseInt(shopCbv[opt].stock) : 0;
      const total = wQty + sQty;

      let statusBadge = '';
      if (sQty <= 0) {
        statusBadge = `<span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-red-100 text-red-700 border border-red-200">🔴 نافد بالمحل</span>`;
      } else if (sQty <= 2) {
        statusBadge = `<span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800 border border-amber-200">🟡 كمية منخفضة</span>`;
      } else {
        statusBadge = `<span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 border border-emerald-200">🟢 متوفر بالمحل</span>`;
      }

      return `
        <tr class="hover:bg-gray-50 transition-colors">
          <td class="p-3 font-bold text-gray-900 flex items-center gap-1.5">
            <span class="text-blue-600">🏷️</span> ${opt}
          </td>
          <td class="p-3 text-center font-mono font-bold text-amber-700 bg-amber-50/40">${wQty} قطعة</td>
          <td class="p-3 text-center font-mono font-bold text-blue-700 bg-blue-50/40">${sQty} قطعة</td>
          <td class="p-3 text-center font-mono font-black text-gray-800">${total} قطعة</td>
          <td class="p-3 text-center">${statusBadge}</td>
          <td class="p-3 text-center">
            <button onclick="quickTransferSpecificVariant(${item.id}, '${opt.replace(/'/g, "\\'")}', ${wQty})" ${wQty <= 0 ? 'disabled' : ''}
              class="bg-blue-600 hover:bg-blue-700 disabled:opacity-30 text-white font-bold px-3 py-1 rounded-xl text-xs shadow-sm transition-all flex items-center gap-1 mx-auto">
              <span>🚚</span> تحويل للمحل
            </button>
          </td>
        </tr>
      `;
    }).join('');
  }

  document.getElementById('variantCompareModal').classList.remove('hidden');
}

function closeVariantCompareModal() {
  document.getElementById('variantCompareModal').classList.add('hidden');
}

function quickTransferSpecificVariant(itemId, optKey, availWh) {
  closeVariantCompareModal();
  openTransferModal(itemId);
  setTimeout(() => {
    selectTrVariant(optKey, availWh);
  }, 100);
}

document.addEventListener('DOMContentLoaded', loadWarehouseData);
</script>

