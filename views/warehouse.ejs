<%- include('partials/header', Object.assign({pageTitle: 'إدارة المستودع'}, locals)) %>

<div class="space-y-6">
  <!-- Header Title & Action -->
  <div class="flex flex-wrap items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-black text-gray-800 flex items-center gap-2">
        <span>🏢</span> المستودع المركزي
      </h1>
      <p class="text-xs text-gray-500 mt-1">إدارة بضاعة المخزن الرئيسي وحساب رأس المال وتحويل الكميات والمقاسات للمحل</p>
    </div>
    <div class="flex items-center gap-2">
      <a href="<%= base %>/product-movements" class="bg-indigo-50 hover:bg-indigo-100 text-indigo-700 font-bold px-4 py-2.5 rounded-xl text-sm border border-indigo-200 transition-all flex items-center gap-1.5">
        <span>📜</span> سجل الحركات
      </a>
      <button onclick="openAddWarehouseModal()" class="bg-blue-700 hover:bg-blue-800 text-white font-bold px-5 py-2.5 rounded-xl text-sm shadow transition-all flex items-center gap-1.5">
        <span>➕</span> إضافة صنف للمستودع
      </button>
    </div>
  </div>

  <!-- Financial Valuation Banner (Manager Only) -->
  <div class="bg-gradient-to-l from-slate-900 via-blue-950 to-indigo-950 text-white rounded-3xl shadow-xl p-5 border border-white/10">
    <div class="flex items-center justify-between mb-4 border-b border-white/10 pb-3">
      <div class="flex items-center gap-2">
        <span class="text-xl">💰</span>
        <span class="font-bold text-sm text-blue-200">التقييم المالي الشامل لبضاعة المستودع</span>
      </div>
      <span class="text-xs bg-blue-500/30 text-blue-200 px-3 py-1 rounded-full border border-blue-400/30">مخزن رئيسي منفصل</span>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
      <div class="bg-white/10 backdrop-blur rounded-2xl p-3.5 border border-white/10">
        <div id="wh-stat-cost" class="text-2xl font-black text-amber-300">0.00 ج</div>
        <div class="text-xs text-gray-300 mt-1">إجمالي رأس المال (سعر التكلفة)</div>
      </div>
      <div class="bg-white/10 backdrop-blur rounded-2xl p-3.5 border border-white/10">
        <div id="wh-stat-retail" class="text-2xl font-black text-emerald-300">0.00 ج</div>
        <div class="text-xs text-gray-300 mt-1">إجمالي القيمة بسعر البيع</div>
      </div>
      <div class="bg-white/10 backdrop-blur rounded-2xl p-3.5 border border-white/10">
        <div id="wh-stat-profit" class="text-2xl font-black text-cyan-300">0.00 ج</div>
        <div class="text-xs text-gray-300 mt-1">صافي الربح المتوقع</div>
      </div>
      <div class="bg-white/10 backdrop-blur rounded-2xl p-3.5 border border-white/10">
        <div id="wh-stat-count" class="text-2xl font-black text-white">0</div>
        <div class="text-xs text-gray-300 mt-1">إجمالي عدد الأصناف المخزنة</div>
      </div>
    </div>
  </div>

  <!-- Search and Filter Controls -->
  <div class="bg-white rounded-2xl shadow-sm border p-4 flex flex-wrap items-center gap-3">
    <div class="flex-1 min-w-[240px] relative">
      <span class="absolute inset-y-0 right-3 flex items-center text-gray-400">🔍</span>
      <input id="whSearchInput" type="text" placeholder="ابحث باسم المنتج، المقاس، أو الباركود..."
        oninput="filterWarehouseTable()"
        class="w-full pl-4 pr-10 py-2.5 border rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-blue-300"/>
    </div>
    <select id="whCatFilter" onchange="filterWarehouseTable()"
      class="border rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-300 bg-white">
      <option value="">جميع التصنيفات</option>
    </select>
    <select id="whStockFilter" onchange="filterWarehouseTable()"
      class="border rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-300 bg-white">
      <option value="">جميع الحالات</option>
      <option value="in_stock">متوفر في المستودع</option>
      <option value="out_of_stock">رصيد صفر (نفذ)</option>
    </select>
    <button onclick="loadWarehouseData()" class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-4 py-2.5 rounded-xl text-sm font-semibold transition-all">
      🔄 تحديث
    </button>
  </div>

  <!-- Warehouse Table -->
  <div class="bg-white rounded-2xl shadow-sm border overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-right text-sm">
        <thead class="bg-gray-50/80 text-gray-600 font-bold border-b text-xs">
          <tr>
            <th class="p-3.5">المنتج والمقاسات</th>
            <th class="p-3.5">الباركود / الكود</th>
            <th class="p-3.5">التصنيف</th>
            <th class="p-3.5">سعر التكلفة</th>
            <th class="p-3.5">سعر البيع</th>
            <th class="p-3.5 text-center">رصيد المستودع</th>
            <th class="p-3.5 text-center">رصيد المحل</th>
            <th class="p-3.5 text-center">إجراءات التحويل</th>
          </tr>
        </thead>
        <tbody id="whTableBody" class="divide-y divide-gray-100">
          <tr>
            <td colspan="8" class="text-center py-10 text-gray-400 font-medium">جارٍ تحميل بيانات المستودع...</td>
          </tr>
        </tbody>
      </table>
    </div>
    <div id="whNoData" class="hidden text-center py-12 text-gray-400">
      <span class="text-3xl block mb-2">📦</span>
      لا توجد أصناف تطابق البحث في المستودع
    </div>
  </div>
</div>

<!-- ════════════════ Modal: تحويل كميات للمحل (Transfer to Store) ════════════════ -->
<div id="transferModal" class="hidden fixed inset-0 bg-black/60 z-[80] flex items-center justify-center p-4">
  <div class="bg-white rounded-3xl shadow-2xl w-full max-w-lg overflow-hidden animate-in fade-in zoom-in duration-150">
    <div class="bg-gradient-to-r from-blue-700 to-indigo-800 text-white p-5 flex items-center justify-between">
      <div>
        <h3 class="font-black text-lg flex items-center gap-2"><span>🚚</span> تحويل بضاعة للمحل</h3>
        <p id="tr-prod-name" class="text-xs text-blue-200 mt-0.5 font-medium"></p>
      </div>
      <button onclick="closeTransferModal()" class="text-white/70 hover:text-white text-2xl leading-none">✕</button>
    </div>

    <div class="p-5 space-y-4 max-h-[75vh] overflow-y-auto">
      <!-- Variants selector if available -->
      <div id="tr-variants-container" class="hidden space-y-2">
        <label class="text-xs font-bold text-gray-700 block">اختر المقاس / الخيار المراد تحويله للمحل:</label>
        <div id="tr-variants-list" class="space-y-3 p-1 max-h-48 overflow-y-auto"></div>
      </div>

      <!-- Current Stock Status Cards -->
      <div class="grid grid-cols-2 gap-3">
        <div class="bg-amber-50 border border-amber-200 rounded-2xl p-3 text-center">
          <span class="text-xs text-amber-800 font-semibold block">المتاح في المستودع</span>
          <span id="tr-avail-wh" class="text-2xl font-black text-amber-700">0</span>
        </div>
        <div class="bg-blue-50 border border-blue-200 rounded-2xl p-3 text-center">
          <span class="text-xs text-blue-800 font-semibold block">الرصيد الحالي في المحل</span>
          <span id="tr-current-shop" class="text-2xl font-black text-blue-700">0</span>
        </div>
      </div>

      <!-- Transfer Quantity Counter -->
      <div class="bg-gray-50 border rounded-2xl p-4 space-y-2">
        <label class="text-xs font-bold text-gray-700 block text-center">الكمية المراد تحويلها وإرسالها للمحل:</label>
        <div class="flex items-center justify-center gap-3">
          <button type="button" onclick="chgTrQty(-10)" class="w-10 h-10 rounded-xl bg-gray-200 hover:bg-gray-300 font-black text-sm flex items-center justify-center transition-all">-10</button>
          <button type="button" onclick="chgTrQty(-1)" class="w-10 h-10 rounded-xl bg-gray-200 hover:bg-gray-300 font-black text-lg flex items-center justify-center transition-all">−</button>
          <input id="trQuantityInput" type="number" min="1" value="1"
            oninput="validateTrQtyInput()"
            class="w-24 text-center font-black text-2xl text-blue-800 border-2 border-blue-400 rounded-xl py-1.5 focus:outline-none focus:ring-2 focus:ring-blue-300"/>
          <button type="button" onclick="chgTrQty(1)" class="w-10 h-10 rounded-xl bg-gray-200 hover:bg-gray-300 font-black text-lg flex items-center justify-center transition-all">+</button>
          <button type="button" onclick="chgTrQty(10)" class="w-10 h-10 rounded-xl bg-gray-200 hover:bg-gray-300 font-black text-sm flex items-center justify-center transition-all">+10</button>
        </div>
        <div class="flex justify-center gap-2 pt-1">
          <button type="button" onclick="setTrAll()" class="text-xs text-blue-600 hover:underline font-bold">تحويل كل الكمية المتاحة</button>
        </div>
      </div>

      <!-- Notes -->
      <div>
        <label class="text-xs font-bold text-gray-600 block mb-1">ملاحظة إذن التحويل (اختياري)</label>
        <input id="trNoteInput" type="text" placeholder="مثال: توريد كمية جديدة للأرفف / سحب طلب خاص..."
          class="w-full border rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-300"/>
      </div>

      <div class="bg-blue-50 border border-blue-200 rounded-xl p-3 text-xs text-blue-800 leading-relaxed">
        ℹ️ عند تأكيد التحويل: سيتم خصم الكمية من المستودع فوراً وإضافتها لمخزن المحل وتحديث الموقع الإلكتروني تلقائياً.
      </div>

      <p id="trError" class="hidden bg-red-50 text-red-700 text-xs rounded-xl p-2.5 text-center font-semibold"></p>
    </div>

    <div class="p-4 border-t bg-gray-50 flex gap-2">
      <button id="trConfirmBtn" onclick="confirmTransferToStore()" class="flex-1 bg-blue-700 hover:bg-blue-800 text-white font-bold py-3 rounded-xl text-sm shadow transition-all">
        ✅ تأكيد تحويل الكمية للمحل
      </button>
      <button onclick="closeTransferModal()" class="px-5 bg-white border hover:bg-gray-100 text-gray-700 font-bold py-3 rounded-xl text-sm">
        إلغاء
      </button>
    </div>
  </div>
</div>

<!-- ════════════════ Modal: إضافة صنف جديد للمستودع ════════════════ -->
<div id="addWhModal" class="hidden fixed inset-0 bg-black/60 z-[80] flex items-center justify-center p-4">
  <div class="bg-white rounded-3xl shadow-2xl w-full max-w-md overflow-hidden">
    <div class="p-5 border-b flex items-center justify-between">
      <h3 class="font-bold text-gray-800 text-lg">➕ إضافة بضاعة جديدة للمستودع</h3>
      <button onclick="closeAddWarehouseModal()" class="text-gray-400 hover:text-gray-600 text-2xl">✕</button>
    </div>
    <form onsubmit="submitAddWarehouseItem(event)" class="p-5 space-y-3.5 max-h-[75vh] overflow-y-auto">
      <div>
        <label class="text-xs font-bold text-gray-700 block mb-1">اسم الصنف في المستودع *</label>
        <input id="aw-name" type="text" required placeholder="اسم المنتج الطبي أو الصنف"
          class="w-full border rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-300"/>
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="text-xs font-bold text-gray-700 block mb-1">الباركود / الكود</label>
          <input id="aw-barcode" type="text" placeholder="باركود الصنف"
            class="w-full border rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-300"/>
        </div>
        <div>
          <label class="text-xs font-bold text-gray-700 block mb-1">التصنيف</label>
          <input id="aw-category" type="text" placeholder="مستلزمات / حشوات..."
            class="w-full border rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-300"/>
        </div>
      </div>
      <div class="grid grid-cols-3 gap-2">
        <div>
          <label class="text-xs font-bold text-gray-700 block mb-1">الكمية *</label>
          <input id="aw-qty" type="number" min="0" value="1" required
            class="w-full border rounded-xl px-3 py-2 text-sm text-center font-bold focus:outline-none focus:ring-2 focus:ring-blue-300"/>
        </div>
        <div>
          <label class="text-xs font-bold text-gray-700 block mb-1">سعر التكلفة</label>
          <input id="aw-cost" type="number" min="0" step="0.01" value="0.00"
            class="w-full border rounded-xl px-3 py-2 text-sm text-center font-mono focus:outline-none focus:ring-2 focus:ring-blue-300"/>
        </div>
        <div>
          <label class="text-xs font-bold text-gray-700 block mb-1">سعر البيع</label>
          <input id="aw-price" type="number" min="0" step="0.01" value="0.00"
            class="w-full border rounded-xl px-3 py-2 text-sm text-center font-mono focus:outline-none focus:ring-2 focus:ring-blue-300"/>
        </div>
      </div>
      <div>
        <label class="text-xs font-bold text-gray-700 block mb-1">ربط مع صنف موجود بالمحل (اختياري)</label>
        <select id="aw-shop-prod-id" class="w-full border rounded-xl px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-blue-300">
          <option value="">-- بدون ربط (صنف جديد بالمستودع فقط) --</option>
        </select>
      </div>
      <div>
        <label class="text-xs font-bold text-gray-700 block mb-1">ملاحظات المستودع</label>
        <textarea id="aw-notes" rows="2" placeholder="رقم الشحنة، مكان التخزين..."
          class="w-full border rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-300 resize-none"></textarea>
      </div>
      <p id="aw-error" class="hidden text-xs text-red-600 bg-red-50 rounded-xl p-2 text-center"></p>
      <div class="flex gap-2 pt-2 border-t">
        <button type="submit" class="flex-1 bg-blue-700 hover:bg-blue-800 text-white font-bold py-2.5 rounded-xl text-sm">
          حفظ في المستودع
        </button>
        <button type="button" onclick="closeAddWarehouseModal()" class="px-5 bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold py-2.5 rounded-xl text-sm">
          إلغاء
        </button>
      </div>
    </form>
  </div>
</div>

<script>
const BASE = '<%= base %>';
let _warehouseItems = [];
let _shopProducts = [];
let _currentTrItem = null;
let _currentTrSizeKey = null;
let _maxAvailTr = 0;

async function loadWarehouseData() {
  try {
    const res = await fetch(`${BASE}/api/warehouse/products`);
    const data = await res.json();
    _warehouseItems = data.items || [];
    _shopProducts = data.shop_products || [];

    // Update Valuation Stats
    const totalCost = _warehouseItems.reduce((s, i) => s + (parseFloat(i.cost_price||0) * parseInt(i.quantity||0)), 0);
    const totalRetail = _warehouseItems.reduce((s, i) => s + (parseFloat(i.sale_price||0) * parseInt(i.quantity||0)), 0);
    const totalProfit = Math.max(0, totalRetail - totalCost);

    document.getElementById('wh-stat-cost').textContent = totalCost.toFixed(2) + ' ج';
    document.getElementById('wh-stat-retail').textContent = totalRetail.toFixed(2) + ' ج';
    document.getElementById('wh-stat-profit').textContent = totalProfit.toFixed(2) + ' ج';
    document.getElementById('wh-stat-count').textContent = _warehouseItems.length;

    // Populate Category dropdown
    const cats = [...new Set(_warehouseItems.map(i => i.category).filter(Boolean))];
    const catSel = document.getElementById('whCatFilter');
    catSel.innerHTML = '<option value="">جميع التصنيفات</option>' + cats.map(c => `<option value="${c}">${c}</option>`).join('');

    // Populate Shop Product link select in Add Modal
    const pSel = document.getElementById('aw-shop-prod-id');
    pSel.innerHTML = '<option value="">-- بدون ربط (صنف جديد بالمستودع فقط) --</option>' + 
      _shopProducts.map(p => `<option value="${p.id}">${p.product_name} (${p.quantity} بالمحل)</option>`).join('');

    renderWarehouseTable(_warehouseItems);
  } catch (err) {
    console.error('Failed to load warehouse data:', err);
  }
}

function parseWhVariants(item) {
  if (item.variants) {
    try {
      const v = typeof item.variants === 'string' ? JSON.parse(item.variants) : item.variants;
      if (v?.sizes?.length) return v;
    } catch (_) {}
  }
  if (item.checkbox_values) {
    try {
      const cv = typeof item.checkbox_values === 'string' ? JSON.parse(item.checkbox_values) : item.checkbox_values;
      const sizes = [];
      Object.entries(cv).forEach(([k, val]) => {
        const sep = k.indexOf('::');
        if (sep === -1) return;
        const group = k.slice(0, sep);
        const label = k.slice(sep + 2);
        const stock = typeof val === 'object' && val?.stock != null ? parseInt(val.stock) : (item.quantity||0);
        sizes.push({ label, qty: stock, _cbKey: k, group });
      });
      if (sizes.length) return { sizes };
    } catch (_) {}
  }
  return null;
}

function renderWarehouseTable(items) {
  const tbody = document.getElementById('whTableBody');
  const noData = document.getElementById('whNoData');
  if (!items.length) {
    tbody.innerHTML = '';
    noData.classList.remove('hidden');
    return;
  }
  noData.classList.add('hidden');

  tbody.innerHTML = items.map(i => {
    const v = parseWhVariants(i);
    let variantBadgeHtml = '';
    if (v && v.sizes && v.sizes.length) {
      variantBadgeHtml = `
        <div class="flex flex-wrap gap-1 mt-1.5">
          ${v.sizes.slice(0, 6).map(s => `
            <span class="text-[10px] px-1.5 py-0.5 rounded-md font-mono ${s.qty > 0 ? 'bg-blue-50 text-blue-700 border border-blue-200' : 'bg-gray-100 text-gray-400 line-through'}">
              ${s.label}: <b>${s.qty}</b>
            </span>
          `).join('')}
          ${v.sizes.length > 6 ? `<span class="text-[10px] text-gray-400">+${v.sizes.length - 6}</span>` : ''}
        </div>
      `;
    }

    const isOutOfStock = parseInt(i.quantity || 0) <= 0;
    const shopProd = _shopProducts.find(p => p.id === i.product_id);
    const shopQty = shopProd ? shopProd.quantity : '—';

    return `
      <tr class="hover:bg-blue-50/40 transition-colors">
        <td class="p-3.5">
          <div class="font-bold text-gray-900">${i.product_name}</div>
          ${variantBadgeHtml}
          ${i.notes ? `<div class="text-[11px] text-gray-400 mt-0.5">${i.notes}</div>` : ''}
        </td>
        <td class="p-3.5 font-mono text-xs text-gray-500">${i.barcode || '—'}</td>
        <td class="p-3.5">
          <span class="text-xs bg-gray-100 text-gray-700 px-2 py-0.5 rounded-lg font-medium">${i.category || 'عام'}</span>
        </td>
        <td class="p-3.5 font-mono font-semibold text-gray-700">${parseFloat(i.cost_price||0).toFixed(2)} ج</td>
        <td class="p-3.5 font-mono font-bold text-blue-700">${parseFloat(i.sale_price||0).toFixed(2)} ج</td>
        <td class="p-3.5 text-center">
          <span class="inline-block px-2.5 py-1 rounded-full font-black text-xs ${isOutOfStock ? 'bg-red-100 text-red-700' : 'bg-amber-100 text-amber-800'}">
            ${i.quantity} قطعة
          </span>
        </td>
        <td class="p-3.5 text-center font-bold text-xs text-gray-600">
          ${shopQty !== '—' ? `<span class="bg-emerald-50 text-emerald-700 border border-emerald-200 px-2 py-0.5 rounded-lg">${shopQty} قطعة</span>` : '<span class="text-gray-400">غير مرتبط</span>'}
        </td>
        <td class="p-3.5 text-center">
          <button onclick="openTransferModal(${i.id})" ${isOutOfStock ? 'disabled' : ''}
            class="bg-blue-600 hover:bg-blue-700 disabled:opacity-40 text-white font-bold px-3 py-1.5 rounded-xl text-xs shadow-sm transition-all flex items-center gap-1 mx-auto">
            <span>🚚</span> تحويل للمحل
          </button>
        </td>
      </tr>
    `;
  }).join('');
}

function filterWarehouseTable() {
  const q = document.getElementById('whSearchInput').value.trim().toLowerCase();
  const cat = document.getElementById('whCatFilter').value;
  const stock = document.getElementById('whStockFilter').value;

  const filtered = _warehouseItems.filter(i => {
    const matchQ = !q || (i.product_name||'').toLowerCase().includes(q) || (i.barcode||'').toLowerCase().includes(q);
    const matchCat = !cat || i.category === cat;
    const matchStock = !stock || (stock === 'in_stock' ? parseInt(i.quantity||0) > 0 : parseInt(i.quantity||0) <= 0);
    return matchQ && matchCat && matchStock;
  });
  renderWarehouseTable(filtered);
}

// ── Transfer to Store Logic ───────────────────────────────────────────────────
function openTransferModal(whItemId) {
  _currentTrItem = _warehouseItems.find(x => x.id === whItemId);
  if (!_currentTrItem) return;

  document.getElementById('tr-prod-name').textContent = _currentTrItem.product_name;
  document.getElementById('trError').classList.add('hidden');
  document.getElementById('trNoteInput').value = '';

  const shopProd = _shopProducts.find(p => p.id === _currentTrItem.product_id);
  document.getElementById('tr-current-shop').textContent = shopProd ? shopProd.quantity : '0';

  const v = parseWhVariants(_currentTrItem);
  const vContainer = document.getElementById('tr-variants-container');
  const vList = document.getElementById('tr-variants-list');

  if (v && v.sizes && v.sizes.length > 0) {
    vContainer.classList.remove('hidden');
    const hasGroups = v.sizes.some(s => s.group);

    if (hasGroups) {
      const gMap = {};
      v.sizes.forEach(s => {
        const g = s.group || 'عام';
        if (!gMap[g]) gMap[g] = [];
        gMap[g].push(s);
      });
      vList.innerHTML = Object.entries(gMap).map(([g, szs]) => `
        <div class="border rounded-xl p-2.5 bg-gray-50/70">
          <div class="text-[11px] font-bold text-gray-500 mb-1.5 border-b pb-0.5">🏷️ ${g}</div>
          <div class="grid grid-cols-3 gap-1.5">
            ${szs.map(s => {
              const out = s.qty <= 0;
              const k = (s._cbKey || s.label).replace(/'/g, "\\'");
              return `
                <button type="button" onclick="selectTransferSize('${k}', ${s.qty}, this)" ${out ? 'disabled' : ''}
                  class="tr-size-btn border rounded-xl p-2 text-xs flex flex-col items-center justify-center transition-all ${out ? 'bg-gray-100 text-gray-300 cursor-not-allowed' : 'bg-white text-gray-800 hover:border-blue-400'}">
                  <span class="font-bold">${s.label}</span>
                  <span class="text-[10px] ${out ? 'text-red-400' : 'text-gray-400'}">${out ? 'نفذ' : s.qty + ' متاح'}</span>
                </button>
              `;
            }).join('')}
          </div>
        </div>
      `).join('');
    } else {
      vList.innerHTML = `<div class="grid grid-cols-3 gap-1.5">${v.sizes.map(s => {
        const out = s.qty <= 0;
        const k = (s._cbKey || s.label).replace(/'/g, "\\'");
        return `
          <button type="button" onclick="selectTransferSize('${k}', ${s.qty}, this)" ${out ? 'disabled' : ''}
            class="tr-size-btn border rounded-xl p-2 text-xs flex flex-col items-center justify-center transition-all ${out ? 'bg-gray-100 text-gray-300 cursor-not-allowed' : 'bg-white text-gray-800 hover:border-blue-400'}">
            <span class="font-bold">${s.label}</span>
            <span class="text-[10px] ${out ? 'text-red-400' : 'text-gray-400'}">${out ? 'نفذ' : s.qty + ' متاح'}</span>
          </button>
        `;
      }).join('')}</div>`;
    }
    // Select first available size
    const firstAvail = v.sizes.find(s => s.qty > 0);
    if (firstAvail) {
      _currentTrSizeKey = firstAvail._cbKey || firstAvail.label;
      _maxAvailTr = firstAvail.qty;
    } else {
      _currentTrSizeKey = null;
      _maxAvailTr = 0;
    }
  } else {
    vContainer.classList.add('hidden');
    _currentTrSizeKey = null;
    _maxAvailTr = parseInt(_currentTrItem.quantity || 0);
  }

  document.getElementById('tr-avail-wh').textContent = _maxAvailTr;
  const initQty = Math.min(1, _maxAvailTr);
  document.getElementById('trQuantityInput').value = initQty;
  document.getElementById('trQuantityInput').max = _maxAvailTr;

  document.getElementById('transferModal').classList.remove('hidden');
}

function selectTransferSize(key, maxQty, btnEl) {
  _currentTrSizeKey = key;
  _maxAvailTr = maxQty;
  document.getElementById('tr-avail-wh').textContent = maxQty;
  document.getElementById('trQuantityInput').max = maxQty;
  document.getElementById('trQuantityInput').value = Math.min(1, maxQty);

  document.querySelectorAll('.tr-size-btn').forEach(b => {
    b.classList.remove('border-blue-600', 'bg-blue-50', 'text-blue-700', 'font-black');
  });
  if (btnEl) btnEl.classList.add('border-blue-600', 'bg-blue-50', 'text-blue-700', 'font-black');
}

function chgTrQty(delta) {
  const inp = document.getElementById('trQuantityInput');
  let val = (parseInt(inp.value) || 0) + delta;
  val = Math.max(1, Math.min(val, _maxAvailTr));
  inp.value = val;
}

function setTrAll() {
  document.getElementById('trQuantityInput').value = _maxAvailTr;
}

function validateTrQtyInput() {
  const inp = document.getElementById('trQuantityInput');
  let val = parseInt(inp.value) || 1;
  if (val > _maxAvailTr) val = _maxAvailTr;
  if (val < 1) val = 1;
  inp.value = val;
}

function closeTransferModal() {
  document.getElementById('transferModal').classList.add('hidden');
  _currentTrItem = null;
  _currentTrSizeKey = null;
}

async function confirmTransferToStore() {
  if (!_currentTrItem) return;
  const qty = parseInt(document.getElementById('trQuantityInput').value) || 0;
  if (qty <= 0) { alert('حدد كمية صحيحة للتحويل'); return; }
  if (qty > _maxAvailTr) { alert(`الكمية المتاحة في المستودع هي (${_maxAvailTr}) فقط`); return; }

  const errEl = document.getElementById('trError');
  errEl.classList.add('hidden');
  const btn = document.getElementById('trConfirmBtn');
  btn.disabled = true;
  btn.textContent = '⏳ جارٍ التحويل للمحل...';

  try {
    const res = await fetch(`${BASE}/api/warehouse/transfer`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        warehouse_item_id: _currentTrItem.id,
        quantity: qty,
        selected_option: _currentTrSizeKey,
        note: document.getElementById('trNoteInput').value.trim()
      })
    });
    const data = await res.json();
    btn.disabled = false;
    btn.textContent = '✅ تأكيد تحويل الكمية للمحل';

    if (!res.ok) {
      errEl.textContent = data.error || 'حدث خطأ أثناء التحويل';
      errEl.classList.remove('hidden');
      return;
    }

    closeTransferModal();
    await loadWarehouseData();
    alert(`🎉 تم بنجاح تحويل (${qty}) قطعة للمحل وتحديث رصيد الموقع!`);
  } catch (err) {
    btn.disabled = false;
    btn.textContent = '✅ تأكيد تحويل الكمية للمحل';
    errEl.textContent = 'فشل الاتصال بالسيرفر';
    errEl.classList.remove('hidden');
  }
}

// ── Add Item to Warehouse Modal ───────────────────────────────────────────────
function openAddWarehouseModal() {
  document.getElementById('aw-name').value = '';
  document.getElementById('aw-barcode').value = '';
  document.getElementById('aw-category').value = '';
  document.getElementById('aw-qty').value = '1';
  document.getElementById('aw-cost').value = '0.00';
  document.getElementById('aw-price').value = '0.00';
  document.getElementById('aw-shop-prod-id').value = '';
  document.getElementById('aw-notes').value = '';
  document.getElementById('aw-error').classList.add('hidden');
  document.getElementById('addWhModal').classList.remove('hidden');
}

function closeAddWarehouseModal() {
  document.getElementById('addWhModal').classList.add('hidden');
}

async function submitAddWarehouseItem(e) {
  e.preventDefault();
  const body = {
    product_name: document.getElementById('aw-name').value.trim(),
    barcode: document.getElementById('aw-barcode').value.trim(),
    category: document.getElementById('aw-category').value.trim(),
    quantity: parseInt(document.getElementById('aw-qty').value) || 0,
    cost_price: parseFloat(document.getElementById('aw-cost').value) || 0,
    sale_price: parseFloat(document.getElementById('aw-price').value) || 0,
    product_id: parseInt(document.getElementById('aw-shop-prod-id').value) || null,
    notes: document.getElementById('aw-notes').value.trim()
  };

  const errEl = document.getElementById('aw-error');
  errEl.classList.add('hidden');

  const res = await fetch(`${BASE}/api/warehouse/products`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(body)
  });
  const data = await res.json();
  if (!res.ok) {
    errEl.textContent = data.error || 'حدث خطأ أثناء الحفظ';
    errEl.classList.remove('hidden');
    return;
  }
  closeAddWarehouseModal();
  await loadWarehouseData();
  alert('✅ تمت إضافة الصنف للمستودع بنجاح');
}

// Initial load
loadWarehouseData();
</script>

</main>
