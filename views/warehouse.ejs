let _currentEditingWhItem = null;

function openEditWarehouseModal(itemId) {
  const item = _warehouseItems.find(i => i.id === itemId);
  if (!item) return;

  _currentEditingWhItem = item;
  document.getElementById('ew-item-id').value = item.id;
  document.getElementById('ew-name').value = item.product_name || '';
  document.getElementById('ew-barcode').value = item.barcode || '';
  document.getElementById('ew-category').value = item.category || 'عام';
  document.getElementById('ew-cost').value = parseFloat(item.cost_price || 0).toFixed(2);
  document.getElementById('ew-price').value = parseFloat(item.sale_price || 0).toFixed(2);
  document.getElementById('ew-qty').value = parseInt(item.quantity || 0, 10);
  document.getElementById('ew-expiry').value = item.expiry_date || '';
  document.getElementById('ew-desc').value = item.description || '';
  document.getElementById('ew-notes').value = item.notes || '';
  document.getElementById('ew-error').classList.add('hidden');

  // Render Variants in Edit Modal
  const grid = document.getElementById('ew-variants-grid');
  grid.innerHTML = '';

  const whFlat = flattenCbv(item.checkbox_values);
  const keys = Object.keys(whFlat);

  if (keys.length > 0) {
    grid.innerHTML = keys.map(displayKey => {
      const obj = whFlat[displayKey] || {};
      const rawKey = obj.rawKey || displayKey;
      const grp = obj.groupName || 'عام';
      const stock = obj.stock != null ? obj.stock : 0;
      return `
        <div class="ew-var-row bg-white p-2.5 rounded-xl border border-amber-200 flex items-center justify-between gap-2 shadow-sm">
          <div class="flex items-center gap-1.5">
            ${grp !== 'عام' ? `<span class="px-1.5 py-0.5 bg-amber-100 text-amber-800 rounded text-[10px] font-mono font-bold">${grp}</span>` : ''}
            <span class="text-xs font-bold text-gray-800">${rawKey}</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-[11px] text-gray-500 font-bold">رصيد:</span>
            <input type="number" min="0" value="${stock}"
              class="ew-var-qty-input w-16 text-center font-bold text-xs border border-amber-300 rounded-lg py-1 focus:outline-none focus:ring-2 focus:ring-amber-400 font-mono bg-white"
              data-group-name="${grp.replace(/"/g, '&quot;')}"
              data-opt-key="${rawKey.replace(/"/g, '&quot;')}"
              oninput="onEwVariantQtyChange()"/>
            <button type="button" onclick="this.closest('div.ew-var-row').remove(); onEwVariantQtyChange();"
              class="p-1 text-red-500 hover:text-red-700 hover:bg-red-50 rounded-lg text-xs font-bold transition-colors" title="حذف هذا المقاس من المستودع">
              🗑️ حذف
            </button>
          </div>
        </div>
      `;
    }).join('');
    document.getElementById('ew-qty').readOnly = true;
    document.getElementById('ew-qty').classList.add('bg-gray-100');
    onEwVariantQtyChange();
  } else {
    grid.innerHTML = `<div class="p-3 text-xs text-gray-400 text-center">لا توجد مقاسات مسجلة لهذا الصنف (يمكنك إضافة مقاس أدناه)</div>`;
    document.getElementById('ew-qty').readOnly = false;
    document.getElementById('ew-qty').classList.remove('bg-gray-100');
    document.getElementById('ew-var-total-sum').textContent = item.quantity || 0;
  }

