<%- include('partials/header', Object.assign({pageTitle: 'إدارة المستودع المركزي'}, locals)) %>

<div class="space-y-6">
  <!-- Header Title & Action Buttons -->
  <div class="flex flex-wrap items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-black text-gray-800 flex items-center gap-2">
        <span>🏢</span> المستودع المركزي والشحنات
      </h1>
      <p class="text-xs text-gray-500 mt-1">إدارة بضاعة المخزن الرئيسي، تعدد الشحنات والتكاليف، وتواريخ الصلاحية، وتحويل المقاسات للمحل</p>
    </div>
    <div class="flex items-center gap-2">
      <a href="<%= base %>/product-movements" class="bg-indigo-50 hover:bg-indigo-100 text-indigo-700 font-bold px-4 py-2.5 rounded-xl text-sm border border-indigo-200 transition-all flex items-center gap-1.5">
        <span>📜</span> سجل الحركات
      </a>
      <button onclick="openReturnFromStoreModal()" class="bg-amber-50 hover:bg-amber-100 text-amber-800 font-bold px-4 py-2.5 rounded-xl text-sm border border-amber-200 transition-all flex items-center gap-1.5">
        <span>↩️</span> إرجاع بضاعة للمستودع
      </button>
      <button onclick="openAddWarehouseModal()" class="bg-blue-700 hover:bg-blue-800 text-white font-bold px-5 py-2.5 rounded-xl text-sm shadow transition-all flex items-center gap-1.5">
        <span>➕</span> إضافة صنف / شحنة للمستودع
      </button>
    </div>
  </div>

  <!-- Financial Valuation Banner (Manager Only) -->
  <div class="bg-gradient-to-l from-slate-900 via-blue-950 to-indigo-950 text-white rounded-3xl shadow-xl p-5 border border-white/10">
    <div class="flex items-center justify-between mb-4 border-b border-white/10 pb-3">
      <div class="flex items-center gap-2">
        <span class="text-xl">💰</span>
        <span class="font-bold text-sm text-blue-200">التقييم المالي الشامل لبضاعة المستودع</span>
      </div>
      <span class="text-xs bg-blue-500/30 text-blue-200 px-3 py-1 rounded-full border border-blue-400/30">مخزن رئيسي منفصل</span>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
      <div class="bg-white/10 backdrop-blur rounded-2xl p-3.5 border border-white/10">
        <div id="wh-stat-cost" class="text-2xl font-black text-amber-300">0.00 ج</div>
        <div class="text-xs text-gray-300 mt-1">إجمالي رأس المال (سعر التكلفة)</div>
      </div>
      <div class="bg-white/10 backdrop-blur rounded-2xl p-3.5 border border-white/10">
        <div id="wh-stat-retail" class="text-2xl font-black text-emerald-300">0.00 ج</div>
        <div class="text-xs text-gray-300 mt-1">إجمالي القيمة بسعر البيع</div>
      </div>
      <div class="bg-white/10 backdrop-blur rounded-2xl p-3.5 border border-white/10">
        <div id="wh-stat-profit" class="text-2xl font-black text-cyan-300">0.00 ج</div>
        <div class="text-xs text-gray-300 mt-1">صافي الربح المتوقع</div>
      </div>
      <div class="bg-white/10 backdrop-blur rounded-2xl p-3.5 border border-white/10">
        <div id="wh-stat-count" class="text-2xl font-black text-white">0</div>
        <div class="text-xs text-gray-300 mt-1">إجمالي عدد الأصناف المخزنة</div>
      </div>
    </div>
  </div>

  <!-- Search and Filter Controls -->
  <div class="bg-white rounded-2xl shadow-sm border p-4 flex flex-wrap items-center gap-3">
    <div class="flex-1 min-w-[240px] relative">
      <span class="absolute inset-y-0 right-3 flex items-center text-gray-400">🔍</span>
      <input id="whSearchInput" type="text" placeholder="ابحث باسم المنتج، المقاس، أو الباركود..."
        oninput="filterWarehouseTable()"
        class="w-full pl-4 pr-10 py-2.5 border rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-blue-300"/>
    </div>
    <select id="whCatFilter" onchange="filterWarehouseTable()"
      class="border rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-300 bg-white">
      <option value="">جميع التصنيفات</option>
    </select>
    <select id="whStockFilter" onchange="filterWarehouseTable()"
      class="border rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-300 bg-white">
      <option value="">جميع الحالات</option>
      <option value="in_stock">متوفر في المستودع</option>
      <option value="out_of_stock">رصيد صفر (نفذ)</option>
    </select>
    <button onclick="loadWarehouseData()" class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-4 py-2.5 rounded-xl text-sm font-semibold transition-all">
      🔄 تحديث
    </button>
  </div>

  <!-- Warehouse Table -->
  <div class="bg-white rounded-2xl shadow-sm border overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-right text-sm">
        <thead class="bg-gray-50/80 text-gray-600 font-bold border-b text-xs">
          <tr>
            <th class="p-3.5">المنتج والمقاسات</th>
            <th class="p-3.5">الباركود / الكود</th>
            <th class="p-3.5">التصنيف</th>
            <th class="p-3.5">سعر التكلفة</th>
            <th class="p-3.5">سعر البيع بالمحل</th>
            <th class="p-3.5 text-center">رصيد المستودع</th>
            <th class="p-3.5 text-center">رصيد المحل</th>
            <th class="p-3.5 text-center">الشحنات والصلاحية</th>
            <th class="p-3.5 text-center">الإجراءات</th>
          </tr>
        </thead>
        <tbody id="whTableBody" class="divide-y divide-gray-100">
          <tr>
            <td colspan="9" class="text-center py-10 text-gray-400 font-medium">جارٍ تحميل بيانات المستودع...</td>
          </tr>
        </tbody>
      </table>
    </div>
    <div id="whNoData" class="hidden text-center py-12 text-gray-400">
      <span class="text-3xl block mb-2">📦</span>
      لا توجد أصناف تطابق البحث في المستودع
    </div>
  </div>
</div>

<!-- ════════════════ Modal: إضافة صنف / شحنة جديدة للمستودع ════════════════ -->
<div id="addWhModal" class="hidden fixed inset-0 bg-black/60 z-[80] flex items-center justify-center p-3 md:p-6 overflow-y-auto">
  <div class="bg-white rounded-3xl shadow-2xl w-full max-w-xl overflow-hidden animate-in fade-in zoom-in-95 duration-150">
    <div class="bg-gradient-to-r from-blue-700 to-indigo-800 text-white p-5 flex items-center justify-between">
      <div>
        <h3 class="font-black text-lg flex items-center gap-2"><span>➕</span> إضافة بضاعة / شحنة للمستودع</h3>
        <p class="text-xs text-blue-200 mt-0.5">اختر صنفاً موجوداً في المحل أو أضف صنفاً جديداً للمستودع</p>
      </div>
      <button onclick="closeAddWarehouseModal()" class="text-white/70 hover:text-white text-2xl">✕</button>
    </div>

    <!-- Mode Switcher Tabs -->
    <div class="flex border-b bg-gray-50 px-5 pt-3 gap-3 text-xs font-bold">
      <button type="button" id="tabModeShop" onclick="switchAddMode('shop')" class="pb-2.5 border-b-2 border-blue-600 text-blue-700 flex items-center gap-1.5 transition-all">
        <span>⚡</span> منتج موجود في المحل (بحث فوري)
      </button>
      <button type="button" id="tabModeCustom" onclick="switchAddMode('custom')" class="pb-2.5 border-b-2 border-transparent text-gray-500 hover:text-gray-800 flex items-center gap-1.5 transition-all">
        <span>✍️</span> صنف جديد بالكامل للمستودع
      </button>
    </div>

    <form onsubmit="submitAddWarehouseItem(event)" class="p-5 space-y-4 max-h-[75vh] overflow-y-auto">
      <input type="hidden" id="aw-shop-prod-id" value=""/>

      <!-- SECTION 1: Shop Product Live Autocomplete Search -->
      <div id="sec-shop-search" class="space-y-1 relative">
        <label class="text-xs font-bold text-gray-700 block">ابحث في منتجات المحل (بالاسم أو الباركود): *</label>
        <div class="relative">
          <span class="absolute inset-y-0 right-3 flex items-center text-gray-400">🔍</span>
          <input id="aw-search-input" type="text" autocomplete="off"
            placeholder="اكتب اسم المنتج أو الباركود لاختياره فوراً..."
            oninput="handleShopSearchInput(this.value)"
            class="w-full pl-4 pr-10 py-2.5 border-2 border-blue-200 rounded-xl text-sm focus:outline-none focus:border-blue-600 bg-blue-50/20"/>
        </div>
        <!-- Search Results Dropdown -->
        <div id="aw-search-dropdown" class="hidden absolute left-0 right-0 top-full mt-1 bg-white border border-gray-200 rounded-2xl shadow-xl max-h-56 overflow-y-auto z-50 divide-y divide-gray-100"></div>
        <div id="aw-selected-badge" class="hidden mt-2 p-3 bg-emerald-50 border border-emerald-200 rounded-xl flex items-center justify-between">
          <div class="text-xs">
            <span class="text-emerald-800 font-bold block" id="aw-selected-name">—</span>
            <span class="text-emerald-600" id="aw-selected-details">—</span>
          </div>
          <button type="button" onclick="clearSelectedShopProduct()" class="text-xs text-red-600 hover:underline font-bold">تغيير الصنف</button>
        </div>
      </div>

      <!-- Variants / Options Quantity Grid -->
      <div id="aw-variants-section" class="hidden bg-blue-50/70 border border-blue-200 rounded-2xl p-3.5 space-y-2.5">
        <div class="flex items-center justify-between border-b border-blue-200/80 pb-2">
          <div class="flex items-center gap-1.5 text-xs font-bold text-blue-900">
            <span>🎨</span> مقاسات وخيارات الصنف (حدد الوارد من كل مقاس أو أضف مقاساً جديداً):
          </div>
          <span class="text-xs text-blue-800 font-mono">إجمالي المقاسات: <strong id="aw-var-total-sum" class="font-bold">0</strong> قطعة</span>
        </div>
        <div id="aw-variants-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-2 max-h-48 overflow-y-auto p-1"></div>
        
        <!-- Add New Custom Variant Row -->
        <div class="flex items-center gap-2 pt-2 border-t border-blue-200">
          <input type="text" id="aw-new-var-name" placeholder="➕ اسم مقاس جديد (مثال: A4, XL, 50g)..."
            class="flex-1 border border-blue-300 rounded-xl px-3 py-1.5 text-xs focus:outline-none focus:ring-2 focus:ring-blue-400 bg-white"
            onkeydown="if(event.key==='Enter'){event.preventDefault();addNewAwVariant();}"/>
          <input type="number" id="aw-new-var-qty" placeholder="الكمية" min="1" value="1"
            class="w-16 border border-blue-300 rounded-xl px-2 py-1.5 text-xs text-center font-bold font-mono focus:outline-none focus:ring-2 focus:ring-blue-400 bg-white"
            onkeydown="if(event.key==='Enter'){event.preventDefault();addNewAwVariant();}"/>
          <button type="button" onclick="addNewAwVariant()"
            class="bg-blue-700 hover:bg-blue-800 text-white font-bold px-3 py-1.5 rounded-xl text-xs shadow-sm transition-all whitespace-nowrap flex items-center gap-1">
            <span>+</span> إضافة مقاس
          </button>
        </div>
      </div>

      <!-- Basic Fields -->
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="text-xs font-bold text-gray-700 block mb-1">اسم الصنف في المستودع *</label>
          <input id="aw-name" type="text" required placeholder="اسم المنتج الطبي"
            class="w-full border rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-300"/>
        </div>
        <div>
          <label class="text-xs font-bold text-gray-700 block mb-1">الباركود / الكود</label>
          <input id="aw-barcode" type="text" placeholder="باركود الصنف"
            class="w-full border rounded-xl px-3 py-2 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-blue-300"/>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="text-xs font-bold text-gray-700 block mb-1">التصنيف</label>
          <input id="aw-category" type="text" placeholder="مستلزمات / حشوات..."
            class="w-full border rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-300"/>
        </div>
        <div>
          <label class="text-xs font-bold text-gray-700 block mb-1">سعر البيع بالمحل (EGP)</label>
          <div class="relative">
            <input id="aw-price" type="number" min="0" step="0.01" value="0.00"
              class="w-full border rounded-xl px-3 py-2 text-sm font-mono font-bold focus:outline-none focus:ring-2 focus:ring-blue-300"/>
            <span id="aw-price-lock" class="hidden absolute left-3 top-2.5 text-xs text-gray-400 font-bold" title="سعر معتمد من المحل">🔒 موحد</span>
          </div>
        </div>
      </div>

      <!-- Cost, Quantity & Expiry -->
      <div class="bg-gray-50 border rounded-2xl p-3.5 space-y-3">
        <div class="text-xs font-bold text-gray-700 border-b pb-2 flex items-center gap-1.5">
          <span>📦</span> بيانات الشحنة والتكلفة الواردة:
        </div>
        <div class="grid grid-cols-3 gap-2">
          <div>
            <label class="text-xs font-bold text-gray-700 block mb-1">الكمية الواردة *</label>
            <input id="aw-qty" type="number" min="1" value="1" required
              class="w-full border rounded-xl px-3 py-2 text-sm text-center font-bold text-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-300"/>
          </div>
          <div>
            <label class="text-xs font-bold text-gray-700 block mb-1">سعر التكلفة (EGP) *</label>
            <input id="aw-cost" type="number" min="0" step="0.01" value="0.00" required
              class="w-full border rounded-xl px-3 py-2 text-sm text-center font-mono font-bold text-amber-700 focus:outline-none focus:ring-2 focus:ring-blue-300"/>
          </div>
          <div>
            <label class="text-xs font-bold text-gray-700 block mb-1">الصلاحية (اختياري)</label>
            <input id="aw-expiry" type="date"
              class="w-full border rounded-xl px-2.5 py-1.5 text-xs focus:outline-none focus:ring-2 focus:ring-blue-300"/>
          </div>
        </div>
      </div>

      <!-- Description & Notes -->
      <div>
        <label class="text-xs font-bold text-gray-700 block mb-1">الوصف (Description)</label>
        <textarea id="aw-desc" rows="2" placeholder="وصف المنتج أو المواصفات الفنية..."
          class="w-full border rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-300 resize-none"></textarea>
      </div>

      <div>
        <label class="text-xs font-bold text-gray-700 block mb-1">ملاحظات الشحنة (اختياري)</label>
        <input id="aw-notes" type="text" placeholder="رقم الفاتورة، اسم المورد، مكان التخزين..."
          class="w-full border rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-300"/>
      </div>

      <p id="aw-error" class="hidden text-xs text-red-600 bg-red-50 rounded-xl p-2.5 text-center font-bold"></p>

      <div class="flex gap-2 pt-2 border-t">
        <button type="submit" class="flex-1 bg-blue-700 hover:bg-blue-800 text-white font-bold py-2.5 rounded-xl text-sm shadow transition-all">
          💾 حفظ الشحنة في المستودع
        </button>
        <button type="button" onclick="closeAddWarehouseModal()" class="px-5 bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold py-2.5 rounded-xl text-sm">
          إلغاء
        </button>
      </div>
    </form>
  </div>
</div>

<!-- ════════════════ Modal: تحويل بضاعة ومقاسات للمحل ════════════════ -->
<div id="transferModal" class="hidden fixed inset-0 bg-black/60 z-[80] flex items-center justify-center p-3 md:p-6 overflow-y-auto">
  <div class="bg-white rounded-3xl shadow-2xl w-full max-w-lg overflow-hidden animate-in fade-in zoom-in-95 duration-150">
    <div class="bg-gradient-to-r from-blue-700 to-indigo-800 text-white p-5 flex items-center justify-between">
      <div>
        <h3 class="font-black text-lg flex items-center gap-2"><span>🚚</span> تحويل بضاعة للمحل</h3>
        <p id="tr-prod-name" class="text-xs text-blue-200 mt-0.5 font-medium"></p>
      </div>
      <button onclick="closeTransferModal()" class="text-white/70 hover:text-white text-2xl leading-none">✕</button>
    </div>

    <div class="p-5 space-y-4 max-h-[75vh] overflow-y-auto">
      <!-- Variants Selector with Pill Badges -->
      <div id="tr-variants-container" class="hidden space-y-2">
        <label class="text-xs font-bold text-gray-700 block">اختر المقاس / الخيار المراد تحويله للمحل:</label>
        <div id="tr-variants-list" class="flex flex-wrap gap-2 p-1 max-h-36 overflow-y-auto"></div>
      </div>

      <!-- Batch Selector (Expiry & Cost selection) -->
      <div id="tr-batch-container" class="space-y-1.5">
        <label class="text-xs font-bold text-gray-700 block">شحنة الصرف بالمستودع:</label>
        <select id="tr-batch-select" onchange="onBatchSelectChange()"
          class="w-full border rounded-xl px-3 py-2 text-xs font-medium bg-white focus:outline-none focus:ring-2 focus:ring-blue-300">
          <option value="">⚡ تلقائي (الأقرب صلاحية والأقدم - FIFO)</option>
        </select>
      </div>

      <!-- Current Stock Status Cards -->
      <div class="grid grid-cols-2 gap-3">
        <div class="bg-amber-50 border border-amber-200 rounded-2xl p-3 text-center">
          <span class="text-xs text-amber-800 font-semibold block">المتاح في المستودع</span>
          <span id="tr-avail-wh" class="text-2xl font-black text-amber-700">0</span>
        </div>
        <div class="bg-blue-50 border border-blue-200 rounded-2xl p-3 text-center">
          <span class="text-xs text-blue-800 font-semibold block">الرصيد الحالي في المحل</span>
          <span id="tr-current-shop" class="text-2xl font-black text-blue-700">0</span>
        </div>
      </div>

      <!-- Transfer Quantity Counter -->
      <div class="bg-gray-50 border rounded-2xl p-4 space-y-2">
        <label class="text-xs font-bold text-gray-700 block text-center">الكمية المراد تحويلها وإرسالها للمحل:</label>
        <div class="flex items-center justify-center gap-2">
          <button type="button" onclick="chgTrQty(-10)" class="w-9 h-9 rounded-xl bg-gray-200 hover:bg-gray-300 font-black text-xs transition-all">-10</button>
          <button type="button" onclick="chgTrQty(-1)" class="w-9 h-9 rounded-xl bg-gray-200 hover:bg-gray-300 font-black text-base transition-all">−</button>
          <input id="trQuantityInput" type="number" min="1" value="1"
            oninput="validateTrQtyInput()"
            class="w-20 text-center font-black text-xl text-blue-800 border-2 border-blue-400 rounded-xl py-1 focus:outline-none focus:ring-2 focus:ring-blue-300"/>
          <button type="button" onclick="chgTrQty(1)" class="w-9 h-9 rounded-xl bg-gray-200 hover:bg-gray-300 font-black text-base transition-all">+</button>
          <button type="button" onclick="chgTrQty(10)" class="w-9 h-9 rounded-xl bg-gray-200 hover:bg-gray-300 font-black text-xs transition-all">+10</button>
        </div>
        <div class="flex justify-center gap-3 pt-1 text-xs">
          <button type="button" onclick="setTrAll()" class="text-blue-600 hover:underline font-bold">تحويل كل الكمية المتاحة</button>
        </div>
      </div>

      <!-- Notes -->
      <div>
        <label class="text-xs font-bold text-gray-600 block mb-1">ملاحظة إذن التحويل (اختياري)</label>
        <input id="trNoteInput" type="text" placeholder="مثال: توريد كمية جديدة للأرفف..."
          class="w-full border rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-300"/>
      </div>

      <div class="bg-blue-50 border border-blue-200 rounded-xl p-3 text-xs text-blue-800 leading-relaxed">
        ℹ️ عند تأكيد التحويل: سيتم خصم الكمية من المستودع فوراً وإضافتها لمخزن المحل وتحديث الموقع الإلكتروني وتتبع التكلفة تلقائياً.
      </div>

      <p id="trError" class="hidden bg-red-50 text-red-700 text-xs rounded-xl p-2.5 text-center font-semibold"></p>
    </div>

    <div class="p-4 border-t bg-gray-50 flex gap-2">
      <button id="trConfirmBtn" onclick="confirmTransferToStore()" class="flex-1 bg-blue-700 hover:bg-blue-800 text-white font-bold py-3 rounded-xl text-sm shadow transition-all">
        ✅ تأكيد تحويل الكمية للمحل
      </button>
      <button onclick="closeTransferModal()" class="px-5 bg-white border hover:bg-gray-100 text-gray-700 font-bold py-3 rounded-xl text-sm">
        إلغاء
      </button>
    </div>
  </div>
</div>

<!-- ════════════════ Modal: إرجاع بضاعة من المحل للمستودع ════════════════ -->
<div id="returnModal" class="hidden fixed inset-0 bg-black/60 z-[80] flex items-center justify-center p-3 md:p-6 overflow-y-auto">
  <div class="bg-white rounded-3xl shadow-2xl w-full max-w-lg overflow-hidden animate-in fade-in zoom-in-95 duration-150">
    <div class="bg-gradient-to-r from-amber-600 to-orange-700 text-white p-5 flex items-center justify-between">
      <div>
        <h3 class="font-black text-lg flex items-center gap-2"><span>↩️</span> إرجاع بضاعة من المحل إلى المستودع</h3>
        <p class="text-xs text-amber-100 mt-0.5">إعادة كميات راكدة أو فائضة من المحل إلى المستودع الرئيسي</p>
      </div>
      <button onclick="closeReturnModal()" class="text-white/70 hover:text-white text-2xl leading-none">✕</button>
    </div>

    <form onsubmit="submitReturnToWarehouse(event)" class="p-5 space-y-4 max-h-[75vh] overflow-y-auto">
      <div>
        <label class="text-xs font-bold text-gray-700 block mb-1">اختر المنتج المراد إرجاعه من المحل: *</label>
        <select id="ret-prod-select" onchange="onReturnProductSelect()" required
          class="w-full border-2 border-amber-200 rounded-xl px-3 py-2.5 text-sm bg-white focus:outline-none focus:border-amber-600">
          <option value="">-- اختر الصنف --</option>
        </select>
      </div>

      <!-- Variant Selector if applicable -->
      <div id="ret-variant-container" class="hidden space-y-1.5">
        <label class="text-xs font-bold text-gray-700 block">اختر المقاس المراد إرجاعه:</label>
        <div id="ret-variant-list" class="flex flex-wrap gap-2"></div>
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div class="bg-blue-50 border border-blue-200 rounded-2xl p-3 text-center">
          <span class="text-xs text-blue-800 font-semibold block">المتاح حالياً بالمحل</span>
          <span id="ret-avail-shop" class="text-2xl font-black text-blue-700">0</span>
        </div>
        <div>
          <label class="text-xs font-bold text-gray-700 block mb-1">الكمية المراد إرجاعها *</label>
          <input id="ret-qty" type="number" min="1" value="1" required
            class="w-full border-2 border-amber-300 rounded-xl px-3 py-2 text-center text-xl font-black text-amber-800 focus:outline-none focus:border-amber-600"/>
        </div>
      </div>

      <div>
        <label class="text-xs font-bold text-gray-700 block mb-1">سبب الإرجاع والملاحظات (اختياري)</label>
        <input id="ret-reason" type="text" placeholder="فائض عن حاجة العرض بالمحل / استرجاع للمخزن..."
          class="w-full border rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-amber-300"/>
