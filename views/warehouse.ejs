<script>
const BASE = '<%= base %>';
let _warehouseItems = [];
let _shopProducts = [];
let _currentTrItem = null;
let _currentTrSizeKey = null;
let _maxAvailTr = 0;
let _addMode = 'shop';

async function loadWarehouseData() {
  try {
    const res = await fetch(`${BASE}/api/warehouse/products`);
    const data = await res.json();
    _warehouseItems = data.items || [];
    _shopProducts = data.shop_products || [];

    // Update Valuation Stats
    const totalCost = _warehouseItems.reduce((s, i) => s + (parseFloat(i.cost_price||0) * parseInt(i.quantity||0)), 0);
    const totalRetail = _warehouseItems.reduce((s, i) => s + (parseFloat(i.sale_price||0) * parseInt(i.quantity||0)), 0);
    const totalProfit = Math.max(0, totalRetail - totalCost);

    document.getElementById('wh-stat-cost').textContent = totalCost.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ج';
    document.getElementById('wh-stat-retail').textContent = totalRetail.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ج';
    document.getElementById('wh-stat-profit').textContent = totalProfit.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ج';
    document.getElementById('wh-stat-count').textContent = _warehouseItems.length;

    // Populate Category filter
    const catSelect = document.getElementById('whCatFilter');
    const categories = Array.from(new Set(_warehouseItems.map(i => i.category).filter(Boolean)));
    catSelect.innerHTML = '<option value="">جميع التصنيفات</option>' + categories.map(c => `<option value="${c}">${c}</option>`).join('');

    renderWarehouseTable(_warehouseItems);
  } catch (err) {
    console.error('Failed to load warehouse data:', err);
  }
}

function renderWarehouseTable(items) {
  const tbody = document.getElementById('whTableBody');
  const noData = document.getElementById('whNoData');

  if (!items || !items.length) {
    tbody.innerHTML = '';
    noData.classList.remove('hidden');
    return;
  }
  noData.classList.add('hidden');

  tbody.innerHTML = items.map(i => {
    const whStock = parseInt(i.quantity || 0);
    const shopStock = i.shop_quantity != null ? parseInt(i.shop_quantity) : '—';
    const cost = parseFloat(i.cost_price || 0).toFixed(2);
    const price = parseFloat(i.sale_price || 0).toFixed(2);

    // Variants badge preview with interactive comparison trigger
    let variantsHtml = '';
    let hasVariantOpts = false;
    if (i.checkbox_values) {
      const cbv = typeof i.checkbox_values === 'string' ? JSON.parse(i.checkbox_values) : i.checkbox_values;
      const opts = Object.keys(cbv);
      if (opts.length > 0) {
        hasVariantOpts = true;
        // Compare with shop product variants if linked
        const shopProd = _shopProducts.find(p => p.id === i.product_id);
        const shopCbv = shopProd && shopProd.checkbox_values ? (typeof shopProd.checkbox_values === 'string' ? JSON.parse(shopProd.checkbox_values) : shopProd.checkbox_values) : {};

        variantsHtml = `<div class="mt-1.5 flex flex-wrap items-center gap-1.5">` +
          opts.slice(0, 3).map(o => {
            const wStock = cbv[o].stock != null ? cbv[o].stock : 0;
            const sStock = shopCbv[o]?.stock != null ? shopCbv[o]?.stock : 0;
            const isLowInShop = sStock <= 0;
            return `<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-lg text-[11px] font-mono border ${isLowInShop ? 'bg-amber-50 text-amber-800 border-amber-300' : 'bg-blue-50 text-blue-800 border-blue-200'}">
              <strong>${o}:</strong> <span title="مستودع">🏢${wStock}</span> | <span title="محل" class="${isLowInShop ? 'text-red-600 font-bold' : ''}">🏬${sStock}</span>
            </span>`;
          }).join('') +
          `<button type="button" onclick="openVariantCompareModal(${i.id})" class="px-2 py-0.5 rounded-lg text-[11px] font-bold bg-indigo-50 hover:bg-indigo-100 text-indigo-700 border border-indigo-200 transition-all flex items-center gap-1">
            <span>📊</span> مقارنة المقاسات (${opts.length})
          </button>` +
          `</div>`;
      }
    }

    // Batches count badge
    const batchCount = (i.batches || []).length;
    const batchesBadge = batchCount > 1 
      ? `<span class="px-2 py-0.5 rounded-full text-[11px] font-bold bg-purple-50 text-purple-700 border border-purple-200">📦 ${batchCount} شحنات</span>`
      : (i.expiry_date ? `<span class="text-xs text-gray-500 font-mono">📅 ${i.expiry_date}</span>` : '<span class="text-gray-300 text-xs">—</span>');

    return `
      <tr class="hover:bg-gray-50 transition-colors">
        <td class="p-3.5">
          <div class="font-bold text-gray-900">${i.product_name}</div>
          ${variantsHtml}
          ${i.description ? `<div class="text-[11px] text-gray-400 line-clamp-1 mt-0.5">${i.description}</div>` : ''}
        </td>
        <td class="p-3.5 font-mono text-xs text-gray-500">${i.barcode || '—'}</td>
        <td class="p-3.5">
          <span class="inline-block px-2.5 py-0.5 rounded-lg text-xs font-semibold bg-gray-100 text-gray-700">
            ${i.category || 'عام'}
          </span>
        </td>
        <td class="p-3.5 font-mono text-amber-700 font-bold">${cost} ج</td>
        <td class="p-3.5 font-mono text-gray-800">${price > 0 ? price + ' ج' : '—'}</td>
        <td class="p-3.5 text-center">
          <span class="px-2.5 py-1 rounded-full font-bold text-xs ${whStock > 0 ? 'bg-amber-50 text-amber-800 border border-amber-200' : 'bg-red-50 text-red-700'} font-mono">
            ${whStock} قطعة
          </span>
        </td>
        <td class="p-3.5 text-center">
