function openAddWarehouseModal() {
  document.getElementById('addWhModal').classList.remove('hidden');
  switchAddMode('shop');
  clearSelectedShopProduct();
  document.getElementById('aw-name').value = '';
  document.getElementById('aw-barcode').value = '';
  document.getElementById('aw-category').value = '';
  document.getElementById('aw-cost').value = '0.00';
  document.getElementById('aw-price').value = '0.00';
  document.getElementById('aw-qty').value = '1';
  document.getElementById('aw-desc').value = '';
  document.getElementById('aw-expiry').value = '';
  document.getElementById('aw-notes').value = '';
  document.getElementById('aw-error').classList.add('hidden');
}

function openAddBatchModal(itemId) {
  const item = _warehouseItems.find(i => i.id === itemId);
  if (!item) return;
  openAddWarehouseModal();
  if (item.product_id) {
    const shopProd = _shopProducts.find(p => p.id === item.product_id);
    if (shopProd) selectShopProduct(shopProd);
  } else {
    switchAddMode('custom');
    document.getElementById('aw-name').value = item.product_name;
    document.getElementById('aw-barcode').value = item.barcode || '';
    document.getElementById('aw-category').value = item.category || '';
    document.getElementById('aw-price').value = item.sale_price || 0;
  }
}

function closeAddWarehouseModal() {
  document.getElementById('addWhModal').classList.add('hidden');
}

function switchAddMode(mode) {
  _addMode = mode;
  const tabShop = document.getElementById('tabModeShop');
  const tabCust = document.getElementById('tabModeCustom');
  const secSearch = document.getElementById('sec-shop-search');
  const lockIcon = document.getElementById('aw-price-lock');
  const priceInput = document.getElementById('aw-price');

  if (mode === 'shop') {
    tabShop.className = 'pb-2.5 border-b-2 border-blue-600 text-blue-700 flex items-center gap-1.5 transition-all';
    tabCust.className = 'pb-2.5 border-b-2 border-transparent text-gray-500 hover:text-gray-800 flex items-center gap-1.5 transition-all';
    secSearch.classList.remove('hidden');
    lockIcon.classList.remove('hidden');
    priceInput.readOnly = true;
    priceInput.classList.add('bg-gray-50');
  } else {
    tabCust.className = 'pb-2.5 border-b-2 border-blue-600 text-blue-700 flex items-center gap-1.5 transition-all';
    tabShop.className = 'pb-2.5 border-b-2 border-transparent text-gray-500 hover:text-gray-800 flex items-center gap-1.5 transition-all';
