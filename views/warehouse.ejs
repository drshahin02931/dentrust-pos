// ── Flatten Checkbox Values Helper ──────────────────────────────────────────
function flattenCbv(cbv) {
  if (!cbv) return {};
  try {
    const parsed = typeof cbv === 'string' ? JSON.parse(cbv) : cbv;
    const out = {};
    Object.keys(parsed).forEach(k => {
      const val = parsed[k];
      if (val && typeof val === 'object' && !('stock' in val) && !('checked' in val)) {
        Object.keys(val).forEach(subK => {
          out[`[${k}] ${subK}`] = { ...val[subK], groupName: k, rawKey: subK };
        });
      } else {
        out[k] = { ...val, groupName: 'عام', rawKey: k };
      }
    });
    return out;
  } catch {
    return {};
  }
}

// ── Variant Comparison Modal Logic ───────────────────────────────────────────
function openVariantCompareModal(itemId) {
  const item = _warehouseItems.find(i => i.id === itemId);
  if (!item) return;

  document.getElementById('cmp-prod-name').textContent = `${item.product_name} • (كود: ${item.barcode || '—'})`;
  const tbody = document.getElementById('cmp-table-body');
  tbody.innerHTML = '';

  const whFlat = flattenCbv(item.checkbox_values);
  const shopProd = _shopProducts.find(p => p.id === item.product_id);
  const shopFlat = flattenCbv(shopProd ? shopProd.checkbox_values : null);

  const allKeys = Array.from(new Set([...Object.keys(whFlat), ...Object.keys(shopFlat)]));

  if (!allKeys.length) {
    tbody.innerHTML = `<tr><td colspan="6" class="p-6 text-center text-gray-400 font-bold">لا توجد مقاسات مسجلة لهذا الصنف</td></tr>`;
  } else {
    tbody.innerHTML = allKeys.map(displayKey => {
      const wObj = whFlat[displayKey] || {};
      const sObj = shopFlat[displayKey] || {};
      const wQty = wObj.stock != null ? parseInt(wObj.stock) : 0;
      const sQty = sObj.stock != null ? parseInt(sObj.stock) : 0;
      const total = wQty + sQty;
      const rawKey = wObj.rawKey || sObj.rawKey || displayKey;
      const grpName = wObj.groupName || sObj.groupName || 'عام';

      let statusBadge = '';
      if (sQty <= 0) {
        statusBadge = `<span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-red-100 text-red-700 border border-red-200">🔴 نافد بالمحل</span>`;
      } else if (sQty <= 2) {
        statusBadge = `<span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800 border border-amber-200">🟡 كمية منخفضة</span>`;
      } else {
        statusBadge = `<span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800 border border-emerald-200">🟢 متوفر بالمحل</span>`;
      }

      return `
        <tr class="hover:bg-gray-50 transition-colors">
          <td class="p-3 font-bold text-gray-900">
            <div class="flex items-center gap-1.5">
              ${grpName !== 'عام' ? `<span class="px-1.5 py-0.5 bg-blue-100 text-blue-800 rounded text-[10px] font-mono font-bold">${grpName}</span>` : ''}
              <span class="text-gray-900">${rawKey}</span>
            </div>
          </td>
          <td class="p-3 text-center font-mono font-bold text-amber-700 bg-amber-50/40">${wQty} قطعة</td>
          <td class="p-3 text-center font-mono font-bold text-blue-700 bg-blue-50/40">${sQty} قطعة</td>
          <td class="p-3 text-center font-mono font-black text-gray-800">${total} قطعة</td>
          <td class="p-3 text-center">${statusBadge}</td>
          <td class="p-3 text-center">
            <button onclick="quickTransferSpecificVariant(${item.id}, '${rawKey.replace(/'/g, "\\'")}', ${wQty})" ${wQty <= 0 ? 'disabled' : ''}
              class="bg-blue-600 hover:bg-blue-700 disabled:opacity-30 text-white font-bold px-3 py-1 rounded-xl text-xs shadow-sm transition-all flex items-center gap-1 mx-auto">
              <span>🚚</span> تحويل للمحل
            </button>
          </td>
        </tr>
      `;
    }).join('');
  }

  document.getElementById('variantCompareModal').classList.remove('hidden');
}

// ── Transfer Modal ────────────────────────────────────────────────────────────
function openTransferModal(itemId) {
  const item = _warehouseItems.find(i => i.id === itemId);
  if (!item) return;

  _currentTrItem = item;
  _currentTrSizeKey = null;
  _maxAvailTr = parseInt(item.quantity || 0);

  document.getElementById('tr-prod-name').textContent = item.product_name;
  document.getElementById('tr-avail-wh').textContent = _maxAvailTr;
  document.getElementById('tr-current-shop').textContent = item.shop_quantity != null ? item.shop_quantity : 0;
  document.getElementById('trQuantityInput').value = '1';
  document.getElementById('trNoteInput').value = '';
  document.getElementById('trError').classList.add('hidden');

  // Populate Batches Selector
  const bSelect = document.getElementById('tr-batch-select');
  const batches = item.batches || [];
  bSelect.innerHTML = '<option value="">⚡ تلقائي (الأقرب صلاحية والأقدم - FIFO)</option>' +
    batches.map(b => `<option value="${b.id}">📦 ${b.batch_number || 'شحنة'} (متاح: ${b.quantity} | تكلفة: ${parseFloat(b.cost_price||0).toFixed(2)} ج ${b.expiry_date ? '| صلاحية: ' + b.expiry_date : ''})</option>`).join('');

  // Handle Variants
  const vContainer = document.getElementById('tr-variants-container');
  const vList = document.getElementById('tr-variants-list');

  let hasVariants = false;
  vList.innerHTML = '';

  if (item.checkbox_values) {
    const cbv = typeof item.checkbox_values === 'string' ? JSON.parse(item.checkbox_values) : item.checkbox_values;
    const opts = Object.keys(cbv);
    if (opts.length > 0) {
      hasVariants = true;
      vList.innerHTML = opts.map((opt, idx) => {
        const stock = cbv[opt].stock != null ? parseInt(cbv[opt].stock) : 0;
        return `
          <button type="button" onclick="selectTrVariant('${opt}', ${stock})" id="tr-opt-${idx}"
            class="tr-opt-btn px-3 py-1.5 rounded-xl border text-xs font-bold transition-all ${idx === 0 ? 'bg-blue-600 text-white border-blue-600' : 'bg-gray-50 text-gray-700 border-gray-200 hover:border-blue-400'}">
            ${opt} <span class="text-[11px] font-mono opacity-80">(${stock})</span>
          </button>
        `;
      }).join('');
      if (opts.length > 0) {
        _currentTrSizeKey = opts[0];
        _maxAvailTr = cbv[opts[0]].stock != null ? parseInt(cbv[opts[0]].stock) : 0;
        document.getElementById('tr-avail-wh').textContent = _maxAvailTr;
      }
    }
  }

  if (hasVariants) vContainer.classList.remove('hidden');
  else vContainer.classList.add('hidden');

  document.getElementById('transferModal').classList.remove('hidden');
}

function selectTrVariant(optKey, stock) {
  _currentTrSizeKey = optKey;
  _maxAvailTr = stock;
  document.getElementById('tr-avail-wh').textContent = stock;
  document.querySelectorAll('.tr-opt-btn').forEach(b => {
    b.className = b.textContent.includes(optKey) 
      ? 'tr-opt-btn px-3 py-1.5 rounded-xl border text-xs font-bold transition-all bg-blue-600 text-white border-blue-600'
      : 'tr-opt-btn px-3 py-1.5 rounded-xl border text-xs font-bold transition-all bg-gray-50 text-gray-700 border-gray-200 hover:border-blue-400';
  });
}

function onBatchSelectChange() {
  const bId = document.getElementById('tr-batch-select').value;
  if (!bId || !_currentTrItem) return;
  const b = (_currentTrItem.batches || []).find(x => String(x.id) === String(bId));
  if (b && !_currentTrSizeKey) {
    _maxAvailTr = parseInt(b.quantity || 0);
    document.getElementById('tr-avail-wh').textContent = _maxAvailTr;
