function filterWarehouseTable() {
  const q = (document.getElementById('whSearchInput').value || '').trim().toLowerCase();
  const cat = document.getElementById('whCatFilter').value;
  const stock = document.getElementById('whStockFilter').value;

  const filtered = _warehouseItems.filter(i => {
    if (q) {
      const matchName = (i.product_name || '').toLowerCase().includes(q);
      const matchBar = (i.barcode || '').toLowerCase().includes(q);
      const matchCat = (i.category || '').toLowerCase().includes(q);
      if (!matchName && !matchBar && !matchCat) return false;
    }
    if (cat && i.category !== cat) return false;
    if (stock === 'in_stock' && (parseInt(i.quantity||0) <= 0)) return false;
    if (stock === 'out_of_stock' && (parseInt(i.quantity||0) > 0)) return false;
    return true;
  });

  renderWarehouseTable(filtered);
}

