function handleShopSearchInput(q) {
  const dd = document.getElementById('aw-search-dropdown');
  if (!q || !q.trim()) {
    dd.classList.add('hidden');
    return;
  }
  const query = q.trim().toLowerCase();
  const matches = _shopProducts.filter(p => 
    (p.product_name || '').toLowerCase().includes(query) ||
    (p.barcode || '').toLowerCase().includes(query) ||
    (p.category || '').toLowerCase().includes(query)
  ).slice(0, 10);

  if (!matches.length) {
    dd.innerHTML = `<div class="p-3 text-xs text-gray-400 text-center">لا توجد منتجات مطابقة في المحل</div>`;
    dd.classList.remove('hidden');
    return;
  }

  dd.innerHTML = matches.map(p => `
    <div onclick="selectShopProductById(${p.id})" class="p-3 hover:bg-blue-50/80 cursor-pointer transition-colors flex items-center justify-between text-xs">
      <div>
        <div class="font-bold text-gray-900">${p.product_name}</div>
        <div class="text-[11px] text-gray-500">القسم: ${p.category || 'عام'} ${p.barcode ? '• باركود: ' + p.barcode : ''}</div>
      </div>
      <div class="text-left font-mono">
        <span class="font-bold text-blue-700 block">${parseFloat(p.sale_price||0).toFixed(2)} ج</span>
        <span class="text-[10px] text-gray-400">رصيد المحل: ${p.quantity||0}</span>
      </div>
    </div>
  `).join('');
  dd.classList.remove('hidden');
}

function selectShopProductById(id) {
  const prod = _shopProducts.find(p => p.id === id);
  if (prod) selectShopProduct(prod);
}

let _selectedShopProd = null;

function selectShopProduct(p) {
  _selectedShopProd = p;
  document.getElementById('aw-search-dropdown').classList.add('hidden');
  document.getElementById('aw-search-input').value = '';
  document.getElementById('aw-shop-prod-id').value = p.id;

  document.getElementById('aw-selected-name').textContent = `✅ ${p.product_name}`;
  document.getElementById('aw-selected-details').textContent = `القسم: ${p.category || 'عام'} • سعر البيع بالمحل: ${parseFloat(p.sale_price||0).toFixed(2)} ج • رصيد المحل الحالي: ${p.quantity || 0} قطعة`;
  document.getElementById('aw-selected-badge').classList.remove('hidden');

  document.getElementById('aw-name').value = p.product_name;
  document.getElementById('aw-barcode').value = p.barcode || '';
  document.getElementById('aw-category').value = p.category || '';
  document.getElementById('aw-price').value = p.sale_price || 0;
  document.getElementById('aw-desc').value = p.description || p.details || '';
  if (p.purchase_price && parseFloat(p.purchase_price) > 0) {
    document.getElementById('aw-cost').value = p.purchase_price;
  }

  // Render Variants Matrix grouped by category/title
  const varSec = document.getElementById('aw-variants-section');
  const varGrid = document.getElementById('aw-variants-grid');
  const grpSelect = document.getElementById('aw-var-group-select');
  varGrid.innerHTML = '';
  grpSelect.innerHTML = '';

  let hasVariants = false;
  let groups = [];

  if (p.checkbox_values) {
    const cbv = typeof p.checkbox_values === 'string' ? JSON.parse(p.checkbox_values) : p.checkbox_values;
    
    // Check if nested by group: { "الحجم": { "A1": {...} } } or flat: { "A1": {...} }
    const topKeys = Object.keys(cbv);
    const isNested = topKeys.some(k => cbv[k] && typeof cbv[k] === 'object' && !('stock' in cbv[k]) && !('checked' in cbv[k]));

    if (isNested) {
      hasVariants = true;
      groups = topKeys;
      varGrid.innerHTML = topKeys.map(grpName => {
        const subOpts = cbv[grpName] || {};
        const optKeys = Object.keys(subOpts);
        return `
          <div class="bg-white p-3 rounded-2xl border border-blue-200 shadow-sm space-y-2">
            <div class="text-xs font-bold text-blue-900 border-b border-gray-100 pb-1.5 flex items-center gap-1">
              <span class="text-blue-600">📂</span> مجموعة: ${grpName}
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2" id="grp-grid-${CSS.escape(grpName)}">
              ${optKeys.map(opt => {
                const shopStock = subOpts[opt].stock != null ? subOpts[opt].stock : '—';
                return `
                  <div class="bg-gray-50/80 p-2 rounded-xl border border-gray-200 flex items-center justify-between gap-2">
                    <div>
                      <span class="text-xs font-bold text-gray-800 block">${opt}</span>
                      <span class="text-[10px] text-gray-400">بالمحل: ${shopStock}</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                      <span class="text-[11px] text-blue-700 font-bold">وارد:</span>
                      <input type="number" min="0" value="0"
                        class="aw-var-qty-input w-16 text-center font-bold text-xs border border-blue-300 rounded-lg py-1 focus:outline-none focus:ring-2 focus:ring-blue-400 font-mono bg-white"
                        data-group-name="${grpName.replace(/"/g, '&quot;')}"
                        data-opt-key="${opt.replace(/"/g, '&quot;')}"
                        oninput="onAwVariantQtyChange()"/>
                    </div>
                  </div>
                `;
              }).join('')}
            </div>
          </div>
        `;
      }).join('');
    } else if (topKeys.length > 0) {
      hasVariants = true;
      groups = ['عام'];
      varGrid.innerHTML = `
        <div class="bg-white p-3 rounded-2xl border border-blue-200 shadow-sm space-y-2">
          <div class="text-xs font-bold text-blue-900 border-b border-gray-100 pb-1.5 flex items-center gap-1">
            <span class="text-blue-600">📂</span> مجموعة المقاسات العامة
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2" id="grp-grid-عام">
            ${topKeys.map(opt => {
              const shopStock = cbv[opt].stock != null ? cbv[opt].stock : '—';
              return `
                <div class="bg-gray-50/80 p-2 rounded-xl border border-gray-200 flex items-center justify-between gap-2">
                  <div>
                    <span class="text-xs font-bold text-gray-800 block">${opt}</span>
                    <span class="text-[10px] text-gray-400">بالمحل: ${shopStock}</span>
                  </div>
                  <div class="flex items-center gap-1.5">
                    <span class="text-[11px] text-blue-700 font-bold">وارد:</span>
                    <input type="number" min="0" value="0"
                      class="aw-var-qty-input w-16 text-center font-bold text-xs border border-blue-300 rounded-lg py-1 focus:outline-none focus:ring-2 focus:ring-blue-400 font-mono bg-white"
                      data-group-name="عام"
                      data-opt-key="${opt.replace(/"/g, '&quot;')}"
                      oninput="onAwVariantQtyChange()"/>
                  </div>
                </div>
              `;
            }).join('')}
          </div>
        </div>
      `;
    }
  }

  // Populate Group select
  if (!groups.length) groups = ['عام', 'الحجم', 'اللون / الشيد'];
  grpSelect.innerHTML = groups.map(g => `<option value="${g}">مجموعة: ${g}</option>`).join('');

  if (hasVariants) {
    varSec.classList.remove('hidden');
    document.getElementById('aw-qty').readOnly = true;
    document.getElementById('aw-qty').classList.add('bg-gray-100');
    document.getElementById('aw-qty').value = '0';
    document.getElementById('aw-var-total-sum').textContent = '0';
  } else {
    varSec.classList.add('hidden');
    document.getElementById('aw-qty').readOnly = false;
    document.getElementById('aw-qty').classList.remove('bg-gray-100');
    document.getElementById('aw-qty').value = '1';
  }
}

function addNewAwVariant() {
  const nameInp = document.getElementById('aw-new-var-name');
  const qtyInp = document.getElementById('aw-new-var-qty');
  const newGrpInp = document.getElementById('aw-new-group-name');
  const grpSelect = document.getElementById('aw-var-group-select');

  const optName = (nameInp.value || '').trim();
  const optQty = Math.max(1, parseInt(qtyInp.value || 1, 10));
  let targetGroup = (newGrpInp.value || '').trim() || grpSelect.value || 'عام';

  if (!optName) {
    nameInp.focus();
    return;
  }

  const varSec = document.getElementById('aw-variants-section');
  const varGrid = document.getElementById('aw-variants-grid');
  varSec.classList.remove('hidden');

  // If new group, add to select options
  if (newGrpInp.value && newGrpInp.value.trim()) {
    const existingOpt = Array.from(grpSelect.options).find(o => o.value === targetGroup);
    if (!existingOpt) {
      const o = document.createElement('option');
      o.value = targetGroup;
      o.textContent = `مجموعة: ${targetGroup}`;
      o.selected = true;
      grpSelect.appendChild(o);
    }
    newGrpInp.value = '';
  }

  // Find or create group container in grid
  let grpContainer = document.getElementById(`grp-grid-${CSS.escape(targetGroup)}`);
  if (!grpContainer) {
    const grpCard = document.createElement('div');
    grpCard.className = 'bg-white p-3 rounded-2xl border border-blue-200 shadow-sm space-y-2 animate-in fade-in duration-150';
    grpCard.innerHTML = `
      <div class="text-xs font-bold text-blue-900 border-b border-gray-100 pb-1.5 flex items-center gap-1">
        <span class="text-blue-600">📂</span> مجموعة: ${targetGroup}
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2" id="grp-grid-${targetGroup.replace(/"/g, '&quot;')}"></div>
    `;
    varGrid.appendChild(grpCard);
    grpContainer = grpCard.querySelector(`[id="grp-grid-${targetGroup}"]`);
  }

  // Check if option already exists in this group
  const existingInp = grpContainer.querySelector(`.aw-var-qty-input[data-opt-key="${CSS.escape(optName)}"]`);
  if (existingInp) {
    existingInp.value = parseInt(existingInp.value || 0, 10) + optQty;
    nameInp.value = '';
    onAwVariantQtyChange();
    existingInp.focus();
    return;
  }

  // Create new card
  const card = document.createElement('div');
  card.className = 'bg-emerald-50/70 p-2.5 rounded-xl border border-emerald-300 flex items-center justify-between gap-2 shadow-sm animate-in fade-in duration-150';
  card.innerHTML = `
    <div>
      <span class="text-xs font-bold text-emerald-900 block flex items-center gap-1">✨ ${optName}</span>
      <span class="text-[10px] text-emerald-700 font-semibold">مضاف حديثاً</span>
    </div>
    <div class="flex items-center gap-1.5">
      <span class="text-[11px] text-blue-700 font-bold">وارد:</span>
      <input type="number" min="0" value="${optQty}"
        class="aw-var-qty-input w-16 text-center font-bold text-xs border border-emerald-400 rounded-lg py-1 focus:outline-none focus:ring-2 focus:ring-emerald-400 font-mono bg-white"
        data-group-name="${targetGroup.replace(/"/g, '&quot;')}"
        data-opt-key="${optName.replace(/"/g, '&quot;')}"
        oninput="onAwVariantQtyChange()"/>
      <button type="button" onclick="this.closest('div.bg-emerald-50\\/70').remove(); onAwVariantQtyChange();" class="text-gray-400 hover:text-red-600 text-sm px-1">✕</button>
    </div>
  `;
  grpContainer.appendChild(card);

  nameInp.value = '';
  document.getElementById('aw-qty').readOnly = true;
  document.getElementById('aw-qty').classList.add('bg-gray-100');
  onAwVariantQtyChange();
}

function onAwVariantQtyChange() {
  const inputs = document.querySelectorAll('.aw-var-qty-input');
  let total = 0;
  inputs.forEach(inp => {
    total += Math.max(0, parseInt(inp.value || 0, 10));
  });
  document.getElementById('aw-qty').value = total;
  document.getElementById('aw-var-total-sum').textContent = total;
}

function clearSelectedShopProduct() {
  _selectedShopProd = null;
  document.getElementById('aw-shop-prod-id').value = '';
  document.getElementById('aw-selected-badge').classList.add('hidden');
  document.getElementById('aw-variants-section').classList.add('hidden');
  document.getElementById('aw-search-input').value = '';
  document.getElementById('aw-qty').readOnly = false;
  document.getElementById('aw-qty').classList.remove('bg-gray-100');
}

async function submitAddWarehouseItem(e) {
  e.preventDefault();
  const errEl = document.getElementById('aw-error');
  errEl.classList.add('hidden');

  const prodId = document.getElementById('aw-shop-prod-id').value || null;
  const name = document.getElementById('aw-name').value;
  const barcode = document.getElementById('aw-barcode').value;
  const category = document.getElementById('aw-category').value;
  const cost = document.getElementById('aw-cost').value;
  const price = document.getElementById('aw-price').value;
  const qty = parseInt(document.getElementById('aw-qty').value || 0, 10);
  const desc = document.getElementById('aw-desc').value;
  const expiry = document.getElementById('aw-expiry').value;
  const notes = document.getElementById('aw-notes').value;

  if (qty <= 0) {
    errEl.textContent = 'يرجى تحديد كمية واردة أكبر من صفر (أدخل الكميات لكل مقاس)';
    errEl.classList.remove('hidden');
    return;
  }

  // Package variants JSON (supports grouped and flat variants)
  let checkboxValuesJson = null;
  const varInputs = document.querySelectorAll('.aw-var-qty-input');
  if (varInputs.length > 0) {
    let baseCbv = {};
    if (_selectedShopProd && _selectedShopProd.checkbox_values) {
      baseCbv = typeof _selectedShopProd.checkbox_values === 'string' ? JSON.parse(_selectedShopProd.checkbox_values) : { ..._selectedShopProd.checkbox_values };
    }
    const isGrouped = Array.from(varInputs).some(i => i.dataset.groupName && i.dataset.groupName !== 'عام');
    
    if (isGrouped) {
      varInputs.forEach(inp => {
        const grp = inp.dataset.groupName || 'عام';
        const k = inp.dataset.optKey;
        const q = parseInt(inp.value || 0, 10);
        if (!baseCbv[grp] || typeof baseCbv[grp] !== 'object') baseCbv[grp] = {};
        baseCbv[grp][k] = { ...(baseCbv[grp][k] || { checked: true }), stock: q, disabled: false };
      });
    } else {
      varInputs.forEach(inp => {
        const k = inp.dataset.optKey;
        const q = parseInt(inp.value || 0, 10);
        baseCbv[k] = { ...(baseCbv[k] || { checked: true }), stock: q, disabled: false };
      });
    }
    checkboxValuesJson = JSON.stringify(baseCbv);
  }

  try {
    const res = await fetch(`${BASE}/api/warehouse/products`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        product_id: prodId ? parseInt(prodId, 10) : null,
        product_name: name,
        barcode,
        category,
        cost_price: parseFloat(cost || 0),
        sale_price: parseFloat(price || 0),
        quantity: qty,
        checkbox_values_json: checkboxValuesJson,
        description: desc,
        expiry_date: expiry || null,
        notes
      })
    });
    const data = await res.json();
    if (!res.ok || data.error) throw new Error(data.error || 'فشل الحفظ في المستودع');

    closeAddWarehouseModal();
    await loadWarehouseData();
    alert('✅ تم حفظ الصنف والشحنة في المستودع بنجاح مع توزيع المجموعات والمقاسات!');
  } catch (err) {
    errEl.textContent = err.message;
    errEl.classList.remove('hidden');
  }
}

