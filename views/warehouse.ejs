}

function closeTransferModal() {
  document.getElementById('transferModal').classList.add('hidden');
}

function chgTrQty(delta) {
  const inp = document.getElementById('trQuantityInput');
  let cur = parseInt(inp.value || 0, 10);
  cur = Math.max(1, Math.min(_maxAvailTr, cur + delta));
  inp.value = cur;
}

function setTrAll() {
  document.getElementById('trQuantityInput').value = Math.max(1, _maxAvailTr);
}

function validateTrQtyInput() {
  const inp = document.getElementById('trQuantityInput');
  let val = parseInt(inp.value || 0, 10);
  if (val > _maxAvailTr) inp.value = _maxAvailTr;
  if (val < 1) inp.value = 1;
}

async function confirmTransferToStore() {
  const errEl = document.getElementById('trError');
  errEl.classList.add('hidden');
  const btn = document.getElementById('trConfirmBtn');
  btn.disabled = true;

  const qty = parseInt(document.getElementById('trQuantityInput').value || 0, 10);
  const note = document.getElementById('trNoteInput').value;
  const batchId = document.getElementById('tr-batch-select').value || null;

  try {
    const res = await fetch(`${BASE}/api/warehouse/transfer`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        warehouse_item_id: _currentTrItem.id,
        quantity: qty,
        selected_option: _currentTrSizeKey,
        batch_id: batchId ? parseInt(batchId, 10) : null,
        note
      })
    });
    const data = await res.json();
    if (!res.ok || data.error) throw new Error(data.error || 'فشل التحويل');

    closeTransferModal();
    await loadWarehouseData();
    alert(`✅ تم تحويل ${qty} قطعة إلى المحل بنجاح وتحديث الموقع الإلكتروني والتكلفة!`);
  } catch (err) {
    errEl.textContent = err.message;
    errEl.classList.remove('hidden');
  } finally {
    btn.disabled = false;
  }
}

// ── Return to Warehouse Modal ─────────────────────────────────────────────────
function openReturnFromStoreModal() {
  const sel = document.getElementById('ret-prod-select');
  sel.innerHTML = '<option value="">-- اختر الصنف من المحل --</option>' +
    _shopProducts.map(p => `<option value="${p.id}">${p.product_name} (رصيد المحل: ${p.quantity||0})</option>`).join('');
  
  document.getElementById('ret-avail-shop').textContent = '0';
  document.getElementById('ret-qty').value = '1';
  document.getElementById('ret-reason').value = '';
  document.getElementById('ret-error').classList.add('hidden');
  document.getElementById('ret-variant-container').classList.add('hidden');
  document.getElementById('returnModal').classList.remove('hidden');
}

function closeReturnModal() {
  document.getElementById('returnModal').classList.add('hidden');
}

let _retSelectedOption = null;
function onReturnProductSelect() {
  const pId = parseInt(document.getElementById('ret-prod-select').value || 0, 10);
  const prod = _shopProducts.find(p => p.id === pId);
  const vCont = document.getElementById('ret-variant-container');
  const vList = document.getElementById('ret-variant-list');
  _retSelectedOption = null;

  if (!prod) {
    document.getElementById('ret-avail-shop').textContent = '0';
    vCont.classList.add('hidden');
    return;
  }

  document.getElementById('ret-avail-shop').textContent = prod.quantity || 0;

  if (prod.checkbox_values) {
    const cbv = typeof prod.checkbox_values === 'string' ? JSON.parse(prod.checkbox_values) : prod.checkbox_values;
    const opts = Object.keys(cbv);
    if (opts.length > 0) {
      vCont.classList.remove('hidden');
      vList.innerHTML = opts.map((o, idx) => `
        <button type="button" onclick="selectRetVariant('${o}', ${cbv[o].stock||0})" id="ret-opt-${idx}"
          class="ret-opt-btn px-3 py-1.5 rounded-xl border text-xs font-bold transition-all ${idx === 0 ? 'bg-amber-600 text-white border-amber-600' : 'bg-gray-50 text-gray-700 border-gray-200'}">
          ${o} (${cbv[o].stock||0})
        </button>
      `).join('');
      _retSelectedOption = opts[0];
      document.getElementById('ret-avail-shop').textContent = cbv[opts[0]].stock != null ? cbv[opts[0]].stock : prod.quantity;
      return;
    }
  }
  vCont.classList.add('hidden');
}

function selectRetVariant(opt, stock) {
  _retSelectedOption = opt;
  document.getElementById('ret-avail-shop').textContent = stock;
  document.querySelectorAll('.ret-opt-btn').forEach(b => {
    b.className = b.textContent.includes(opt)
      ? 'ret-opt-btn px-3 py-1.5 rounded-xl border text-xs font-bold transition-all bg-amber-600 text-white border-amber-600'
      : 'ret-opt-btn px-3 py-1.5 rounded-xl border text-xs font-bold transition-all bg-gray-50 text-gray-700 border-gray-200';
  });
}

async function submitReturnToWarehouse(e) {
  e.preventDefault();
  const errEl = document.getElementById('ret-error');
  errEl.classList.add('hidden');

  const pId = parseInt(document.getElementById('ret-prod-select').value || 0, 10);
  const qty = parseInt(document.getElementById('ret-qty').value || 0, 10);
  const reason = document.getElementById('ret-reason').value;

  try {
    const res = await fetch(`${BASE}/api/warehouse/return-from-store`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        product_id: pId,
        quantity: qty,
        selected_option: _retSelectedOption,
        reason
      })
    });
    const data = await res.json();
    if (!res.ok || data.error) throw new Error(data.error || 'فشل الإرجاع للمستودع');

    closeReturnModal();
    await loadWarehouseData();
    alert(`✅ تم إرجاع ${qty} قطعة من المحل إلى المستودع بنجاح!`);
  } catch (err) {
    errEl.textContent = err.message;
    errEl.classList.remove('hidden');
  }
}

function closeVariantCompareModal() {
  document.getElementById('variantCompareModal').classList.add('hidden');
}

function quickTransferSpecificVariant(itemId, optKey, availWh) {
  closeVariantCompareModal();
  openTransferModal(itemId);
  setTimeout(() => {
    selectTrVariant(optKey, availWh);
  }, 100);
}

document.addEventListener('DOMContentLoaded', loadWarehouseData);
</script>

