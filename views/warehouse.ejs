// ── Warehouse Batches Interactive Management Handlers ────────────────────────
async function loadAndRenderWhBatches(itemId) {
  const container = document.getElementById('ew-batches-list');
  const badge = document.getElementById('ew-batches-count-badge');
  if (!container) return;
  container.innerHTML = '<div class="text-center py-3 text-xs text-indigo-500 font-medium">جارٍ تحميل قائمة الشحنات...</div>';

  try {
    const res = await fetch(`${BASE}/api/warehouse/items/${itemId}/batches`);
    const data = await res.json();
    const batches = data.batches || [];

    if (badge) badge.textContent = `${batches.length} شحنات`;

    if (batches.length === 0) {
      container.innerHTML = `<div class="p-3 text-xs text-gray-400 text-center bg-white/60 rounded-xl border border-dashed border-indigo-200">لا توجد شحنات فرعية مسجلة (يمكنك إضافة شحنة جديدة أدناه)</div>`;
      return;
    }

    container.innerHTML = batches.map((b, idx) => {
      const isLatest = idx === batches.length - 1;
      const bNum = b.batch_number || `شحنة #${b.id}`;
      const bCost = parseFloat(b.cost_price || 0).toFixed(2);
      const bQty = parseInt(b.quantity || 0, 10);
      const bExp = b.expiry_date || '';
      const bNotes = b.notes || '';

      return `
        <div id="wh-batch-card-${b.id}" class="bg-white p-3 rounded-2xl border border-indigo-200 shadow-sm space-y-2.5 transition-all">
          <div class="flex items-center justify-between border-b border-gray-100 pb-1.5">
            <div class="flex items-center gap-1.5">
              <span class="text-base">${isLatest ? '🟢' : '📦'}</span>
              <span class="font-bold text-xs text-gray-800">${bNum}</span>
              ${isLatest ? '<span class="text-[10px] bg-emerald-100 text-emerald-800 font-bold px-1.5 py-0.5 rounded">الشحنة الأخيرة</span>' : ''}
            </div>
            <div class="flex items-center gap-1.5">
              <button type="button" onclick="updateWhBatch(${b.id})" 
                class="bg-indigo-50 hover:bg-indigo-100 text-indigo-700 font-bold px-2.5 py-1 rounded-lg text-xs border border-indigo-200 transition-all flex items-center gap-1 shadow-sm">
                <span>💾</span> حفظ التعديل
              </button>
              <button type="button" onclick="deleteWhBatch(${b.id})"
                class="bg-red-50 hover:bg-red-100 text-red-600 font-bold px-2.5 py-1 rounded-lg text-xs border border-red-200 transition-all flex items-center gap-1">
                <span>🗑️</span> حذف
              </button>
            </div>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-xs">
            <div>
              <label class="text-[10px] font-bold text-gray-500 block mb-0.5">عنوان الشحنة</label>
              <input id="wb-num-${b.id}" type="text" value="${bNum.replace(/"/g, '&quot;')}"
                class="w-full border border-gray-200 rounded-lg px-2 py-1 text-xs font-bold text-gray-800 focus:ring-2 focus:ring-indigo-400 bg-gray-50/50"/>
            </div>
            <div>
              <label class="text-[10px] font-bold text-gray-500 block mb-0.5">الكمية</label>
              <input id="wb-qty-${b.id}" type="number" min="0" value="${bQty}"
                class="w-full border border-gray-200 rounded-lg px-2 py-1 text-xs text-center font-bold text-blue-700 focus:ring-2 focus:ring-indigo-400 font-mono"/>
            </div>
            <div>
              <label class="text-[10px] font-bold text-gray-500 block mb-0.5">سعر التكلفة (ج)</label>
              <input id="wb-cost-${b.id}" type="number" min="0" step="0.01" value="${bCost}"
                class="w-full border border-gray-200 rounded-lg px-2 py-1 text-xs text-center font-bold text-amber-700 focus:ring-2 focus:ring-indigo-400 font-mono"/>
            </div>
            <div>
              <label class="text-[10px] font-bold text-gray-500 block mb-0.5">الصلاحية</label>
              <input id="wb-exp-${b.id}" type="date" value="${bExp}"
                class="w-full border border-gray-200 rounded-lg px-2 py-1 text-xs focus:ring-2 focus:ring-indigo-400 font-mono"/>
            </div>
          </div>

          <div>
            <input id="wb-notes-${b.id}" type="text" value="${bNotes.replace(/"/g, '&quot;')}" placeholder="ملاحظات الشحنة..."
              class="w-full border border-gray-200 rounded-lg px-2.5 py-1 text-xs text-gray-600 focus:ring-2 focus:ring-indigo-400 bg-gray-50/30"/>
          </div>
        </div>
      `;
    }).join('');
  } catch (err) {
    container.innerHTML = `<div class="p-3 text-xs text-red-500 text-center">فشل تحميل الشحنات: ${err.message}</div>`;
  }
}

async function updateWhBatch(batchId) {
  const num = document.getElementById(`wb-num-${batchId}`)?.value;
  const qty = parseInt(document.getElementById(`wb-qty-${batchId}`)?.value || 0, 10);
  const cost = parseFloat(document.getElementById(`wb-cost-${batchId}`)?.value || 0);
  const exp = document.getElementById(`wb-exp-${batchId}`)?.value;
  const notes = document.getElementById(`wb-notes-${batchId}`)?.value;

  try {
    const res = await fetch(`${BASE}/api/warehouse/batches/${batchId}`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ batch_number: num, quantity: qty, cost_price: cost, expiry_date: exp, notes })
    });
    const data = await res.json();
    if (!res.ok || data.error) throw new Error(data.error || 'فشل تحديث الشحنة');

    if (data.total_quantity != null) {
      document.getElementById('ew-qty').value = data.total_quantity;
    }
    await loadWarehouseData();
    alert('✅ تم تعديل بيانات الشحنة بنجاح وتحديث إجمالي رصيد المستودع!');
    if (_currentEditingWhItem) loadAndRenderWhBatches(_currentEditingWhItem.id);
  } catch (err) {
    alert('❌ خطأ: ' + err.message);
  }
}

async function deleteWhBatch(batchId) {
  if (!confirm('هل أنت متأكد من حذف هذه الشحنة نهائياً من المستودع؟')) return;

  try {
    const res = await fetch(`${BASE}/api/warehouse/batches/${batchId}`, {
      method: 'DELETE'
    });
    const data = await res.json();
    if (!res.ok || data.error) throw new Error(data.error || 'فشل حذف الشحنة');

    if (data.total_quantity != null) {
      document.getElementById('ew-qty').value = data.total_quantity;
    }
    await loadWarehouseData();
    alert('🗑️ تم حذف الشحنة بنجاح وتحديث رصيد المستودع!');
    if (_currentEditingWhItem) loadAndRenderWhBatches(_currentEditingWhItem.id);
  } catch (err) {
    alert('❌ خطأ: ' + err.message);
  }
}

