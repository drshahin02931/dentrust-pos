    const res = await fetch(`${BASE}/api/warehouse/items/${_currentEditingWhItem.id}/batches`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ batch_number: num, quantity: qty, cost_price: cost, expiry_date: exp, notes })
    });
