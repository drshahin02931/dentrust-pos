async function submitEditWarehouseItem(e) {
  e.preventDefault();
  if (!_currentEditingWhItem) return;
  const errEl = document.getElementById('ew-error');
  errEl.classList.add('hidden');

  const itemId = _currentEditingWhItem.id;
  const name = document.getElementById('ew-name').value;
  const barcode = document.getElementById('ew-barcode').value;
  const category = document.getElementById('ew-category').value;
  const cost = document.getElementById('ew-cost').value;
  const price = document.getElementById('ew-price').value;
  const qty = parseInt(document.getElementById('ew-qty').value || 0, 10);
  const desc = document.getElementById('ew-desc').value;
  const expiry = document.getElementById('ew-expiry').value;
  const notes = document.getElementById('ew-notes').value;

  // Package remaining variants (excluding deleted ones!)
  let checkboxValuesJson = null;
  const varInputs = document.querySelectorAll('.ew-var-qty-input');
  if (varInputs.length > 0) {
    let baseCbv = {};
    const isGrouped = Array.from(varInputs).some(i => i.dataset.groupName && i.dataset.groupName !== 'عام');
    if (isGrouped) {
      varInputs.forEach(inp => {
        const grp = inp.dataset.groupName || 'عام';
        const k = inp.dataset.optKey;
        const q = parseInt(inp.value || 0, 10);
        if (!baseCbv[grp]) baseCbv[grp] = {};
        baseCbv[grp][k] = { checked: true, stock: q, disabled: false };
      });
    } else {
      varInputs.forEach(inp => {
        const k = inp.dataset.optKey;
        const q = parseInt(inp.value || 0, 10);
        baseCbv[k] = { checked: true, stock: q, disabled: false };
      });
    }
    checkboxValuesJson = JSON.stringify(baseCbv);
  }

  try {
    const res = await fetch(`${BASE}/api/warehouse/products/${itemId}`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        product_name: name,
        barcode,
        category,
        cost_price: parseFloat(cost || 0),
        sale_price: parseFloat(price || 0),
        quantity: qty,
        checkbox_values_json: checkboxValuesJson,
        description: desc,
        expiry_date: expiry || null,
        notes
      })
    });
    const data = await res.json();
    if (!res.ok || data.error) throw new Error(data.error || 'فشل تحديث المستودع');

    closeEditWarehouseModal();
    await loadWarehouseData();
    alert('✅ تم حفظ تعديلات الصنف والمقاسات بالمستودع بنجاح!');
  } catch (err) {
    errEl.textContent = err.message;
    errEl.classList.remove('hidden');
  }
}

