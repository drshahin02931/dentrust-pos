<%- include('partials/header', Object.assign({pageTitle: 'رسائل الواتساب'}, locals)) %>
<div class="max-w-3xl mx-auto space-y-6">

  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold text-gray-800">📱 إعدادات رسائل الواتساب</h1>
    <a href="<%- base %>/website-orders" class="text-sm text-blue-600 hover:underline">← طلبات الموقع</a>
  </div>

  <div class="bg-blue-50 border border-blue-200 rounded-2xl px-5 py-4 text-sm text-blue-800">
    <strong>البلاسهولدرز المتاحة في كل رسالة:</strong><br/>
    <code class="bg-blue-100 px-1 rounded">{name}</code> اسم العميل &nbsp;|&nbsp;
    <code class="bg-blue-100 px-1 rounded">{total}</code> إجمالي الطلب &nbsp;|&nbsp;
    <code class="bg-blue-100 px-1 rounded">{tracking}</code> رقم التتبع (حالة شحن فقط) &nbsp;|&nbsp;
    <code class="bg-blue-100 px-1 rounded">{reason}</code> سبب الإلغاء (حالة إلغاء فقط)
  </div>

  <!-- Admin Phones & Gateway Configuration Card -->
  <div class="bg-gradient-to-br from-emerald-50/70 to-teal-50/50 border border-emerald-200 rounded-2xl p-5 shadow-sm space-y-4">
    <div class="flex items-center justify-between border-b border-emerald-200/70 pb-3">
      <div class="flex items-center gap-2">
        <span class="text-2xl">🔔</span>
        <div>
          <h2 class="text-base font-bold text-gray-800">أرقام الإدارة الـ 5 المعتمدة للتنبيهات الفورية</h2>
          <p class="text-xs text-gray-500">تصلها رسالة واتساب تفصيلية فورية لكل طلب جديد يتم على الموقع</p>
        </div>
      </div>
      <span class="bg-emerald-100 text-emerald-800 text-xs font-bold px-3 py-1 rounded-full border border-emerald-200">5 أرقام مفعلة ✅</span>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-2 text-center text-xs font-mono font-bold">
      <div class="bg-white border border-emerald-200 rounded-xl py-2 px-1 text-emerald-900 shadow-sm">01157004081</div>
      <div class="bg-white border border-emerald-200 rounded-xl py-2 px-1 text-emerald-900 shadow-sm">01123144277</div>
      <div class="bg-white border border-emerald-200 rounded-xl py-2 px-1 text-emerald-900 shadow-sm">01123144288</div>
      <div class="bg-white border border-emerald-200 rounded-xl py-2 px-1 text-emerald-900 shadow-sm">01014067776</div>
      <div class="bg-white border border-emerald-200 rounded-xl py-2 px-1 text-emerald-900 shadow-sm">01011222763</div>
    </div>

    <!-- Gateway API Configuration -->
    <div class="border-t border-emerald-200/70 pt-3 space-y-3">
      <div class="text-xs font-bold text-gray-700 flex items-center justify-between">
        <span>⚙️ إعدادات بوابة الإرسال التلقائي (UltraMsg / WhatsApp Gateway):</span>
        <span class="text-[11px] text-gray-400 font-normal">ربط رقم الشركة عبر QR Code</span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div>
          <label class="block text-[11px] font-semibold text-gray-600 mb-1">Instance ID</label>
          <input type="text" id="cfg-instance-id" placeholder="مثال: instance12345"
            class="w-full border rounded-xl px-3 py-2 text-xs font-mono focus:outline-none focus:ring-2 focus:ring-emerald-300 bg-white"/>
        </div>
        <div>
          <label class="block text-[11px] font-semibold text-gray-600 mb-1">API Token</label>
          <input type="password" id="cfg-token" placeholder="رمز الأمان (Token)"
            class="w-full border rounded-xl px-3 py-2 text-xs font-mono focus:outline-none focus:ring-2 focus:ring-emerald-300 bg-white"/>
        </div>
      </div>
      <div class="flex gap-2">
        <button type="button" onclick="saveGatewayConfig()" id="saveCfgBtn"
          class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-4 py-2 rounded-xl text-xs shadow-sm transition-all">
          💾 حفظ إعدادات البوابة
        </button>
        <button type="button" onclick="sendTestWhatsApp()" id="testWaBtn"
          class="bg-white hover:bg-gray-50 border border-emerald-300 text-emerald-800 font-bold px-4 py-2 rounded-xl text-xs shadow-sm transition-all">
          🧪 إرسال رسالة تجريبية الآن
        </button>
      </div>
      <div id="cfgFeedback" class="hidden text-xs font-bold rounded-lg px-3 py-2 text-center"></div>
    </div>
  </div>

  <div id="saveMsg" class="hidden rounded-xl px-4 py-3 text-sm font-semibold text-center"></div>

  <form id="templatesForm" class="space-y-5">

    <% const statuses = [
      { key: 'pending',   label: '⏳ انتظار', color: 'yellow' },
      { key: 'confirmed', label: '✅ مؤكد',   color: 'green'  },
      { key: 'shipped',   label: '🚚 شحن',    color: 'blue'   },
      { key: 'delivered', label: '📦 تسليم',  color: 'purple' },
      { key: 'cancelled', label: '❌ إلغاء',  color: 'red'    },
    ]; %>

    <% statuses.forEach(s => { %>
    <div class="bg-white rounded-2xl border shadow-sm overflow-hidden">
      <div class="px-5 py-3 border-b bg-gray-50 flex items-center justify-between">
        <span class="font-bold text-gray-700 text-sm"><%= s.label %></span>
        <button type="button" onclick="resetTemplate('<%= s.key %>')"
          class="text-xs text-gray-400 hover:text-gray-600">↺ إعادة للافتراضي</button>
      </div>
      <div class="p-4">
        <textarea name="<%= s.key %>" id="tmpl-<%= s.key %>" rows="5"
          class="w-full border rounded-xl px-3 py-2.5 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-blue-200 resize-y"
          placeholder="نص الرسالة..."></textarea>
        <div class="mt-2 flex gap-2">
          <button type="button" onclick="previewMsg('<%= s.key %>')"
            class="text-xs bg-gray-100 hover:bg-gray-200 text-gray-700 px-3 py-1.5 rounded-lg font-medium">👁️ معاينة</button>
          <div id="preview-<%= s.key %>" class="hidden text-xs text-gray-500 bg-gray-50 rounded-lg px-3 py-2 flex-1 whitespace-pre-wrap font-mono"></div>
        </div>
      </div>
    </div>
    <% }) %>

    <div class="flex gap-3 pb-6">
      <button type="submit" id="saveBtn"
        class="flex-1 bg-blue-700 hover:bg-blue-800 text-white font-bold py-3 rounded-2xl text-sm transition-all">
        💾 حفظ كل الرسائل
      </button>
      <button type="button" onclick="resetAll()"
        class="bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold py-3 px-5 rounded-2xl text-sm">
        إعادة كل الافتراضيات
      </button>
    </div>
  </form>
</div>

<script>
const BASE = "<%- base %>";

const DEFAULTS = {
  pending:   'مرحباً {name} 👋\nتم استلام طلبك بنجاح وجارٍ مراجعته.\nإجمالي الطلب: {total} ج.م\nسنتواصل معك قريباً.\n\n— دينتراست 🌸',
  confirmed: 'مرحباً {name} ✅\nتم تأكيد طلبك وجارٍ التجهيز للشحن.\nإجمالي الطلب: {total} ج.م\nشكراً لثقتك فينا!\n\n— دينتراست 🌸',
  shipped:   'مرحباً {name} 🚚\nطلبك في الطريق إليك الآن!\nإجمالي الطلب: {total} ج.م\n{tracking}نراك قريباً 😊\n\n— دينتراست 🌸',
  delivered: 'مرحباً {name} 📦\nتم توصيل طلبك بنجاح!\nنتمنى أن تكون سعيداً بمنتجاتك.\nشاركنا رأيك وساعد الآخرين 🌟\n\n— دينتراست 🌸',
  cancelled: 'مرحباً {name}\nنأسف، تم إلغاء طلبك.\n{reason}للاستفسار تواصل معنا.\n\n— دينتراست 🌸',
};

async function loadTemplates() {
  try {
    const data = await fetch(`${BASE}/api/settings/whatsapp-templates`).then(r => r.json());
    for (const [k, v] of Object.entries(data)) {
      const el = document.getElementById(`tmpl-${k}`);
      if (el) el.value = v;
    }
  } catch(e) {
    // fill with defaults on error
    for (const [k, v] of Object.entries(DEFAULTS)) {
      const el = document.getElementById(`tmpl-${k}`);
      if (el && !el.value) el.value = v;
    }
  }
}

function resetTemplate(key) {
  const el = document.getElementById(`tmpl-${key}`);
  if (el && DEFAULTS[key]) {
    el.value = DEFAULTS[key];
    el.classList.add('ring-2','ring-yellow-300');
    setTimeout(() => el.classList.remove('ring-2','ring-yellow-300'), 800);
  }
}

function resetAll() {
  if (!confirm('إعادة كل الرسائل للنصوص الافتراضية؟')) return;
  for (const k of Object.keys(DEFAULTS)) resetTemplate(k);
}

function previewMsg(key) {
  const el  = document.getElementById(`tmpl-${key}`);
  const pre = document.getElementById(`preview-${key}`);
  const txt = (el?.value || '').replace(/{name}/g, 'محمد أحمد')
    .replace(/{total}/g, '٣٥٠')
    .replace(/{tracking}/g, 'رقم التتبع: EG123456\n')
    .replace(/{reason}/g, 'السبب: العميل طلب الإلغاء\n');
  pre.textContent = txt;
  pre.classList.toggle('hidden');
}

document.getElementById('templatesForm').addEventListener('submit', async e => {
  e.preventDefault();
  const btn  = document.getElementById('saveBtn');
  const msg  = document.getElementById('saveMsg');
  btn.disabled = true; btn.textContent = '...';
  const body = {};
  ['pending','confirmed','shipped','delivered','cancelled'].forEach(k => {
    const el = document.getElementById(`tmpl-${k}`);
    if (el) body[k] = el.value;
  });
  try {
    const res = await fetch(`${BASE}/api/settings/whatsapp-templates`, {
      method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body)
    });
    const data = await res.json();
    if (res.ok) {
      msg.className = 'rounded-xl px-4 py-3 text-sm font-semibold text-center bg-green-50 text-green-700 border border-green-200';
      msg.textContent = '✅ تم حفظ الرسائل بنجاح!';
    } else {
      msg.className = 'rounded-xl px-4 py-3 text-sm font-semibold text-center bg-red-50 text-red-700 border border-red-200';
      msg.textContent = data.error || 'حدث خطأ';
    }
  } catch(_) {
    msg.className = 'rounded-xl px-4 py-3 text-sm font-semibold text-center bg-red-50 text-red-700 border border-red-200';
    msg.textContent = 'حدث خطأ في الاتصال';
  }
  msg.classList.remove('hidden');
  btn.disabled = false; btn.textContent = '💾 حفظ كل الرسائل';
  setTimeout(() => msg.classList.add('hidden'), 4000);
});

async function loadGatewayConfig() {
  try {
    const res = await fetch(`${BASE}/api/settings/whatsapp-config`);
    const data = await res.json();
    if (data.instance_id) document.getElementById('cfg-instance-id').value = data.instance_id;
    if (data.token) document.getElementById('cfg-token').value = data.token;
  } catch (_) {}
}

async function saveGatewayConfig() {
  const instance_id = document.getElementById('cfg-instance-id').value.trim();
  const token = document.getElementById('cfg-token').value.trim();
  const btn = document.getElementById('saveCfgBtn');
  const fb = document.getElementById('cfgFeedback');
  btn.disabled = true; btn.textContent = '⏳ جاري الحفظ...';

  try {
    const res = await fetch(`${BASE}/api/settings/whatsapp-config`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ instance_id, token })
    });
    const data = await res.json();
    fb.classList.remove('hidden');
    if (res.ok && data.ok) {
      fb.className = 'text-xs font-bold rounded-lg px-3 py-2 text-center bg-emerald-100 text-emerald-800 border border-emerald-300';
      fb.textContent = '✅ تم حفظ إعدادات بوابة الواتساب بنجاح!';
    } else {
      fb.className = 'text-xs font-bold rounded-lg px-3 py-2 text-center bg-red-100 text-red-800 border border-red-300';
      fb.textContent = '❌ ' + (data.error || 'فشل الحفظ');
    }
  } catch (e) {
    fb.className = 'text-xs font-bold rounded-lg px-3 py-2 text-center bg-red-100 text-red-800 border border-red-300';
    fb.textContent = '❌ تعذر الاتصال بالسيرفر';
    fb.classList.remove('hidden');
  } finally {
    btn.disabled = false; btn.textContent = '💾 حفظ إعدادات البوابة';
    setTimeout(() => fb.classList.add('hidden'), 4000);
  }
}

async function sendTestWhatsApp() {
  const btn = document.getElementById('testWaBtn');
  const fb = document.getElementById('cfgFeedback');
  btn.disabled = true; btn.textContent = '⏳ جارٍ إرسال التجربة...';

  try {
    const res = await fetch(`${BASE}/api/settings/whatsapp-test`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({})
    });
    const data = await res.json();
    fb.classList.remove('hidden');
    if (data.ok) {
      fb.className = 'text-xs font-bold rounded-lg px-3 py-2 text-center bg-emerald-100 text-emerald-800 border border-emerald-300';
      fb.textContent = '✅ تم إرسال الرسالة التجريبية بنجاح! راجع رقم 01157004081 على واتساب';
    } else {
      fb.className = 'text-xs font-bold rounded-lg px-3 py-2 text-center bg-amber-100 text-amber-800 border border-amber-300';
      fb.textContent = '⚠️ لم يتم الإرسال: تأكد من إدخال الـ Instance ID والـ Token الصحيحين للبوابة';
    }
  } catch (e) {
    fb.className = 'text-xs font-bold rounded-lg px-3 py-2 text-center bg-red-100 text-red-800 border border-red-300';
    fb.textContent = '❌ خطأ: ' + e.message;
    fb.classList.remove('hidden');
  } finally {
    btn.disabled = false; btn.textContent = '🧪 إرسال رسالة تجريبية الآن';
  }
}

loadTemplates();
loadGatewayConfig();
</script>

</main>
<%- include('partials/footer', locals) %>
