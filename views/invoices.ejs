    <div class="flex gap-2 pt-1">
      <button id="editPricesSaveBtn" onclick="saveEditPrices()" class="flex-1 bg-yellow-500 hover:bg-yellow-600 text-white font-bold py-2.5 rounded-xl text-sm">حفظ</button>
      <button onclick="closeEditPrices()" class="px-5 bg-gray-100 hover:bg-gray-200 text-gray-600 font-bold py-2.5 rounded-xl text-sm">إلغاء</button>
    </div>
  </div>
</div>

</main>
