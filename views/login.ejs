<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>تسجيل الدخول — DenTrust POS</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['Segoe UI', 'Arial', 'sans-serif'] },
          colors: {
            blue: {
              50: '#f7f4f9', 100: '#eee7f4', 200: '#dacce8', 300: '#bca2d6',
              400: '#936bbd', 500: '#6d399c', 600: '#521959', 700: '#3b1859',
              800: '#211c54', 900: '#121d4d', 950: '#0a1030'
            }
          }
        }
      }
    };
  </script>
</head>
<body class="min-h-screen flex items-center justify-center p-4" style="background: linear-gradient(135deg, #0d1e5c 0%, #4e1856 52%, #7f132a 100%);">
  <div class="w-full max-w-sm">
    <div class="text-center mb-6">
      <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-white/10 border border-white/20 backdrop-blur-sm shadow-lg mb-3 text-3xl">🦷</div>
      <h1 class="text-3xl font-black text-white tracking-wide" dir="ltr">DenTrust</h1>
      <p class="text-purple-200 text-[11px] font-bold tracking-[0.25em] uppercase mt-1" dir="ltr">ROOTED IN QUALITY</p>
    </div>

    <div class="relative bg-white rounded-3xl shadow-2xl p-8 overflow-hidden border border-white/20">
      <div class="absolute inset-y-6 left-0 w-2 rounded-r-full" style="background: linear-gradient(180deg, #10246b 0%, #521959 55%, #83142c 100%);"></div>
      <div class="absolute inset-y-6 right-0 w-2 rounded-l-full" style="background: linear-gradient(180deg, #83142c 0%, #521959 55%, #10246b 100%);"></div>
      <% if (error) { %>
      <div class="bg-red-50 border border-red-200 text-red-700 rounded-xl px-4 py-3 text-sm mb-5 flex items-center gap-2">
        <span>⚠️</span><span><%- error %></span>
      </div>
      <% } %>

      <form method="POST" action="<%- base %>/login" class="space-y-5">
        <div>
          <label class="text-xs font-bold text-gray-600 block mb-1.5">اسم المستخدم</label>
          <input name="username" type="text" required autocomplete="username"
            class="w-full border-2 border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-blue-500 transition-colors"
            placeholder="أدخل اسم المستخدم" autofocus/>
        </div>
        <div>
          <label class="text-xs font-bold text-gray-600 block mb-1.5">كلمة المرور</label>
          <input name="password" type="password" required autocomplete="current-password"
            class="w-full border-2 border-gray-200 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-blue-500 transition-colors"
            placeholder="••••••••"/>
        </div>
        <button type="submit"
          class="w-full text-white font-bold py-3 rounded-xl transition-all shadow-md hover:opacity-95 text-sm"
          style="background: linear-gradient(135deg, #10246b 0%, #521959 52%, #83142c 100%);">
          تسجيل الدخول
        </button>
      </form>
    </div>
  </div>
</body>
</html>
