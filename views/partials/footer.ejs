  </main>

  <!-- Change Password Modal -->
  <% if (typeof currentUser !== 'undefined' && currentUser) { %>
  <div id="changePwModal" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-[9999] p-4">
    <div class="bg-white rounded-2xl w-full max-w-sm shadow-2xl">
      <div class="p-5 border-b flex items-center justify-between">
        <h3 class="font-bold text-gray-800">🔑 تغيير كلمة المرور</h3>
        <button onclick="closeChangePw()" class="text-gray-400 hover:text-gray-600 text-2xl leading-none">×</button>
      </div>
      <div class="p-5 space-y-4">
        <div>
          <label class="text-xs font-semibold text-gray-600 block mb-1">كلمة المرور الحالية</label>
          <input id="cpCurrent" type="password" autocomplete="current-password"
            class="w-full border-2 border-gray-200 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:border-blue-400"
            placeholder="••••••••"/>
        </div>
        <div>
          <label class="text-xs font-semibold text-gray-600 block mb-1">كلمة المرور الجديدة</label>
          <input id="cpNew" type="password" autocomplete="new-password"
            class="w-full border-2 border-gray-200 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:border-blue-400"
            placeholder="4 أحرف على الأقل"/>
        </div>
        <div>
          <label class="text-xs font-semibold text-gray-600 block mb-1">تأكيد كلمة المرور الجديدة</label>
          <input id="cpConfirm" type="password" autocomplete="new-password"
            class="w-full border-2 border-gray-200 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:border-blue-400"
            placeholder="••••••••"/>
        </div>
        <div id="cpError" class="hidden bg-red-50 border border-red-200 text-red-700 rounded-xl px-3 py-2 text-sm"></div>
        <div id="cpSuccess" class="hidden bg-green-50 border border-green-200 text-green-700 rounded-xl px-3 py-2 text-sm">✅ تم تغيير كلمة المرور بنجاح</div>
        <div class="flex gap-3">
          <button onclick="submitChangePw()" id="cpSubmitBtn"
            class="flex-1 bg-blue-700 hover:bg-blue-800 text-white font-semibold py-2.5 rounded-xl text-sm">
            حفظ كلمة المرور
          </button>
          <button onclick="closeChangePw()"
            class="flex-1 bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold py-2.5 rounded-xl text-sm">
            إلغاء
          </button>
        </div>
      </div>
    </div>
  </div>
  <script>
  const _BASE_PATH = "<%= base %>";
  function openChangePw() {
    document.getElementById("cpCurrent").value = "";
    document.getElementById("cpNew").value = "";
    document.getElementById("cpConfirm").value = "";
    document.getElementById("cpError").classList.add("hidden");
    document.getElementById("cpSuccess").classList.add("hidden");
    document.getElementById("cpSubmitBtn").disabled = false;
    document.getElementById("changePwModal").classList.remove("hidden");
    setTimeout(() => document.getElementById("cpCurrent").focus(), 100);
  }
  function closeChangePw() {
    document.getElementById("changePwModal").classList.add("hidden");
  }
  async function submitChangePw() {
    const current = document.getElementById("cpCurrent").value;
    const newPw   = document.getElementById("cpNew").value;
    const confirm = document.getElementById("cpConfirm").value;
    const errEl   = document.getElementById("cpError");
    const sucEl   = document.getElementById("cpSuccess");
    errEl.classList.add("hidden");
    sucEl.classList.add("hidden");
    if (!current || !newPw || !confirm) { errEl.textContent = "جميع الحقول مطلوبة"; errEl.classList.remove("hidden"); return; }
    if (newPw.length < 4) { errEl.textContent = "كلمة المرور الجديدة يجب أن تكون 4 أحرف على الأقل"; errEl.classList.remove("hidden"); return; }
    if (newPw !== confirm) { errEl.textContent = "كلمتا المرور الجديدتان غير متطابقتين"; errEl.classList.remove("hidden"); return; }
    const btn = document.getElementById("cpSubmitBtn");
    btn.disabled = true; btn.textContent = "جارٍ الحفظ...";
    try {
      const res = await fetch(`${_BASE_PATH}/api/users/me/password`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        credentials: "include",
        body: JSON.stringify({ current_password: current, new_password: newPw })
      });
      const data = await res.json();
      btn.disabled = false; btn.textContent = "حفظ كلمة المرور";
      if (res.ok) {
        sucEl.classList.remove("hidden");
        setTimeout(closeChangePw, 1800);
      } else {
        errEl.textContent = data.error || "حدث خطأ";
        errEl.classList.remove("hidden");
      }
    } catch(e) {
      btn.disabled = false; btn.textContent = "حفظ كلمة المرور";
      errEl.textContent = "خطأ في الاتصال";
      errEl.classList.remove("hidden");
    }
  }
  document.addEventListener("keydown", e => {
    if (e.key === "Escape" && !document.getElementById("changePwModal").classList.contains("hidden")) closeChangePw();
  });
  </script>
  <% } %>

  <!-- Global Language Toggle Script -->
  <script>
  (function() {
    const LANG_KEY = 'pos_ui_lang';
    let currentLang = localStorage.getItem(LANG_KEY) || 'ar';
    function applyLang(lang) {
      currentLang = lang;
      localStorage.setItem(LANG_KEY, lang);
      const isRtl = lang === 'ar';
      const html = document.getElementById('htmlRoot');
      html.setAttribute('lang', lang);
      html.setAttribute('dir', isRtl ? 'rtl' : 'ltr');
      document.querySelectorAll('[data-ar][data-en]').forEach(el => {
        el.textContent = lang === 'ar' ? el.getAttribute('data-ar') : el.getAttribute('data-en');
      });
      document.querySelectorAll('[data-ar-placeholder][data-en-placeholder]').forEach(el => {
        el.placeholder = lang === 'ar' ? el.getAttribute('data-ar-placeholder') : el.getAttribute('data-en-placeholder');
      });
      const btn = document.getElementById('langBtnText');
      if (btn) btn.textContent = lang === 'ar' ? 'EN' : 'عر';
    }
    window.toggleLang = function() { applyLang(currentLang === 'ar' ? 'en' : 'ar'); };
    window.getCurrentLang = function() { return currentLang; };
    document.addEventListener('DOMContentLoaded', () => applyLang(currentLang));
  })();
  </script>

  <!-- ════════════════ Online Orders Audio & Toast Alert System ════════════════ -->
  <div id="globalOrderToast" class="hidden fixed top-5 left-1/2 -translate-x-1/2 z-[99999] max-w-md w-full px-4 animate-in slide-in-from-top duration-200">
    <div class="bg-gradient-to-r from-orange-600 to-amber-600 text-white rounded-2xl shadow-2xl p-4 border-2 border-white/30 flex items-center gap-3.5 backdrop-blur-md">
      <div class="w-12 h-12 rounded-xl bg-white/20 flex items-center justify-center text-2xl flex-shrink-0 animate-bounce">
        🛒
      </div>
      <div class="flex-1 min-w-0">
        <div class="flex items-center justify-between">
          <span class="font-black text-sm text-yellow-100">وصل طلب جديد من الموقع! 🔔</span>
          <span id="toastTime" class="text-[10px] text-white/80">الآن</span>
        </div>
        <p id="toastCustName" class="text-xs font-bold text-white truncate mt-0.5">عميل جديد</p>
        <p id="toastSummary" class="text-[11px] text-yellow-100 truncate mt-0.5"></p>
      </div>
      <div class="flex flex-col gap-1 flex-shrink-0">
        <a id="toastLink" href="<%= base %>/website-orders" class="bg-white text-orange-700 hover:bg-yellow-50 font-black text-xs px-3 py-1.5 rounded-xl text-center shadow transition-all">
          عرض ↗
        </a>
        <button onclick="dismissGlobalToast()" class="text-white/70 hover:text-white text-[11px] text-center font-bold">
          إغلاق
        </button>
      </div>
    </div>
  </div>

  <!-- Real-time Alerts & Sound Script -->
  <script>
  (function() {
    const BASE_PATH = "<%= base %>";
    let _lastUnseenOrdersCount = null;
    let _audioCtx = null;

    // Web Audio API Ding-Dong Chime Sound Generator (No external audio file needed)
    function playOrderAlertSound() {
      try {
        const AudioCtx = window.AudioContext || window.webkitAudioContext;
        if (!AudioCtx) return;
        if (!_audioCtx) _audioCtx = new AudioCtx();
        if (_audioCtx.state === 'suspended') _audioCtx.resume();

        const notes = [
          { freq: 659.25, time: 0, dur: 0.25 },     // E5
          { freq: 880.00, time: 0.15, dur: 0.35 },  // A5
          { freq: 1174.66, time: 0.30, dur: 0.55 }  // D6 (high joyful chime)
        ];

        notes.forEach(n => {
          const osc = _audioCtx.createOscillator();
          const gain = _audioCtx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(n.freq, _audioCtx.currentTime + n.time);

          gain.gain.setValueAtTime(0.001, _audioCtx.currentTime + n.time);
          gain.gain.exponentialRampToValueAtTime(0.35, _audioCtx.currentTime + n.time + 0.04);
          gain.gain.exponentialRampToValueAtTime(0.001, _audioCtx.currentTime + n.time + n.dur);

          osc.connect(gain);
          gain.connect(_audioCtx.destination);

          osc.start(_audioCtx.currentTime + n.time);
          osc.stop(_audioCtx.currentTime + n.time + n.dur);
        });
      } catch (err) {
        console.warn('Audio alert error:', err);
      }
    }

    // Unlock AudioContext on first user touch/click (browser autoplay policy)
    function unlockAudio() {
      try {
        const AudioCtx = window.AudioContext || window.webkitAudioContext;
        if (AudioCtx && !_audioCtx) {
          _audioCtx = new AudioCtx();
          if (_audioCtx.state === 'suspended') _audioCtx.resume();
        }
      } catch (_) {}
      document.removeEventListener('click', unlockAudio);
      document.removeEventListener('keydown', unlockAudio);
    }
    document.addEventListener('click', unlockAudio, { once: true });
    document.addEventListener('keydown', unlockAudio, { once: true });

    // Show Global Toast for New Orders
    window.showOrderToast = function(orderInfo) {
      const toast = document.getElementById('globalOrderToast');
      if (!toast) return;
      if (orderInfo) {
        document.getElementById('toastCustName').textContent = `👤 ${orderInfo.customer_name || 'عميل'} (${orderInfo.total_amount ? parseFloat(orderInfo.total_amount).toFixed(2)+' ج' : ''})`;
        document.getElementById('toastSummary').textContent = orderInfo.items_summary || 'طلب شراء جديد عبر الموقع الإلكتروني';
      }
      toast.classList.remove('hidden');

      // Auto dismiss after 12 seconds
      clearTimeout(window._toastTimer);
      window._toastTimer = setTimeout(() => {
        dismissGlobalToast();
      }, 12000);
    };

    window.dismissGlobalToast = function() {
      const toast = document.getElementById('globalOrderToast');
      if (toast) toast.classList.add('hidden');
    };

    // Poll for Low Stock & Website Orders
    async function checkAlerts() {
      // 1. Low stock badge
      try {
        const res = await fetch(`${BASE_PATH}/api/products/low-stock`, { credentials: 'include' });
        const items = await res.json();
        const badge = document.getElementById("lowStockBadge");
        if (badge) {
          if (items.length > 0) { badge.textContent = items.length; badge.classList.remove("hidden"); }
          else { badge.classList.add("hidden"); }
        }
      } catch(_) {}

      // 2. Website order alerts (every 12 seconds)
      try {
        const res = await fetch(`${BASE_PATH}/api/website-orders/alerts/count`, { credentials: 'include' });
        const data = await res.json();
        const count = parseInt(data.count || 0, 10);
        const webBadge = document.getElementById("webOrdersBadge");

        if (webBadge) {
          if (count > 0) {
            webBadge.textContent = count;
            webBadge.classList.remove("hidden");
          } else {
            webBadge.classList.add("hidden");
          }
        }

        // New order arrived!
        if (_lastUnseenOrdersCount !== null && count > _lastUnseenOrdersCount) {
          playOrderAlertSound();
          showOrderToast(data.latest);
        }
        _lastUnseenOrdersCount = count;
      } catch(_) {}
    }

    window.refreshAlerts = checkAlerts;
    document.addEventListener('DOMContentLoaded', checkAlerts);
    setInterval(checkAlerts, 12000); // Poll every 12 seconds
  })();
  </script>

  <!-- PWA: Service Worker + Push Notifications -->
  <script>
  (function () {
    if (!('serviceWorker' in navigator) || !('PushManager' in window)) return;

    function urlBase64ToUint8Array(base64String) {
      const padding = '='.repeat((4 - base64String.length % 4) % 4);
      const base64 = (base64String + padding).replace(/\-/g, '+').replace(/_/g, '/');
      const rawData = window.atob(base64);
      const outputArray = new Uint8Array(rawData.length);
      for (let i = 0; i < rawData.length; ++i) {
        outputArray[i] = rawData.charCodeAt(i);
      }
      return outputArray;
    }

    async function initPush() {
      try {
        const reg = await navigator.serviceWorker.register('<%= base %>/sw.js', { scope: '<%= base %>/' });
        if (!('Notification' in window)) return;

        let permission = Notification.permission;
        if (permission === 'default') {
          permission = await Notification.requestPermission();
        }
        if (permission !== 'granted') return;

        const keyRes = await fetch('<%= base %>/api/push/vapid-public-key', { credentials: 'include' });
        if (!keyRes.ok) return;
        const { publicKey } = await keyRes.json();
        if (!publicKey) return;

        let sub = await reg.pushManager.getSubscription();
        if (!sub) {
          sub = await reg.pushManager.subscribe({
            userVisibleOnly: true,
            applicationServerKey: urlBase64ToUint8Array(publicKey)
          });
        }

        const subJson = sub.toJSON();
        if (subJson && subJson.keys) {
          await fetch('<%= base %>/api/push/subscribe', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'include',
            body: JSON.stringify({
              endpoint: sub.endpoint,
              keys: subJson.keys
            })
          });
        }
      } catch (err) {
        console.warn('[DenTrust Push]', err);
      }
    }

    if (document.readyState === 'complete') {
      initPush();
    } else {
      window.addEventListener('load', initPush);
    }
  })();
  </script>

  <!-- لما التطبيق يتقفل فعليًا، نبلّغ السيرفر يقفل الجلسة -->
  <% if (typeof currentUser !== 'undefined' && currentUser) { %>
  <script>
  (function () {
    // نتابع لو المستخدم بيضغط على لينك داخلي
    // عشان مانبعتش session/close عند الانتقال بين الصفحات
    var _goingInternal = false;

    document.addEventListener('click', function (e) {
      var a = e.target.closest('a[href]');
      if (!a) return;
      var href = a.getAttribute('href');
      // لو اللينك داخلي (يبدأ بـ / أو بنفس الـ origin)
      if (href && (href.startsWith('/') || href.startsWith(location.origin))) {
        _goingInternal = true;
      }
    });

    // pagehide بيتفعل لما الصفحة تتقفل —
    // لو كان انتقال داخلي: تجاهل — لو التطبيق اتقفل فعلاً: ابعت session/close
    window.addEventListener('pagehide', function () {
      if (_goingInternal) { _goingInternal = false; return; }
      try { navigator.sendBeacon('<%= base %>/api/session/close'); } catch (e) {}
    });
  })();
  </script>
  <% } %>

