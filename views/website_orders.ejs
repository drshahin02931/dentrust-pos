<%- include('partials/header', Object.assign({pageTitle: 'طلبات الموقع'}, locals)) %>

<style>
  .status-badge { display:inline-flex; align-items:center; gap:4px; padding:3px 10px; border-radius:9999px; font-size:11px; font-weight:700; }
  .status-pending   { background:#fef9c3; color:#854d0e; }
  .status-confirmed { background:#dbeafe; color:#1e40af; }
  .status-shipped   { background:#e0e7ff; color:#4338ca; }
  .status-delivered { background:#dcfce7; color:#15803d; }
  .status-cancelled { background:#fee2e2; color:#b91c1c; }
</style>

<div class="space-y-5">

  <!-- Header -->
  <div class="flex flex-wrap items-center justify-between gap-3">
    <h1 class="text-2xl font-black text-gray-800">🌐 طلبات الموقع</h1>
    <div class="flex items-center gap-2">
      <button onclick="loadOrders()" class="bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold px-4 py-2 rounded-xl flex items-center gap-1.5">
        🔄 تحديث
      </button>
    </div>
  </div>

  <!-- Stats row -->
  <div class="grid grid-cols-2 sm:grid-cols-5 gap-3">
    <div onclick="setFilter('all')"       id="stat-all"       class="stat-card cursor-pointer bg-white border-2 border-gray-200 rounded-2xl p-3 text-center hover:border-blue-400 transition-colors">
      <div class="text-xl font-black text-gray-700" id="cnt-all">—</div>
      <div class="text-xs text-gray-500 mt-0.5">الكل</div>
    </div>
    <div onclick="setFilter('pending')"   id="stat-pending"   class="stat-card cursor-pointer bg-yellow-50 border-2 border-yellow-200 rounded-2xl p-3 text-center hover:border-yellow-400 transition-colors">
      <div class="text-xl font-black text-yellow-700" id="cnt-pending">—</div>
      <div class="text-xs text-yellow-600 mt-0.5">⏳ انتظار</div>
    </div>
    <div onclick="setFilter('confirmed')" id="stat-confirmed" class="stat-card cursor-pointer bg-blue-50 border-2 border-blue-200 rounded-2xl p-3 text-center hover:border-blue-400 transition-colors">
      <div class="text-xl font-black text-blue-700" id="cnt-confirmed">—</div>
      <div class="text-xs text-blue-600 mt-0.5">✅ مؤكد</div>
    </div>
    <div onclick="setFilter('shipped')"   id="stat-shipped"   class="stat-card cursor-pointer bg-indigo-50 border-2 border-indigo-200 rounded-2xl p-3 text-center hover:border-indigo-400 transition-colors">
      <div class="text-xl font-black text-indigo-700" id="cnt-shipped">—</div>
      <div class="text-xs text-indigo-600 mt-0.5">🚚 شحن</div>
    </div>
    <div onclick="setFilter('delivered')" id="stat-delivered" class="stat-card cursor-pointer bg-green-50 border-2 border-green-200 rounded-2xl p-3 text-center hover:border-green-400 transition-colors">
      <div class="text-xl font-black text-green-700" id="cnt-delivered">—</div>
      <div class="text-xs text-green-600 mt-0.5">📦 تم التوصيل</div>
    </div>
  </div>

  <!-- Search + filter -->
  <div class="bg-white rounded-2xl border shadow-sm p-4 flex flex-wrap gap-3 items-center">
    <input id="searchInput" type="text" placeholder="🔍 ابحث باسم العميل أو الهاتف..." oninput="debounceSearch()"
      class="flex-1 min-w-[180px] border border-gray-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-300"/>
    <select id="statusFilter" onchange="loadOrders()" class="border border-gray-200 rounded-xl px-3 py-2 text-sm focus:outline-none">
      <option value="all">كل الحالات</option>
      <option value="pending">⏳ انتظار</option>
      <option value="confirmed">✅ مؤكد</option>
      <option value="shipped">🚚 شحن</option>
      <option value="delivered">📦 تم التوصيل</option>
      <option value="cancelled">❌ ملغي</option>
    </select>
  </div>

  <!-- Orders list -->
  <div id="ordersContainer">
    <div class="flex items-center justify-center py-16 text-gray-400">
      <svg class="animate-spin h-6 w-6 ml-2" viewBox="0 0 24 24" fill="none">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"/>
      </svg>
      جارٍ التحميل...
    </div>
  </div>

  <!-- Pagination -->
  <div id="pagination" class="flex items-center justify-center gap-2 hidden">
    <button onclick="changePage(-1)" id="prevBtn" class="px-4 py-2 rounded-xl text-sm font-bold bg-white border hover:bg-gray-50 disabled:opacity-40">◀ السابق</button>
    <span id="pageInfo" class="text-sm text-gray-600 font-medium"></span>
    <button onclick="changePage(1)"  id="nextBtn" class="px-4 py-2 rounded-xl text-sm font-bold bg-white border hover:bg-gray-50 disabled:opacity-40">التالي ▶</button>
  </div>
</div>


<!-- ── WhatsApp Notification Modal ── -->
<div id="waModal" class="hidden fixed inset-0 bg-black/50 z-[60] flex items-center justify-center p-4">
  <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md p-6 space-y-4">
    <div class="flex items-center gap-3">
      <div class="text-4xl">📱</div>
      <div>
        <h2 class="font-black text-gray-800 text-lg">إشعار العميل على واتساب</h2>
        <p class="text-xs text-gray-400 mt-0.5">تم تحديث الحالة بنجاح ✅</p>
      </div>
    </div>

    <!-- Auto-sent badge -->
    <div id="waAutoSent" class="hidden bg-green-50 border border-green-200 rounded-xl p-3 text-center">
      <span class="text-green-700 font-bold text-sm">✅ تم الإرسال تلقائياً عبر واتساب!</span>
    </div>

    <!-- Message preview -->
    <div class="bg-[#e9fbe5] rounded-xl p-4 border border-green-200 space-y-1">
      <div class="flex items-center justify-between mb-2">
        <span class="text-xs font-bold text-green-700">رسالة واتساب للعميل:</span>
        <button onclick="copyWaMsg()" id="copyBtn"
          class="text-xs bg-white border border-green-300 text-green-700 font-bold px-3 py-1 rounded-lg hover:bg-green-50">
          📋 نسخ
        </button>
      </div>
      <div id="waMsgPreview" class="text-sm text-gray-700 whitespace-pre-line leading-relaxed font-medium"></div>
    </div>

    <!-- Action buttons -->
    <div class="flex gap-2">
      <a id="waOpenLink" href="#" target="_blank" rel="noopener"
        class="flex-1 flex items-center justify-center gap-2 bg-[#25d366] hover:bg-[#1ebe5a] text-white font-black py-3 rounded-xl text-sm shadow-sm">
        <svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
          <path d="M12 0C5.373 0 0 5.373 0 12c0 2.126.553 4.122 1.516 5.853L0 24l6.335-1.493C8.053 23.456 9.988 24 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818c-1.881 0-3.638-.507-5.148-1.389l-.369-.219-3.762.887.945-3.653-.242-.375A9.796 9.796 0 012.182 12C2.182 6.578 6.578 2.182 12 2.182S21.818 6.578 21.818 12 17.422 21.818 12 21.818z"/>
        </svg>
        فتح واتساب
      </a>
      <button onclick="closeWaModal()" class="px-5 bg-gray-100 hover:bg-gray-200 text-gray-600 font-bold py-3 rounded-xl text-sm">
        تخطي
      </button>
    </div>
    <p class="text-center text-xs text-gray-400">الضغط على "فتح واتساب" سيفتح المحادثة مع الرسالة جاهزة للإرسال</p>
  </div>
</div>

<!-- ── Order Detail Modal ── -->
<div id="detailModal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4" onclick="if(event.target===this)closeDetail()">
  <div class="bg-white rounded-2xl shadow-2xl w-full max-w-lg max-h-[90vh] flex flex-col">
    <!-- Header: Order #N + date -->
    <div class="flex items-start justify-between px-5 pt-5 pb-4 border-b">
      <div>
        <h2 id="detailOrderNum" class="font-black text-gray-900 text-xl leading-tight">Order</h2>
        <p  id="detailOrderDate" class="text-sm text-gray-400 mt-0.5"></p>
      </div>
      <button onclick="closeDetail()" class="text-gray-400 hover:text-gray-600 text-2xl leading-none mt-0.5">✕</button>
    </div>
    <!-- Scrollable body -->
    <div id="detailBody" class="overflow-y-auto flex-1 p-5 space-y-4">
      <div class="flex items-center justify-center py-8 text-gray-400">جارٍ التحميل...</div>
    </div>
    <!-- Footer row 1: status + delete -->
    <div class="px-5 pt-3 pb-2 border-t flex items-center gap-2">
      <div class="flex items-center gap-2 flex-1">
        <span class="text-sm font-semibold text-gray-500 whitespace-nowrap">Status</span>
        <select id="detailStatusSelect" onchange="saveDetailStatus()"
          class="flex-1 border border-gray-200 rounded-xl px-3 py-2 text-sm font-bold focus:outline-none focus:ring-2 focus:ring-blue-300 bg-yellow-50 text-yellow-800">
          <option value="pending">⏳ Pending</option>
          <option value="confirmed">✅ Confirmed</option>
          <option value="shipped">🚚 Shipped</option>
          <option value="delivered">📦 Delivered</option>
          <option value="cancelled">❌ Cancelled</option>
        </select>
      </div>
      <button id="detailDeleteBtn" onclick="deleteFromDetail()"
        class="flex items-center gap-1.5 bg-red-50 hover:bg-red-100 text-red-600 font-bold py-2 px-4 rounded-xl text-sm border border-red-200 whitespace-nowrap">
        🗑 Delete
      </button>
    </div>
    <!-- Footer row 2: print + whatsapp -->
    <div class="px-5 pb-4 pt-1 flex gap-2">
      <button onclick="printOrderDetail()"
        class="flex-1 flex items-center justify-center gap-2 bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold py-2.5 rounded-xl text-sm border border-gray-200">
        🖨️ طباعة الفاتورة
      </button>
      <button id="detailWaBtn" onclick="openDetailWhatsApp()"
        class="flex-1 flex items-center justify-center gap-2 bg-[#25d366] hover:bg-[#1ebe5a] text-white font-bold py-2.5 rounded-xl text-sm shadow-sm">
        <svg viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 flex-shrink-0">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
          <path d="M12 0C5.373 0 0 5.373 0 12c0 2.126.553 4.122 1.516 5.853L0 24l6.335-1.493C8.053 23.456 9.988 24 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818c-1.881 0-3.638-.507-5.148-1.389l-.369-.219-3.762.887.945-3.653-.242-.375A9.796 9.796 0 012.182 12C2.182 6.578 6.578 2.182 12 2.182S21.818 6.578 21.818 12 17.422 21.818 12 21.818z"/>
        </svg>
        واتساب للعميل
      </button>
    </div>
  </div>
</div>

<!-- ── Status Modal ── -->
<div id="statusModal" class="hidden fixed inset-0 bg-black/40 z-[60] flex items-center justify-center p-4">
  <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md p-6 space-y-4">
    <div class="flex items-center justify-between">
      <h2 class="font-black text-gray-800 text-lg">تحديث حالة الطلب</h2>
      <button onclick="closeModal()" class="text-gray-400 hover:text-gray-600 text-2xl leading-none">✕</button>
    </div>
    <div id="modalOrderInfo" class="bg-gray-50 rounded-xl p-3 text-sm text-gray-600"></div>
    <div class="space-y-2">
      <label class="text-xs font-semibold text-gray-500 block">الحالة الجديدة</label>
      <div class="grid grid-cols-2 gap-2" id="statusButtons">
        <button onclick="selectStatus('pending')"   class="status-btn py-2.5 rounded-xl text-sm font-bold border-2 border-yellow-300 bg-yellow-50 text-yellow-700 hover:bg-yellow-100">⏳ انتظار</button>
        <button onclick="selectStatus('confirmed')" class="status-btn py-2.5 rounded-xl text-sm font-bold border-2 border-blue-300 bg-blue-50 text-blue-700 hover:bg-blue-100">✅ مؤكد</button>
        <button onclick="selectStatus('shipped')"   class="status-btn py-2.5 rounded-xl text-sm font-bold border-2 border-indigo-300 bg-indigo-50 text-indigo-700 hover:bg-indigo-100">🚚 جارٍ الشحن</button>
        <button onclick="selectStatus('delivered')" class="status-btn py-2.5 rounded-xl text-sm font-bold border-2 border-green-300 bg-green-50 text-green-700 hover:bg-green-100">📦 تم التوصيل</button>
        <button onclick="selectStatus('cancelled')" class="status-btn col-span-2 py-2.5 rounded-xl text-sm font-bold border-2 border-red-300 bg-red-50 text-red-600 hover:bg-red-100">❌ إلغاء الطلب</button>
      </div>
    </div>
    <div class="space-y-1">
      <label class="text-xs font-semibold text-gray-500 block">ملاحظات (اختياري)</label>
      <textarea id="modalNotes" rows="2" placeholder="أضف ملاحظة للطلب..."
        class="w-full border border-gray-200 rounded-xl px-3 py-2 text-sm resize-none focus:outline-none focus:ring-2 focus:ring-blue-300"></textarea>
    </div>
    <div class="flex gap-2">
      <button onclick="saveStatus()" id="saveBtn" class="flex-1 bg-blue-600 hover:bg-blue-700 text-white font-bold py-2.5 rounded-xl text-sm">حفظ التحديث</button>
      <button onclick="closeModal()" class="px-5 bg-gray-100 hover:bg-gray-200 text-gray-600 font-bold py-2.5 rounded-xl text-sm">إلغاء</button>
    </div>
  </div>
</div>

<script>
const BASE = "<%- base %>";
let _currentPage = 1;
let _currentFilter = 'all';
let _currentOrderId = null;
let _selectedStatus = null;
let _searchTimer = null;

// ── Load stats ──
async function loadStats() {
  const statuses = ['all','pending','confirmed','shipped','delivered','cancelled'];
  const results = await Promise.all(statuses.map(async s => {
    try {
      const _p = new URLSearchParams({ limit: '1' });
      if (s !== 'all') _p.set('status', s);
      const r = await fetch(`${BASE}/api/website-orders/all?${_p}`);
      const d = await r.json();
      return { s, total: d.total || 0 };
    } catch { return { s, total: 0 }; }
  }));
  results.forEach(({ s, total }) => {
    const el = document.getElementById(`cnt-${s}`);
    if (el) el.textContent = total;
  });
}

// ── Load orders ──
async function loadOrders() {
  const search  = document.getElementById('searchInput').value.trim();
  const status  = document.getElementById('statusFilter').value;
  _currentFilter = status;
  document.getElementById('ordersContainer').innerHTML = `
    <div class="flex items-center justify-center py-16 text-gray-400">
      <svg class="animate-spin h-6 w-6 ml-2" viewBox="0 0 24 24" fill="none">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"/>
      </svg>جارٍ التحميل...
    </div>`;
  try {
    const qs = new URLSearchParams({ status, search, page: _currentPage });
    const res = await fetch(`${BASE}/api/website-orders/all?${qs}`);
    const { orders, total, limit } = await res.json();
    renderOrders(orders);
    renderPagination(total, limit);
    loadStats();
  } catch(e) {
    document.getElementById('ordersContainer').innerHTML =
      `<div class="text-center text-red-400 py-10">❌ خطأ في التحميل: ${e.message}</div>`;
  }
}

function renderOrders(orders) {
  const container = document.getElementById('ordersContainer');
  if (!orders.length) {
    container.innerHTML = `<div class="text-center text-gray-400 py-16 text-sm">لا توجد طلبات بهذه الحالة</div>`;
    return;
  }
  const statusLabels = {
    pending:   '⏳ انتظار',
    confirmed: '✅ مؤكد',
    shipped:   '🚚 جارٍ الشحن',
    delivered: '📦 تم التوصيل',
    cancelled: '❌ ملغي',
  };
  container.innerHTML = orders.map(o => `
    <div class="bg-white border rounded-2xl shadow-sm p-4 mb-3 hover:shadow-md transition-shadow cursor-pointer" onclick="openDetail(${o.id})">
      <div class="flex flex-wrap items-start gap-3 justify-between">
        <div class="flex-1 min-w-0">
          <div class="flex flex-wrap items-center gap-2 mb-1">
            <span class="font-black text-gray-800">${escHtml(o.customer_name || 'عميل')}</span>
            <span class="status-badge status-${o.status || 'pending'}">${statusLabels[o.status] || '⏳ انتظار'}</span>
            ${!o.seen ? '<span class="bg-green-100 text-green-700 text-[10px] font-black px-2 py-0.5 rounded-full">جديد</span>' : ''}
          </div>
          ${o.customer_phone ? `<div class="text-sm text-gray-500">📞 ${escHtml(o.customer_phone)}</div>` : ''}
          ${o.customer_city ? `<div class="text-xs text-gray-400 mt-0.5">📍 ${escHtml(o.customer_city)}${o.customer_address ? ' — ' + escHtml(o.customer_address) : ''}</div>` : ''}
          <div class="flex flex-wrap gap-4 mt-2">
            <span class="text-blue-700 font-black text-lg">${parseFloat(o.total_amount||0).toLocaleString('ar-EG')} ج.م</span>
            <span class="text-gray-400 text-sm self-end">${o.items_count} منتج</span>
          </div>
          ${o.promo_code ? `<div class="flex items-center gap-2 mt-1">
            <span class="text-xs bg-green-100 text-green-700 font-bold px-2 py-0.5 rounded-full">🎟️ ${escHtml(o.promo_code)}</span>
            ${o.discount_amount ? `<span class="text-xs text-green-600 font-semibold">خصم: ${parseFloat(o.discount_amount).toLocaleString('ar-EG')} ج.م</span>` : ''}
          </div>` : ''}
          <div class="text-xs text-gray-400 mt-1 truncate">🛍️ ${escHtml(o.items_summary || '—')}</div>
          ${o.notes ? `<div class="text-xs bg-yellow-50 border border-yellow-200 rounded-lg px-2 py-1 mt-2 text-yellow-700">📝 ${escHtml(o.notes)}</div>` : ''}
        </div>
        <div class="flex flex-col items-end gap-2 flex-shrink-0">
          <div class="text-xs text-gray-400 whitespace-nowrap">
            ${new Date(o.created_at).toLocaleDateString('ar-EG',{day:'numeric',month:'short'})}
            ${new Date(o.created_at).toLocaleTimeString('ar-EG',{hour:'2-digit',minute:'2-digit'})}
          </div>
          <span class="text-xs text-blue-400 font-medium">اضغط للتفاصيل ←</span>
        </div>
      </div>
    </div>`).join('');
}

function renderPagination(total, limit) {
  const pages = Math.ceil(total / limit);
  const pag = document.getElementById('pagination');
  if (pages <= 1) { pag.classList.add('hidden'); return; }
  pag.classList.remove('hidden');
  document.getElementById('pageInfo').textContent = `صفحة ${_currentPage} من ${pages} (${total} طلب)`;
  document.getElementById('prevBtn').disabled = _currentPage <= 1;
  document.getElementById('nextBtn').disabled = _currentPage >= pages;
}

function changePage(delta) {
  _currentPage += delta;
  if (_currentPage < 1) _currentPage = 1;
  loadOrders();
}

function setFilter(status) {
  document.getElementById('statusFilter').value = status;
  _currentPage = 1;
  loadOrders();
}

function debounceSearch() {
  clearTimeout(_searchTimer);
  _searchTimer = setTimeout(() => { _currentPage = 1; loadOrders(); }, 400);
}

// ── Detail Modal ──
let _detailOrder = null;
let _detailWaLink = null;
let _detailItems  = [];

// Parse "product x4، product2 x2" summary text into item rows when no DB items available
function parseItemsSummary(summary) {
  if (!summary) return [];
  return summary.split(/[،,]/).map(s => s.trim()).filter(Boolean).map(part => {
    const m = part.match(/^(.+?)\s+[xX×](\d+)\s*$/);
    if (m) return { product_name: m[1].trim(), quantity: parseInt(m[2]), unit_price: null, total_price: null };
    return { product_name: part, quantity: '—', unit_price: null, total_price: null };
  });
}

function buildItemsRows(items, summary, stylePrefix) {
  const src = items.length ? items : parseItemsSummary(summary);
  if (!src.length) return `<tr><td colspan='4' style='text-align:center;padding:12px;color:#9ca3af;font-size:13px;'>—</td></tr>`;
  return src.map(it => {
    const opt       = (it.selected_option || '').trim();
    const optHtml   = opt ? `<div style='font-size:11px;color:#7c3aed;font-weight:700;margin-top:2px;'>◈ ${escHtml(opt)}</div>` : '';
    const hasPrice  = it.unit_price !== null && it.unit_price !== undefined;
    const lineTotal = hasPrice ? parseFloat(it.total_price || (parseFloat(it.unit_price||0) * parseInt(it.quantity||1))) : null;
    const priceCell = hasPrice ? parseFloat(it.unit_price||0).toLocaleString('ar-EG') : '—';
    const totalCell = hasPrice ? lineTotal.toLocaleString('ar-EG') : '—';
    return `<tr>
      <td style='width:48%;padding:6px 4px 6px 2px;border-bottom:1px dashed #d1d5db;vertical-align:top;'>
        <div style='font-weight:600;color:#1f2937;font-size:13px;line-height:1.3;'>${escHtml(it.product_name || '—')}</div>
        ${optHtml}
      </td>
      <td style='width:8%;text-align:center;padding:6px 2px;border-bottom:1px dashed #d1d5db;font-size:13px;'>${it.quantity}</td>
      <td style='width:18%;text-align:left;padding:6px 2px;border-bottom:1px dashed #d1d5db;font-size:13px;'>${priceCell}</td>
      <td style='width:26%;text-align:left;padding:6px 2px;border-bottom:1px dashed #d1d5db;font-size:13px;font-weight:700;'>${totalCell}</td>
    </tr>`;
  }).join('');
}

// Status select background colors
const STATUS_SELECT_CLASSES = {
  pending:   'bg-yellow-50 text-yellow-800',
  confirmed: 'bg-blue-50 text-blue-800',
  shipped:   'bg-indigo-50 text-indigo-800',
  delivered: 'bg-green-50 text-green-800',
  cancelled: 'bg-red-50 text-red-800',
};

function _updateStatusSelectStyle(val) {
  const sel = document.getElementById('detailStatusSelect');
  if (!sel) return;
  sel.className = sel.className.replace(/bg-\S+ text-\S+/g, '');
  const cls = STATUS_SELECT_CLASSES[val] || STATUS_SELECT_CLASSES.pending;
  cls.split(' ').forEach(c => sel.classList.add(c));
}

async function openDetail(id) {
  _detailOrder = null;
  _detailWaLink = null;
  document.getElementById('detailOrderNum').textContent  = 'Order';
  document.getElementById('detailOrderDate').textContent = '';
  document.getElementById('detailBody').innerHTML =
    `<div class="flex items-center justify-center py-8 text-gray-400">جارٍ التحميل...</div>`;
  document.getElementById('detailModal').classList.remove('hidden');
  try {
    const res  = await fetch(`${BASE}/api/website-orders/${id}`);
    const { order, items } = await res.json();
    _detailOrder = order;
    _detailItems  = items || [];

    // ── Status dropdown ──
    const sel = document.getElementById('detailStatusSelect');
    sel.value = order.status || 'pending';
    _updateStatusSelectStyle(order.status || 'pending');

    // ── Build items rows ──
    const discount  = parseFloat(order.discount_amount || 0);
    const delivery  = parseFloat(order.delivery_amount || 0);
    const total     = parseFloat(order.total_amount    || 0);
    const subtotal  = total + discount - delivery;

    const itemsRows = buildItemsRows(items, order.items_summary);

    const dt      = new Date(order.created_at);
    const dateStr = dt.toLocaleDateString('ar-EG', {day:'numeric', month:'long', year:'numeric'});
    const timeStr = dt.toLocaleTimeString('ar-EG', {hour:'2-digit', minute:'2-digit'});
    const orderNum = order.dentrust_order_id || order.id;

    document.getElementById('detailOrderNum').textContent  = `طلب رقم #${orderNum}`;
    document.getElementById('detailOrderDate').textContent = `${dateStr}  ${timeStr}`;

    document.getElementById('detailBody').innerHTML = `
      <div style='text-align:center;padding-bottom:12px;border-bottom:2px dashed #9ca3af;margin-bottom:0;'>
        <div style='font-size:15px;font-weight:900;color:#1f2937;'>🌐 طلب من الموقع</div>
      </div>
      <div style='padding:10px 0;border-bottom:1px dashed #d1d5db;'>
        <div style='font-weight:900;font-size:14px;color:#111827;'>طلب رقم #${escHtml(String(orderNum))}</div>
        <div style='font-size:12px;color:#6b7280;margin-top:2px;'>${dateStr}&nbsp;&nbsp;${timeStr}</div>
      </div>
      <div style='padding:10px 0;border-bottom:1px dashed #d1d5db;'>
        <div style='display:flex;gap:8px;font-size:13px;margin-bottom:6px;'>
          <span style='font-weight:700;color:#6b7280;min-width:56px;'>العميل</span>
          <span style='font-weight:600;color:#111827;'>${escHtml(order.customer_name || '—')}</span>
        </div>
        ${order.customer_phone ? `<div style='display:flex;gap:8px;font-size:13px;margin-bottom:6px;'>
          <span style='font-weight:700;color:#6b7280;min-width:56px;'>الهاتف</span>
          <a href='tel:${escHtml(order.customer_phone)}' style='color:#2563eb;font-weight:500;'>${escHtml(order.customer_phone)}</a>
        </div>` : ''}
        ${order.customer_city ? `<div style='display:flex;gap:8px;font-size:13px;'>
          <span style='font-weight:700;color:#6b7280;min-width:56px;'>العنوان</span>
          <span style='color:#374151;'>${escHtml(order.customer_city)}${order.customer_address ? '، ' + escHtml(order.customer_address) : ''}</span>
        </div>` : ''}
      </div>
      <table style='width:100%;border-collapse:collapse;margin-top:4px;direction:rtl;'>
        <thead>
          <tr style='border-top:2px solid #111827;border-bottom:2px solid #111827;'>
            <th style='width:48%;text-align:right;padding:6px 4px 6px 2px;font-size:12px;font-weight:900;color:#374151;'>المنتج</th>
            <th style='width:8%;text-align:center;padding:6px 2px;font-size:12px;font-weight:900;color:#374151;'>ك</th>
            <th style='width:18%;text-align:left;padding:6px 2px;font-size:12px;font-weight:900;color:#374151;'>سعر</th>
            <th style='width:26%;text-align:left;padding:6px 2px;font-size:12px;font-weight:900;color:#374151;'>إجمالي</th>
          </tr>
        </thead>
        <tbody>${itemsRows}</tbody>
      </table>
      <div style='padding-top:8px;'>
        ${(discount > 0 || delivery > 0) ? `
        <div style='display:flex;justify-content:space-between;font-size:13px;color:#6b7280;padding:3px 0;'>
          <span>المجموع</span><span>${subtotal.toLocaleString('ar-EG')} ج.م</span>
        </div>` : ''}
        ${discount > 0 ? `
        <div style='display:flex;justify-content:space-between;font-size:13px;color:#15803d;font-weight:600;padding:3px 0;'>
          <span>خصم${order.promo_code ? ' (' + escHtml(order.promo_code) + ')' : ''}</span>
          <span>− ${discount.toLocaleString('ar-EG')} ج.م</span>
        </div>` : ''}
        ${delivery > 0 ? `<div style='display:flex;justify-content:space-between;font-size:13px;color:#374151;font-weight:600;padding:3px 0;'>
          <span>مصاريف التوصيل</span>
          <span>+ ${delivery.toLocaleString('ar-EG')} ج.م</span>
        </div>` : ''}
        <div style='display:flex;justify-content:space-between;font-size:15px;font-weight:900;color:#111827;border-top:2px solid #111827;border-bottom:2px solid #111827;padding:6px 0;margin-top:4px;'>
          <span>الإجمالي</span><span>${total.toLocaleString('ar-EG')} ج.م</span>
        </div>
      </div>
      ${order.notes ? `<div style='margin-top:8px;background:#fefce8;border:1px solid #fde68a;border-radius:8px;padding:8px 12px;font-size:12px;color:#92400e;'>📝 ${escHtml(order.notes)}</div>` : ''}
    `;

  } catch(e) {
    document.getElementById('detailBody').innerHTML =
      `<div class="text-center text-red-400 py-8">❌ خطأ في التحميل</div>`;
  }
}

function closeDetail() {
  document.getElementById('detailModal').classList.add('hidden');
  _detailOrder = null;
  _detailWaLink = null;
}

async function saveDetailStatus() {
  if (!_detailOrder) return;
  const sel    = document.getElementById('detailStatusSelect');
  const status = sel.value;
  _updateStatusSelectStyle(status);
  try {
    const res  = await fetch(`${BASE}/api/website-orders/${_detailOrder.id}/status`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ status })
    });
    const data = await res.json();
    if (data.ok) {
      _detailOrder.status = status;
      _detailWaLink = data.wa_link || null;
      loadOrders();
    }
  } catch(_) {}
}

function openDetailWhatsApp() {
  if (!_detailOrder) return;
  const phone = (_detailOrder.customer_phone || '').replace(/[^0-9+]/g,'');
  const intl  = phone.startsWith('+')
    ? phone.slice(1)
    : (phone.startsWith('0') && phone.length === 11 ? '20' + phone.slice(1) : phone);
  if (_detailWaLink) { window.open(_detailWaLink, '_blank'); return; }
  if (intl) window.open(`https://wa.me/${intl}`, '_blank');
  else alert('لا يوجد رقم هاتف للعميل');
}

function printOrderDetail() {
  if (!_detailOrder) return;
  const o        = _detailOrder;
  const items    = _detailItems || [];
  const discount = parseFloat(o.discount_amount  || 0);
  const delivery = parseFloat(o.delivery_amount  || 0);
  const total    = parseFloat(o.total_amount     || 0);
  const subtotal = discount > 0 ? total + discount - delivery : total - delivery;
  const orderNum = o.dentrust_order_id || o.id;

  const _printSrc = items.length ? items : parseItemsSummary(o.items_summary);
  const itemsRows = _printSrc.length
    ? _printSrc.map(it => {
        const opt      = (it.selected_option || '').trim();
        const hasPrice = it.unit_price !== null && it.unit_price !== undefined;
        const lineTotal = hasPrice ? parseFloat(it.total_price || (parseFloat(it.unit_price||0) * parseInt(it.quantity||1))).toFixed(2) : '—';
        return `<tr>
          <td style="text-align:right;word-break:break-word;padding:4px 3px;border-bottom:1px dotted #bbb;line-height:1.4;">
            ${escHtml(it.product_name || '—')}
            ${opt ? `<div style="font-size:9px;font-weight:600;color:#555;margin-top:1px;">◈ ${escHtml(opt)}</div>` : ''}
          </td>
          <td style="text-align:center;padding:4px 3px;border-bottom:1px dotted #bbb;">${it.quantity}</td>
          <td style="text-align:left;padding:4px 3px;border-bottom:1px dotted #bbb;">${hasPrice ? parseFloat(it.unit_price||0).toFixed(2) : '—'}</td>
          <td style="text-align:left;font-weight:bold;padding:4px 3px;border-bottom:1px dotted #bbb;">${lineTotal}</td>
        </tr>`;
      }).join('')
    : `<tr><td colspan="4" style="text-align:center;padding:10px;color:#999;">—</td></tr>`;

  const w = window.open('', '_blank', 'width=480,height=700');
  w.document.write(`<!DOCTYPE html><html dir="rtl" lang="ar"><head>
    <meta charset="UTF-8"><title>طلب #${orderNum}</title>
    <style>
      @page { size: auto; margin: 8mm; }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body { font-family: Arial, Tahoma, 'Segoe UI', sans-serif; font-size: 12px; color: #000; direction: rtl; }
      .store-title { font-size: 15px; font-weight: 900; text-align: center; margin-bottom: 3px; }
      .order-num   { font-size: 13px; font-weight: 900; }
      .order-date  { font-size: 10px; color: #666; margin-top: 1px; }
      hr { border: none; border-top: 1px dashed #000; margin: 6px 0; }
      .info-row { font-size: 11px; margin-bottom: 2px; }
      table { width: 100%; border-collapse: collapse; margin-top: 4px; }
      thead th { font-size: 10px; font-weight: bold; padding: 3px 2px; border-top: 1px solid #000; border-bottom: 1px solid #000; text-align: right; }
      thead th.lft { text-align: left; }
      thead th.ctr { text-align: center; }
      .totals { margin-top: 5px; }
      .tot-row  { display:flex; justify-content:space-between; font-size:11px; padding:2px 0; }
      .tot-disc { color:#166534; font-weight:600; }
      .tot-main { display:flex; justify-content:space-between; font-size:14px; font-weight:900; border-top:2px solid #000; border-bottom:2px solid #000; padding:4px 0; margin-top:3px; }
      .note-box { margin-top:6px; font-size:10px; color:#555; }
      @media print { body { margin:0; } }
    </style>
  </head><body>
    <div class="store-title">🌐 طلب من الموقع</div>
    <hr/>
    <div class="order-num">طلب رقم #${escHtml(String(orderNum))}</div>
    <div class="order-date">${new Date(o.created_at).toLocaleDateString('ar-EG',{day:'numeric',month:'long',year:'numeric'})} ${new Date(o.created_at).toLocaleTimeString('ar-EG',{hour:'2-digit',minute:'2-digit'})}</div>
    <hr/>
    <div class="info-row"><strong>العميل:</strong> ${escHtml(o.customer_name||'—')}</div>
    ${o.customer_phone ? `<div class="info-row"><strong>الهاتف:</strong> ${escHtml(o.customer_phone)}</div>` : ''}
    ${o.customer_city  ? `<div class="info-row"><strong>العنوان:</strong> ${escHtml(o.customer_city)}${o.customer_address ? '، '+escHtml(o.customer_address) : ''}</div>` : ''}
    <hr/>
    <table>
      <thead>
        <tr>
          <th style="width:46%;">المنتج</th>
          <th class="ctr" style="width:8%;">ك</th>
          <th class="lft" style="width:20%;">سعر</th>
          <th class="lft" style="width:26%;">الإجمالي</th>
        </tr>
      </thead>
      <tbody>${itemsRows}</tbody>
    </table>
    <div class="totals">
      ${(discount > 0 || delivery > 0) ? `
        <div class="tot-row"><span>المجموع الجزئي</span><span>${subtotal.toLocaleString('ar-EG')} ج.م</span></div>
        ${discount > 0 ? `<div class="tot-row tot-disc"><span>خصم${o.promo_code ? ' ('+escHtml(o.promo_code)+')' : ''}</span><span>− ${discount.toLocaleString('ar-EG')} ج.م</span></div>` : ''}
        ${delivery > 0 ? `<div class="tot-row" style="font-weight:600;"><span>مصاريف التوصيل</span><span>+ ${delivery.toLocaleString('ar-EG')} ج.م</span></div>` : ''}
      ` : ''}
      <div class="tot-main"><span>الإجمالي</span><span>${total.toLocaleString('ar-EG')} ج.م</span></div>
    </div>
    ${o.notes ? `<hr/><div class="note-box">📝 ${escHtml(o.notes)}</div>` : ''}
    <script>window.onload=()=>window.print();<\/script>
  </body></html>`);
  w.document.close();
}

// Keep for backward compat (called from list card status modal flow)
function openStatusFromDetail() {
  if (!_detailOrder) return;
  closeDetail();
  openModal(_detailOrder.id, _detailOrder.customer_name, _detailOrder.items_summary, parseFloat(_detailOrder.total_amount||0), _detailOrder.status||'pending');
}

async function deleteFromDetail() {
  if (!_detailOrder) return;
  if (!confirm(`حذف طلب "${_detailOrder.customer_name}"؟\nسيُحذف من الموقع أيضاً.`)) return;
  const btn = document.getElementById('detailDeleteBtn');
  btn.disabled = true; btn.textContent = '⏳';
  try {
    await fetch(`${BASE}/api/website-orders/${_detailOrder.id}`, { method: 'DELETE' });
    closeDetail();
    loadOrders();
  } catch(e) { alert('خطأ: ' + e.message); btn.disabled = false; btn.innerHTML = '🗑 Delete'; }
}

// ── Status Modal ──
function openModal(id, name, items, total, currentStatus) {
  _currentOrderId = id;
  _selectedStatus = currentStatus;
  document.getElementById('modalOrderInfo').innerHTML =
    `<div class="font-semibold text-gray-700">${escHtml(name)}</div>
     <div class="text-xs mt-1">${escHtml(items)}</div>
     <div class="text-blue-700 font-black mt-1">${total.toLocaleString('ar-EG')} ج.م</div>`;
  document.getElementById('modalNotes').value = '';
  highlightStatus(currentStatus);
  document.getElementById('statusModal').classList.remove('hidden');
}

function closeModal() {
  document.getElementById('statusModal').classList.add('hidden');
  _currentOrderId = null; _selectedStatus = null;
}

function selectStatus(s) {
  _selectedStatus = s;
  highlightStatus(s);
}

function highlightStatus(s) {
  document.querySelectorAll('.status-btn').forEach(b => b.style.outline = '');
  const map = { pending:'pending', confirmed:'confirmed', shipped:'shipped', delivered:'delivered', cancelled:'cancelled' };
  const idx = Object.keys(map).indexOf(s);
  if (idx >= 0) {
    const btns = document.querySelectorAll('.status-btn');
    if (btns[idx]) btns[idx].style.outline = '3px solid #3b82f6';
  }
}

async function saveStatus() {
  if (!_currentOrderId || !_selectedStatus) return;
  const btn = document.getElementById('saveBtn');
  btn.disabled = true; btn.textContent = '⏳ جارٍ الحفظ...';
  try {
    const res = await fetch(`${BASE}/api/website-orders/${_currentOrderId}/status`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ status: _selectedStatus, notes: document.getElementById('modalNotes').value })
    });
    const data = await res.json();
    if (data.ok) {
      closeModal();
      loadOrders();
      // Show WhatsApp notification modal
      if (data.wa_message) {
        document.getElementById('waMsgPreview').textContent = data.wa_message;
        const link = document.getElementById('waOpenLink');
        if (data.wa_link) {
          link.href = data.wa_link;
          link.classList.remove('opacity-40', 'pointer-events-none');
        } else {
          link.classList.add('opacity-40', 'pointer-events-none');
          link.href = '#';
        }
        // Show auto-sent badge if Twilio sent it
        const autoSent = document.getElementById('waAutoSent');
        if (data.twilio_sent) autoSent.classList.remove('hidden');
        else autoSent.classList.add('hidden');
        document.getElementById('waModal').classList.remove('hidden');
      }
    } else { alert('خطأ في الحفظ'); }
  } catch(e) { alert('خطأ: ' + e.message); }
  finally { btn.disabled = false; btn.textContent = 'حفظ التحديث'; }
}

function closeWaModal() {
  document.getElementById('waModal').classList.add('hidden');
}

async function copyWaMsg() {
  const msg = document.getElementById('waMsgPreview').textContent;
  try {
    await navigator.clipboard.writeText(msg);
    const btn = document.getElementById('copyBtn');
    btn.textContent = '✅ تم النسخ!';
    setTimeout(() => btn.textContent = '📋 نسخ', 2000);
  } catch(_) {}
}

async function deleteOrder(id, btn) {
  if (!confirm('هتحذف الطلب ده؟')) return;
  btn.disabled = true;
  try {
    await fetch(`${BASE}/api/website-orders/${id}`, { method: 'DELETE' });
    loadOrders();
  } catch(e) { alert('خطأ: ' + e.message); btn.disabled = false; }
}

function escHtml(s) {
  return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}
function escAttr(s) {
  return String(s||'').replace(/'/g,'&#39;').replace(/"/g,'&quot;');
}

// Init
loadOrders();
</script>

