<!DOCTYPE html>
<%
const lang = (st && st.invoice_lang) || 'ar';
const showAr = lang === 'ar' || lang === 'both';
const showEn = lang === 'en' || lang === 'both';
const isBoth = lang === 'both';
const currencyLabel = (st && st.currency) || 'جنيه';
const currencyEnLabel = (st && st.currency_en) || 'EGP';
const saleDateStr = (sale.date || '').substring(0, 16);
const saleDateDay = (sale.date || '').substring(0, 10);
const storeName = (st && st.store_name) || 'اسم المحل';
const storeNameEn = (st && st.store_name_en) || 'Store';
const invoiceTitle = (st && st.invoice_title) || 'فاتورة';
const invoiceTitleEn = (st && st.invoice_title_en) || 'INVOICE';
const invoiceFooter = (st && st.invoice_footer) || 'شكراً لتعاملكم معنا';
const invoiceFooterEn = (st && st.invoice_footer_en) || 'Thank you for your business';
const logoUrl = (st && st.logo_url) || '';
const autoPrint = (st && st.auto_print) === '1';
const prevBal = previousBalance || 0;
const _netTotal   = (typeof netTotal !== 'undefined')   ? netTotal   : parseFloat(sale.total_amount || 0);
const _totalRet   = (typeof totalReturned !== 'undefined') ? totalReturned : 0;
const _itemsSubtotal = items.reduce((s, i) => {
  const nq = parseInt(i.net_qty != null ? i.net_qty : (i.quantity || 0)) || 0;
  return s + (parseFloat(i.unit_price || 0) * nq);
}, 0);
const _calcDelivery = (sale.delivery_amount && parseFloat(sale.delivery_amount) > 0 ? parseFloat(sale.delivery_amount) : 0)
  || ((['online','website'].includes(sale.source) || sale.dentrust_order_id) && _itemsSubtotal > 0 && _netTotal > _itemsSubtotal ? Math.max(0, Math.round((_netTotal + parseFloat(sale.discount_amount || 0) - _itemsSubtotal) * 100) / 100) : 0);
const _hasDelivery = _calcDelivery > 0;
const _effectiveDelivery = _calcDelivery;
const _hasDiscount = sale.discount_amount && parseFloat(sale.discount_amount) > 0;
const _subtotalBeforeDiscount = _itemsSubtotal > 0 ? _itemsSubtotal : Math.max(0, _netTotal + parseFloat(sale.discount_amount || 0) - _effectiveDelivery);

function fmt(n) { return parseFloat(n || 0).toFixed(2); }

const _isDeliveryOrder = (sale.delivery_type === 'delivery' || sale.delivery_type === 'shipping' 
  || (sale.delivery_amount && parseFloat(sale.delivery_amount) > 0)
  || (sale.clinic_address && !sale.clinic_address.includes('استلام من مقر الشركة') && !sale.clinic_address.includes('الفرع الرئيسي')));

const _isWebsitePickup = !_isDeliveryOrder && (
  (['online','website'].includes(sale.source) || sale.dentrust_order_id) &&
  (sale.delivery_type === 'pickup' || sale.delivery_type === 'store_pickup'
   || (sale.clinic_address && (sale.clinic_address.includes('استلام من مقر الشركة') || sale.clinic_address.includes('الفرع الرئيسي')))
   || (sale.customer_address && (sale.customer_address.includes('استلام من مقر الشركة') || sale.customer_address.includes('الفرع الرئيسي'))))
);

const _isPickupOrder = !_isDeliveryOrder && (_isWebsitePickup || sale.delivery_type === 'pickup' || sale.delivery_type === 'store_pickup');

function payMethodAr(m) {
  if (_isWebsitePickup && (!m || m === 'online' || m === 'pickup' || m === 'store_pickup')) {
    return 'الدفع عند الاستلام بالفرع';
  }
  const map = { cash:'كاش', naqdi:'كاش', visa:'فيزا', instapay:'InstaPay', split:'مقسّم', credit:'آجل', online:'أونلاين', pickup:'استلام من الفرع', store_pickup:'استلام من الفرع' };
  return map[m] || m;
}
function payMethodEn(m) {
  if (_isWebsitePickup && (!m || m === 'online' || m === 'pickup' || m === 'store_pickup')) {
    return 'Pay at Store / Branch';
  }
  const map = { cash:'Cash', naqdi:'Cash', visa:'Visa', instapay:'InstaPay', split:'Split', credit:'Credit', online:'Online', pickup:'Store Pickup', store_pickup:'Store Pickup' };
  return map[m] || m;
}

function cleanAddr(addr) {
  if (!addr) return '';
  const s = String(addr).trim();
  if (s.includes('استلام من مقر الشركة') || s.includes('الفرع الرئيسي')) return '';
  return s;
}
const _validAddress = cleanAddr(sale.clinic_address) || cleanAddr(customer && customer.address);
%>
<html lang="<%= showAr ? 'ar' : 'en' %>" dir="<%= (showAr && !isBoth) ? 'rtl' : 'ltr' %>">
<head>
  <meta charset="UTF-8"/>
  <title><%= showAr ? 'فاتورة #'+sale.id : 'Invoice #'+sale.id %></title>
  <style>
    @page { size: <%= (st && st.receipt_width) || '57mm' %> auto; margin: 3mm 7.5mm; }
    * { box-sizing: border-box; margin: 0; padding: 0; color: #000; }
    body {
      width: <%= (st && st.receipt_width) || '57mm' %>;
      font-family: 'Arial', 'Tahoma', 'Segoe UI', sans-serif;
      font-size: 11px;
      color: #000;
      background: #fff;
      font-weight: 700;
    }
    @media screen {
      body { max-width: <%= (st && st.receipt_width) || '57mm' %>; margin: 20px auto; border: 1px dashed #000; padding: 8px; }
    }
    @media print {
      .no-print { display: none !important; }
      body { border: none; padding: 0; margin: 0; color: #000 !important; background: #fff !important; font-weight: 800; }
      * {
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
        color: #000 !important;
        border-color: #000 !important;
        text-shadow: none !important;
      }
      tbody td { border-bottom: 1px dotted #000 !important; font-weight: 700; color: #000 !important; }
      .divider { border-top: 1px dashed #000 !important; }
      .store-name { font-weight: 900 !important; color: #000 !important; }
      .total-main { border-top: 2px solid #000 !important; border-bottom: 2px solid #000 !important; font-weight: 900 !important; color: #000 !important; }
      .sub-row { font-weight: 700 !important; color: #000 !important; }
      span, div, p, th, td, b, strong { color: #000 !important; }
    }
    .center { text-align: center; }
    .right  { text-align: right; }
    .left   { text-align: left; }
    .bold   { font-weight: bold; }
    .divider { border: none; border-top: 1px dashed #000; margin: 5px 0; }
    .row { display: flex; justify-content: space-between; align-items: baseline; margin: 2.5px 0; font-size: 11px; color: #000; }
    .store-name { font-size: 17px; font-weight: 900; letter-spacing: 0.5px; margin: 3px 0 1px; color: #000; }
    .store-sub  { font-size: 10px; margin: 1px 0; color: #000; font-weight: 600; }
    .inv-title { font-size: 12px; font-weight: bold; text-transform: uppercase; letter-spacing: 2px; margin: 4px 0; color: #000; }
    table { width: 100%; border-collapse: collapse; margin: 2px 0; }
    thead th {
      font-size: 10px; font-weight: bold; padding: 3px 2px;
      border-bottom: 1px solid #000; border-top: 1px solid #000;
      color: #000;
    }
    tbody td {
      font-size: 11px; padding: 3px 2px; vertical-align: top;
      border-bottom: 1px dotted #000; font-weight: 700;
      color: #000;
    }
    tbody tr:last-child td { border-bottom: none; }
    .total-section { margin-top: 4px; }
    .total-main {
      display: flex; justify-content: space-between;
      font-size: 14px; font-weight: 900; padding: 4px 0;
      border-top: 2px solid #000; border-bottom: 2px solid #000; margin: 4px 0;
      color: #000;
    }
    .sub-row { display: flex; justify-content: space-between; font-size: 11px; padding: 2px 0; color: #000; }
    .credit-stamp {
      border: 2px solid #000; border-radius: 4px; padding: 3px 8px;
      font-size: 12px; font-weight: bold; text-align: center; margin: 5px 0; letter-spacing: 1px;
      color: #000;
    }
    .balance-box { border: 1px dashed #000; border-radius: 3px; padding: 4px 6px; margin: 3px 0; color: #000; }
    .balance-total {
      display: flex; justify-content: space-between;
      font-size: 13px; font-weight: bold;
      border-top: 1px dashed #000; padding-top: 3px; margin-top: 3px;
      color: #000;
    }
    .footer-text {
      white-space: pre-line; text-align: center; font-size: 10px; line-height: 1.6; margin-top: 5px;
      color: #000; font-weight: 600;
    }
    .logo-box { margin: 0 auto 4px; text-align: center; }
    .logo-box img { max-width: 60px; max-height: 60px; object-fit: contain; }
    .no-print { }
  </style>
</head>
<body>

  <div class="center" style="margin-bottom:5px;">
    <% if (logoUrl) { %>
    <div class="logo-box"><img src="<%- logoUrl %>" alt="logo"/></div>
    <% } %>
    <% if (showAr) { %>
    <div class="store-name"><%- storeName %></div>
    <% } %>
    <% if (showEn) { %>
    <div class="store-name" style="font-size:<%= showAr ? '13' : '17' %>px;"><%- storeNameEn %></div>
    <% } %>
    <% if (st && st.store_phone) { %>
    <div class="store-sub"><%- st.store_phone %></div>
    <% } %>
    <% if (st && st.store_address && showAr) { %>
    <div class="store-sub"><%- st.store_address %></div>
    <% } %>
    <% if (st && st.store_address_en && showEn) { %>
    <div class="store-sub"><%- st.store_address_en %></div>
    <% } %>
  </div>

  <hr class="divider"/>

  <div class="center inv-title">
    <% if (showAr) { %><%- invoiceTitle %><% } %>
    <% if (isBoth) { %> / <% } %>
    <% if (showEn) { %><%- invoiceTitleEn %><% } %>
  </div>

  <hr class="divider"/>

  <% if (showAr) { %>
  <div class="row"><span>رقم الفاتورة</span><span class="bold">#<%= sale.id %></span></div>
  <% if (sale.dentrust_order_id || sale.source === 'online' || sale.source === 'website') { %>
  <div class="row"><span>مصدر الطلب</span><span class="bold" style="color:#000;font-weight:900;">🌐 طلب موقع <%= sale.dentrust_order_id ? ('#' + sale.dentrust_order_id) : '' %></span></div>
  <% } %>
  <div class="row"><span>التاريخ</span><span><%= saleDateStr %></span></div>
  <div class="row"><span>الدفع</span><span class="bold"><%= payMethodAr(sale.payment_method) %></span></div>
  <% if (customer) { %>
  <div class="row"><span>العميل</span><span class="bold" style="max-width:55%;text-align:left;"><%- customer.name %> <%= customer.customer_code ? ('[' + customer.customer_code + ']') : '' %></span></div>
  <% if (customer.phone) { %><div class="row"><span>الهاتف</span><span class="bold"><%= customer.phone %></span></div><% } %>
  <% if (_isDeliveryOrder) { %>
  <div class="row"><span>طريقة التسليم</span><span class="bold" style="color:#000;">🛵 توصيل للعيادة</span></div>
  <% if (_validAddress) { %>
  <div class="row"><span>عنوان التوصيل</span><span style="max-width:60%;text-align:left;word-break:break-word;"><%- _validAddress %></span></div>
  <% } %>
  <% } else if (_isPickupOrder) { %>
  <div class="row"><span>طريقة التسليم</span><span class="bold" style="color:#000;">🏪 استلام من الفرع / مقر الشركة</span></div>
  <% } else if (_validAddress) { %>
  <div class="row"><span>العنوان</span><span style="max-width:60%;text-align:left;word-break:break-word;"><%- _validAddress %></span></div>
  <% } %>
  <% if (sale.promo_code) { %>
  <div class="row"><span>كود الخصم</span><span class="bold">🎟️ <%= sale.promo_code %></span></div>
  <% } %>
  <% } %>
  <% } %>

  <% if (showEn) { %>
  <div style="direction:ltr;<%= isBoth ? 'border-top:1px dashed #000;margin-top:4px;padding-top:4px;' : '' %>">
    <div class="row"><span>Invoice #</span><span class="bold"><%= sale.id %></span></div>
    <% if (sale.dentrust_order_id || sale.source === 'online' || sale.source === 'website') { %>
    <div class="row"><span>Order Source</span><span class="bold" style="color:#000;font-weight:900;">🌐 Website Order <%= sale.dentrust_order_id ? ('#' + sale.dentrust_order_id) : '' %></span></div>
    <% } %>
    <div class="row"><span>Date</span><span><%= saleDateStr %></span></div>
    <div class="row"><span>Payment</span><span class="bold"><%= payMethodEn(sale.payment_method) %></span></div>
    <% if (_isDeliveryOrder) { %>
    <div class="row"><span>Delivery</span><span class="bold" style="color:#000;">🛵 Clinic Delivery</span></div>
    <% if (_validAddress) { %>
    <div class="row"><span>Delivery Address</span><span style="max-width:60%;word-break:break-word;"><%- _validAddress %></span></div>
    <% } %>
    <% } else if (_isPickupOrder) { %>
    <div class="row"><span>Delivery</span><span class="bold" style="color:#000;">🏪 Store Pickup</span></div>
    <% } else if (_validAddress) { %>
    <div class="row"><span>Address</span><span style="max-width:60%;word-break:break-word;"><%- _validAddress %></span></div>
    <% } %>
    <% if (customer) { %>
    <div class="row"><span>Customer</span><span class="bold"><%- customer.name %></span></div>
    <% if (customer.phone) { %><div class="row"><span>Phone</span><span class="bold"><%= customer.phone %></span></div><% } %>
    <% } %>
  </div>
  <% } %>

  <hr class="divider"/>

  <% if (showAr) { %>
  <table>
    <thead>
      <tr>
        <th class="right" style="width:48%;">المنتج</th>
        <th class="center" style="width:8%;">ك</th>
        <th class="left"   style="width:20%;">سعر</th>
        <th class="left"   style="width:24%;">الإجمالي</th>
      </tr>
    </thead>
    <tbody>
      <% for (const item of items) { const nq = parseInt(item.net_qty != null ? item.net_qty : item.quantity); const rq = parseInt(item.returned_qty || 0); if (nq <= 0 && rq > 0) continue; %>
      <tr>
        <td class="right" style="word-break:break-word;line-height:1.4;">
          <%- item.product_name %>
          <% if (item.selected_option) { %>
          <div style="font-size:9px;font-weight:700;color:#000;margin-top:1px;">◈ <%- item.selected_option %></div>
          <% } %>
          <% if (rq > 0) { %>
          <div style="font-size:9px;color:#000;font-weight:700;margin-top:1px;">مرتجع: <%= rq %></div>
          <% } %>
        </td>
        <td class="center"><%= nq %></td>
        <td class="left"><%= fmt(item.unit_price) %></td>
        <td class="left bold"><%= fmt(parseFloat(item.unit_price) * nq) %></td>
      </tr>
      <% } %>
    </tbody>
  </table>
  <% } %>

  <% if (showEn) { %>
  <table style="direction:ltr;">
    <thead>
      <tr>
        <th class="left" style="width:48%;">Item</th>
        <th class="center" style="width:8%;">Qty</th>
        <th class="left"  style="width:20%;">Price</th>
        <th class="left"  style="width:24%;">Total</th>
      </tr>
    </thead>
    <tbody>
      <% for (const item of items) { const nq = parseInt(item.net_qty != null ? item.net_qty : item.quantity); const rq = parseInt(item.returned_qty || 0); if (nq <= 0 && rq > 0) continue; %>
      <tr>
        <td class="left" style="word-break:break-word;line-height:1.4;">
          <%- item.product_name %>
          <% if (item.selected_option) { %>
          <div style="font-size:9px;font-weight:700;color:#000;margin-top:1px;">◈ <%- item.selected_option %></div>
          <% } %>
          <% if (rq > 0) { %>
          <div style="font-size:9px;color:#000;font-weight:700;margin-top:1px;">Returned: <%= rq %></div>
          <% } %>
        </td>
        <td class="center"><%= nq %></td>
        <td class="left"><%= fmt(item.unit_price) %></td>
        <td class="left bold"><%= fmt(parseFloat(item.unit_price) * nq) %></td>
      </tr>
      <% } %>
    </tbody>
  </table>
  <% } %>

  <div class="total-section">
    <% if (_hasDiscount) { %>
    <% if (showAr) { %>
    <div class="sub-row" style="font-weight:700;color:#000;">
      <span>المجموع قبل الخصم</span>
      <span><%= fmt(_subtotalBeforeDiscount) %> <%= currencyLabel %></span>
    </div>
    <div class="sub-row" style="font-weight:700;color:#000;">
      <span>خصم<%= sale.promo_code ? ` (${sale.promo_code})` : '' %></span>
      <span>- <%= fmt(sale.discount_amount) %> <%= currencyLabel %></span>
    </div>
    <% } %>
    <% if (showEn) { %>
    <div class="sub-row bold" style="direction:ltr;color:#000;">
      <span>Subtotal (Before Discount)</span>
      <span><%= fmt(_subtotalBeforeDiscount) %> <%= currencyEnLabel %></span>
    </div>
    <div class="sub-row bold" style="direction:ltr;color:#000;">
      <span>Discount<%= sale.promo_code ? ` (${sale.promo_code})` : '' %></span>
      <span>- <%= fmt(sale.discount_amount) %> <%= currencyEnLabel %></span>
    </div>
    <% } %>
    <% } %>

    <% if (_hasDelivery) { %>
    <% if (showAr) { %>
    <div class="sub-row" style="font-weight:700;color:#000;">
      <span>مصاريف التوصيل</span>
      <span>+ <%= fmt(_effectiveDelivery) %> <%= currencyLabel %></span>
    </div>
    <% } %>
    <% if (showEn) { %>
    <div class="sub-row bold" style="direction:ltr;color:#000;">
      <span>Delivery Fee</span>
      <span>+ <%= fmt(_effectiveDelivery) %> <%= currencyEnLabel %></span>
    </div>
    <% } %>
    <% } %>

    <% if (_totalRet > 0) { %>
    <% if (showAr) { %>
    <div class="sub-row" style="font-weight:700;color:#000;"><span>مرتجع</span><span>- <%= fmt(_totalRet) %> <%= currencyLabel %></span></div>
    <% } %>
    <% if (showEn) { %>
    <div class="sub-row bold" style="direction:ltr;color:#000;"><span>Returns</span><span>- <%= fmt(_totalRet) %> <%= currencyEnLabel %></span></div>
    <% } %>
    <% } %>

    <% if (showAr) { %>
    <div class="total-main">
      <span><%= _hasDiscount ? 'الإجمالي بعد الخصم' : 'الإجمالي' %></span>
      <span><%= fmt(_netTotal) %> <%= currencyLabel %></span>
    </div>
    <% } %>
    <% if (showEn) { %>
    <div class="total-main" style="direction:ltr;">
      <span><%= _hasDiscount ? 'TOTAL (AFTER DISCOUNT)' : 'TOTAL' %></span>
      <span><%= fmt(_netTotal) %> <%= currencyEnLabel %></span>
    </div>
    <% } %>
    <% if (sale.payment_method !== 'credit' && sale.amount_received) { %>
    <% if (showAr) { %>
    <div class="sub-row"><span>مستلم</span><span><%= fmt(sale.amount_received) %> <%= currencyLabel %></span></div>
    <% if (parseFloat(sale.change_due) > 0) { %>
    <div class="sub-row bold"><span>الباقي للعميل</span><span><%= fmt(sale.change_due) %> <%= currencyLabel %></span></div>
    <% } %>
    <% } %>
    <% if (showEn) { %>
    <div class="sub-row" style="direction:ltr;"><span>Received</span><span><%= fmt(sale.amount_received) %> <%= currencyEnLabel %></span></div>
    <% if (parseFloat(sale.change_due) > 0) { %>
    <div class="sub-row bold" style="direction:ltr;"><span>Change</span><span><%= fmt(sale.change_due) %> <%= currencyEnLabel %></span></div>
    <% } %>
    <% } %>
    <% } %>
  </div>

  <% if (sale.payment_method === 'credit') { %>
  <div class="credit-stamp">
    <% if (showAr) { %>★ آجـل ★<% } %>
    <% if (isBoth) { %> | <% } %>
    <% if (showEn) { %>★ CREDIT ★<% } %>
  </div>
  <div class="balance-box">
    <% if (prevBal > 0) { %>
    <% if (showAr) { %>
    <div class="row"><span>رصيد سابق:</span><span><%= fmt(prevBal) %> <%= currencyLabel %></span></div>
    <div class="row"><span>هذا الطلب:</span><span><%= fmt(_netTotal) %> <%= currencyLabel %></span></div>
    <% } %>
    <% if (showEn) { %>
    <div class="row" style="direction:ltr;"><span>Previous:</span><span><%= fmt(prevBal) %> <%= currencyEnLabel %></span></div>
    <div class="row" style="direction:ltr;"><span>This order:</span><span><%= fmt(_netTotal) %> <%= currencyEnLabel %></span></div>
    <% } %>
    <% } %>
    <% if (showAr) { %>
    <div class="balance-total"><span>إجمالي المتبقي</span><span><%= fmt(prevBal + _netTotal) %> <%= currencyLabel %></span></div>
    <% } %>
    <% if (showEn) { %>
    <div class="balance-total" style="direction:ltr;"><span>Total Due</span><span><%= fmt(prevBal + _netTotal) %> <%= currencyEnLabel %></span></div>
    <% } %>
  </div>
  <% } %>

  <hr class="divider"/>

  <div class="footer-text">
    <% if (showAr) { %><%- invoiceFooter %><% } %>
    <% if (isBoth) { %><br/><% } %>
    <% if (showEn) { %><%- invoiceFooterEn %><% } %>
  </div>

  <!-- ── Print Button (screen only, never printed) ── -->
  <div class="no-print" style="margin-top:16px;text-align:center;">
    <button onclick="window.print()"
      style="display:inline-flex;align-items:center;justify-content:center;gap:6px;background:linear-gradient(135deg, #0a2463 0%, #1e40af 100%);color:#fff;border:none;padding:10px 32px;border-radius:24px;font-size:13px;font-weight:900;cursor:pointer;box-shadow:0 3px 10px rgba(10,36,99,0.3);letter-spacing:0.3px;">
      🖨️ طباعة
    </button>
  </div>

  <script>
    window.onload = function() {
      <% if (autoPrint) { %>
      setTimeout(() => window.print(), 300);
      <% } %>
    };
  </script>
</body>
</html>
