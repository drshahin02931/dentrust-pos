<!DOCTYPE html>
<%
const lang = (st && st.invoice_lang) || 'ar';
const showAr = lang === 'ar' || lang === 'both';
const showEn = lang === 'en' || lang === 'both';
const isBoth = lang === 'both';
const currencyLabel = (st && st.currency) || 'جنيه';
const currencyEnLabel = (st && st.currency_en) || 'EGP';
const saleDateStr = (sale.date || '').substring(0, 16);
const saleDateDay = (sale.date || '').substring(0, 10);
const storeName = (st && st.store_name) || 'اسم المحل';
const storeNameEn = (st && st.store_name_en) || 'Store';
const invoiceTitle = (st && st.invoice_title) || 'فاتورة';
const invoiceTitleEn = (st && st.invoice_title_en) || 'INVOICE';
const invoiceFooter = (st && st.invoice_footer) || 'شكراً لتعاملكم معنا';
const invoiceFooterEn = (st && st.invoice_footer_en) || 'Thank you for your business';
const logoUrl = (st && st.logo_url) || '';
const autoPrint = (st && st.auto_print) === '1';
const prevBal = previousBalance || 0;
const _netTotal   = (typeof netTotal !== 'undefined')   ? netTotal   : parseFloat(sale.total_amount || 0);
const _totalRet   = (typeof totalReturned !== 'undefined') ? totalReturned : 0;

function fmt(n) { return parseFloat(n || 0).toFixed(2); }
function payMethodAr(m) {
  const map = { cash:'كاش', naqdi:'كاش', visa:'فيزا', instapay:'InstaPay', split:'مقسّم', credit:'آجل' };
  return map[m] || m;
}
function payMethodEn(m) {
  const map = { cash:'Cash', naqdi:'Cash', visa:'Visa', instapay:'InstaPay', split:'Split', credit:'Credit' };
  return map[m] || m;
}
%>
<html lang="<%= showAr ? 'ar' : 'en' %>" dir="<%= (showAr && !isBoth) ? 'rtl' : 'ltr' %>">
<head>
  <meta charset="UTF-8"/>
  <title><%= showAr ? 'فاتورة #'+sale.id : 'Invoice #'+sale.id %></title>
  <style>
    @page { size: <%= (st && st.receipt_width) || '57mm' %> auto; margin: 3mm 7.5mm; }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      width: <%= (st && st.receipt_width) || '57mm' %>;
      font-family: 'Arial', 'Tahoma', 'Segoe UI', sans-serif;
      font-size: 11px;
      color: #000;
      background: #fff;
    }
    @media screen {
      body { max-width: <%= (st && st.receipt_width) || '57mm' %>; margin: 20px auto; border: 1px dashed #ccc; padding: 8px; }
    }
    @media print {
      body { border: none; padding: 0; margin: 0; }
    }
    .center { text-align: center; }
    .right  { text-align: right; }
    .left   { text-align: left; }
    .bold   { font-weight: bold; }
    .divider { border: none; border-top: 1px dashed #000; margin: 5px 0; }
    .row { display: flex; justify-content: space-between; align-items: baseline; margin: 2.5px 0; font-size: 11px; }
    .store-name { font-size: 17px; font-weight: 900; letter-spacing: 0.5px; margin: 3px 0 1px; }
    .store-sub  { font-size: 10px; margin: 1px 0; }
    .inv-title { font-size: 12px; font-weight: bold; text-transform: uppercase; letter-spacing: 2px; margin: 4px 0; }
    table { width: 100%; border-collapse: collapse; margin: 2px 0; }
    thead th {
      font-size: 10px; font-weight: bold; padding: 3px 2px;
      border-bottom: 1px solid #000; border-top: 1px solid #000;
    }
    tbody td {
      font-size: 11px; padding: 3px 2px; vertical-align: top;
      border-bottom: 1px dotted #000; font-weight: 700;
    }
    tbody tr:last-child td { border-bottom: none; }
    .total-section { margin-top: 4px; }
    .total-main {
      display: flex; justify-content: space-between;
      font-size: 14px; font-weight: 900; padding: 4px 0;
      border-top: 2px solid #000; border-bottom: 2px solid #000; margin: 4px 0;
    }
    .sub-row { display: flex; justify-content: space-between; font-size: 11px; padding: 2px 0; }
    .credit-stamp {
      border: 2px solid #000; border-radius: 4px; padding: 3px 8px;
      font-size: 12px; font-weight: bold; text-align: center; margin: 5px 0; letter-spacing: 1px;
    }
    .balance-box { border: 1px dashed #000; border-radius: 3px; padding: 4px 6px; margin: 3px 0; }
    .balance-total {
      display: flex; justify-content: space-between;
      font-size: 13px; font-weight: bold;
      border-top: 1px dashed #000; padding-top: 3px; margin-top: 3px;
    }
    .footer-text {
      white-space: pre-line; text-align: center; font-size: 10px; line-height: 1.6; margin-top: 5px;
    }
    .logo-box { margin: 0 auto 4px; text-align: center; }
    .logo-box img { max-width: 60px; max-height: 60px; object-fit: contain; }
    .no-print { }
    @media print {
      .no-print { display: none !important; }
      * { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; color: #000 !important; }
      body { font-weight: 800; background: #fff !important; }
      tbody td { border-bottom: 1px dotted #000 !important; font-weight: 700; }
      .divider { border-top: 1px dashed #000 !important; }
      .store-name { font-weight: 900 !important; }
      .total-main { border-top: 2px solid #000 !important; border-bottom: 2px solid #000 !important; font-weight: 900 !important; }
      .sub-row { font-weight: 700 !important; }
    }
  </style>
</head>
<body>

  <div class="center" style="margin-bottom:5px;">
    <% if (logoUrl) { %>
    <div class="logo-box"><img src="<%- logoUrl %>" alt="logo"/></div>
    <% } %>
    <% if (showAr) { %>
    <div class="store-name"><%- storeName %></div>
    <% } %>
    <% if (showEn) { %>
    <div class="store-name" style="font-size:<%= showAr ? '13' : '17' %>px;"><%- storeNameEn %></div>
    <% } %>
    <% if (st && st.store_phone) { %>
    <div class="store-sub"><%- st.store_phone %></div>
    <% } %>
    <% if (st && st.store_address && showAr) { %>
    <div class="store-sub"><%- st.store_address %></div>
    <% } %>
    <% if (st && st.store_address_en && showEn) { %>
    <div class="store-sub"><%- st.store_address_en %></div>
    <% } %>
  </div>

  <hr class="divider"/>

  <div class="center inv-title">
    <% if (showAr) { %><%- invoiceTitle %><% } %>
    <% if (isBoth) { %> / <% } %>
    <% if (showEn) { %><%- invoiceTitleEn %><% } %>
  </div>

  <hr class="divider"/>

  <% if (showAr) { %>
  <div class="row"><span>رقم الفاتورة</span><span class="bold">#<%= sale.id %></span></div>
  <div class="row"><span>التاريخ</span><span><%= saleDateStr %></span></div>
  <div class="row"><span>الدفع</span><span class="bold"><%= payMethodAr(sale.payment_method) %></span></div>
  <% if (customer) { %>
  <div class="row"><span>العميل</span><span class="bold" style="max-width:55%;text-align:left;"><%- customer.name %></span></div>
  <% if (customer.phone) { %><div class="row"><span>الهاتف</span><span><%= customer.phone %></span></div><% } %>
  <% if (customer.address) { %><div class="row"><span>العنوان</span><span style="max-width:60%;text-align:left;word-break:break-word;"><%- customer.address %></span></div><% } %>
  <% } %>
  <% } %>

  <% if (showEn) { %>
  <div style="direction:ltr;<%= isBoth ? 'border-top:1px dashed #000;margin-top:4px;padding-top:4px;' : '' %>">
    <div class="row"><span>Invoice #</span><span class="bold"><%= sale.id %></span></div>
    <div class="row"><span>Date</span><span><%= saleDateStr %></span></div>
    <div class="row"><span>Payment</span><span class="bold"><%= payMethodEn(sale.payment_method) %></span></div>
    <% if (customer) { %>
    <div class="row"><span>Customer</span><span class="bold"><%- customer.name %></span></div>
    <% if (customer.phone) { %><div class="row"><span>Phone</span><span><%= customer.phone %></span></div><% } %>
    <% if (customer.address) { %><div class="row"><span>Address</span><span style="max-width:60%;word-break:break-word;"><%- customer.address %></span></div><% } %>
    <% } %>
  </div>
  <% } %>

  <hr class="divider"/>

  <% if (showAr) { %>
  <table>
    <thead>
      <tr>
        <th class="right" style="width:48%;">المنتج</th>
        <th class="center" style="width:8%;">ك</th>
        <th class="left"   style="width:20%;">سعر</th>
        <th class="left"   style="width:24%;">الإجمالي</th>
      </tr>
    </thead>
    <tbody>
      <% for (const item of items) { const nq = parseInt(item.net_qty != null ? item.net_qty : item.quantity); const rq = parseInt(item.returned_qty || 0); if (nq <= 0 && rq > 0) continue; %>
      <tr>
        <td class="right" style="word-break:break-word;line-height:1.4;">
          <%- item.product_name %>
          <% if (item.selected_option) { %>
          <div style="font-size:9px;font-weight:700;color:#000;margin-top:1px;">◈ <%- item.selected_option %></div>
          <% } %>
          <% if (rq > 0) { %>
          <div style="font-size:9px;color:#c00;margin-top:1px;">مرتجع: <%= rq %></div>
          <% } %>
        </td>
        <td class="center"><%= nq %></td>
        <td class="left"><%= fmt(item.unit_price) %></td>
        <td class="left bold"><%= fmt(parseFloat(item.unit_price) * nq) %></td>
      </tr>
      <% } %>
    </tbody>
  </table>
  <% } %>

  <% if (showEn) { %>
  <table style="direction:ltr;">
    <thead>
      <tr>
        <th class="left" style="width:48%;">Item</th>
        <th class="center" style="width:8%;">Qty</th>
        <th class="left"  style="width:20%;">Price</th>
        <th class="left"  style="width:24%;">Total</th>
      </tr>
    </thead>
    <tbody>
      <% for (const item of items) { const nq = parseInt(item.net_qty != null ? item.net_qty : item.quantity); const rq = parseInt(item.returned_qty || 0); if (nq <= 0 && rq > 0) continue; %>
      <tr>
        <td class="left" style="word-break:break-word;line-height:1.4;">
          <%- item.product_name %>
          <% if (item.selected_option) { %>
          <div style="font-size:9px;font-weight:700;color:#000;margin-top:1px;">◈ <%- item.selected_option %></div>
          <% } %>
          <% if (rq > 0) { %>
          <div style="font-size:9px;color:#c00;margin-top:1px;">Returned: <%= rq %></div>
          <% } %>
        </td>
        <td class="center"><%= nq %></td>
        <td class="left"><%= fmt(item.unit_price) %></td>
        <td class="left bold"><%= fmt(parseFloat(item.unit_price) * nq) %></td>
      </tr>
      <% } %>
    </tbody>
  </table>
  <% } %>

  <div class="total-section">
    <% if (sale.discount_amount && parseFloat(sale.discount_amount) > 0) { %>
    <% if (showAr) { %>
    <div class="sub-row" style="font-weight:700;"><span>خصم</span><span>- <%= fmt(sale.discount_amount) %> <%= currencyLabel %></span></div>
    <% } %>
    <% if (showEn) { %>
    <div class="sub-row bold" style="direction:ltr;"><span>Discount</span><span>- <%= fmt(sale.discount_amount) %> <%= currencyEnLabel %></span></div>
    <% } %>
    <% } %>
    <% if (sale.delivery_amount && parseFloat(sale.delivery_amount) > 0) { %>
    <% if (showAr) { %>
    <div class="sub-row" style="font-weight:700;"><span>مصاريف التوصيل</span><span>+ <%= fmt(sale.delivery_amount) %> <%= currencyLabel %></span></div>
    <% } %>
    <% if (showEn) { %>
    <div class="sub-row bold" style="direction:ltr;"><span>Delivery</span><span>+ <%= fmt(sale.delivery_amount) %> <%= currencyEnLabel %></span></div>
    <% } %>
    <% } %>
    <% if (_totalRet > 0) { %>
    <% if (showAr) { %>
    <div class="sub-row" style="font-weight:700;color:#c00;"><span>مرتجع</span><span>- <%= fmt(_totalRet) %> <%= currencyLabel %></span></div>
    <% } %>
    <% if (showEn) { %>
    <div class="sub-row bold" style="direction:ltr;color:#c00;"><span>Returns</span><span>- <%= fmt(_totalRet) %> <%= currencyEnLabel %></span></div>
    <% } %>
    <% } %>
    <% if (showAr) { %>
    <div class="total-main">
      <span>الإجمالي</span>
      <span><%= fmt(_netTotal) %> <%= currencyLabel %></span>
    </div>
    <% } %>
    <% if (showEn) { %>
    <div class="total-main" style="direction:ltr;">
      <span>TOTAL</span>
      <span><%= fmt(_netTotal) %> <%= currencyEnLabel %></span>
    </div>
    <% } %>
    <% if (sale.payment_method !== 'credit' && sale.amount_received) { %>
    <% if (showAr) { %>
    <div class="sub-row"><span>مستلم</span><span><%= fmt(sale.amount_received) %> <%= currencyLabel %></span></div>
    <% if (parseFloat(sale.change_due) > 0) { %>
    <div class="sub-row bold"><span>الباقي للعميل</span><span><%= fmt(sale.change_due) %> <%= currencyLabel %></span></div>
    <% } %>
    <% } %>
    <% if (showEn) { %>
    <div class="sub-row" style="direction:ltr;"><span>Received</span><span><%= fmt(sale.amount_received) %> <%= currencyEnLabel %></span></div>
    <% if (parseFloat(sale.change_due) > 0) { %>
    <div class="sub-row bold" style="direction:ltr;"><span>Change</span><span><%= fmt(sale.change_due) %> <%= currencyEnLabel %></span></div>
    <% } %>
    <% } %>
    <% } %>
  </div>

  <% if (sale.payment_method === 'credit') { %>
  <div class="credit-stamp">
    <% if (showAr) { %>★ آجـل ★<% } %>
    <% if (isBoth) { %> | <% } %>
    <% if (showEn) { %>★ CREDIT ★<% } %>
  </div>
  <div class="balance-box">
    <% if (prevBal > 0) { %>
    <% if (showAr) { %>
    <div class="row"><span>رصيد سابق:</span><span><%= fmt(prevBal) %> <%= currencyLabel %></span></div>
    <div class="row"><span>هذا الطلب:</span><span><%= fmt(_netTotal) %> <%= currencyLabel %></span></div>
    <% } %>
    <% if (showEn) { %>
    <div class="row" style="direction:ltr;"><span>Previous:</span><span><%= fmt(prevBal) %> <%= currencyEnLabel %></span></div>
    <div class="row" style="direction:ltr;"><span>This order:</span><span><%= fmt(_netTotal) %> <%= currencyEnLabel %></span></div>
    <% } %>
    <% } %>
    <% if (showAr) { %>
    <div class="balance-total"><span>إجمالي المتبقي</span><span><%= fmt(prevBal + _netTotal) %> <%= currencyLabel %></span></div>
    <% } %>
    <% if (showEn) { %>
    <div class="balance-total" style="direction:ltr;"><span>Total Due</span><span><%= fmt(prevBal + _netTotal) %> <%= currencyEnLabel %></span></div>
    <% } %>
  </div>
  <% } %>

  <hr class="divider"/>

  <div class="footer-text">
    <% if (showAr) { %><%- invoiceFooter %><% } %>
    <% if (isBoth) { %><br/><% } %>
    <% if (showEn) { %><%- invoiceFooterEn %><% } %>
  </div>

  <!-- ── Edit Section (screen only, never printed) ── -->
  <div class="no-print" style="margin-top:14px;border-top:2px dashed #ccc;padding-top:12px;">
    <!-- Edit Customer Info -->
    <div id="editCustomerBox" style="display:none;background:#f0f9ff;border:1px solid #bae6fd;border-radius:8px;padding:10px;margin-bottom:8px;">
      <div style="font-size:11px;font-weight:900;margin-bottom:6px;color:#0369a1;">✏️ تعديل بيانات العميل</div>
      <div style="margin-bottom:4px;"><label style="font-size:10px;color:#555;">الاسم</label>
        <input id="edit_cust_name" value="<%= ((customer && customer.name) || sale.customer_name || '').replace(/"/g,'&quot;') %>" style="width:100%;border:1px solid #cbd5e1;border-radius:4px;padding:3px 6px;font-size:11px;"/></div>
      <div style="margin-bottom:4px;"><label style="font-size:10px;color:#555;">الهاتف</label>
        <input id="edit_cust_phone" value="<%= ((customer && customer.phone) || '').replace(/"/g,'&quot;') %>" style="width:100%;border:1px solid #cbd5e1;border-radius:4px;padding:3px 6px;font-size:11px;"/></div>
      <div style="margin-bottom:6px;"><label style="font-size:10px;color:#555;">العنوان</label>
        <input id="edit_cust_addr" value="<%= ((customer && customer.address) || '').replace(/"/g,'&quot;') %>" style="width:100%;border:1px solid #cbd5e1;border-radius:4px;padding:3px 6px;font-size:11px;"/></div>
      <div style="display:flex;gap:6px;">
        <button onclick="saveCustomerEdit()" style="flex:1;background:#0284c7;color:#fff;border:none;border-radius:6px;padding:5px;font-size:11px;font-weight:bold;cursor:pointer;">💾 حفظ</button>
        <button onclick="document.getElementById('editCustomerBox').style.display='none'" style="background:#e2e8f0;border:none;border-radius:6px;padding:5px 10px;font-size:11px;cursor:pointer;">إلغاء</button>
      </div>
      <div id="editCustMsg" style="font-size:10px;margin-top:4px;color:green;display:none;"></div>
    </div>

    <!-- Edit Item Prices -->
    <% if (canEditPrices) { %>
    <div id="editPricesBox" style="display:none;background:#fefce8;border:1px solid #fde68a;border-radius:8px;padding:10px;margin-bottom:8px;">
      <div style="font-size:11px;font-weight:900;margin-bottom:6px;color:#92400e;">✏️ تعديل الأسعار والكميات</div>
      <table style="width:100%;border-collapse:collapse;font-size:11px;">
        <thead><tr>
          <th style="text-align:right;padding:3px 2px;border-bottom:1px solid #fde68a;">المنتج</th>
          <th style="text-align:center;padding:3px 2px;border-bottom:1px solid #fde68a;width:40px;">ك</th>
          <th style="text-align:left;padding:3px 2px;border-bottom:1px solid #fde68a;width:60px;">السعر</th>
        </tr></thead>
        <tbody>
          <% for (const item of items) { const nq = parseInt(item.net_qty != null ? item.net_qty : item.quantity); %>
          <tr>
            <td style="padding:3px 2px;font-weight:600;"><%- item.product_name %></td>
            <td style="padding:3px 2px;text-align:center;">
              <input type="number" min="1" value="<%= nq %>" data-item-id="<%= item.id %>" data-field="quantity"
                style="width:38px;border:1px solid #fbbf24;border-radius:3px;padding:2px 3px;text-align:center;font-size:11px;"/>
            </td>
            <td style="padding:3px 2px;">
              <input type="number" min="0" step="0.01" value="<%= parseFloat(item.unit_price).toFixed(2) %>" data-item-id="<%= item.id %>" data-field="unit_price"
                style="width:55px;border:1px solid #fbbf24;border-radius:3px;padding:2px 3px;font-size:11px;"/>
            </td>
          </tr>
          <% } %>
        </tbody>
      </table>
      <div style="margin-top:8px;padding-top:6px;border-top:1px dashed #fde68a;">
        <div style="display:flex;gap:6px;align-items:center;margin-bottom:4px;">
          <label style="font-size:10px;color:#555;min-width:65px;">خصم (جنيه)</label>
          <input type="number" id="edit_discount" min="0" step="0.01" value="<%= parseFloat(sale.discount_amount||0).toFixed(2) %>"
            style="width:70px;border:1px solid #fbbf24;border-radius:3px;padding:2px 5px;font-size:11px;"/>
        </div>
        <div style="display:flex;gap:6px;align-items:center;">
          <label style="font-size:10px;color:#555;min-width:65px;">توصيل (جنيه)</label>
          <input type="number" id="edit_delivery" min="0" step="0.01" value="<%= parseFloat(sale.delivery_amount||0).toFixed(2) %>"
            style="width:70px;border:1px solid #fbbf24;border-radius:3px;padding:2px 5px;font-size:11px;"/>
        </div>
      </div>
      <div style="display:flex;gap:6px;margin-top:8px;">
        <button onclick="savePriceEdits()" style="flex:1;background:#d97706;color:#fff;border:none;border-radius:6px;padding:5px;font-size:11px;font-weight:bold;cursor:pointer;">💾 حفظ الأسعار</button>
        <button onclick="document.getElementById('editPricesBox').style.display='none'" style="background:#e2e8f0;border:none;border-radius:6px;padding:5px 10px;font-size:11px;cursor:pointer;">إلغاء</button>
      </div>
      <div id="editPriceMsg" style="font-size:10px;margin-top:4px;color:green;display:none;"></div>
    </div>
    <% } %>

    <!-- Edit Buttons Row -->
    <div style="display:flex;gap:6px;flex-wrap:wrap;justify-content:center;margin-bottom:8px;">
      <button onclick="toggleBox('editCustomerBox')"
        style="display:inline-flex;align-items:center;gap:4px;background:#e0f2fe;color:#0369a1;border:1px solid #bae6fd;padding:5px 12px;border-radius:20px;font-size:11px;font-weight:bold;cursor:pointer;">
        👤 تعديل العميل
      </button>
      <% if (canEditPrices) { %>
      <button onclick="toggleBox('editPricesBox')"
        style="display:inline-flex;align-items:center;gap:4px;background:#fefce8;color:#92400e;border:1px solid #fde68a;padding:5px 12px;border-radius:20px;font-size:11px;font-weight:bold;cursor:pointer;">
        💲 تعديل الأسعار
      </button>
      <% } %>
      <button onclick="window.print()"
        style="display:inline-flex;align-items:center;gap:4px;background:#f1f5f9;color:#475569;border:1px solid #cbd5e1;padding:5px 12px;border-radius:20px;font-size:11px;font-weight:bold;cursor:pointer;">
        🖨️ طباعة
      </button>
    </div>

    <script>
    const _BASE_EDIT = "<%- base %>";
    const _SALE_ID   = <%= sale.id %>;

    function toggleBox(id) {
      const el = document.getElementById(id);
      el.style.display = el.style.display === 'none' ? 'block' : 'none';
    }

    async function saveCustomerEdit() {
      const name  = document.getElementById('edit_cust_name').value.trim();
      const phone = document.getElementById('edit_cust_phone').value.trim();
      const addr  = document.getElementById('edit_cust_addr').value.trim();
      const msg   = document.getElementById('editCustMsg');
      try {
        const r = await fetch(`${_BASE_EDIT}/api/sales/${_SALE_ID}/customer`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify({ customer_name: name, customer_phone: phone, customer_address: addr })
        });
        const d = await r.json();
        if (d.ok) {
          msg.textContent = '✅ تم الحفظ بنجاح — أعِد تحميل الصفحة لرؤية التغييرات';
          msg.style.color = 'green'; msg.style.display = 'block';
        } else {
          msg.textContent = '❌ ' + (d.error || 'خطأ');
          msg.style.color = 'red'; msg.style.display = 'block';
        }
      } catch(e) { msg.textContent = '❌ ' + e.message; msg.style.color='red'; msg.style.display='block'; }
    }

    async function savePriceEdits() {
      const msg = document.getElementById('editPriceMsg');
      try {
        // Collect all items: { id, unit_price } array — existing /item-prices endpoint
        const inputs = document.querySelectorAll('#editPricesBox input[data-item-id][data-field="unit_price"]');
        const itemsPayload = Array.from(inputs).map(inp => ({
          id:         inp.dataset.itemId,
          unit_price: parseFloat(inp.value) || 0
        }));
        const r = await fetch(`${_BASE_EDIT}/api/sales/${_SALE_ID}/item-prices`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify({ items: itemsPayload })
        });
        const d = await r.json();
        if (!d.ok) throw new Error(d.error || 'خطأ في حفظ الأسعار');
        msg.textContent = '✅ تم الحفظ — أعِد تحميل الصفحة لرؤية الإجمالي الجديد';
        msg.style.color = 'green'; msg.style.display = 'block';
      } catch(e) { msg.textContent = '❌ ' + e.message; msg.style.color='red'; msg.style.display='block'; }
    }
    </script>
  </div>

  <% if (customer && customer.phone) { %>
  <div style="margin-top:10px;text-align:center;" class="no-print">
    <a id="waBtn" href="#" target="_blank"
       style="display:inline-flex;align-items:center;gap:6px;background:#25d366;color:#fff;text-decoration:none;padding:7px 16px;border-radius:20px;font-size:12px;font-weight:bold;">
      <svg width="14" height="14" fill="white" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.127.558 4.123 1.532 5.855L.054 23.5l5.819-1.527A11.938 11.938 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 01-5.012-1.375l-.36-.213-3.727.977.994-3.63-.235-.374A9.818 9.818 0 1112 21.818z"/></svg>
      إرسال واتساب
    </a>
  </div>
  <script>
    (function(){
      var phone = "<%= customer.phone %>".replace(/[^0-9]/g, "");
      var intl  = phone.startsWith("0") ? "2" + phone : phone;
      var store = "<%- (st && st.store_name) || 'المحل' %>";
      var items = [<% for (let _i=0; _i<items.length; _i++) { const it=items[_i]; const _nq=parseInt(it.net_qty!=null?it.net_qty:it.quantity); if(_nq<=0&&parseInt(it.returned_qty||0)>0) continue; %>"<%- it.product_name.replace(/"/g,'\\"') %> ×<%= _nq %>"<%= _i < items.length-1 ? ',' : '' %><% } %>];
      var total = "<%= fmt(_netTotal) %>";
      var msg   = "🧾 فاتورة من " + store + "\n#<%= sale.id %> — <%= saleDateDay %>\n\n" +
                  items.join("\n") + "\n\nالإجمالي: " + total + " جنيه\nشكراً لتعاملكم معنا 🙏";
      document.getElementById("waBtn").href = "https://wa.me/" + intl + "?text=" + encodeURIComponent(msg);
    })();
  </script>
  <% } %>

  <script>
    window.onload = function() {
      <% if (autoPrint) { %>
      setTimeout(() => window.print(), 300);
      <% } %>
    };
  </script>
</body>
</html>
