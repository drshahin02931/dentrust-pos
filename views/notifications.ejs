<%- include('partials/header', Object.assign({pageTitle: 'النواقص'}, locals)) %>
<div class="max-w-7xl mx-auto space-y-5">

  <!-- Header -->
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div>
      <h1 class="text-2xl font-black text-gray-900 flex items-center gap-2">
        <span>📉</span> النواقص ومتابعة المستودع والشراء
      </h1>
      <p class="text-xs text-gray-500 mt-1">
        متابعة فورية لكل المنتجات والمقاسات الناقصة أو التي وصلت لصفر بالمحل أو المستودع — مع آخر صلاحية وآخر سعر شراء والتحويل المباشر
      </p>
    </div>
    <button onclick="loadAll()" id="refreshBtn"
      class="bg-gradient-to-r from-[#10246b] via-[#521959] to-[#83142c] hover:opacity-95 text-white font-bold px-5 py-2.5 rounded-xl shadow flex items-center gap-2 text-sm">
      🔄 تحديث البيانات
    </button>
  </div>

  <!-- KPI / Quick Filter Cards -->
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2.5">
    <button type="button" onclick="setShortageFilter('all')" id="flt-all"
      class="flt-card text-right p-3 rounded-2xl border-2 border-blue-600 bg-blue-50/70 transition-all shadow-xs cursor-pointer">
      <div class="text-[11px] font-bold text-gray-600">📋 الكل</div>
      <div id="kpi-all" class="text-2xl font-black text-gray-900 mt-0.5 font-mono">—</div>
    </button>
    <button type="button" onclick="setShortageFilter('shop_zero')" id="flt-shop_zero"
      class="flt-card text-right p-3 rounded-2xl border border-red-200 bg-white hover:bg-red-50/50 transition-all shadow-xs cursor-pointer">
      <div class="text-[11px] font-bold text-red-700">🚫 صفر بالمحل</div>
      <div id="kpi-shop-zero" class="text-2xl font-black text-red-600 mt-0.5 font-mono">—</div>
    </button>
    <button type="button" onclick="setShortageFilter('shop_low')" id="flt-shop_low"
      class="flt-card text-right p-3 rounded-2xl border border-amber-200 bg-white hover:bg-amber-50/50 transition-all shadow-xs cursor-pointer">
      <div class="text-[11px] font-bold text-amber-800">⚠️ حد أدنى بالمحل</div>
      <div id="kpi-shop-low" class="text-2xl font-black text-amber-600 mt-0.5 font-mono">—</div>
    </button>
    <button type="button" onclick="setShortageFilter('can_transfer')" id="flt-can_transfer"
      class="flt-card text-right p-3 rounded-2xl border border-indigo-200 bg-white hover:bg-indigo-50/50 transition-all shadow-xs cursor-pointer">
      <div class="text-[11px] font-bold text-indigo-800">📦 متوفر للتحويل</div>
      <div id="kpi-transfer" class="text-2xl font-black text-indigo-700 mt-0.5 font-mono">—</div>
    </button>
    <button type="button" onclick="setShortageFilter('need_purchase')" id="flt-need_purchase"
      class="flt-card text-right p-3 rounded-2xl border border-rose-200 bg-white hover:bg-rose-50/50 transition-all shadow-xs cursor-pointer">
      <div class="text-[11px] font-bold text-rose-800">🛒 تنبيه للشراء</div>
      <div id="kpi-purchase" class="text-2xl font-black text-rose-700 mt-0.5 font-mono">—</div>
    </button>
    <button type="button" onclick="setShortageFilter('wh_short')" id="flt-wh_short"
      class="flt-card text-right p-3 rounded-2xl border border-purple-200 bg-white hover:bg-purple-50/50 transition-all shadow-xs cursor-pointer">
      <div class="text-[11px] font-bold text-purple-800">🏢 نواقص المستودع</div>
      <div id="kpi-wh-short" class="text-2xl font-black text-purple-700 mt-0.5 font-mono">—</div>
    </button>
  </div>

  <!-- Search & Category Filter Bar -->
  <div class="bg-white rounded-2xl border shadow-xs p-3.5 flex flex-wrap items-center gap-3">
    <div class="flex-1 min-w-[220px] relative">
      <span class="absolute right-3 top-2.5 text-gray-400">🔍</span>
      <input id="shortageSearch" type="text" placeholder="ابحث باسم المنتج أو الباركود أو المقاس..."
        oninput="applyShortageFilters()"
        class="w-full border rounded-xl pr-9 pl-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400"/>
    </div>
    <select id="shortageCatFilter" onchange="applyShortageFilters()"
      class="border rounded-xl px-3 py-2 text-sm bg-gray-50 font-semibold text-gray-700 focus:outline-none focus:ring-2 focus:ring-blue-400 min-w-[160px]">
      <option value="">كل التصنيفات</option>
    </select>
    <label class="flex items-center gap-1.5 text-xs font-bold text-gray-600 cursor-pointer bg-gray-50 border rounded-xl px-3 py-2">
      <input type="checkbox" id="hideUnsetZero" onchange="applyShortageFilters()" class="accent-blue-700"/>
      إخفاء الأصناف الصفرية بدون حد أدنى
    </label>
  </div>

  <!-- Results Container -->
  <div id="shortagesBody" class="space-y-3">
    <div class="bg-white rounded-2xl border p-10 text-center text-gray-400 text-sm">جارٍ تحميل النواقص...</div>
  </div>
</div>

<!-- ══════════════ Modal: تحويل مباشر من المستودع للمحل ══════════════ -->
<div id="shortageTransferModal" class="hidden fixed inset-0 bg-black/60 z-[80] flex items-center justify-center p-3 md:p-5">
  <div class="bg-white rounded-3xl shadow-2xl w-full max-w-lg overflow-hidden">
    <div class="bg-gradient-to-r from-[#10246b] via-[#521959] to-[#83142c] text-white p-4 sm:p-5 flex items-center justify-between">
      <div>
        <h3 class="font-black text-base sm:text-lg flex items-center gap-2"><span>🚚</span> تحويل من المستودع للمحل</h3>
        <p id="st-prod-name" class="text-xs text-purple-100 mt-0.5 font-bold"></p>
      </div>
      <button onclick="closeShortageTransferModal()" class="text-white/75 hover:text-white text-2xl leading-none">✕</button>
    </div>

    <div class="p-5 space-y-4 max-h-[80vh] overflow-y-auto">
      <div class="grid grid-cols-2 gap-2.5 text-center">
        <div class="bg-amber-50 border border-amber-200 rounded-2xl p-2.5">
          <div class="text-[11px] font-bold text-amber-800">المتاح بالمستودع</div>
          <div id="st-avail-wh" class="text-xl font-black text-amber-900 font-mono">0</div>
        </div>
        <div class="bg-blue-50 border border-blue-200 rounded-2xl p-2.5">
          <div class="text-[11px] font-bold text-blue-800">الرصيد الحالي بالمحل</div>
          <div id="st-avail-shop" class="text-xl font-black text-blue-900 font-mono">0</div>
        </div>
      </div>

      <!-- Batch Selector -->
      <div class="space-y-1.5">
        <label class="text-xs font-bold text-gray-700 block">📦 الشحنة المراد التحويل منها:</label>
        <select id="st-batch-select" onchange="onStBatchChange()"
          class="w-full border-2 border-indigo-200 rounded-xl px-3 py-2 text-xs font-bold bg-indigo-50/40 text-gray-800 focus:outline-none focus:ring-2 focus:ring-indigo-400"></select>
        <div class="flex items-center justify-between text-[11px] text-gray-500 px-1">
          <span>💰 سعر الشراء: <strong id="st-batch-cost" class="text-amber-700 font-mono">—</strong></span>
          <span id="st-batch-exp-wrap" class="hidden">📅 الصلاحية: <strong id="st-batch-exp" class="text-gray-700 font-mono">—</strong></span>
        </div>
      </div>

      <!-- Variants Selector (if item has variants) -->
      <div id="st-variants-box" class="hidden space-y-2 bg-gray-50 border rounded-2xl p-3">
        <label class="text-xs font-bold text-gray-700 block">🎨 اختر المقاس / الخيار المطلوب تحويله:</label>
        <div id="st-variants-list" class="flex flex-wrap gap-1.5"></div>
      </div>

      <!-- Quantity -->
      <div class="space-y-1.5">
        <div class="flex items-center justify-between">
          <label class="text-xs font-bold text-gray-700">الكمية المحولة:</label>
          <button type="button" onclick="setStAll()" class="text-xs font-bold text-blue-700 hover:underline">تحويل الكل المتاح</button>
        </div>
        <div class="flex items-center gap-2">
          <button type="button" onclick="chgStQty(-1)" class="w-10 h-10 rounded-xl bg-gray-100 hover:bg-gray-200 font-black text-lg">−</button>
          <input id="st-qty" type="number" min="1" value="1" oninput="validateStQty()"
            class="flex-1 border-2 border-blue-200 rounded-xl py-2 text-center text-lg font-black font-mono text-blue-900 focus:outline-none focus:ring-2 focus:ring-blue-400"/>
          <button type="button" onclick="chgStQty(1)" class="w-10 h-10 rounded-xl bg-gray-100 hover:bg-gray-200 font-black text-lg">+</button>
        </div>
      </div>

      <!-- Note -->
      <div>
        <label class="text-xs font-bold text-gray-700 block mb-1">ملاحظات التحويل (اختياري)</label>
        <input id="st-note" type="text" placeholder="تحويل من صفحة النواقص..."
          class="w-full border rounded-xl px-3 py-2 text-xs focus:outline-none focus:ring-2 focus:ring-blue-300"/>
      </div>

      <p id="st-error" class="hidden text-xs text-red-700 bg-red-50 border border-red-200 rounded-xl p-2.5 text-center font-bold"></p>

      <div class="flex gap-2 pt-2 border-t">
        <button type="button" id="st-confirm-btn" onclick="confirmShortageTransfer()"
          class="flex-1 bg-blue-700 hover:bg-blue-800 text-white font-bold py-2.5 rounded-xl text-sm shadow transition-all">
          ✅ تأكيد التحويل للمحل
        </button>
        <button type="button" onclick="closeShortageTransferModal()"
          class="px-5 bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold py-2.5 rounded-xl text-sm">
          إلغاء
        </button>
      </div>
    </div>
  </div>
</div>

<script>
const BASE = "<%- base %>";
let _allShortages = [];
let _currentFilter = "all";
const _expandedVariants = new Set();

function escHtml(s) {
  return String(s ?? '')
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

function fmtMoney(n) {
  const num = parseFloat(n || 0);
  if (!num || num <= 0) return 'غير محدد';
  return num.toLocaleString('ar-EG', { minimumFractionDigits: 0, maximumFractionDigits: 2 }) + ' ج.م';
}

function flattenClientCbv(cbv) {
  if (!cbv) return {};
  try {
    const parsed = typeof cbv === 'string' ? JSON.parse(cbv) : cbv;
    const out = {};
    Object.keys(parsed || {}).forEach(k => {
      const val = parsed[k];
      if (val && typeof val === 'object' && !('stock' in val) && !('checked' in val) && !('min_stock' in val)) {
        Object.keys(val).forEach(subK => {
          out[subK] = { ...val[subK], groupName: k, rawKey: subK };
        });
      } else if (val && typeof val === 'object') {
        const sep = k.indexOf('::');
        const g = sep !== -1 ? k.slice(0, sep) : 'عام';
        const rk = sep !== -1 ? k.slice(sep + 2) : k;
        out[rk] = { ...val, groupName: g, rawKey: rk };
      }
    });
    return out;
  } catch (_) { return {}; }
}

async function loadAll() {
  const btn = document.getElementById("refreshBtn");
  if (btn) { btn.disabled = true; btn.textContent = "⏳ جارٍ التحميل..."; }
  try {
    const res = await fetch(`${BASE}/api/products/low-stock`, { credentials: 'include' });
    const data = await res.json();
    _allShortages = Array.isArray(data) ? data : [];
    populateCategories();
    updateKpis();
    applyShortageFilters();
    if (typeof window.refreshAlerts === 'function') window.refreshAlerts();
  } catch (e) {
    document.getElementById("shortagesBody").innerHTML =
      `<div class="bg-white rounded-2xl border p-8 text-center text-red-500 font-bold text-sm">⚠️ حدث خطأ أثناء تحميل النواقص: ${escHtml(e.message)}</div>`;
  }
  if (btn) { btn.disabled = false; btn.textContent = "🔄 تحديث البيانات"; }
}

function populateCategories() {
  const sel = document.getElementById("shortageCatFilter");
  const cur = sel.value;
  const cats = Array.from(new Set(_allShortages.map(i => i.category || 'عام').filter(Boolean))).sort();
  sel.innerHTML = `<option value="">كل التصنيفات (${cats.length})</option>` +
    cats.map(c => `<option value="${escHtml(c)}">${escHtml(c)}</option>`).join('');
  if (cats.includes(cur)) sel.value = cur;
}

function updateKpis() {
  document.getElementById("kpi-all").textContent = _allShortages.length;
  document.getElementById("kpi-shop-zero").textContent = _allShortages.filter(i => i.product_id && i.shop_qty === 0).length;
  document.getElementById("kpi-shop-low").textContent = _allShortages.filter(i => i.product_id && i.shop_qty > 0 && i.is_shop_short).length;
  document.getElementById("kpi-transfer").textContent = _allShortages.filter(i => i.can_transfer).length;
  document.getElementById("kpi-purchase").textContent = _allShortages.filter(i => i.needs_purchase).length;
  document.getElementById("kpi-wh-short").textContent = _allShortages.filter(i => i.is_wh_short).length;
}

function setShortageFilter(mode) {
  _currentFilter = mode;
  document.querySelectorAll('.flt-card').forEach(el => {
    el.classList.remove('border-2', 'border-blue-600', 'bg-blue-50/70', 'ring-2', 'ring-blue-200');
    if (!el.classList.contains('bg-white')) el.classList.add('bg-white');
  });
  const active = document.getElementById(`flt-${mode}`);
  if (active) {
    active.classList.remove('bg-white');
    active.classList.add('border-2', 'border-blue-600', 'bg-blue-50/70', 'ring-2', 'ring-blue-200');
  }
  applyShortageFilters();
}

function toggleAllVariantsFor(key) {
  if (_expandedVariants.has(key)) _expandedVariants.delete(key);
  else _expandedVariants.add(key);
  applyShortageFilters();
}

function applyShortageFilters() {
  const q = (document.getElementById("shortageSearch").value || '').trim().toLowerCase();
  const cat = document.getElementById("shortageCatFilter").value;
  const hideUnsetZero = document.getElementById("hideUnsetZero").checked;

  const filtered = _allShortages.filter(item => {
    if (_currentFilter === 'shop_zero' && !(item.product_id && item.shop_qty === 0)) return false;
    if (_currentFilter === 'shop_low' && !(item.product_id && item.shop_qty > 0 && item.is_shop_short)) return false;
    if (_currentFilter === 'can_transfer' && !item.can_transfer) return false;
    if (_currentFilter === 'need_purchase' && !item.needs_purchase) return false;
    if (_currentFilter === 'wh_short' && !item.is_wh_short) return false;

    if (hideUnsetZero && item.shop_qty === 0 && (item.min_stock || 0) === 0 && (!item.short_variants || !item.short_variants.some(v => v.min_stock > 0))) {
      return false;
    }

    if (cat && (item.category || 'عام') !== cat) return false;

    if (q) {
      const mName = (item.product_name || '').toLowerCase().includes(q);
      const mBar = (item.barcode || '').toLowerCase().includes(q);
      const mCat = (item.category || '').toLowerCase().includes(q);
      const mVar = (item.variants_detail || []).some(v => (v.raw_key || '').toLowerCase().includes(q));
      if (!mName && !mBar && !mCat && !mVar) return false;
    }
    return true;
  });

  renderShortagesList(filtered);
}

function renderShortagesList(items) {
  const container = document.getElementById("shortagesBody");
  if (!items.length) {
    container.innerHTML = `
      <div class="bg-white rounded-2xl border p-10 text-center space-y-2">
        <div class="text-3xl">✅</div>
        <div class="text-base font-black text-emerald-700">لا توجد نواقص مطابقة للبحث الحالي!</div>
      </div>`;
    return;
  }

  container.innerHTML = items.map((item, idx) => {
    const rowKey = `${item.product_id || 'w'}_${item.warehouse_item_id || 'p'}_${idx}`;
    const isExpanded = _expandedVariants.has(rowKey);
    const hasWh = !!item.warehouse_item_id && item.warehouse_qty > 0;
    const isZero = item.product_id && item.shop_qty === 0;

    // Last expiry pill ONLY if present
    const expiryHtml = item.last_expiry_date
      ? `<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-bold bg-slate-100 text-slate-700 border border-slate-200 font-mono">📅 آخر صلاحية: ${escHtml(item.last_expiry_date)}</span>`
      : '';

    // Batches list (when available in warehouse)
    const batches = item.wh_batches || [];
    const batchesHtml = batches.length > 0 ? `
      <div class="mt-2 pt-2 border-t border-indigo-200/70 space-y-1">
        <div class="text-[11px] font-black text-indigo-900">📦 الشحنات المتاحة في المستودع (${batches.length}):</div>
        <div class="flex flex-wrap gap-1.5">
          ${batches.map(b => {
            const bExp = b.expiry_date ? ` • 📅 ${escHtml(b.expiry_date)}` : '';
            return `
              <button type="button" data-row-key="${escHtml(rowKey)}" data-batch-id="${b.id}" onclick="openShortageTransferFromBtn(this)"
                class="text-right bg-white hover:bg-indigo-50 border border-indigo-200 rounded-xl px-2.5 py-1.5 text-[11px] transition-all shadow-2xs cursor-pointer">
                <span class="font-bold text-indigo-950">${escHtml(b.batch_number)}</span>:
                <strong class="font-mono text-blue-700">${b.quantity}</strong> قطعة •
                <strong class="font-mono text-amber-700">${parseFloat(b.cost_price || 0).toFixed(2)} ج</strong>${bExp}
              </button>`;
          }).join('')}
        </div>
      </div>` : '';

    // Variant breakdown
    let variantsHtml = '';
    if (item.has_variants && item.variants_detail && item.variants_detail.length > 0) {
      const listToShow = isExpanded ? item.variants_detail : (item.short_variants.length > 0 ? item.short_variants : item.variants_detail);
      const hiddenCount = item.variants_detail.length - listToShow.length;
      variantsHtml = `
        <div class="mt-3 bg-gray-50/90 border border-gray-200 rounded-2xl p-3 space-y-2">
          <div class="flex items-center justify-between flex-wrap gap-2">
            <span class="text-xs font-black text-gray-700">🎨 تفاصيل المقاسات / الخيارات (${item.short_variants.length} ناقص من أصل ${item.variants_detail.length}):</span>
            ${item.variants_detail.length > item.short_variants.length && item.short_variants.length > 0 ? `
              <button type="button" onclick="toggleAllVariantsFor('${rowKey}')"
                class="text-[11px] font-bold text-blue-700 hover:underline cursor-pointer">
                ${isExpanded ? 'إخفاء المقاسات السليمة ▲' : `عرض باقي المقاسات (+${hiddenCount}) ▼`}
              </button>` : ''}
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2">
            ${listToShow.map(v => {
              const vBadgeBg = v.shop_qty === 0
                ? 'border-red-300 bg-red-50/70'
                : (v.is_shop_short ? 'border-amber-300 bg-amber-50/70' : (v.is_wh_short ? 'border-purple-200 bg-purple-50/50' : 'border-gray-200 bg-white'));
              const vLbl = v.group_name && v.group_name !== 'عام' ? `${v.group_name}: ${v.raw_key}` : v.raw_key;
              return `
                <div class="rounded-xl border ${vBadgeBg} p-2 flex items-center justify-between gap-2 text-xs">
                  <div class="min-w-0">
                    <div class="font-black text-gray-900 truncate">${escHtml(vLbl)}</div>
                    <div class="flex flex-wrap items-center gap-1.5 text-[11px] mt-0.5 font-mono">
                      <span class="${v.shop_qty === 0 ? 'text-red-700 font-black' : (v.is_shop_short ? 'text-amber-800 font-black' : 'text-gray-600')}">
                        المحل: ${v.shop_qty}
                      </span>
                      ${v.min_stock > 0 ? `<span class="text-gray-400">(أدنى: ${v.min_stock})</span>` : ''}
                      <span class="text-gray-300">|</span>
                      <span class="${v.wh_qty > 0 ? 'text-indigo-700 font-bold' : 'text-rose-700 font-bold'}">
                        مستودع: ${v.wh_qty}
                      </span>
                    </div>
                  </div>
                  <div class="flex-shrink-0">
                    ${v.wh_qty > 0 && item.warehouse_item_id
                      ? `<button type="button" data-row-key="${escHtml(rowKey)}" data-opt-key="${escHtml(v.raw_key)}" onclick="openShortageTransferFromBtn(this)"
                           class="bg-blue-700 hover:bg-blue-800 text-white font-bold px-2.5 py-1 rounded-lg text-[11px] shadow-2xs cursor-pointer">
                           🔄 تحويل
                         </button>`
                      : (v.is_short
                          ? `<span class="inline-block bg-rose-100 text-rose-800 border border-rose-200 font-bold px-2 py-0.5 rounded-lg text-[10px]">🛒 شراء</span>`
                          : `<span class="text-emerald-600 font-bold text-[10px]">✓</span>`)
                    }
                  </div>
                </div>`;
            }).join('')}
          </div>
        </div>`;
    }

    // Main Warehouse vs Purchase banner
    let whBoxHtml = '';
    if (hasWh) {
      whBoxHtml = `
        <div class="bg-indigo-50/70 border border-indigo-200 rounded-2xl p-3 space-y-2">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <div class="flex flex-wrap items-center gap-2">
              <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-xl text-xs font-black bg-indigo-100 text-indigo-900 border border-indigo-200">
                📦 متوفر بالمستودع: ${item.warehouse_qty} قطعة
              </span>
              ${item.is_wh_short ? `<span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-xl text-xs font-black bg-purple-100 text-purple-900 border border-purple-200">🏢 المستودع وصل للحد الأدنى (${item.warehouse_min_stock})</span>` : ''}
              <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-xl text-xs font-bold bg-amber-50 text-amber-900 border border-amber-200">
                💰 آخر سعر شراء: <strong class="font-mono">${fmtMoney(item.last_purchase_price)}</strong>
              </span>
            </div>
            <button type="button" data-row-key="${escHtml(rowKey)}" onclick="openShortageTransferFromBtn(this)"
              class="bg-blue-700 hover:bg-blue-800 text-white font-bold px-4 py-2 rounded-xl text-xs shadow transition-all flex items-center gap-1.5 cursor-pointer">
              <span>🔄</span> تحويل من المستودع للمحل
            </button>
          </div>
          ${batchesHtml}
        </div>`;
    } else {
      whBoxHtml = `
        <div class="bg-rose-50 border border-rose-200 rounded-2xl p-3 flex flex-wrap items-center justify-between gap-2">
          <div class="flex flex-wrap items-center gap-2">
            <span class="inline-flex items-center gap-1 px-3 py-1 rounded-xl text-xs font-black bg-rose-600 text-white shadow-2xs">
              🛒 تنبيه للشراء — غير متوفر في المستودع
            </span>
            ${item.warehouse_min_stock > 0 ? `<span class="text-xs font-bold text-rose-800">(الحد الأدنى بالمستودع: ${item.warehouse_min_stock})</span>` : ''}
          </div>
          <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white border border-rose-200 text-xs font-bold text-gray-800">
            <span>💰 آخر سعر شراء:</span>
            <strong class="font-mono text-rose-700 text-sm">${fmtMoney(item.last_purchase_price)}</strong>
          </div>
        </div>`;
    }

    return `
      <div class="bg-white rounded-2xl border ${isZero ? 'border-red-300 shadow-sm' : 'border-gray-200 shadow-xs'} p-4 space-y-3" data-row-key="${rowKey}">
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div class="space-y-1">
            <div class="flex flex-wrap items-center gap-2">
              <h3 class="text-base font-black text-gray-900">${escHtml(item.product_name)}</h3>
              <span class="px-2 py-0.5 rounded-lg text-[11px] font-bold bg-gray-100 text-gray-700">${escHtml(item.category || 'عام')}</span>
              ${item.barcode ? `<span class="font-mono text-[11px] text-gray-400">#${escHtml(item.barcode)}</span>` : ''}
              ${!item.product_id ? `<span class="px-2 py-0.5 rounded-lg text-[11px] font-bold bg-purple-100 text-purple-800">بالمستودع فقط</span>` : ''}
            </div>
            <div class="flex flex-wrap items-center gap-2 pt-0.5">
              ${expiryHtml}
            </div>
          </div>

          <div class="flex items-center gap-2 flex-wrap">
            ${item.product_id ? `
              <div class="px-3 py-1.5 rounded-xl border text-center ${isZero ? 'bg-red-50 border-red-300' : (item.is_shop_short ? 'bg-amber-50 border-amber-300' : 'bg-emerald-50 border-emerald-200')}">
                <div class="text-[10px] font-bold text-gray-600">الرصيد بالمحل</div>
                <div class="text-lg font-black font-mono ${isZero ? 'text-red-700' : (item.is_shop_short ? 'text-amber-800' : 'text-emerald-700')}">
                  ${item.shop_qty}
                </div>
                ${item.shop_min_stock > 0 ? `<div class="text-[10px] text-gray-500 font-bold">حد أدنى: ${item.shop_min_stock}</div>` : ''}
              </div>` : ''}
          </div>
        </div>

        ${whBoxHtml}
        ${variantsHtml}
      </div>
    `;
  }).join('');

  // Store row lookup map for modal triggers
  window._shortageRowMap = {};
  items.forEach((item, idx) => {
    window._shortageRowMap[`${item.product_id || 'w'}_${item.warehouse_item_id || 'p'}_${idx}`] = item;
  });
}

// ── Direct Transfer Modal Logic ───────────────────────────────────────────────
let _stItem = null;
let _stSelectedOpt = null;
let _stMaxAvail = 0;

function openShortageTransferFromBtn(btn) {
  const rowKey = btn.dataset.rowKey;
  const batchId = btn.dataset.batchId ? parseInt(btn.dataset.batchId, 10) : null;
  const optKey = btn.dataset.optKey || null;
  openShortageTransferModal(rowKey, batchId, optKey);
}

function selectStVariantFromBtn(btn) {
  selectStVariant(btn.dataset.optKey, parseInt(btn.dataset.optStock || 0, 10));
}

function openShortageTransferModal(rowKey, initialBatchId = null, presetOptKey = null) {
  const item = (window._shortageRowMap || {})[rowKey];
  if (!item || !item.warehouse_item_id) return;
  _stItem = item;
  _stSelectedOpt = presetOptKey;

  document.getElementById('st-prod-name').textContent = item.product_name;
  document.getElementById('st-avail-shop').textContent = item.shop_qty || 0;
  document.getElementById('st-note').value = '';
  document.getElementById('st-error').classList.add('hidden');
  document.getElementById('st-qty').value = '1';

  const bSel = document.getElementById('st-batch-select');
  const batches = item.wh_batches || [];
  bSel.innerHTML = `<option value="">⚡ تلقائي — الأقدم صلاحية والأقدم دخولاً (FIFO)</option>` +
    batches.map(b => {
      const expStr = b.expiry_date ? ` | صلاحية: ${escHtml(b.expiry_date)}` : '';
      return `<option value="${b.id}">📦 ${escHtml(b.batch_number)} (متاح: ${b.quantity} | تكلفة: ${parseFloat(b.cost_price || 0).toFixed(2)} ج${expStr})</option>`;
    }).join('');
  bSel.value = initialBatchId && batches.some(b => String(b.id) === String(initialBatchId)) ? String(initialBatchId) : '';

  onStBatchChange();
  document.getElementById('shortageTransferModal').classList.remove('hidden');
}

function closeShortageTransferModal() {
  document.getElementById('shortageTransferModal').classList.add('hidden');
  _stItem = null;
}

function onStBatchChange() {
  if (!_stItem) return;
  const bId = document.getElementById('st-batch-select').value;
  const batches = _stItem.wh_batches || [];
  const selBatch = bId ? batches.find(b => String(b.id) === String(bId)) : null;

  const costEl = document.getElementById('st-batch-cost');
  const expWrap = document.getElementById('st-batch-exp-wrap');
  const expEl = document.getElementById('st-batch-exp');

  if (selBatch) {
    costEl.textContent = parseFloat(selBatch.cost_price || 0).toFixed(2) + ' ج';
    if (selBatch.expiry_date) {
      expEl.textContent = selBatch.expiry_date;
      expWrap.classList.remove('hidden');
    } else {
      expWrap.classList.add('hidden');
    }
  } else {
    costEl.textContent = fmtMoney(_stItem.last_purchase_price);
    const firstExp = batches.find(b => b.expiry_date)?.expiry_date || _stItem.last_expiry_date;
    if (firstExp) {
      expEl.textContent = firstExp + ' (الأقرب)';
      expWrap.classList.remove('hidden');
    } else {
      expWrap.classList.add('hidden');
    }
  }

  const vBox = document.getElementById('st-variants-box');
  const vList = document.getElementById('st-variants-list');
  const whItemMap = flattenClientCbv(_stItem.wh_checkbox_values);
  const whKeys = Object.keys(whItemMap);

  if (whKeys.length > 0) {
    vBox.classList.remove('hidden');
    const sourceMap = (selBatch && selBatch.checkbox_values) ? flattenClientCbv(selBatch.checkbox_values) : whItemMap;
    if (!_stSelectedOpt || (!sourceMap[_stSelectedOpt] && !whItemMap[_stSelectedOpt])) {
      _stSelectedOpt = whKeys.find(k => (sourceMap[k]?.stock || 0) > 0) || whKeys[0];
    }
    const selStock = parseInt(sourceMap[_stSelectedOpt]?.stock || 0, 10);
    _stMaxAvail = selStock;

    vList.innerHTML = whKeys.map(rk => {
      const st = parseInt(sourceMap[rk]?.stock || 0, 10);
      const isSel = _stSelectedOpt === rk;
      return `
        <button type="button" onclick="selectStVariantFromBtn(this)" data-opt-key="${escHtml(rk)}" data-opt-stock="${st}"
          class="st-var-btn px-3 py-1.5 rounded-xl border text-xs font-bold transition-all cursor-pointer ${isSel ? 'bg-blue-700 text-white border-blue-700 shadow-xs' : 'bg-white text-gray-700 border-gray-200 hover:border-blue-400'}">
          ${escHtml(rk)} <span class="font-mono opacity-80">(${st})</span>
        </button>`;
    }).join('');
    document.getElementById('st-avail-wh').textContent = _stMaxAvail;
  } else {
    vBox.classList.add('hidden');
    _stSelectedOpt = null;
    _stMaxAvail = selBatch ? parseInt(selBatch.quantity || 0, 10) : parseInt(_stItem.warehouse_qty || 0, 10);
    document.getElementById('st-avail-wh').textContent = _stMaxAvail;
  }
  validateStQty();
}

function selectStVariant(optKey, stock) {
  _stSelectedOpt = optKey;
  _stMaxAvail = stock;
  document.getElementById('st-avail-wh').textContent = stock;
  document.querySelectorAll('.st-var-btn').forEach(b => {
    const isSel = b.dataset.optKey === optKey;
    b.className = isSel
      ? 'st-var-btn px-3 py-1.5 rounded-xl border text-xs font-bold transition-all cursor-pointer bg-blue-700 text-white border-blue-700 shadow-xs'
      : 'st-var-btn px-3 py-1.5 rounded-xl border text-xs font-bold transition-all cursor-pointer bg-white text-gray-700 border-gray-200 hover:border-blue-400';
  });
  validateStQty();
}

function validateStQty() {
  const inp = document.getElementById('st-qty');
  let val = parseInt(inp.value || 0, 10);
  if (_stMaxAvail > 0 && val > _stMaxAvail) inp.value = _stMaxAvail;
  if (val < 1) inp.value = 1;
}

function chgStQty(delta) {
  const inp = document.getElementById('st-qty');
  const maxAllowed = Math.max(1, _stMaxAvail);
  inp.value = Math.max(1, Math.min(maxAllowed, (parseInt(inp.value || 1, 10) || 1) + delta));
}

function setStAll() {
  document.getElementById('st-qty').value = Math.max(1, _stMaxAvail);
}

async function confirmShortageTransfer() {
  if (!_stItem) return;
  const errEl = document.getElementById('st-error');
  errEl.classList.add('hidden');
  const btn = document.getElementById('st-confirm-btn');
  const qty = parseInt(document.getElementById('st-qty').value || 0, 10);
  const batchId = document.getElementById('st-batch-select').value || null;
  const note = document.getElementById('st-note').value.trim();

  if (qty <= 0 || (_stMaxAvail > 0 && qty > _stMaxAvail)) {
    errEl.textContent = `الكمية المطلوبة (${qty}) غير متاحة (${_stMaxAvail} متاح)`;
    errEl.classList.remove('hidden');
    return;
  }

  btn.disabled = true;
  btn.textContent = '⏳ جارٍ التحويل...';
  try {
    const res = await fetch(`${BASE}/api/warehouse/transfer`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        warehouse_item_id: _stItem.warehouse_item_id,
        quantity: qty,
        selected_option: _stSelectedOpt,
        batch_id: batchId ? parseInt(batchId, 10) : null,
        note: note || 'تحويل مباشر من صفحة النواقص'
      })
    });
    const data = await res.json();
    if (!res.ok || data.error) throw new Error(data.error || 'فشل التحويل');

    closeShortageTransferModal();
    await loadAll();
    alert(`✅ تم تحويل ${qty} قطعة إلى المحل بنجاح!`);
  } catch (err) {
    errEl.textContent = err.message;
    errEl.classList.remove('hidden');
  } finally {
    btn.disabled = false;
    btn.textContent = '✅ تأكيد التحويل للمحل';
  }
}

loadAll();
</script>

