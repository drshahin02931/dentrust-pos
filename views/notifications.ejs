<%- include('partials/header', Object.assign({pageTitle: 'الإشعارات'}, locals)) %>
<div class="max-w-3xl mx-auto space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold text-gray-800">🔔 الإشعارات</h1>
    <button onclick="loadAll()" id="refreshBtn"
      class="bg-blue-700 text-white font-semibold px-6 py-2.5 rounded-xl hover:bg-blue-800 flex items-center gap-2">
      🔄 تحديث
    </button>
  </div>

  <!-- Out of Stock -->
  <div class="bg-white rounded-2xl border shadow-sm p-6 space-y-4">
    <div class="flex items-center justify-between border-b pb-2">
      <h2 class="font-bold text-gray-700 text-base">🚫 نفد من المخزون</h2>
      <span id="outBadge" class="hidden bg-red-100 text-red-700 text-xs font-black rounded-full px-3 py-1"></span>
    </div>
    <div id="outStockBody">
      <div class="flex items-center justify-center py-8 text-gray-400 text-sm gap-2">
        <svg class="animate-spin h-4 w-4 text-gray-400" viewBox="0 0 24 24" fill="none">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"/>
        </svg>
        جارٍ التحميل...
      </div>
    </div>
  </div>

  <!-- Low Stock -->
  <div class="bg-white rounded-2xl border shadow-sm p-6 space-y-4">
    <div class="flex items-center justify-between border-b pb-2">
      <h2 class="font-bold text-gray-700 text-base">⚠️ مخزون منخفض</h2>
      <span id="lowBadge" class="hidden bg-orange-100 text-orange-700 text-xs font-black rounded-full px-3 py-1"></span>
    </div>
    <div id="lowStockBody">
      <div class="flex items-center justify-center py-8 text-gray-400 text-sm gap-2">
        <svg class="animate-spin h-4 w-4 text-gray-400" viewBox="0 0 24 24" fill="none">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"/>
        </svg>
        جارٍ التحميل...
      </div>
    </div>
  </div>
</div>

<script>
const BASE = "<%- base %>";

async function loadAll() {
  const btn = document.getElementById("refreshBtn");
  btn.disabled = true;
  btn.textContent = "⏳ جارٍ التحديث...";
  try {
    const res = await fetch(`${BASE}/api/products/low-stock`);
    const items = await res.json();
    renderSection("outStockBody", "outBadge", items.filter(p => p.quantity === 0), true);
    renderSection("lowStockBody", "lowBadge", items.filter(p => p.quantity > 0), false);
  } catch(e) {
    ["outStockBody","lowStockBody"].forEach(id => {
      document.getElementById(id).innerHTML =
        `<div class="py-6 text-center text-red-400 text-sm">⚠️ حدث خطأ أثناء التحميل</div>`;
    });
  }
  btn.disabled = false;
  btn.textContent = "🔄 تحديث";
}

function renderSection(bodyId, badgeId, items, isOut) {
  const body  = document.getElementById(bodyId);
  const badge = document.getElementById(badgeId);

  if (!items.length) {
    badge.classList.add("hidden");
    body.innerHTML = `
      <div class="flex items-center justify-center gap-2 py-6 text-green-600 text-sm font-medium">
        <span class="text-lg">✅</span>
        <span>${isOut ? 'لا توجد منتجات نافدة' : 'المخزون جيد، لا توجد منتجات منخفضة'}</span>
      </div>`;
    return;
  }

  badge.textContent = `${items.length} منتج`;
  badge.classList.remove("hidden");

  body.innerHTML = `
    <div class="overflow-hidden rounded-xl border border-gray-100">
      <table class="w-full text-sm">
        <thead>
          <tr class="bg-gray-50 text-right text-xs font-semibold text-gray-500 border-b">
            <th class="px-4 py-3">المنتج</th>
            <th class="px-4 py-3">التصنيف</th>
            <th class="px-4 py-3 text-center">الكمية</th>
            <th class="px-4 py-3 text-center">الحد الأدنى</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          ${items.map(p => `
            <tr class="hover:bg-gray-50 transition-colors">
              <td class="px-4 py-3 font-semibold text-gray-800">${p.product_name}</td>
              <td class="px-4 py-3 text-gray-400 text-xs">${p.category || '—'}</td>
              <td class="px-4 py-3 text-center">
                <span class="inline-block font-black text-sm px-2.5 py-0.5 rounded-full
                  ${p.quantity === 0
                    ? 'bg-red-100 text-red-700'
                    : 'bg-orange-100 text-orange-700'}">
                  ${p.quantity}
                </span>
              </td>
              <td class="px-4 py-3 text-center text-gray-500 text-xs">${p.min_stock}</td>
            </tr>`).join("")}
        </tbody>
      </table>
    </div>`;
}

loadAll();
</script>

</main>
<%- include('partials/footer', locals) %>
